---

<button
  id="code-mode-toggle"
  class="relative flex items-center gap-1.5 px-3 py-1.5 rounded-md font-mono text-xs tracking-wider transition-all duration-300 border border-dark-200 hover:border-emerald-400/50 bg-dark-50 text-dark-500 hover:text-emerald-500 group"
  aria-label="Activar Code Mode"
>
  <span class="inline-block w-1.5 h-1.5 rounded-full bg-dark-300 transition-colors duration-300 group-hover:bg-emerald-400" id="code-mode-dot"></span>
  <span id="code-mode-label">CODE_MODE:<span class="text-dark-400" id="code-mode-state">OFF</span></span>
</button>

<script>
  const codeToggle = document.getElementById('code-mode-toggle');
  const codeDot = document.getElementById('code-mode-dot');
  const codeModeState = document.getElementById('code-mode-state');

  function applyCodeMode(active: boolean, instant = false) {
    if (active) {
      // Add code-mode but start with hidden visual state for boot effect
      document.documentElement.classList.add('code-mode');
      document.body.classList.add('code-mode');

      if (!instant) {
        // Delayed visual reveal: start transparent, fade in after boot sequence
        document.body.classList.add('code-mode--booting');
        // Remove booting class after the last boot log fires (~1800ms)
        setTimeout(() => {
          document.body.classList.remove('code-mode--booting');
        }, 1800);
      }

      if (codeDot) codeDot.classList.add('bg-emerald-400', 'shadow-[0_0_6px_rgba(52,211,153,0.5)]');
      if (codeDot) codeDot.classList.remove('bg-dark-300');
      if (codeModeState) {
        codeModeState.textContent = 'ON';
        codeModeState.classList.remove('text-dark-400');
        codeModeState.classList.add('text-emerald-400');
      }
      if (codeToggle) {
        codeToggle.classList.add('border-emerald-400/40', 'text-emerald-400');
        codeToggle.classList.remove('border-dark-200', 'text-dark-500');
      }
    } else {
      document.documentElement.classList.remove('code-mode');
      document.body.classList.remove('code-mode');
      document.body.classList.remove('code-mode--booting');
      if (codeDot) codeDot.classList.remove('bg-emerald-400', 'shadow-[0_0_6px_rgba(52,211,153,0.5)]');
      if (codeDot) codeDot.classList.add('bg-dark-300');
      if (codeModeState) {
        codeModeState.textContent = 'OFF';
        codeModeState.classList.add('text-dark-400');
        codeModeState.classList.remove('text-emerald-400');
      }
      if (codeToggle) {
        codeToggle.classList.remove('border-emerald-400/40', 'text-emerald-400');
        codeToggle.classList.add('border-dark-200', 'text-dark-500');
      }
    }
  }

  // Initialize from localStorage (instant = true to skip boot animation on page load)
  const savedCodeMode = localStorage.getItem('code-mode') === 'on';
  applyCodeMode(savedCodeMode, true);

  // ── Subtle activation sound via Web Audio API ──
  function playCodeModeSound(activate: boolean) {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);

      if (activate) {
        // Rising "power on" beep — two quick tones
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, ctx.currentTime);
        osc.frequency.setValueAtTime(900, ctx.currentTime + 0.06);
        gain.gain.setValueAtTime(0.04, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.15);
      } else {
        // Falling "power off" beep
        osc.type = 'sine';
        osc.frequency.setValueAtTime(900, ctx.currentTime);
        osc.frequency.setValueAtTime(400, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.03, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
        osc.start(ctx.currentTime);
        osc.stop(ctx.currentTime + 0.12);
      }

      // Clean up context after sound finishes
      setTimeout(() => ctx.close(), 300);
    } catch {
      // Web Audio API not available — silently skip
    }
  }

  codeToggle?.addEventListener('click', () => {
    const isActive = document.documentElement.classList.contains('code-mode');
    const newState = !isActive;
    localStorage.setItem('code-mode', newState ? 'on' : 'off');
    playCodeModeSound(newState);
    applyCodeMode(newState);
  });
</script>
