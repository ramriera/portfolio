---
import { Image } from 'astro:assets';
import profileImg from '@/assets/shared/foto-perfil.png';
---

<section class="section-padding" data-component="AboutSection">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center about-grid">
      <!-- Image side -->
      <div data-reveal="left" class="relative about-image-col" data-component="ProfileImage">
        <div class="relative rounded-2xl overflow-hidden dashed-border about-image-wrap">
          <Image
            src={profileImg}
            alt="Ramon Riera"
            class="w-full aspect-[3/4] lg:aspect-[4/5] object-cover"
            loading="lazy"
            decoding="async"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            data-token="$aspect-ratio: 4/3 → 4/5 (lg)|$radius-2xl: 1rem / 16px|$border: 1px solid $neutral-200"
          />
        </div>
      </div>

      <!-- Content side -->
      <div>
        <div data-reveal data-delay="0" class="mb-6 flex items-center gap-3 about-icon-badge">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-eye-blink">
                <!-- Eye outer shape -->
                <path d="M4 22C4 22 10 10 22 10C34 10 40 22 40 22C40 22 34 34 22 34C10 34 4 22 4 22Z" class="icon-stroke icon-draw" />
                <!-- Iris -->
                <circle cx="22" cy="22" r="7" class="icon-accent icon-draw-delay" />
              </g>
              <!-- Pupil (looks around) -->
              <g class="icon-eye-pupil">
                <circle cx="22" cy="22" r="3" class="icon-accent-fill" />
              </g>
              <!-- Reflection dot -->
              <circle cx="24.5" cy="19.5" r="1.5" fill="white" opacity="0.6" class="icon-eye-pupil" />
            </svg>
          </span>
        </div>

        <h2 data-reveal data-delay="100" class="heading-lg mb-6 about-heading-design"
          data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)|$spacing-bottom: 1.5rem / 24px">
          Diseñador con visión
          <span class="text-primary-500"
            data-token="$color-primary-500: #D97757">estratégica</span>
        </h2>

        <!-- Code mode: JSDoc block in window container -->
        <div data-reveal data-delay="100" class="about-jsdoc mb-2" aria-hidden="true">
          <div class="jsdoc-window">
            <div class="jsdoc-titlebar">
              <div class="jsdoc-dots">
                <span class="json-dot json-dot--red"></span>
                <span class="json-dot json-dot--yellow"></span>
                <span class="json-dot json-dot--green"></span>
              </div>
              <span class="jsdoc-filename">
                <svg class="jsdoc-file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
                </svg>
                core.config.ts
              </span>
              <span class="jsdoc-tab-active">core.config.ts</span>
            </div>
            <div class="jsdoc-body">
              <div class="jsdoc-line"><span class="jsdoc-gutter">1</span><span class="jsdoc-code"><span class="jsdoc-delim">/**</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">2</span><span class="jsdoc-code"><span class="jsdoc-star"> *</span> <span class="jsdoc-desc">Diseñador con visión estratégica</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">3</span><span class="jsdoc-code"><span class="jsdoc-star"> *</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">4</span><span class="jsdoc-code"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@role</span> <span class="jsdoc-value">UX Lead · Product Designer</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">5</span><span class="jsdoc-code"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@vision</span> <span class="jsdoc-value">Strategic Product Design</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">6</span><span class="jsdoc-code"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@method</span> <span class="jsdoc-value">Data-driven & User-centric</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">7</span><span class="jsdoc-code"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@stack</span> <span class="jsdoc-value">Design Systems · DesignOps · UX Research</span></span></div>
              <div class="jsdoc-line"><span class="jsdoc-gutter">8</span><span class="jsdoc-code"><span class="jsdoc-delim"> */</span></span></div>
            </div>
          </div>
        </div>

        <!-- Normal mode: prose paragraphs -->
        <div data-reveal data-delay="200" class="about-bio-prose space-y-5 text-body mb-10"
          data-token="$font-family-sans: Inter|$color-text-body: #7c766c|$spacing-gap: 1.25rem / 20px">
          <p>
            Soy Ramon Riera, <strong class="text-neutral-900 font-semibold">UX y Product Designer</strong> especializado en <strong class="text-neutral-900 font-semibold">estrategia de experiencia de usuario</strong> y <strong class="text-neutral-900 font-semibold">Design Operations</strong>, con más de 8 años diseñando productos digitales para empresas como <strong class="text-neutral-900 font-semibold">Iberia</strong> y <strong class="text-neutral-900 font-semibold">Banco Sabadell</strong> o mejorando el flujo de <strong class="text-neutral-900 font-semibold">ImaginBank</strong> y <strong class="text-neutral-900 font-semibold">Massimo Dutti</strong>.
          </p>
          <p>
            Trabajo en la intersección entre <strong class="text-neutral-900 font-semibold">UX, estrategia y sistemas de diseño</strong>, ayudando a equipos de producto e ingeniería a crear experiencias consistentes. Actualmente soy <strong class="text-neutral-900 font-semibold">UX Lead en Doctori.com</strong>, donde lidero <strong class="text-neutral-900 font-semibold">Design Operations</strong> y el desarrollo del <strong class="text-neutral-900 font-semibold">Design System</strong>.
          </p>
          <p>
            Creo firmemente en un diseño que <strong class="text-neutral-900 font-semibold">simplifica lo complejo</strong>, alineando las decisiones de negocio con las necesidades del usuario para crear experiencias que, simplemente, funcionan.
          </p>
        </div>
        <!-- Code mode: console/terminal window -->
        <div data-reveal data-delay="200" class="about-bio-readme mb-6">
          <div class="readme-window">
            <div class="readme-titlebar">
              <div class="readme-dots">
                <span class="json-dot json-dot--red"></span>
                <span class="json-dot json-dot--yellow"></span>
                <span class="json-dot json-dot--green"></span>
              </div>
              <span class="readme-filename">
                <svg class="readme-file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                about.md
              </span>
              <span class="readme-tab-active">about.md</span>
            </div>
            <div class="readme-body">
              <div class="readme-line"><span class="readme-gutter">1</span><span class="readme-code"><span class="readme-delim">/**</span></span></div>
              <div class="readme-line"><span class="readme-gutter">2</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-tag">@module</span> <span class="readme-text">about-designer</span></span></div>
              <div class="readme-line"><span class="readme-gutter">3</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-tag">@role</span> <span class="readme-text">UX &amp; Product Designer</span></span></div>
              <div class="readme-line"><span class="readme-gutter">4</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-tag">@experience</span> <span class="readme-text">8+ years</span></span></div>
              <div class="readme-line"><span class="readme-gutter">5</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-tag">@description</span></span></div>
              <div class="readme-line"><span class="readme-gutter">6</span><span class="readme-code"><span class="readme-star"> *</span></span></div>
              <div class="readme-line"><span class="readme-gutter">7</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text">Especializado en <span class="readme-highlight">estrategia de experiencia</span></span></span></div>
              <div class="readme-line"><span class="readme-gutter">8</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text"><span class="readme-highlight">de usuario</span> y <span class="readme-highlight">Design Operations</span>, diseñando</span></span></div>
              <div class="readme-line"><span class="readme-gutter">9</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text">productos digitales para empresas como</span></span></div>
              <div class="readme-line"><span class="readme-gutter">10</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text"><span class="readme-highlight">Iberia</span>, <span class="readme-highlight">Banco Sabadell</span>, <span class="readme-highlight">ImaginBank</span></span></span></div>
              <div class="readme-line"><span class="readme-gutter">11</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text">y <span class="readme-highlight">Massimo Dutti</span>.</span></span></div>
              <div class="readme-line"><span class="readme-gutter">12</span><span class="readme-code"><span class="readme-star"> *</span></span></div>
              <div class="readme-line"><span class="readme-gutter">13</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text">Trabajo en la intersección entre <span class="readme-highlight">UX</span>,</span></span></div>
              <div class="readme-line"><span class="readme-gutter">14</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text"><span class="readme-highlight">estrategia</span> y <span class="readme-highlight">sistemas de diseño</span>.</span></span></div>
              <div class="readme-line"><span class="readme-gutter">15</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text">Actualmente <span class="readme-highlight">UX Lead en Doctori.com</span>.</span></span></div>
              <div class="readme-line"><span class="readme-gutter">16</span><span class="readme-code"><span class="readme-star"> *</span></span></div>
              <div class="readme-line"><span class="readme-gutter">17</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-tag">@philosophy</span> <span class="readme-text">Simplificar lo complejo, alineando</span></span></div>
              <div class="readme-line"><span class="readme-gutter">18</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-text">  negocio con necesidades del usuario.</span></span></div>
              <div class="readme-line"><span class="readme-gutter">19</span><span class="readme-code"><span class="readme-star"> *</span></span></div>
              <div class="readme-line"><span class="readme-gutter">20</span><span class="readme-code"><span class="readme-star"> *</span> <span class="readme-tag">@stack</span> <span class="readme-text"><span class="readme-highlight">Design Systems</span> | <span class="readme-highlight">Product Design</span> | <span class="readme-highlight">DesignOps</span></span></span></div>
              <div class="readme-line"><span class="readme-gutter">21</span><span class="readme-code"><span class="readme-delim"> */</span></span></div>
            </div>

            <!-- Command lines (terminal style, inside window) -->
            <div class="readme-cmds">
              <a href="/about" class="readme-cmd-line" data-component="ButtonRunCmd">
                <span class="readme-gutter">22</span>
                <span class="readme-code">
                  <span class="readme-cmd-prompt">&gt;</span> <span class="readme-cmd-text">cat</span> <span class="readme-cmd-file">about.md</span><span class="readme-cmd-cursor">_</span>
                </span>
              </a>
              <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
                class="readme-cmd-line" data-component="ButtonCVCode">
                <span class="readme-gutter">23</span>
                <span class="readme-code">
                  <span class="readme-cmd-prompt">&gt;</span> <span class="readme-cmd-text">get</span> <span class="readme-cmd-file">cv.pdf</span><span class="readme-cmd-cursor">_</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div data-reveal data-delay="300" class="flex flex-wrap gap-4 about-buttons-normal">
          <a href="/about" class="btn-primary hero-cta-normal"
            data-component="ButtonPrimary"
            data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
            Conocer más
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/docs/CV-Ramon-Riera-Depares.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline btn-cv-normal"
            data-component="ButtonOutline"
            data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px"
          >
            Ver CV
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══ JSDoc heading — code mode only ═══ */
  .about-jsdoc {
    display: none;
  }

  :global(.code-mode) .about-heading-design {
    display: none !important;
  }

  :global(.code-mode) .about-jsdoc {
    display: block;
  }

  /* Hide icon badge + remove top space in code mode */
  :global(.code-mode) .about-icon-badge {
    display: none !important;
  }

  /* Photo container: stretch column, center image vertically */
  :global(.code-mode) .about-grid {
    align-items: stretch !important;
  }

  :global(.code-mode) .about-image-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  :global(.code-mode) .about-image-wrap {
    background: #1e1e2e;
  }

  /* ── Window container (matches readme-window) ── */
  .jsdoc-window {
    background: #1e1e2e;
    border-radius: 8px;
    border: 1px solid var(--cm-border, #30363d);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .jsdoc-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    background: #181825;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .jsdoc-dots {
    display: flex;
    gap: 6px;
  }

  .jsdoc-filename {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #7d8590;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .jsdoc-file-icon {
    color: #7d8590;
    flex-shrink: 0;
  }

  .jsdoc-tab-active {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #e6edf3;
    background: #1e1e2e;
    padding: 0.25rem 0.75rem;
    border-radius: 4px 4px 0 0;
    margin-left: auto;
    border: 1px solid var(--cm-border, #30363d);
    border-bottom: 1px solid #1e1e2e;
  }

  .jsdoc-body {
    padding: 0.5rem 0;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .jsdoc-line {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    position: relative;
    transition: background 0.15s ease;
  }

  .jsdoc-line:hover {
    background: var(--cm-bg-hover, rgba(255, 255, 255, 0.04));
  }

  .jsdoc-line::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    width: 2px;
    background: transparent;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .jsdoc-line:hover::before {
    background: var(--cm-function, #8be9fd);
    box-shadow: 0 0 6px rgba(139, 233, 253, 0.4);
  }

  .jsdoc-gutter {
    display: inline-block;
    min-width: 36px;
    text-align: right;
    padding-right: 12px;
    color: var(--cm-text-muted, #7d8590);
    opacity: 0.3;
    user-select: none;
    flex-shrink: 0;
    font-size: inherit;
    line-height: inherit;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .jsdoc-line:hover .jsdoc-gutter {
    color: var(--cm-function, #8be9fd);
    opacity: 0.9;
  }

  .jsdoc-code {
    flex: 1;
    min-width: 0;
  }

  .jsdoc-delim {
    color: var(--cm-comment);
    opacity: 0.5;
  }

  .jsdoc-star {
    color: var(--cm-comment);
    opacity: 0.5;
  }

  .jsdoc-desc {
    color: var(--cm-text-secondary);
    font-weight: 500;
    font-size: 1.15em;
  }

  .jsdoc-tag {
    color: var(--cm-keyword);
  }

  .jsdoc-value {
    color: var(--cm-text-muted);
  }

  /* ── Hide design-mode buttons in code mode ── */
  :global(.code-mode) .about-buttons-normal {
    display: none !important;
  }

  /* ── Readme command lines (inside window) ── */
  .readme-cmds {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding: 0.5rem 0 0.75rem;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .readme-cmd-line {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    position: relative;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .readme-cmd-line:hover {
    background: var(--cm-bg-hover, rgba(255, 255, 255, 0.04));
  }

  .readme-cmd-line::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    width: 2px;
    background: transparent;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .readme-cmd-line:hover::before {
    background: var(--cm-string, #50fa7b);
    box-shadow: 0 0 6px rgba(80, 250, 123, 0.4);
  }

  .readme-cmd-line:hover .readme-gutter {
    color: var(--cm-string, #50fa7b);
    opacity: 1;
  }

  .readme-cmd-prompt {
    color: var(--cm-text-muted, #7d8590);
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }

  .readme-cmd-line:hover .readme-cmd-prompt {
    color: var(--cm-function, #8be9fd);
    text-shadow: 0 0 8px rgba(139, 233, 253, 0.3);
  }

  .readme-cmd-text {
    color: var(--cm-keyword, #bd93f9);
  }

  .readme-cmd-file {
    color: var(--cm-string, #50fa7b);
    transition: text-shadow 0.15s ease;
  }

  .readme-cmd-line:hover .readme-cmd-file {
    text-shadow: 0 0 8px rgba(80, 250, 123, 0.25);
  }

  .readme-cmd-cursor {
    color: var(--cm-string, #50fa7b);
    animation: readmeCursorBlink 1s step-end infinite;
    font-weight: 700;
    margin-left: 1px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .readme-cmd-line:hover .readme-cmd-cursor {
    opacity: 1;
  }

  @keyframes readmeCursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
