---
import { Image } from 'astro:assets';
import profileImg from '@/assets/shared/foto-perfil.png';
---

<section class="section-padding" data-component="AboutSection">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <!-- Image side -->
      <div data-reveal="left" class="relative" data-component="ProfileImage">
        <div class="relative rounded-2xl overflow-hidden dashed-border">
          <Image
            src={profileImg}
            alt="Ramon Riera"
            class="w-full aspect-[3/4] lg:aspect-[4/5] object-cover"
            loading="lazy"
            decoding="async"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            data-token="$aspect-ratio: 4/3 → 4/5 (lg)|$radius-2xl: 1rem / 16px|$border: 1px solid $neutral-200"
          />
        </div>
      </div>

      <!-- Content side -->
      <div>
        <div data-reveal data-delay="0" class="mb-6 flex items-center gap-3">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-eye-blink">
                <!-- Eye outer shape -->
                <path d="M4 22C4 22 10 10 22 10C34 10 40 22 40 22C40 22 34 34 22 34C10 34 4 22 4 22Z" class="icon-stroke icon-draw" />
                <!-- Iris -->
                <circle cx="22" cy="22" r="7" class="icon-accent icon-draw-delay" />
              </g>
              <!-- Pupil (looks around) -->
              <g class="icon-eye-pupil">
                <circle cx="22" cy="22" r="3" class="icon-accent-fill" />
              </g>
              <!-- Reflection dot -->
              <circle cx="24.5" cy="19.5" r="1.5" fill="white" opacity="0.6" class="icon-eye-pupil" />
            </svg>
          </span>
        </div>

        <h2 data-reveal data-delay="100" class="heading-lg mb-6 about-heading-design"
          data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)|$spacing-bottom: 1.5rem / 24px">
          Diseñador con visión
          <span class="text-primary-500"
            data-token="$color-primary-500: #D97757">estratégica</span>
        </h2>

        <!-- Code mode: JSDoc block in window container -->
        <div data-reveal data-delay="100" class="about-jsdoc mb-2" aria-hidden="true">
          <div class="jsdoc-window">
            <div class="jsdoc-titlebar">
              <div class="jsdoc-dots">
                <span class="json-dot json-dot--red"></span>
                <span class="json-dot json-dot--yellow"></span>
                <span class="json-dot json-dot--green"></span>
              </div>
              <span class="jsdoc-filename">
                <svg class="jsdoc-file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
                </svg>
                core.config.ts
              </span>
              <span class="jsdoc-tab-active">core.config.ts</span>
            </div>
            <div class="jsdoc-body">
              <div class="jsdoc-line gl"><span class="jsdoc-delim">/**</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-star"> *</span> <span class="jsdoc-desc">Diseñador con visión estratégica</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-star"> *</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@role</span> <span class="jsdoc-value">UX Lead · Product Designer</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@vision</span> <span class="jsdoc-value">Strategic Product Design</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@method</span> <span class="jsdoc-value">Data-driven & User-centric</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-star"> *</span> <span class="jsdoc-tag">@stack</span> <span class="jsdoc-value">Design Systems · DesignOps · UX Research</span></div>
              <div class="jsdoc-line gl"><span class="jsdoc-delim"> */</span></div>
            </div>
          </div>
        </div>

        <!-- Normal mode: prose paragraphs -->
        <div data-reveal data-delay="200" class="about-bio-prose space-y-5 text-body mb-10"
          data-token="$font-family-sans: Inter|$color-text-body: #7c766c|$spacing-gap: 1.25rem / 20px">
          <p>
            Soy Ramon Riera, <strong class="text-neutral-900 font-semibold">UX y Product Designer</strong> especializado en <strong class="text-neutral-900 font-semibold">estrategia de experiencia de usuario</strong> y <strong class="text-neutral-900 font-semibold">Design Operations</strong>, con más de 8 años diseñando productos digitales para empresas como <strong class="text-neutral-900 font-semibold">Iberia</strong> y <strong class="text-neutral-900 font-semibold">Banco Sabadell</strong> o mejorando el flujo de <strong class="text-neutral-900 font-semibold">ImaginBank</strong> y <strong class="text-neutral-900 font-semibold">Massimo Dutti</strong>.
          </p>
          <p>
            Trabajo en la intersección entre <strong class="text-neutral-900 font-semibold">UX, estrategia y sistemas de diseño</strong>, ayudando a equipos de producto e ingeniería a crear experiencias consistentes. Actualmente soy <strong class="text-neutral-900 font-semibold">UX Lead en Doctori.com</strong>, donde lidero <strong class="text-neutral-900 font-semibold">Design Operations</strong> y el desarrollo del <strong class="text-neutral-900 font-semibold">Design System</strong>.
          </p>
          <p>
            Creo firmemente en un diseño que <strong class="text-neutral-900 font-semibold">simplifica lo complejo</strong>, alineando las decisiones de negocio con las necesidades del usuario para crear experiencias que, simplemente, funcionan.
          </p>
        </div>
        <!-- Code mode: console/terminal window -->
        <div data-reveal data-delay="200" class="about-bio-readme mb-6">
          <div class="readme-window">
            <div class="readme-titlebar">
              <div class="readme-dots">
                <span class="json-dot json-dot--red"></span>
                <span class="json-dot json-dot--yellow"></span>
                <span class="json-dot json-dot--green"></span>
              </div>
              <span class="readme-filename">
                <svg class="readme-file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                about.md
              </span>
              <span class="readme-tab-active">about.md</span>
            </div>
            <div class="readme-body">
              <div class="readme-line gl"><span class="readme-comment">/**</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-tag">@module</span> about-designer</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-tag">@role</span> UX &amp; Product Designer</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-tag">@experience</span> 8+ years</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-tag">@description</span></span></div>
              <div class="readme-line gl"><span class="readme-comment"> *</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * Especializado en <span class="readme-highlight">estrategia de experiencia</span></span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-highlight">de usuario</span> y <span class="readme-highlight">Design Operations</span>, diseñando</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * productos digitales para empresas como</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-highlight">Iberia</span>, <span class="readme-highlight">Banco Sabadell</span>, <span class="readme-highlight">ImaginBank</span></span></div>
              <div class="readme-line gl"><span class="readme-comment"> * y <span class="readme-highlight">Massimo Dutti</span>.</span></div>
              <div class="readme-line gl"><span class="readme-comment"> *</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * Trabajo en la intersección entre <span class="readme-highlight">UX</span>,</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-highlight">estrategia</span> y <span class="readme-highlight">sistemas de diseño</span>.</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * Actualmente <span class="readme-highlight">UX Lead en Doctori.com</span>.</span></div>
              <div class="readme-line gl"><span class="readme-comment"> *</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-tag">@philosophy</span> Simplificar lo complejo, alineando</span></div>
              <div class="readme-line gl"><span class="readme-comment"> *   negocio con necesidades del usuario.</span></div>
              <div class="readme-line gl"><span class="readme-comment"> *</span></div>
              <div class="readme-line gl"><span class="readme-comment"> * <span class="readme-tag">@stack</span> <span class="readme-highlight">Design Systems</span> | <span class="readme-highlight">Product Design</span> | <span class="readme-highlight">DesignOps</span></span></div>
              <div class="readme-line gl"><span class="readme-comment"> */</span></div>
            </div>
          </div>
        </div>

        <div data-reveal data-delay="300" class="flex flex-wrap gap-4">
          <a href="/about" class="btn-primary hero-cta-normal"
            data-component="ButtonPrimary"
            data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
            Conocer más
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/about" class="hero-cta-code" data-component="ButtonRunCmd">
            <span class="hero-cta-prompt">&gt;</span> cat <span class="hero-cta-cmd">about.md</span><span class="hero-cta-cursor">_</span>
          </a>
          <a
            href="/docs/CV-Ramon-Riera-Depares.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline btn-cv-normal"
            data-component="ButtonOutline"
            data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px"
          >
            Ver CV
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
            </svg>
          </a>
          <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
            class="btn-cv-code" data-component="ButtonCVCode">
            <svg class="btn-code-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
            </svg>
            <span class="code-fn">get</span><span class="code-parens">(</span><span class="code-string">'cv.pdf'</span><span class="code-parens">)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══ JSDoc heading — code mode only ═══ */
  .about-jsdoc {
    display: none;
  }

  :global(.code-mode) .about-heading-design {
    display: none !important;
  }

  :global(.code-mode) .about-jsdoc {
    display: block;
  }

  /* ── Window container (matches readme-window) ── */
  .jsdoc-window {
    background: #1e1e2e;
    border-radius: 8px;
    border: 1px solid var(--cm-border, #30363d);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .jsdoc-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    background: #181825;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .jsdoc-dots {
    display: flex;
    gap: 6px;
  }

  .jsdoc-filename {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #7d8590;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .jsdoc-file-icon {
    color: #7d8590;
    flex-shrink: 0;
  }

  .jsdoc-tab-active {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #e6edf3;
    background: #1e1e2e;
    padding: 0.25rem 0.75rem;
    border-radius: 4px 4px 0 0;
    margin-left: auto;
    border: 1px solid var(--cm-border, #30363d);
    border-bottom: 1px solid #1e1e2e;
  }

  .jsdoc-body {
    padding: 0.75rem 0.875rem;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .jsdoc-line {
    white-space: nowrap;
  }

  .jsdoc-delim {
    color: var(--cm-comment);
  }

  .jsdoc-star {
    color: var(--cm-comment);
    opacity: 0.6;
  }

  .jsdoc-desc {
    color: var(--cm-text-secondary);
    font-weight: 500;
    font-size: 1.15em;
  }

  .jsdoc-tag {
    color: var(--cm-keyword);
  }

  .jsdoc-value {
    color: var(--cm-text-muted);
  }
</style>
