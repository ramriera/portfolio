<button
  id="floating-back-to-top"
  class="floating-btt"
  aria-label="Volver arriba"
  data-component="FloatingBackToTop"
>
  <!-- Normal mode: minimal arrow icon -->
  <span class="floating-btt-normal">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
    </svg>
  </span>
  <!-- Code mode: terminal style -->
  <span class="floating-btt-code">
    <span class="floating-btt-code-text">TOP<span class="floating-btt-cursor">_</span></span>
  </span>
</button>

<script>
  function initFloatingBtt() {
    const btn = document.getElementById('floating-back-to-top');
    if (!btn) return;

    let visible = false;
    const THRESHOLD = 300;

    function update() {
      const shouldShow = window.scrollY > THRESHOLD;
      if (shouldShow === visible) return;
      visible = shouldShow;

      if (shouldShow) {
        btn.classList.add('floating-btt--visible');
      } else {
        btn.classList.remove('floating-btt--visible');
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    update();

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  initFloatingBtt();
  document.addEventListener('astro:page-load', initFloatingBtt);
</script>
