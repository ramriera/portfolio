---
import WordsCarousel from './WordsCarousel.astro';
import { siteConfig } from '@/utils/data';

const rotatingWords = ['importan', 'conectan', 'inspiran', 'transforman', 'brillan', 'impactan', 'perduran'];
---

<section class="relative min-h-0 sm:min-h-[85svh] md:min-h-[90vh] flex items-center justify-center overflow-hidden pt-20 pb-8 sm:py-0"
  data-component="HeroSection">
  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 -right-16 md:-right-32 w-[min(500px,80vw)] h-[min(500px,80vw)] rounded-full bg-primary-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-1/4 -left-16 md:-left-32 w-[min(500px,80vw)] h-[min(500px,80vw)] rounded-full bg-primary-500/[0.04] blur-3xl"></div>
  </div>

  <div class="container-custom w-full">
    <!-- Persistent grid: intro left, stats right on xl -->
    <div class="hero-grid">
      <!-- Left: intro content -->
      <div class="hero-main-content max-w-4xl xl:max-w-none text-center xl:text-left">
        <!-- Greeting line -->
        <div data-reveal data-delay="0" class="mb-3 sm:mb-6 md:mb-10 flex flex-col items-center xl:items-start">
          <div class="w-12 h-12 sm:w-14 sm:h-14 mb-3 sm:mb-4">
            <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-hand-wave">
                  <!-- Wrist to palm -->
                  <path d="M18 38C12 36 9 30 9 25L9 22" class="icon-stroke icon-draw" />
                  <!-- Index finger (accent) -->
                  <path d="M15 22V10C15 8 16.5 6 19 6C21.5 6 22 8 22 10V21" class="icon-accent icon-draw-delay" />
                  <!-- Middle finger -->
                  <path d="M22 21V7C22 5 23.5 3 26 3C28.5 3 29 5 29 7V21" class="icon-stroke icon-draw" />
                  <!-- Ring finger -->
                  <path d="M29 21V10C29 8 30.5 6 33 6C35.5 6 36 8 36 10V24C36 32 30 38 24 38" class="icon-stroke icon-draw" />
                  <!-- Thumb -->
                  <path d="M15 22C13 21 10 19 9 17C8 15 9.5 13 12 13C14 13 15 15 15 17" class="icon-stroke icon-draw" />
                </g>
                <!-- Sparkle near index finger tip -->
                <circle cx="18" cy="3" r="1.2" class="icon-accent icon-wave-line-1" />
                <path d="M5 10L3 8M3 12L1 12M5 14L3 16" class="icon-accent icon-wave-line-2" />
              </svg>
            </span>
          </div>
          <span class="text-xl sm:text-2xl md:text-3xl font-medium text-dark-900 tracking-wide"
            data-token="$font-family-display: Space Grotesk|$font-size-2xl: 1.5rem / 24px">
            Soy <span class="text-primary-500"
              data-token="$color-primary-500: #D97757">Ramon Riera</span>
          </span>
        </div>

        <!-- Main heading -->
        <h1 data-reveal data-delay="100" class="heading-xl mb-4 sm:mb-6 md:mb-10"
          data-token="$font-size-heading-xl: clamp(2.25rem, 5vw, 4.5rem)|$font-weight: 600 (semibold)|$spacing-bottom: 2.5rem / 40px">
          Diseño experiencias<br />
          <span class="sm:whitespace-nowrap">digitales que
          <span class="text-primary-500"><WordsCarousel words={rotatingWords} interval={3000} /></span></span>
        </h1>

        <!-- Subtitle -->
        <p data-reveal data-delay="200" class="text-body text-sm sm:text-base md:text-xl max-w-2xl mx-auto xl:mx-0 mb-5 sm:mb-8 md:mb-14 leading-relaxed"
          data-token="$font-family-sans: Inter|$color-text-muted: #7c766c|$spacing-bottom: 3.5rem / 56px">
          UX Lead con experiencia en estrategia de producto, investigación de usuario y diseño de interfaces. Trabajo ayudando a equipos a crear productos digitales que realmente resuelven problemas.
        </p>

        <!-- CTA buttons -->
        <div data-reveal data-delay="300" class="flex flex-wrap items-center justify-center xl:justify-start gap-4">
          <!-- Normal mode button -->
          <a href="/projects" class="btn-primary text-base hero-cta-normal"
            data-component="ButtonPrimary"
            data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
            Ver proyectos
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <!-- Code mode: terminal command button -->
          <a href="/projects" class="hero-cta-code" data-component="ButtonRunCmd">
            <span class="hero-cta-prompt">&gt;</span> run <span class="hero-cta-cmd">open_projects.sh</span><span class="hero-cta-cursor">_</span>
          </a>
        </div>
      </div>

      <!-- Right: Stats (persistent column — never moves below) -->
      <div data-reveal data-delay="400" class="hero-stats-col"
        data-component="StatsBar"
        data-token="$spacing-gap: 2rem / 32px|$spacing-margin-top: 4rem / 64px">
        <div class="hero-stats-inner">
          <div class="hero-stat-item text-center">
            <div class="text-3xl font-semibold text-dark-900"
              data-token="$font-size-3xl: 1.875rem / 30px|$font-weight: 600 (semibold)|$color-text-primary: #1a1918">
              <span class="count-up" data-target="6">0</span>+
            </div>
            <div class="text-xs text-dark-400 tracking-wide mt-1 whitespace-nowrap">Años exp.</div>
          </div>
          <div class="hero-stats-divider-h"></div>
          <div class="hero-stats-divider-v"></div>
          <div class="hero-stat-item text-center">
            <div class="text-3xl font-semibold text-dark-900"
              data-token="$font-size-3xl: 1.875rem / 30px|$font-weight: 600 (semibold)|$color-text-primary: #1a1918">
              <span class="count-up" data-target="35">0</span>+
            </div>
            <div class="text-xs text-dark-400 tracking-wide mt-1">Proyectos completados</div>
          </div>
          <div class="hero-stats-divider-h"></div>
          <div class="hero-stats-divider-v"></div>
          <div class="hero-stat-item text-center">
            <div class="text-3xl font-semibold text-dark-900"
              data-token="$font-size-3xl: 1.875rem / 30px|$font-weight: 600 (semibold)|$color-text-primary: #1a1918">
              <span class="count-up" data-target="12">0</span>+
            </div>
            <div class="text-xs text-dark-400 tracking-wide mt-1">Clientes corporativos</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCountUp() {
    const counters = document.querySelectorAll('.count-up');
    if (!counters.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.counted) return;
        el.dataset.counted = '1';

        const target = parseInt(el.dataset.target || '0', 10);
        const duration = 3000;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // ease-out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
        observer.unobserve(el);
      });
    }, { threshold: 0.2 });

    counters.forEach((c) => observer.observe(c));
  }

  initCountUp();
  document.addEventListener('astro:page-load', initCountUp);
</script>
