</style>

<script>
  function initCountUp() {
    const counters = document.querySelectorAll('.count-up');
    if (!counters.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.counted) return;
        el.dataset.counted = '1';

        const target = parseInt(el.dataset.target || '0', 10);
        const duration = 3000;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
        observer.unobserve(el);
      });
    }, { threshold: 0.2 });

    counters.forEach((c) => observer.observe(c));
  }

  initCountUp();
  document.addEventListener('astro:page-load', initCountUp);
</script>

<script>
  // ── Boot log staggered reveal ──
  function initBootLog() {
    const lines = document.querySelectorAll('.hero-log-line');
    lines.forEach((line) => {
      const el = line as HTMLElement;
      const delay = parseInt(el.dataset.delay || '0', 10);
      setTimeout(() => el.classList.add('visible'), delay);
    });
  }

  // ── Typewriter effect for role field (humanized random delays) ──
  function initTypewriter() {
    const el = document.querySelector('.hero-role-typewriter') as HTMLElement | null;
    if (!el || el.dataset.twInit) return;
    el.dataset.twInit = '1';

    const roles: string[] = JSON.parse(el.dataset.roles || '[]');
    if (roles.length < 2) return;

    const textEl = el.querySelector('.hero-role-text') as HTMLElement;
    if (!textEl) return;

    let roleIdx = 0;
    const PAUSE = 3000;

    // Random delay to mimic human typing rhythm
    function randType() { return 50 + Math.random() * 100; }   // 50–150ms
    function randDel()  { return 25 + Math.random() * 45; }    // 25–70ms

    function deleteThenType() {
      const current = textEl.textContent || '';
      let i = current.length;

      // Delete phase — recursive setTimeout for random cadence
      function deleteChar() {
        if (i <= 0) {
          // Switch to next role, start typing
          roleIdx = (roleIdx + 1) % roles.length;
          const next = roles[roleIdx];
          let j = 0;
          function typeChar() {
            j++;
            textEl.textContent = next.slice(0, j);
            if (j < next.length) {
              setTimeout(typeChar, randType());
            } else {
              setTimeout(deleteThenType, PAUSE);
            }
          }
          // Slight pause before typing starts (like a human thinking)
          setTimeout(typeChar, 200 + Math.random() * 300);
          return;
        }
        i--;
        textEl.textContent = current.slice(0, i);
        setTimeout(deleteChar, randDel());
      }

      deleteChar();
    }

    // Start after initial pause
    setTimeout(deleteThenType, PAUSE + 1200);
  }

  // ── Stats ticker: count up when code-mode is active ──
  function initStatsTicker() {
    const tickers = document.querySelectorAll<HTMLElement>('.stats-ticker');
    if (!tickers.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.tickerDone) return;
        el.dataset.tickerDone = '1';

        const target = parseInt(el.dataset.target || '0', 10);
        const duration = 1200;
        const start = performance.now();

        function tick(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // ease-out quart for satisfying deceleration
          const eased = 1 - Math.pow(1 - progress, 4);
          const current = Math.round(target * eased);
          el.textContent = String(current).padStart(2, '0');
          if (progress < 1) requestAnimationFrame(tick);
        }

        // Delay start slightly to sync with boot log
        setTimeout(() => requestAnimationFrame(tick), 800);
        observer.unobserve(el);
      });
    }, { threshold: 0.3 });

    tickers.forEach((t) => observer.observe(t));
  }

  // Init on load & Astro page transitions
  function initHeroCode() {
    initBootLog();
    initTypewriter();
    initStatsTicker();
  }

  initHeroCode();
  document.addEventListener('astro:page-load', initHeroCode);
</script>
