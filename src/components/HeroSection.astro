---
import WordsCarousel from './WordsCarousel.astro';

const rotatingWords = ['importan', 'conectan', 'inspiran', 'transforman', 'brillan', 'impactan', 'perduran'];
---

<section class="relative min-h-[95vh] flex items-center overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 -right-32 w-[500px] h-[500px] rounded-full bg-primary-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-1/4 -left-32 w-[500px] h-[500px] rounded-full bg-primary-500/[0.04] blur-3xl"></div>
  </div>

  <div class="container-custom w-full">
    <div class="max-w-4xl">
      <!-- Greeting line -->
      <div data-reveal data-delay="0" class="mb-10">
        <div class="w-14 h-14 mb-4">
          <span class="section-icon">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-hand-wave">
                <!-- Palm -->
                <path d="M22 38C14 38 10 32 10 26V18" class="icon-stroke icon-draw" />
                <!-- Fingers -->
                <path d="M14 22V12C14 10.5 15 9 17 9C19 9 20 10.5 20 12V20" class="icon-stroke icon-draw" />
                <path d="M20 20V8C20 6.5 21 5 23 5C25 5 26 6.5 26 8V20" class="icon-accent icon-draw-delay" />
                <path d="M26 20V10C26 8.5 27 7 29 7C31 7 32 8.5 32 10V20" class="icon-stroke icon-draw" />
                <path d="M32 20V14C32 12.5 33 11 35 11C37 11 37 12.5 37 14V26C37 33 32 38 26 38" class="icon-stroke icon-draw" />
                <!-- Thumb -->
                <path d="M14 22C14 22 10 20 9 18C8 16 9 14 11 14C13 14 14 16 14 18" class="icon-accent icon-draw-delay" />
              </g>
              <!-- Motion lines -->
              <line x1="6" y1="8" x2="4" y2="6" class="icon-accent icon-wave-line-1" />
              <line x1="4" y1="12" x2="1" y2="12" class="icon-accent icon-wave-line-2" />
              <line x1="6" y1="16" x2="4" y2="18" class="icon-accent icon-wave-line-3" />
            </svg>
          </span>
        </div>
        <span class="text-2xl md:text-3xl font-medium text-dark-900 dark:text-dark-100 tracking-wide">
          Soy <span class="text-primary-500">Ramon Riera</span>
        </span>
      </div>

      <!-- Main heading -->
      <h1 data-reveal data-delay="100" class="heading-xl mb-10">
        Diseño experiencias<br />
        <span class="whitespace-nowrap">digitales que
        <span class="text-primary-500"><WordsCarousel words={rotatingWords} interval={2000} /></span></span>
      </h1>

      <!-- Subtitle -->
      <p data-reveal data-delay="200" class="text-body text-xl max-w-2xl mb-14 leading-relaxed">
        Especializado en Design Systems, Product Design y Design Operations.
        Transformando ideas complejas en interfaces intuitivas y elegantes.
      </p>

      <!-- CTA buttons -->
      <div data-reveal data-delay="300" class="flex flex-wrap items-center gap-4">
        <a href="/projects" class="btn-primary text-base">
          Ver proyectos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="mailto:ramriera28@gmail.com" class="btn-outline text-base">
          Hablemos
        </a>
      </div>
    </div>

    <!-- Stats — horizontal on mobile, vertical on xl side -->
    <div data-reveal data-delay="400" class="flex justify-start gap-8 mt-16 xl:mt-0 xl:absolute xl:right-12 xl:top-1/2 xl:-translate-y-1/2 xl:flex-col xl:gap-10" data-reveal-dir="right-xl">
      <div class="text-center">
        <div class="text-3xl font-semibold text-dark-900 dark:text-dark-100">
          <span class="count-up" data-target="8">0</span>+
        </div>
        <div class="text-xs text-dark-400 dark:text-dark-500 tracking-wide mt-1">Años exp.</div>
      </div>
      <div class="hidden xl:block w-6 h-px bg-dark-200 dark:bg-dark-700 mx-auto"></div>
      <div class="w-px h-8 bg-dark-200 dark:bg-dark-700 my-auto xl:hidden"></div>
      <div class="text-center">
        <div class="text-3xl font-semibold text-dark-900 dark:text-dark-100">
          <span class="count-up" data-target="50">0</span>+
        </div>
        <div class="text-xs text-dark-400 dark:text-dark-500 tracking-wide mt-1">Proyectos</div>
      </div>
      <div class="hidden xl:block w-6 h-px bg-dark-200 dark:bg-dark-700 mx-auto"></div>
      <div class="w-px h-8 bg-dark-200 dark:bg-dark-700 my-auto xl:hidden"></div>
      <div class="text-center">
        <div class="text-3xl font-semibold text-dark-900 dark:text-dark-100">
          <span class="count-up" data-target="15">0</span>+
        </div>
        <div class="text-xs text-dark-400 dark:text-dark-500 tracking-wide mt-1">Clientes</div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCountUp() {
    const counters = document.querySelectorAll('.count-up');
    if (!counters.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        if (el.dataset.counted) return;
        el.dataset.counted = '1';

        const target = parseInt(el.dataset.target || '0', 10);
        const duration = 3000;
        const start = performance.now();

        function update(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          // ease-out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(update);
        }

        requestAnimationFrame(update);
        observer.unobserve(el);
      });
    }, { threshold: 0.5 });

    counters.forEach((c) => observer.observe(c));
  }

  initCountUp();
  document.addEventListener('astro:page-load', initCountUp);
</script>
