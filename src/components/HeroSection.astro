---
import { siteConfig } from '@/utils/data';
import WordsCarousel from './WordsCarousel.astro';

const rotatingWords = ['importan', 'conectan', 'inspiran', 'transforman', 'brillan'];
---

<section class="relative min-h-[95vh] flex items-center overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 -right-32 w-[500px] h-[500px] rounded-full bg-primary-500/[0.04] blur-3xl"></div>
    <div class="absolute bottom-1/4 -left-32 w-[500px] h-[500px] rounded-full bg-primary-500/[0.04] blur-3xl"></div>
  </div>

  <div class="container-custom w-full">
    <div class="max-w-4xl">
      <!-- Greeting line -->
      <div data-reveal data-delay="0" class="flex items-center gap-3 mb-10">
        <span class="text-2xl md:text-3xl font-medium text-dark-900 dark:text-dark-100 tracking-wide">
          Hola<span class="inline-block animate-wave origin-[70%_70%]">&#x1F44B;</span>, soy <span class="text-primary-500">Ramon Riera</span>
        </span>
      </div>

      <!-- Main heading -->
      <h1 data-reveal data-delay="100" class="heading-xl mb-10">
        Diseño experiencias<br />
        <span class="whitespace-nowrap">digitales que
        <span class="text-primary-500"><WordsCarousel words={rotatingWords} interval={3000} /></span></span>
      </h1>

      <!-- Subtitle -->
      <p data-reveal data-delay="200" class="text-body text-xl max-w-2xl mb-14 leading-relaxed">
        Especializado en Design Systems, Product Design y Design Operations.
        Transformando ideas complejas en interfaces intuitivas y elegantes.
      </p>

      <!-- CTA buttons -->
      <div data-reveal data-delay="300" class="flex flex-wrap items-center gap-4">
        <a href="/projects" class="btn-primary text-base">
          Ver proyectos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="mailto:ramriera28@gmail.com" class="btn-outline text-base">
          Hablemos
        </a>
      </div>
    </div>

    <!-- Stats on the side -->
    <div data-reveal="right" data-delay="400" class="hidden xl:flex absolute right-12 top-1/2 -translate-y-1/2 flex-col gap-10">
      <div class="text-center">
        <div class="text-3xl font-semibold text-dark-900 dark:text-dark-100">8+</div>
        <div class="text-xs text-dark-400 dark:text-dark-500 tracking-wide mt-1">Años exp.</div>
      </div>
      <div class="w-6 h-px bg-dark-200 dark:bg-dark-700 mx-auto"></div>
      <div class="text-center">
        <div class="text-3xl font-semibold text-dark-900 dark:text-dark-100">50+</div>
        <div class="text-xs text-dark-400 dark:text-dark-500 tracking-wide mt-1">Proyectos</div>
      </div>
      <div class="w-6 h-px bg-dark-200 dark:bg-dark-700 mx-auto"></div>
      <div class="text-center">
        <div class="text-3xl font-semibold text-dark-900 dark:text-dark-100">15+</div>
        <div class="text-xs text-dark-400 dark:text-dark-500 tracking-wide mt-1">Clientes</div>
      </div>
    </div>
  </div>
</section>
