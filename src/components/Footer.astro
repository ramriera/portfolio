---
const year = new Date().getFullYear();
---

<footer class="footer-poly mt-8" data-component="Footer" data-token="$spacing-padding-y: 3rem / 48px|$color-text-muted: #a8a196">
  <div class="container-custom footer-poly__inner">
    <div class="footer-poly__row">
      <p class="footer-poly__text text-sm text-neutral-400"
        data-token="$font-size-sm: 0.875rem / 14px|$color-text-muted: #a8a196">
        &copy; {year} Ramon Riera. Todos los derechos reservados.
      </p>
      <p class="footer-poly__text text-sm text-neutral-400"
        data-token="$font-size-sm: 0.875rem / 14px|$color-text-muted: #a8a196">
        Diseñado y desarrollado con
        <span class="text-primary-500">&hearts;</span>
        usando Astro + Tailwind
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-poly {
    height: 120px;
    display: flex;
    align-items: center;
  }

  .footer-poly__inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .footer-poly__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .footer-poly__text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .footer-poly {
      height: auto;
      padding: 2rem 0;
    }
    .footer-poly__inner {
      gap: 0.75rem;
    }
    .footer-poly__row {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
    .footer-poly__text {
      white-space: nowrap;
      justify-content: center;
      font-size: 0.7rem;
    }
  }
</style>
