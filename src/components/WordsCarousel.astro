---
interface Props {
  words: string[];
  interval?: number;
}

const { words, interval = 3000 } = Astro.props;
---

<span
  class="words-carousel-wrapper inline-flex relative align-baseline overflow-hidden"
  data-words={JSON.stringify(words)}
  data-interval={interval}
>
  <!-- Hidden sizer: renders all words stacked to reserve max width -->
  <span class="words-sizer" aria-hidden="true">
    {words.map((word) => (
      <span class="block invisible">{word}</span>
    ))}
  </span>

  <!-- Visible animated words -->
  {words.map((word, i) => (
    <span
      class:list={[
        'words-carousel-word absolute inset-0 inline-flex items-baseline justify-center xl:justify-start',
        i === 0 ? 'active' : '',
      ]}
      data-index={i}
    >
      <span class="word-inner relative inline-block">
        <span class="word-text">{word}</span>
        <!-- Hand-drawn underline -->
        <svg
          class="word-underline absolute -bottom-1 left-0 w-full"
          viewBox="0 0 200 12"
          preserveAspectRatio="none"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M2 8.5C30 3.5 60 2 100 5.5C140 9 170 4.5 198 7"
            stroke="currentColor"
            stroke-width="3.5"
            stroke-linecap="round"
            class="underline-path"
          />
        </svg>
      </span>
    </span>
  ))}
</span>

<style>
  .words-carousel-wrapper {
    white-space: nowrap;
  }

  /* Sizer takes up space for the widest word */
  .words-sizer {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    height: 1lh;
    overflow: hidden;
  }

  @media (min-width: 1280px) {
    .words-sizer {
      align-items: flex-start;
    }
  }

  .words-carousel-word {
    opacity: 0;
    transform: translateY(40%);
    transition:
      opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    white-space: nowrap;
  }

  .words-carousel-word.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .words-carousel-word.exiting {
    opacity: 0;
    transform: translateY(-40%);
  }

  /* Underline animation */
  .word-underline {
    height: 10px;
    color: var(--color-primary-500, #D97757);
    overflow: visible;
  }

  .underline-path {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    transition: stroke-dashoffset 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }

  .words-carousel-word.active .underline-path {
    stroke-dashoffset: 0;
  }

  .words-carousel-word.exiting .underline-path {
    stroke-dashoffset: 300;
    transition: stroke-dashoffset 0.15s ease-in;
  }

  /* Code mode: pink underline */
  :global(body.code-mode) .word-underline {
    color: #ff79c6;
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll('.words-carousel-wrapper').forEach((wrapper) => {
      const el = wrapper as HTMLElement;
      if (el.dataset.initialized) return;
      el.dataset.initialized = '1';

      const words = JSON.parse(el.dataset.words || '[]') as string[];
      const interval = parseInt(el.dataset.interval || '3000', 10);
      const wordEls = el.querySelectorAll('.words-carousel-word');
      let current = 0;

      setInterval(() => {
        const prev = current;
        current = (current + 1) % words.length;

        wordEls[prev].classList.remove('active');
        wordEls[prev].classList.add('exiting');

        wordEls[current].classList.add('active');
        wordEls[current].classList.remove('exiting');

        setTimeout(() => {
          wordEls[prev].classList.remove('exiting');
        }, 300);
      }, interval);
    });
  }

  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
