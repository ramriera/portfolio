---
import { projects } from '@/utils/data';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

const projectList = projects.map((p, i) => ({
  id: i + 1,
  slug: p.slug,
  name: p.title,
  cat: p.category || 'Design',
  year: p.year,
  status: 'Done',
}));

---

<!-- Static Dashboard Terminal — fullscreen, no scroll -->
<div id="interactive-terminal" class="dashboard">
  <!-- CRT scanlines overlay -->
  <div class="crt-overlay" aria-hidden="true"></div>

  <div class="term-window">
    <!-- ═══ HEADER: Static info bar ═══ -->
    <div class="term-header">
      <div class="term-header-left">
        <div class="term-dots">
          <span style="background:#ff5f57"></span>
          <span style="background:#febc2e"></span>
          <span style="background:#28c840"></span>
        </div>
        <span class="term-header-name">Ramon Riera</span>
        <span class="term-header-sep">|</span>
        <span class="term-header-info">UX Lead & Product Designer</span>
      </div>
      <div class="term-header-right">
        <span class="term-header-os">Astro 5.17</span>
        <span class="term-header-sep">|</span>
        <span class="term-header-date" id="term-header-date"></span>
        <span class="term-header-sep">|</span>
        <span class="term-header-status">● Active</span>
      </div>
    </div>

    <!-- ═══ MAIN: Output area — fills remaining space ═══ -->
    <div id="term-output" class="term-output" tabindex="-1"></div>

    <!-- ═══ FOOTER: Fixed input line ═══ -->
    <div class="term-input-row">
      <span class="term-prompt"><span class="term-prompt-user">ramon</span><span class="term-prompt-at">@</span><span class="term-prompt-host">riera</span><span class="term-prompt-colon">:</span><span class="term-prompt-path">~</span><span class="term-prompt-dollar">$</span></span>
      <input
        id="term-input"
        class="term-input"
        type="text"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Terminal input"
      />
      <span class="term-cursor" id="term-cursor">&#9608;</span>
    </div>

  </div>
</div>

<style is:global>
  /* ═══════════════════════════════════════
     TERMINAL — Exact Reference Replica
     ═══════════════════════════════════════ */

  .dashboard {
    display: flex;
    align-items: stretch;
    justify-content: center;
    position: fixed;
    inset: 0;
    z-index: 9999;
    padding: 1.5rem;
    overflow: hidden;
    background: #11111b;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    scrollbar-width: none;
  }

  .dashboard::-webkit-scrollbar { display: none; }

  .dashboard.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .dashboard.is-open.is-closing {
    opacity: 0;
    pointer-events: none;
  }

  /* Lock html scroll when terminal is open */
  html:has(.dashboard.is-open) {
    overflow: hidden !important;
  }

  .term-window {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    background: #1e1e2e;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    scrollbar-width: none;
    border-radius: 12px;
    border: 1px solid #30363d;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.03);
    position: relative;
    z-index: 20;
  }

  /* ── Header ── */
  .term-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    background: #181825;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    user-select: none;
    -webkit-user-select: none;
    flex-shrink: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    gap: 1rem;
  }

  .term-header-left,
  .term-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }

  .term-header-name { color: #e6edf3; font-weight: 600; }
  .term-header-info { color: #7d8590; }
  .term-header-sep  { color: #30363d; }
  .term-header-os   { color: #8be9fd; }
  .term-header-date { color: #bd93f9; }
  .term-header-status { color: #50fa7b; font-weight: 600; }

  .term-dots {
    display: flex;
    gap: 7px;
  }

  .term-dots span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: block;
  }

  /* ── Output ── */
  .term-output {
    flex: 1;
    padding: 1.25rem 2rem;
    overflow-y: auto;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: clamp(0.65rem, 1.1vw, 0.85rem);
    line-height: 1.7;
    color: #e6edf3;
    scrollbar-width: none;
    contain: layout style;
    will-change: scroll-position;
  }

  .term-output::-webkit-scrollbar { display: none; }

  .dashboard *::-webkit-scrollbar { display: none; }
  .dashboard * { scrollbar-width: none; }

  .term-line {
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 1.4em;
    contain: content;
  }

  .term-line.term-row-selectable {
    color: #4b5563;
  }

  .term-line.term-row-active {
    color: #4ade80;
    font-weight: 700;
  }

  .term-line .term-pointer {
    color: #4ade80;
    font-weight: 700;
    animation: pointer-blink 1s step-end infinite;
  }

  @keyframes pointer-blink {
    0%, 60% { opacity: 1; }
    61%, 100% { opacity: 0; }
  }

  .term-line.term-row-flash {
    color: #e6edf3;
    font-weight: 700;
  }

  .term-line.term-row-flash .term-pointer {
    color: #e6edf3;
    animation: none;
    opacity: 1;
  }

  /* ── Input row ── */
  .term-input-row {
    display: flex;
    align-items: center;
    padding: 0.75rem 2rem 1rem;
    gap: 0.625rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
    contain: layout style;
  }

  .term-prompt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .term-prompt-user,
  .term-prompt-host  { color: #50fa7b; font-weight: 700; }
  .term-prompt-at,
  .term-prompt-colon { color: #7d8590; }
  .term-prompt-path  { color: #8be9fd; font-weight: 700; }
  .term-prompt-dollar { color: #7d8590; }

  .term-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: #e6edf3;
    caret-color: #d97757;
    line-height: 1.5;
  }

  .term-prompt-echo {
    user-select: none;
    -webkit-user-select: none;
  }

  /* ── Cursor ── */
  .term-cursor {
    color: #d97757;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    line-height: 1;
    animation: cursor-blink 1s step-end infinite;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
    margin-left: -2px;
    will-change: opacity;
  }

  .term-input:focus ~ .term-cursor {
    display: none;
  }

  @keyframes cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* ── Semantic colors ── */
  .t-keyword  { color: #bd93f9; }
  .t-function { color: #8be9fd; }
  .t-string   { color: #50fa7b; }
  .t-constant { color: #f1fa8c; }
  .t-comment  { color: #6272a4; font-style: italic; }
  .t-muted    { color: #7d8590; }
  .t-accent   { color: #d97757; }
  .t-error    { color: #f55; }

  /* ── CRT overlay ── */
  .crt-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.04) 2px,
      rgba(0, 0, 0, 0.04) 4px
    );
    mix-blend-mode: multiply;
    will-change: transform;
    transform: translateZ(0);
  }

  .crt-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0, 0, 0, 0.2) 100%);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .dashboard { padding: 0.5rem; }

    .term-header {
      flex-direction: column;
      align-items: flex-start;
      padding: 0.625rem 1rem;
      gap: 0.25rem;
    }

    .term-header-right { font-size: 0.7rem; }

    .term-output {
      padding: 1rem 1.25rem;
      font-size: 0.68rem;
    }

    .term-input-row {
      padding: 0.625rem 1.25rem 0.75rem;
    }

    .term-prompt,
    .term-input {
      font-size: 0.75rem;
    }
  }
</style>

<script define:vars={{ projectList }}>
  // ── Lazy init: only bootstrap terminal when first opened ──
  (function() {
    var terminal = document.getElementById('interactive-terminal');
    if (!terminal) return;

    var initialized = false;

    function bootTerminal() {
      if (initialized) return;
      initialized = true;
      initTerminal();
    }

    // Stub: replaced by real function after init
    window.openTerminal = function() {
      bootTerminal();
      window.openTerminal();
    };
    window.closeTerminal = function() {};
  })();

  function initTerminal() {
    var terminal = document.getElementById('interactive-terminal');
    var output = document.getElementById('term-output');
    var input = document.getElementById('term-input');
    var dateEl = document.getElementById('term-header-date');

    if (!terminal || !output || !input) return;

    // Set date
    if (dateEl) {
      var now = new Date();
      dateEl.textContent = now.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    var history = [];
    var histIdx = -1;

    // ── Helpers ──

    function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
    function c(cls, text) { return '<span class="t-' + cls + '">' + esc(text) + '</span>'; }

    function line(html) {
      var d = document.createElement('div');
      d.className = 'term-line';
      d.innerHTML = html;
      output.appendChild(d);
    }



    // Throttled scroll — max once per frame
    var scrollPending = false;
    function scroll() {
      if (scrollPending) return;
      scrollPending = true;
      requestAnimationFrame(function() {
        output.scrollTop = output.scrollHeight;
        scrollPending = false;
      });
    }

    // ── Typewriter effect ──
    var typewriterBusy = false;

    function typeLines(lines, cb, delay) {
      var d = delay || 40;
      typewriterBusy = true;
      var i = 0;
      // Batch: flush multiple lines in one rAF for fast (≤20ms) delays
      var batchSize = d <= 20 ? 3 : 1;

      function next() {
        if (i >= lines.length) { typewriterBusy = false; scroll(); if (cb) cb(); return; }
        var frag = document.createDocumentFragment();
        var count = Math.min(batchSize, lines.length - i);
        for (var j = 0; j < count; j++) {
          var el = document.createElement('div');
          el.className = 'term-line';
          el.innerHTML = lines[i + j];
          frag.appendChild(el);
        }
        output.appendChild(frag);
        i += count;
        scroll();
        setTimeout(next, d + Math.random() * (d * 0.4));
      }
      next();
    }

    // ── MOTD ──

    function showMotd(cb) {
      var motdLines = [
        '<span class="t-accent">  ____                                  ____  _                </span>',
        '<span class="t-accent"> |  _ \\ __ _ _ __ ___   ___  _ __      |  _ \\(_) ___ _ __ __ _ </span>',
        "<span class=\"t-accent\"> | |_) / _` | '_ ` _ \\ / _ \\| '_ \\     | |_) | |/ _ \\ '__/ _` |</span>",
        '<span class="t-accent"> |  _ &lt; (_| | | | | | | (_) | | | |    |  _ &lt;| |  __/ | | (_| |</span>',
        '<span class="t-accent"> |_| \\_\\__,_|_| |_| |_|\\___/|_| |_|    |_| \\_\\_|\\___|_|  \\__,_|</span>',
        '&nbsp;',
        c('muted', 'UX Lead & Product Designer') + ' ' + c('comment', '// ramonriera.design'),
        '&nbsp;',
        c('string', 'Bienvenido.'),
        '&nbsp;',
        'Escribe ' + c('keyword', 'menu') + ' para ver los comandos disponibles.',
        c('comment', '─'.repeat(60)),
      ];
      typeLines(motdLines, function() {
        var marker = document.createElement('div');
        marker.id = 'motd-end';
        output.appendChild(marker);
        if (cb) cb();
      }, 70);
    }

    // ── Commands ──

    // ── Commands (return arrays of lines) ──

    function cmdHelp() {
      var categories = [
        { label: 'PROFILE', items: [
          ['about', 'Dossier profesional completo'],
          ['experience', 'Trayectoria profesional'],
          ['education', 'Formacion y certificaciones'],
          ['skills', 'Habilidades tecnicas'],
          ['social', 'Links de redes sociales'],
          ['cv', 'Descarga el CV'],
        ]},
        { label: 'PORTFOLIO', items: [
          ['projects', 'Lista proyectos interactiva'],
        ]},
        { label: 'SYSTEM', items: [
          ['neofetch', 'Info del sistema'],
          ['ls', 'Lista archivos del portfolio'],
          ['history', 'Historial de comandos'],
          ['date', 'Fecha y hora actual'],
          ['clear', 'Limpia la consola'],
          ['reset', 'Reinicia la terminal'],
          ['exit', 'Cierra la terminal'],
        ]},
      ];

      var allLines = [
        '&nbsp;',
        c('keyword', '  COMANDOS DISPONIBLES'),
        c('comment', '  ' + '─'.repeat(50)),
      ];

      // Track which lines will become selectable rows
      var selectableInfo = [];

      categories.forEach(function(cat) {
        allLines.push('&nbsp;');
        allLines.push('  ' + c('accent', cat.label));
        cat.items.forEach(function(item) {
          var baseHtml = '  ' + c('function', item[0].padEnd(14)) + ' ' + c('muted', item[1]);
          selectableInfo.push({ lineIndex: allLines.length, baseHtml: baseHtml, cmd: item[0] });
          allLines.push(baseHtml);
        });
      });

      allLines.push('&nbsp;');
      allLines.push('  ' + c('muted', '[↑/↓]') + ' navegar  ' + c('muted', '[Enter]') + ' ejecutar  ' + c('muted', '[ESC]') + ' cerrar terminal');
      allLines.push('&nbsp;');

      var startIdx = output.children.length;

      typeLines(allLines, function() {
        // After typewriter finishes, mark the rendered elements as selectable
        var rowEls = [];
        selectableInfo.forEach(function(info) {
          var el = output.children[startIdx + info.lineIndex];
          if (el) {
            el.classList.add('term-row-selectable');
            el.setAttribute('data-cmd', info.cmd);
            rowEls.push({ el: el, base: info.baseHtml });
          }
        });
        selectMode = { rows: rowEls, idx: 0 };
        updateSelectHighlight();
      }, 18);

      return null;
    }

    function cmdWhoami() {
      var line60 = c('comment', '─'.repeat(62));
      return [
        '&nbsp;',
        '  ' + c('accent', '▓▓ DOSSIER: RAMON RIERA'),
        '  ' + line60,
        '&nbsp;',
        '  ' + c('string', 'IDENTIDAD'),
        '&nbsp;',
        '  Diseñador de Producto enfocado en la intersección entre',
        '  la ' + c('keyword', 'estética funcional') + ' y el ' + c('keyword', 'código creativo') + '.',
        '  Especializado en ' + c('string', 'sistemas de diseño escalables') + ' y',
        '  ' + c('string', 'experiencias interactivas') + ' que conectan negocio y usuario.',
        '&nbsp;',
        '  ' + line60,
        '&nbsp;',
        '  ' + c('string', 'TECH STACK'),
        '&nbsp;',
        '  ' + c('function', 'DESIGN') + '     ' + c('muted', 'Figma · Adobe CC · Design Systems · UX Research'),
        '  ' + c('function', 'CODE') + '       ' + c('muted', 'React · Astro · Tailwind · TypeScript · Framer Motion'),
        '  ' + c('function', 'OPS') + '        ' + c('muted', 'DesignOps · Design Tokens · CI/CD · Storybook'),
        '&nbsp;',
        '  ' + line60,
        '&nbsp;',
        '  ' + c('string', 'ESTATUS & CONTACTO'),
        '&nbsp;',
        '  ' + c('function', 'STATUS') + '     ' + c('string', '● Available for projects'),
        '  ' + c('function', 'ROLE') + '       ' + c('muted', 'UX Lead & Strategic Product Designer @ Doctori.com'),
        '  ' + c('function', 'LOC') + '        ' + c('muted', 'Barcelona, ES / Remote'),
        '  ' + c('function', 'EMAIL') + '      ' + c('muted', 'hello@ramonriera.design'),
        '  ' + c('function', 'WEB') + '        ' + c('muted', 'ramonriera.design'),
        '&nbsp;',
        '  ' + line60,
        '&nbsp;',
      ];
    }

    function cmdEducation() {
      var sep = c('muted', ' │ ');
      var line70 = c('comment', '─'.repeat(16) + '┼' + '─'.repeat(62));
      var out = [
        '&nbsp;',
        '  ' + c('accent', ' CERTIFICACIONES'),
        '&nbsp;',
        '  ' + c('muted', 'AÑO'.padEnd(16)) + sep + c('muted', 'CERTIFICACION'),
        '  ' + line70,
        '  ' + c('constant', '2023            ') + sep + ' ' + c('function', 'Design System Specialist — Figma Camp (Figma.Camp)'),
        '  ' + c('constant', '2021            ') + sep + ' ' + c('function', 'UX/UI Design Bootcamp — NEOLAND (Barcelona)'),
        '  ' + line70,
        '&nbsp;',
        '  ' + c('accent', ' FORMACION ACADEMICA'),
        '&nbsp;',
        '  ' + c('muted', 'PERIODO'.padEnd(16)) + sep + c('muted', 'TITULO / INSTITUCION'),
        '  ' + line70,
        '  ' + c('constant', '2014 — 2016     ') + sep + ' ' + c('keyword', 'Master de Comunicacion y Estudios Culturales — Universitat de Girona'),
        '  ' + c('constant', '2009 — 2013     ') + sep + ' ' + c('keyword', 'Grado de Comunicacion Cultural — Universitat de Girona'),
        '  ' + c('constant', '2007 — 2009     ') + sep + ' ' + c('keyword', 'Licenciatura de Comunicacion Audiovisual — Universidad de Navarra'),
        '  ' + line70,
        '&nbsp;',
      ];
      return out;
    }

    function cmdExperience() {
      var sep = c('muted', ' │ ');
      var divider = '  ' + c('comment', '─'.repeat(18) + '┼' + '─'.repeat(22) + '┼' + '─'.repeat(30));
      var out = [
        '&nbsp;',
        '  ' + c('accent', ' TRAYECTORIA PROFESIONAL'),
        '&nbsp;',
        '  ' + c('muted', 'PERIODO'.padEnd(18)) + sep + c('muted', 'EMPRESA'.padEnd(22)) + sep + c('muted', 'ROL'),
        divider,
        '  ' + c('constant', '2021 — Presente   ') + sep + c('string', 'Doctori.com           ') + sep + c('keyword', 'UX Lead & Strategic Product Designer'),
        '  ' + c('constant', '2017 — 2021       ') + sep + c('string', 'JBM                   ') + sep + c('keyword', 'Junior -> Mid UX/UI Designer'),
        divider,
        '&nbsp;',
        '  ' + c('accent', ' CONSULTORIA SENIOR'),
        '&nbsp;',
        divider,
        '  ' + c('constant', '2023 — 2024       ') + sep + c('comment', '  Leemons             ') + sep + c('muted', 'Consultor · Product & UI'),
        '  ' + c('constant', '2022 — 2023       ') + sep + c('comment', '  Iberia              ') + sep + c('muted', 'Consultor · Design Systems'),
        '  ' + c('constant', '2021 — 2022       ') + sep + c('comment', '  Banco Sabadell      ') + sep + c('muted', 'Consultor · Design Systems'),
        divider,
        '  ' + c('comment', '5 posiciones') + ' ' + c('muted', '|') + ' ' + c('comment', (new Date().getFullYear() - 2017) + '+ años de experiencia'),
        '&nbsp;',
      ];
      return out;
    }

    // ── Interactive TUI selector (pointer-based) ──
    var selectMode = null; // { rows: [{ el, base }], idx: number }

    function exitSelectMode() {
      if (!selectMode) return;
      selectMode.rows.forEach(function(r) {
        r.el.classList.remove('term-row-active', 'term-row-selectable');
        r.el.innerHTML = r.base;
      });
      selectMode = null;
    }

    function updateSelectHighlight() {
      if (!selectMode) return;
      selectMode.rows.forEach(function(r, i) {
        if (i === selectMode.idx) {
          r.el.classList.add('term-row-active');
          r.el.innerHTML = '<span class="term-pointer">❯</span>' + r.base.slice(1);
          r.el.scrollIntoView({ block: 'nearest' });
        } else {
          r.el.classList.remove('term-row-active');
          r.el.innerHTML = r.base;
        }
      });
    }

    function flashAndExecute(cb) {
      if (!selectMode) { cb(); return; }
      var row = selectMode.rows[selectMode.idx];
      row.el.classList.add('term-row-flash');
      setTimeout(function() {
        row.el.classList.remove('term-row-flash');
        cb();
      }, 120);
    }

    function showCommandFooter(pid, isProfile) {
      line('&nbsp;');
      line(c('comment', '  ' + '─'.repeat(50)));
      line('&nbsp;');
      if (isProfile) {
        line('  ' + c('muted', '[') + c('function', 'experience') + c('muted', ']') + '  ' + c('muted', '[') + c('function', 'education') + c('muted', ']') + '  ' + c('muted', '[') + c('function', 'skills') + c('muted', ']') + '  ' + c('muted', '[') + c('function', 'social') + c('muted', ']'));
      }
      var parts = [];
      if (pid) {
        var others = projectList.filter(function(p) { return p.id !== pid; });
        var rand = others[Math.floor(Math.random() * others.length)];
        if (rand) {
          var slug = rand.slug.split('-')[0].toLowerCase();
          var shortName = rand.name.split(' - ')[0];
          parts.push(c('muted', '[') + c('function', shortName) + c('muted', ']') + ' src ' + slug);
        }
      }
      parts.push(c('muted', '[MENU]') + ' menu');
      parts.push(c('muted', '[ESC]') + ' cerrar terminal');
      line('  ' + parts.join('  '));
      line('&nbsp;');
      scroll();
    }

    function cmdProjects() {
      line('&nbsp;');

      var rowEls = [];
      var W = [6, 32, 18, 6];
      var b = c('muted', '│');

      function hr(l, m, r) {
        return '  ' + c('comment', l + '─'.repeat(W[0]) + m + '─'.repeat(W[1]) + m + '─'.repeat(W[2]) + m + '─'.repeat(W[3]) + r);
      }

      function row(cols, styles) {
        var cells = '';
        for (var i = 0; i < cols.length; i++) {
          var padded = (' ' + cols[i]).padEnd(W[i]);
          cells += b + '<span class="t-' + styles[i] + '">' + padded + '</span>';
        }
        return '  ' + cells + b;
      }

      var headerLines = [
        hr('┌', '┬', '┐'),
        row([' ID', ' NAME', ' CATEGORY', ' YEAR'], ['muted', 'muted', 'muted', 'muted']),
        hr('├', '┼', '┤'),
      ];
      headerLines.forEach(function(h) { line(h); });

      projectList.forEach(function(p) {
        var id = ' ' + String(p.id).padStart(2, '0');
        var baseHtml = ' ' + row([id, ' ' + p.name, ' ' + (p.cat || ''), ' ' + p.year], ['accent', 'string', 'keyword', 'constant']);
        var el = document.createElement('div');
        el.className = 'term-line term-row-selectable';
        el.innerHTML = baseHtml;
        el.setAttribute('data-project-id', p.id);
        output.appendChild(el);
        rowEls.push({ el: el, base: baseHtml });
      });

      line(hr('└', '┴', '┘'));

      // Footer
      line('&nbsp;');
      line('  ' + c('muted', '[↑/↓]') + ' seleccionar  ' + c('muted', '[Enter]') + ' ver detalle  ' + c('muted', '[MENU]') + ' menu  ' + c('muted', '[ESC]') + ' cancelar');
      line('&nbsp;');
      scroll();

      // Activate selection mode (projects)
      selectMode = { rows: rowEls, idx: 0 };
      updateSelectHighlight();

      return null;
    }

    // src <ID> — view project details inside terminal
    function cmdSrc(args) {
      var query = args.join(' ').toLowerCase();
      if (!query) return [c('error', 'Uso:') + ' src &lt;ID | nombre&gt;'];

      var id = parseInt(query, 10);
      var project = isNaN(id)
        ? projectList.find(function(p) { return p.name.toLowerCase().includes(query) || p.slug.includes(query); })
        : projectList.find(function(p) { return p.id === id; });

      if (!project) {
        var out = [c('error', 'No se encontro: "' + esc(query) + '"')];
        projectList.forEach(function(p) {
          out.push('  ' + c('constant', '[' + String(p.id).padStart(2, '0') + ']') + ' ' + c('string', p.name));
        });
        return out;
      }

      // Check for dedicated command (e.g. massimo, iberia)
      var slug = project.slug.split('-')[0].toLowerCase();
      if (commandMap[slug]) return commandMap[slug]([]);
      var nameKey = project.name.toLowerCase().replace(/[^a-z0-9]/g, '');
      if (commandMap[nameKey]) return commandMap[nameKey]([]);
      var slugKey = project.slug.replace(/-/g, '').toLowerCase();
      if (commandMap[slugKey]) return commandMap[slugKey]([]);

      // Generic project card
      var line62 = c('comment', '─'.repeat(62));
      return [
        '&nbsp;',
        '  ' + c('accent', '▓▓ PROJECT FILE: ' + project.name.toUpperCase()),
        '  ' + line62,
        '  ' + c('function', 'ID') + '         ' + c('accent', '[' + String(project.id).padStart(2, '0') + ']'),
        '  ' + c('function', 'CATEGORY') + '   ' + c('muted', project.cat || ''),
        '  ' + c('function', 'YEAR') + '       ' + c('constant', project.year),
        '  ' + line62,
        '&nbsp;',
      ];
    }

