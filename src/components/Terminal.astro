---
import { projects, siteConfig } from '@/utils/data';

const projectList = projects.map((p, i) => ({
  id: i + 1,
  slug: p.slug,
  title: p.title,
  year: p.year,
}));
---

<!-- Terminal overlay — hidden by default, pure black fullscreen -->
<div id="terminal" class="terminal-overlay">
  <!-- CRT Scanlines — topmost visual layer, no interaction -->
  <div class="terminal-scanlines" aria-hidden="true"></div>

  <!-- Scrollable content area — flex-col, starts top-left -->
  <div id="terminal-scroll" class="terminal-body">
    <!-- Output history -->
    <div id="terminal-output"></div>

    <!-- Input line -->
    <div class="terminal-input-row" id="terminal-input-line">
      <span class="terminal-prompt">ramon@riera:~$</span>
      <div class="terminal-input-wrap">
        <input
          id="terminal-input"
          type="text"
          class="terminal-input"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
        <span id="terminal-cursor" class="terminal-cursor" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</div>

<style>
  /* ═══════════════════════════════════════
     PURE TERMINAL — Clean & Minimal
     ═══════════════════════════════════════ */

  .terminal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #000000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .terminal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Scrollable body — content flows top-left ── */
  .terminal-body {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 2rem;
    scroll-padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .terminal-body {
      padding: 3rem;
    }
  }

  .terminal-body::-webkit-scrollbar {
    width: 4px;
  }
  .terminal-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .terminal-body::-webkit-scrollbar-thumb {
    background: #1a1a1a;
    border-radius: 2px;
  }

  /* ── Output ── */
  #terminal-output {
    width: 100%;
    color: #e0e0e0;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 768px) {
    #terminal-output {
      font-size: 0.875rem;
    }
  }

  /* ── Input row ── */
  .terminal-input-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.125rem;
  }

  .terminal-prompt {
    color: #50fa7b;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
    user-select: none;
  }

  @media (min-width: 768px) {
    .terminal-prompt {
      font-size: 0.875rem;
    }
  }

  .terminal-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .terminal-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #e0e0e0;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    caret-color: transparent;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 768px) {
    .terminal-input {
      font-size: 0.875rem;
    }
  }

  /* ── Block cursor ── */
  .terminal-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    background: #50fa7b;
    position: absolute;
    top: 0.15em;
    left: 0;
    animation: cursor-blink 1s step-end infinite;
    pointer-events: none;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── CRT Scanlines ── */
  .terminal-scanlines {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.12) 0px,
      rgba(0, 0, 0, 0.12) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: multiply;
  }

  /* ── Typewriter line fade-in ── */
  .tw-line {
    opacity: 0;
    animation: tw-in 0.04s ease forwards;
  }

  @keyframes tw-in {
    to { opacity: 1; }
  }

  /* ── Semantic colors ── */
  .t-green  { color: #50fa7b; }
  .t-cyan   { color: #8be9fd; }
  .t-yellow { color: #f1fa8c; }
  .t-pink   { color: #ff79c6; }
  .t-orange { color: #ffb86c; }
  .t-muted  { color: #555e6b; }
  .t-white  { color: #e0e0e0; }
  .t-red    { color: #ff5555; }
  .t-bold   { font-weight: 700; }
</style>

<script define:vars={{ projectList, siteConfig }}>
  const terminal = document.getElementById('terminal');
  const output = document.getElementById('terminal-output');
  const input = document.getElementById('terminal-input');
  const cursor = document.getElementById('terminal-cursor');
  const scrollEl = document.getElementById('terminal-scroll');

  // ── State ──
  const cmdHistory = [];
  let histIdx = -1;
  let busy = false;

  // ═══ Open / Close ═══

  function openTerminal() {
    output.innerHTML = '';
    input.value = '';
    terminal.classList.add('is-open');
    document.body.style.overflow = 'hidden';

    busy = true;
    typeLines(motd, () => {
      busy = false;
      input.focus();
      syncCursor();
    });
  }

  function closeTerminal() {
    terminal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  window.openTerminal = openTerminal;
  window.closeTerminal = closeTerminal;

  // ═══ Cursor ═══

  let _cw = null;

  function charWidth() {
    if (_cw) return _cw;
    const m = document.createElement('span');
    m.style.cssText = `font-family:'JetBrains Mono',ui-monospace,monospace;font-size:${getComputedStyle(input).fontSize};position:absolute;visibility:hidden`;
    m.textContent = 'M';
    document.body.appendChild(m);
    _cw = m.getBoundingClientRect().width;
    document.body.removeChild(m);
    return _cw;
  }

  function syncCursor() {
    if (!input || !cursor) return;
    cursor.style.left = `${input.selectionStart * charWidth()}px`;
  }

  input.addEventListener('input', syncCursor);
  input.addEventListener('click', syncCursor);
  input.addEventListener('keyup', syncCursor);

  // ═══ Output helpers ═══

  function typeLines(lines, cb) {
    let i = 0;
    function next() {
      if (i >= lines.length) { cb?.(); return; }
      const div = document.createElement('div');
      div.className = 'tw-line';
      const l = lines[i];
      if (typeof l === 'string') div.textContent = l;
      else div.innerHTML = l.html;
      output.appendChild(div);
      toBottom();
      i++;
      setTimeout(next, 16 + Math.random() * 14);
    }
    next();
  }

  function print(html) {
    const d = document.createElement('div');
    d.innerHTML = html;
    output.appendChild(d);
    toBottom();
  }

  function toBottom() {
    requestAnimationFrame(() => { scrollEl.scrollTop = scrollEl.scrollHeight; });
  }

  // ═══ MOTD ═══

  const motd = [
    { html: '' },
    { html: '<span class="t-green t-bold"> ramon@riera — portfolio v1.0</span>' },
    { html: '<span class="t-muted"> ────────────────────────────────────────</span>' },
    { html: '' },
    { html: '<span class="t-white"> Welcome. Type</span> <span class="t-yellow t-bold">help</span> <span class="t-white">to see available commands.</span>' },
    { html: '<span class="t-white"> Type</span> <span class="t-yellow t-bold">exit</span> <span class="t-white">to return to the visual portfolio.</span>' },
    { html: '' },
  ];

  // ═══ Commands ═══

  function cmdHelp() {
    return [
      { html: '' },
      { html: '<span class="t-yellow t-bold"> COMMANDS</span>' },
      { html: '' },
      { html: '   <span class="t-green">help</span>          <span class="t-muted">Show this message</span>' },
      { html: '   <span class="t-green">about</span>         <span class="t-muted">About me</span>' },
      { html: '   <span class="t-green">projects</span>      <span class="t-muted">List portfolio projects</span>' },
      { html: '   <span class="t-green">open</span> <span class="t-cyan">[id]</span>     <span class="t-muted">Open a project</span>' },
      { html: '   <span class="t-green">contact</span>       <span class="t-muted">Get in touch</span>' },
      { html: '   <span class="t-green">clear</span>         <span class="t-muted">Clear screen</span>' },
      { html: '   <span class="t-green">exit</span>          <span class="t-muted">Close terminal</span>' },
      { html: '' },
    ];
  }

  function cmdAbout() {
    return [
      { html: '' },
      { html: ' <span class="t-cyan t-bold">Ramon Riera</span>' },
      { html: ' <span class="t-muted">UX Lead · Product Designer · Design Systems</span>' },
      { html: '' },
      { html: ' <span class="t-white">+8 años diseñando productos digitales para</span>' },
      { html: ' <span class="t-white">empresas como</span> <span class="t-yellow">Iberia</span><span class="t-white">,</span> <span class="t-yellow">Banco Sabadell</span><span class="t-white">,</span>' },
      { html: ' <span class="t-yellow">ImaginBank</span> <span class="t-white">y</span> <span class="t-yellow">Massimo Dutti</span><span class="t-white">.</span>' },
      { html: '' },
      { html: ' <span class="t-white">Especializado en</span> <span class="t-green">estrategia de UX</span><span class="t-white">,</span>' },
      { html: ' <span class="t-green">Design Systems</span> <span class="t-white">y</span> <span class="t-green">DesignOps</span><span class="t-white">.</span>' },
      { html: '' },
      { html: ' <span class="t-muted">Currently:</span>  <span class="t-orange">UX Lead @ Doctori.com</span>' },
      { html: ' <span class="t-muted">Location:</span>   <span class="t-white">Barcelona, ES</span>' },
      { html: '' },
    ];
  }

  function cmdProjects() {
    const pad = (s, n) => s.length >= n ? s.slice(0, n) : s + ' '.repeat(n - s.length);
    const rows = projectList.map((p) => {
      const id = String(p.id).padStart(2, ' ');
      return { html: `   <span class="t-cyan">${id}</span>  <span class="t-muted">│</span>  <span class="t-white">${pad(p.title, 30)}</span>  <span class="t-muted">│</span>  <span class="t-orange">${p.year}</span>` };
    });

    return [
      { html: '' },
      { html: '  <span class="t-yellow t-bold"> ID  │  Project                          │  Year</span>' },
      { html: '  <span class="t-muted">─────┼──────────────────────────────────┼───────</span>' },
      ...rows,
      { html: '' },
      { html: ' <span class="t-muted">Type</span> <span class="t-green">open [id]</span> <span class="t-muted">to view a project.</span>' },
      { html: '' },
    ];
  }

  function cmdOpen(args) {
    if (!args[0]) {
      return [{ html: ' <span class="t-red">Error:</span> <span class="t-white">Missing ID.</span> <span class="t-muted">Usage:</span> <span class="t-green">open [id]</span>' }];
    }
    const project = projectList.find((p) => p.id === parseInt(args[0], 10));
    if (!project) {
      return [{ html: ` <span class="t-red">Error:</span> <span class="t-white">ID "${esc(args[0])}" not found.</span> <span class="t-muted">Type</span> <span class="t-green">projects</span> <span class="t-muted">to list IDs.</span>` }];
    }
    setTimeout(() => { window.location.href = `/projects/${project.slug}`; }, 500);
    return [{ html: ` <span class="t-green">→</span> <span class="t-white">Opening</span> <span class="t-yellow">${project.title}</span><span class="t-muted">...</span>` }];
  }

  function cmdContact() {
    const e = siteConfig.email;
    const li = siteConfig.social.linkedin;
    const md = siteConfig.social.medium;
    return [
      { html: '' },
      { html: ' <span class="t-yellow t-bold">CONTACT</span>' },
      { html: '' },
      { html: `   <span class="t-muted">Email</span>      <a href="mailto:${e}" class="t-cyan" style="text-decoration:underline;text-underline-offset:3px">${e}</a>` },
      { html: `   <span class="t-muted">LinkedIn</span>   <a href="${li}" target="_blank" rel="noopener" class="t-cyan" style="text-decoration:underline;text-underline-offset:3px">${li.replace('https://', '')}</a>` },
      { html: `   <span class="t-muted">Medium</span>     <a href="${md}" target="_blank" rel="noopener" class="t-cyan" style="text-decoration:underline;text-underline-offset:3px">${md.replace('https://', '')}</a>` },
      { html: '' },
    ];
  }

  function cmdExit() {
    print(' <span class="t-muted">logout</span>');
    setTimeout(closeTerminal, 300);
    return null;
  }

  // ═══ Processor ═══

  function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function processCmd(raw) {
    const t = raw.trim();
    if (!t) return null;

    print(`<span class="t-green" style="font-weight:600">ramon@riera:~$</span> <span class="t-white">${esc(t)}</span>`);

    const [cmd, ...args] = t.split(/\s+/);
    switch (cmd.toLowerCase()) {
      case 'help':     return cmdHelp();
      case 'about':    return cmdAbout();
      case 'projects': return cmdProjects();
      case 'open':     return cmdOpen(args);
      case 'contact':  return cmdContact();
      case 'exit':     return cmdExit();
      case 'clear':    output.innerHTML = ''; return null;
      default:
        return [{ html: ` <span class="t-red">command not found:</span> <span class="t-white">${esc(cmd)}</span>` }];
    }
  }

  // ═══ Input ═══

  input.addEventListener('keydown', (e) => {
    if (busy) { e.preventDefault(); return; }

    if (e.key === 'Enter') {
      e.preventDefault();
      const v = input.value;
      if (v.trim()) cmdHistory.push(v);
      histIdx = cmdHistory.length;
      const lines = processCmd(v);
      input.value = '';
      syncCursor();
      if (lines) {
        busy = true;
        typeLines(lines, () => { busy = false; input.focus(); toBottom(); });
      }
      return;
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (histIdx > 0) { histIdx--; input.value = cmdHistory[histIdx]; syncCursor(); }
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (histIdx < cmdHistory.length - 1) { histIdx++; input.value = cmdHistory[histIdx]; }
      else { histIdx = cmdHistory.length; input.value = ''; }
      syncCursor();
    }
  });

  // ═══ Global focus ═══
  terminal.addEventListener('click', () => input.focus());
</script>
