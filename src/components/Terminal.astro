---
import { projects, siteConfig } from '@/utils/data';

const projectList = projects.map((p, i) => ({
  id: i + 1,
  slug: p.slug,
  title: p.title,
  year: p.year,
}));

const today = new Date();
const dateStr = today.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
---

<!-- Terminal overlay — hidden by default -->
<div id="terminal" class="terminal-overlay">

  <!-- ── Title bar ── -->
  <div class="terminal-titlebar">
    <div class="terminal-titlebar-left">
      <span class="terminal-dot terminal-dot--red"></span>
      <span class="terminal-dot terminal-dot--yellow"></span>
      <span class="terminal-dot terminal-dot--green"></span>
      <span class="terminal-titlebar-sep"></span>
      <span class="terminal-titlebar-name">Ramon Riera</span>
      <span class="terminal-titlebar-divider">|</span>
      <span class="terminal-titlebar-role">UX Lead & Product Designer</span>
    </div>
    <div class="terminal-titlebar-right">
      <span class="terminal-titlebar-meta">Astro 5.17</span>
      <span class="terminal-titlebar-divider">|</span>
      <span class="terminal-titlebar-meta">{dateStr}</span>
      <span class="terminal-titlebar-divider">|</span>
      <span class="terminal-titlebar-status">
        <span class="terminal-status-dot"></span>
        Active
      </span>
    </div>
  </div>

  <!-- ── Body: output top, prompt anchored bottom ── -->
  <div id="terminal-scroll" class="terminal-body">
    <!-- Output area — grows from top -->
    <div id="terminal-output" class="terminal-output"></div>

    <!-- Spacer pushes prompt to bottom when output is short -->
    <div class="terminal-spacer"></div>

    <!-- Input line — always at bottom -->
    <div class="terminal-input-row" id="terminal-input-line">
      <span class="terminal-prompt"><span class="tp-user">ramon</span><span class="tp-at">@</span><span class="tp-host">riera</span><span class="tp-colon">:</span><span class="tp-path">~</span><span class="tp-dollar">$</span></span>
      <div class="terminal-input-wrap">
        <input
          id="terminal-input"
          type="text"
          class="terminal-input"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
        />
        <span id="terminal-cursor" class="terminal-cursor" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <!-- CRT Scanlines — subtle overlay -->
  <div class="terminal-scanlines" aria-hidden="true"></div>
</div>

<style>
  /* ═══════════════════════════════════════
     TERMINAL — System-Native Design
     ═══════════════════════════════════════ */

  .terminal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #1a1b2e;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .terminal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* ── Title Bar ── */
  .terminal-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    background: #161726;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
    user-select: none;
  }

  .terminal-titlebar-left,
  .terminal-titlebar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal-dot--red    { background: #ff5f57; }
  .terminal-dot--yellow { background: #febc2e; }
  .terminal-dot--green  { background: #28c840; }

  .terminal-titlebar-sep {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.1);
    margin: 0 0.35rem;
  }

  .terminal-titlebar-name {
    color: #e0e0e0;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .terminal-titlebar-divider {
    color: rgba(255, 255, 255, 0.15);
    font-weight: 300;
  }

  .terminal-titlebar-role {
    color: #7a7d8e;
    font-weight: 400;
  }

  .terminal-titlebar-meta {
    color: #7a7d8e;
    font-weight: 500;
  }

  .terminal-titlebar-status {
    color: #50fa7b;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .terminal-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #50fa7b;
    animation: status-pulse 2s ease-in-out infinite;
  }

  @keyframes status-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Hide right side of titlebar on small screens */
  @media (max-width: 640px) {
    .terminal-titlebar-right { display: none; }
    .terminal-titlebar-role  { display: none; }
  }

  /* ── Body ── */
  .terminal-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.5rem;
    scroll-padding-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .terminal-body {
      padding: 2.5rem;
    }
  }

  .terminal-body::-webkit-scrollbar       { width: 4px; }
  .terminal-body::-webkit-scrollbar-track  { background: transparent; }
  .terminal-body::-webkit-scrollbar-thumb  { background: #2a2b3d; border-radius: 2px; }

  /* ── Output ── */
  .terminal-output {
    color: #c4c7d4;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.8rem;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 768px) {
    .terminal-output { font-size: 0.85rem; }
  }

  /* Spacer pushes prompt to bottom when content is short */
  .terminal-spacer {
    flex: 1;
  }

  /* ── Input row ── */
  .terminal-input-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    width: 100%;
    flex-shrink: 0;
    padding-top: 0.25rem;
  }

  .terminal-prompt {
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
    user-select: none;
  }

  @media (min-width: 768px) {
    .terminal-prompt { font-size: 0.85rem; }
  }

  .tp-user  { color: #50fa7b; }
  .tp-at    { color: #c4c7d4; }
  .tp-host  { color: #8be9fd; }
  .tp-colon { color: #c4c7d4; }
  .tp-path  { color: #bd93f9; }
  .tp-dollar { color: #c4c7d4; }

  .terminal-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .terminal-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #e0e0e0;
    font-family: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    font-size: 0.8rem;
    line-height: 1.75;
    caret-color: transparent;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 768px) {
    .terminal-input { font-size: 0.85rem; }
  }

  /* ── Block cursor ── */
  .terminal-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    background: #c4c7d4;
    position: absolute;
    top: 0.15em;
    left: 0;
    animation: cursor-blink 1s step-end infinite;
    pointer-events: none;
  }

  @keyframes cursor-blink {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 0; }
  }

  /* ── CRT Scanlines ── */
  .terminal-scanlines {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.06) 0px,
      rgba(0, 0, 0, 0.06) 1px,
      transparent 1px,
      transparent 3px
    );
  }

  /* ── Typewriter line animation ── */
  .tw-line {
    opacity: 0;
    animation: tw-in 0.04s ease forwards;
  }

  @keyframes tw-in {
    to { opacity: 1; }
  }

  /* ── Semantic colors ── */
  .t-green  { color: #50fa7b; }
  .t-cyan   { color: #8be9fd; }
  .t-yellow { color: #f1fa8c; }
  .t-pink   { color: #ff79c6; }
  .t-orange { color: #ffb86c; }
  .t-purple { color: #bd93f9; }
  .t-muted  { color: #565973; }
  .t-white  { color: #c4c7d4; }
  .t-red    { color: #ff5555; }
  .t-bold   { font-weight: 700; }
</style>

<script define:vars={{ projectList, siteConfig }}>
  const terminal = document.getElementById('terminal');
  const output = document.getElementById('terminal-output');
  const input = document.getElementById('terminal-input');
  const cursor = document.getElementById('terminal-cursor');
  const scrollEl = document.getElementById('terminal-scroll');

  const cmdHistory = [];
  let histIdx = -1;
  let busy = false;

  // ═══ Open / Close ═══

  function openTerminal() {
    output.innerHTML = '';
    input.value = '';
    terminal.classList.add('is-open');
    document.body.style.overflow = 'hidden';

    busy = true;
    typeLines(motd, () => {
      busy = false;
      input.focus();
      syncCursor();
    });
  }

  function closeTerminal() {
    terminal.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  window.openTerminal = openTerminal;
  window.closeTerminal = closeTerminal;

  // ═══ Cursor ═══

  let _cw = null;
  function charWidth() {
    if (_cw) return _cw;
    const m = document.createElement('span');
    m.style.cssText = "font-family:'JetBrains Mono',ui-monospace,monospace;font-size:" + getComputedStyle(input).fontSize + ";position:absolute;visibility:hidden";
    m.textContent = 'M';
    document.body.appendChild(m);
    _cw = m.getBoundingClientRect().width;
    document.body.removeChild(m);
    return _cw;
  }

  function syncCursor() {
    if (!input || !cursor) return;
    cursor.style.left = (input.selectionStart * charWidth()) + 'px';
  }

  input.addEventListener('input', syncCursor);
  input.addEventListener('click', syncCursor);
  input.addEventListener('keyup', syncCursor);

  // ═══ Output helpers ═══

  function typeLines(lines, cb) {
    let i = 0;
    function next() {
      if (i >= lines.length) { if (cb) cb(); return; }
      const d = document.createElement('div');
      d.className = 'tw-line';
      const l = lines[i];
      if (typeof l === 'string') d.textContent = l;
      else d.innerHTML = l.html;
      output.appendChild(d);
      toBottom();
      i++;
      setTimeout(next, 16 + Math.random() * 14);
    }
    next();
  }

  function print(html) {
    const d = document.createElement('div');
    d.innerHTML = html;
    output.appendChild(d);
    toBottom();
  }

  function toBottom() {
    requestAnimationFrame(function() { scrollEl.scrollTop = scrollEl.scrollHeight; });
  }

  // ═══ ASCII Art MOTD ═══

  const motd = [
    { html: '<span class="t-orange">  ____ ____ _  </span>' },
    { html: '<span class="t-orange"> | _ \\  _ _ _  ___ ___ _  _ | \\(_) ___ _ __ _ </span>' },
    { html: '<span class="t-orange"> | |_) / _` | \'_ ` _ \\ / _ \\| \'_ \\|  _ \\| \'__/ _` |</span>' },
    { html: '<span class="t-orange"> |  _ < (_| | | | | | | (_) | | | | |_) | | | (_| |</span>' },
    { html: '<span class="t-orange"> |_| \\_\\__,_|_| |_| |_|\\___/|_| |_| .__/|_|  \\__,_|</span>' },
    { html: '<span class="t-orange">                                   |_|</span>' },
    { html: '' },
    { html: ' <span class="t-white">UX Lead & Product Designer</span> <span class="t-muted">//</span> <span class="t-muted">ramonriera.design</span>' },
    { html: '' },
    { html: ' <span class="t-green t-bold">Bienvenido.</span> <span class="t-white">Escribe</span> <span class="t-cyan t-bold">help</span> <span class="t-white">para ver los comandos disponibles.</span>' },
    { html: ' <span class="t-muted">─────────────────────────────────────────────────</span>' },
    { html: '' },
  ];

  // ═══ Commands ═══

  function cmdHelp() {
    return [
      { html: '' },
      { html: ' <span class="t-yellow t-bold">COMANDOS DISPONIBLES</span>' },
      { html: '' },
      { html: '   <span class="t-green">help</span>          <span class="t-muted">Muestra este mensaje</span>' },
      { html: '   <span class="t-green">about</span>         <span class="t-muted">Sobre mí</span>' },
      { html: '   <span class="t-green">projects</span>      <span class="t-muted">Lista de proyectos del portfolio</span>' },
      { html: '   <span class="t-green">open</span> <span class="t-cyan">[id]</span>     <span class="t-muted">Abre un proyecto por su ID</span>' },
      { html: '   <span class="t-green">contact</span>       <span class="t-muted">Contacto y redes</span>' },
      { html: '   <span class="t-green">clear</span>         <span class="t-muted">Limpia la pantalla</span>' },
      { html: '   <span class="t-green">exit</span>          <span class="t-muted">Cierra la terminal</span>' },
      { html: '' },
    ];
  }

  function cmdAbout() {
    return [
      { html: '' },
      { html: ' <span class="t-cyan t-bold">Ramon Riera</span>' },
      { html: ' <span class="t-muted">UX Lead · Product Designer · Design Systems</span>' },
      { html: '' },
      { html: ' <span class="t-white">+8 años diseñando productos digitales para</span>' },
      { html: ' <span class="t-white">empresas como</span> <span class="t-yellow">Iberia</span><span class="t-white">,</span> <span class="t-yellow">Banco Sabadell</span><span class="t-white">,</span>' },
      { html: ' <span class="t-yellow">ImaginBank</span> <span class="t-white">y</span> <span class="t-yellow">Massimo Dutti</span><span class="t-white">.</span>' },
      { html: '' },
      { html: ' <span class="t-white">Especializado en</span> <span class="t-green">estrategia de UX</span><span class="t-white">,</span>' },
      { html: ' <span class="t-green">Design Systems</span> <span class="t-white">y</span> <span class="t-green">DesignOps</span><span class="t-white">.</span>' },
      { html: '' },
      { html: ' <span class="t-muted">Actualmente:</span>  <span class="t-orange">UX Lead @ Doctori.com</span>' },
      { html: ' <span class="t-muted">Ubicación:</span>    <span class="t-white">Barcelona, ES</span>' },
      { html: '' },
    ];
  }

  function cmdProjects() {
    var pad = function(s, n) { return s.length >= n ? s.slice(0, n) : s + ' '.repeat(n - s.length); };
    var rows = projectList.map(function(p) {
      var id = String(p.id).padStart(2, ' ');
      return { html: '   <span class="t-cyan">' + id + '</span>  <span class="t-muted">│</span>  <span class="t-white">' + pad(p.title, 30) + '</span>  <span class="t-muted">│</span>  <span class="t-orange">' + p.year + '</span>' };
    });

    return [
      { html: '' },
      { html: '  <span class="t-yellow t-bold"> ID  │  Proyecto                          │  Año</span>' },
      { html: '  <span class="t-muted">─────┼──────────────────────────────────┼───────</span>' },
    ].concat(rows).concat([
      { html: '' },
      { html: ' <span class="t-muted">Escribe</span> <span class="t-green">open [id]</span> <span class="t-muted">para abrir un proyecto.</span>' },
      { html: '' },
    ]);
  }

  function cmdOpen(args) {
    if (!args[0]) {
      return [{ html: ' <span class="t-red">Error:</span> <span class="t-white">Falta el ID.</span> <span class="t-muted">Uso:</span> <span class="t-green">open [id]</span>' }];
    }
    var project = projectList.find(function(p) { return p.id === parseInt(args[0], 10); });
    if (!project) {
      return [{ html: ' <span class="t-red">Error:</span> <span class="t-white">ID "' + esc(args[0]) + '" no encontrado.</span> <span class="t-muted">Escribe</span> <span class="t-green">projects</span> <span class="t-muted">para ver los IDs.</span>' }];
    }
    setTimeout(function() { window.location.href = '/projects/' + project.slug; }, 500);
    return [{ html: ' <span class="t-green">→</span> <span class="t-white">Abriendo</span> <span class="t-yellow">' + project.title + '</span><span class="t-muted">...</span>' }];
  }

  function cmdContact() {
    var e = siteConfig.email;
    var li = siteConfig.social.linkedin;
    var md = siteConfig.social.medium;
    return [
      { html: '' },
      { html: ' <span class="t-yellow t-bold">CONTACTO</span>' },
      { html: '' },
      { html: '   <span class="t-muted">Email</span>      <a href="mailto:' + e + '" class="t-cyan" style="text-decoration:underline;text-underline-offset:3px">' + e + '</a>' },
      { html: '   <span class="t-muted">LinkedIn</span>   <a href="' + li + '" target="_blank" rel="noopener" class="t-cyan" style="text-decoration:underline;text-underline-offset:3px">' + li.replace('https://', '') + '</a>' },
      { html: '   <span class="t-muted">Medium</span>     <a href="' + md + '" target="_blank" rel="noopener" class="t-cyan" style="text-decoration:underline;text-underline-offset:3px">' + md.replace('https://', '') + '</a>' },
      { html: '' },
    ];
  }

  function cmdExit() {
    print(' <span class="t-muted">logout</span>');
    setTimeout(closeTerminal, 300);
    return null;
  }

  // ═══ Processor ═══

  function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

  function processCmd(raw) {
    var t = raw.trim();
    if (!t) return null;

    print('<span class="tp-user">ramon</span><span class="tp-at">@</span><span class="tp-host">riera</span><span class="tp-colon">:</span><span class="tp-path">~</span><span class="tp-dollar">$</span> <span class="t-white">' + esc(t) + '</span>');

    var parts = t.split(/\s+/);
    var cmd = parts[0].toLowerCase();
    var args = parts.slice(1);

    switch (cmd) {
      case 'help':     return cmdHelp();
      case 'about':    return cmdAbout();
      case 'projects': return cmdProjects();
      case 'open':     return cmdOpen(args);
      case 'contact':  return cmdContact();
      case 'exit':     return cmdExit();
      case 'clear':    output.innerHTML = ''; return null;
      default:
        return [{ html: ' <span class="t-red">comando no encontrado:</span> <span class="t-white">' + esc(cmd) + '</span>' }];
    }
  }

  // ═══ Input ═══

  input.addEventListener('keydown', function(e) {
    if (busy) { e.preventDefault(); return; }

    if (e.key === 'Enter') {
      e.preventDefault();
      var v = input.value;
      if (v.trim()) cmdHistory.push(v);
      histIdx = cmdHistory.length;
      var lines = processCmd(v);
      input.value = '';
      syncCursor();
      if (lines) {
        busy = true;
        typeLines(lines, function() { busy = false; input.focus(); toBottom(); });
      }
      return;
    }

    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (histIdx > 0) { histIdx--; input.value = cmdHistory[histIdx]; syncCursor(); }
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (histIdx < cmdHistory.length - 1) { histIdx++; input.value = cmdHistory[histIdx]; }
      else { histIdx = cmdHistory.length; input.value = ''; }
      syncCursor();
    }
  });

  // ═══ Global focus ═══
  terminal.addEventListener('click', function() { input.focus(); });
</script>
