    function cmdCv() {
      setTimeout(function() { window.open('/docs/CV-Ramon-Riera-Depares.pdf', '_blank'); }, 800);
      return [
        '&nbsp;',
        c('string', '  Loading dossier...'),
        c('muted', '  Fetching /docs/CV-Ramon-Riera-Depares.pdf'),
        c('string', '  ✓ Opening in new tab.'),
        '&nbsp;',
      ];
    }

    var isExiting = false;

    function doExit() {
      if (isExiting) return;
      isExiting = true;
      if (selectMode) exitSelectMode();
      line(c('muted', 'logout'));
      line(c('comment', '[process completed] Connection to ramon@riera closed.'));
      scroll();
      setTimeout(function() {
        terminal.classList.add('is-closing');
        setTimeout(function() {
          terminal.classList.remove('is-closing');
          window.closeTerminal();
          isExiting = false;
        }, 450);
      }, 300);
    }

    function cmdExit() {
      doExit();
      return null;
    }

    // File-to-command mapping for bare filename execution
    var fileMap = {
      'about.md': 'about', 'projects.exe': 'projects', 'experience.log': 'experience',
      'education.dat': 'education', 'skills.json': 'skills', 'contact.link': 'social',
      'social.yaml': 'social', 'cv.pdf': 'cv', 'neofetch.sh': 'neofetch',
      'massimo.md': 'massimo',
      'movefast.md': 'movefast',
      'globalhelping.md': 'globalhelping',
      'sabadell.md': 'sabadell',
      'imaginbank.md': 'imaginbank',
      'iberia.md': 'iberia',
      'solotemazos.md': 'solotemazos',
    };

    var commandMap = {
      menu: cmdHelp, help: cmdHelp, about: cmdWhoami, experience: cmdExperience, education: cmdEducation, projects: cmdProjects,
      src: cmdSrc, skills: cmdSkills, social: cmdSocial,
      massimo: cmdMassimo, movefast: cmdMovefast, globalhelping: cmdGlobalhelping,
      sabadell: cmdSabadell, banco: cmdSabadell, imaginbank: cmdImaginbank,
      iberia: cmdIberia, solotemazos: cmdSolotemazos,
      neofetch: cmdNeofetch, cv: cmdCv, history: cmdHistory, date: cmdDate,
      ls: cmdLs, exit: cmdExit,
      clear: function() { return null; },
      reset: function() {
        output.innerHTML = '';
        history.length = 0;
        histIdx = -1;
        try { sessionStorage.removeItem(sessionKey); } catch(e) {}
        showMotd(function() { input.focus(); });
        return null;
      },
    };

    // ── Process command ──

    function processCmd(raw) {
      var t = raw.trim();
      if (!t) return;

      // Exit any active TUI menu
      if (selectMode) exitSelectMode();

      // Full clear: clean slate for every command
      output.innerHTML = '';
      output.scrollTop = 0;

      line('<span class="term-prompt-echo"><span class="t-string">ramon</span><span class="t-muted">@</span><span class="t-string">riera</span><span class="t-muted">:~$</span></span>  ' + esc(t));

      var parts = t.split(/\s+/);
      var cmd = parts[0].toLowerCase();
      var args = parts.slice(1);

      history.push(t);
      histIdx = history.length;

      // Bare filename execution: e.g. "about.md" → about command
      if (!commandMap[cmd] && fileMap[cmd]) {
        cmd = fileMap[cmd];
      }

      // Commands that handle their own UI (no footer)
      var noFooter = { menu: 1, help: 1, projects: 1, clear: 1, reset: 1, exit: 1 };
      var profileCmds = { about: 1, experience: 1, education: 1, skills: 1, social: 1, cv: 1 };

      var fn = commandMap[cmd];
      if (fn) {
        var result = fn(args);
        if (result && result.length) {
          var pid = result._projectId;
          var isProfile = profileCmds[cmd] || false;
          typeLines(result, function() {
            if (!noFooter[cmd]) showCommandFooter(pid, isProfile);
          });
        }
      } else {
        typeLines([
          c('error', 'comando no encontrado: ' + esc(cmd)),
          c('muted', 'Escribe') + ' ' + c('keyword', 'menu') + ' ' + c('muted', 'para ver los comandos.'),
        ]);
      }
    }

    // ── Input ──

    // Move cursor to end of input text
    function cursorToEnd() {
      setTimeout(function() {
        input.selectionStart = input.selectionEnd = input.value.length;
        input.focus();
      }, 0);
    }

    // Find longest common prefix among strings
    function commonPrefix(strs) {
      if (!strs.length) return '';
      var prefix = strs[0];
      for (var i = 1; i < strs.length; i++) {
        while (strs[i].indexOf(prefix) !== 0) {
          prefix = prefix.slice(0, -1);
          if (!prefix) return '';
        }
      }
      return prefix;
    }

    input.addEventListener('keydown', function(e) {
      if (typewriterBusy) { e.preventDefault(); return; }

      // ── Selection mode (projects TUI) ──
      if (selectMode) {
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (selectMode.idx > 0) { selectMode.idx--; updateSelectHighlight(); }
          return;
        }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (selectMode.idx < selectMode.rows.length - 1) { selectMode.idx++; updateSelectHighlight(); }
          return;
        }
        if (e.key === 'Enter') {
          e.preventDefault();
          var rowObj = selectMode.rows[selectMode.idx];
          var pid = rowObj.el.getAttribute('data-project-id');
          var cmd = rowObj.el.getAttribute('data-cmd');
          flashAndExecute(function() {
            exitSelectMode();
            if (pid) {
              processCmd('src ' + pid);
            } else if (cmd) {
              processCmd(cmd);
            }
            input.value = '';
          });
          return;
        }
        if (e.key === 'Escape') {
          e.preventDefault();
          exitSelectMode();
          line(c('muted', '  Selección cancelada.'));
          scroll();
          return;
        }
        // Any other key exits selection mode and falls through to normal input
        exitSelectMode();
      }

      if (e.key === 'Enter') {
        processCmd(input.value);
        input.value = '';
        return;
      }

      // ── History: ↑ ──
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (histIdx > 0) {
          histIdx--;
          input.value = history[histIdx];
          cursorToEnd();
        }
        return;
      }

      // ── History: ↓ ──
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (histIdx < history.length - 1) {
          histIdx++;
          input.value = history[histIdx];
        } else {
          histIdx = history.length;
          input.value = '';
        }
        cursorToEnd();
        return;
      }

      // ── Tab autocomplete ──
      if (e.key === 'Tab') {
        e.preventDefault();
        var q = input.value.trim().toLowerCase();
        if (!q) return;

        var cmdNames = Object.keys(commandMap);
        var matches = cmdNames.filter(function(k) { return k.startsWith(q); });

        if (matches.length === 1) {
          // Single match → complete + space
          input.value = matches[0] + ' ';
          cursorToEnd();
        } else if (matches.length > 1) {
          // Multiple matches → complete common prefix + show options
          var cp = commonPrefix(matches);
          if (cp.length > q.length) {
            input.value = cp;
            cursorToEnd();
          }
          line(c('muted', '  ' + matches.join('  ')));
          scroll();
        }
        return;
      }

      // ── Ctrl+L → clear ──
      if (e.key === 'l' && e.ctrlKey) {
        e.preventDefault();
        processCmd('clear');
        return;
      }

      // ── ESC → exit terminal ──
      if (e.key === 'Escape') {
        e.preventDefault();
        doExit();
        return;
      }
    });

    // ── Global focus (only when terminal is open) ──
    document.addEventListener('click', function() {
      if (terminal.classList.contains('is-open')) input.focus();
    });

    // ── Favicon switching ──
    var faviconNormal = '/favicon.svg';
    var faviconCode = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="#1a5c1a"/><rect x="27" y="12" width="10" height="40" rx="3" fill="#D97757"/></svg>');

    function setFavicon(href) {
      var link = document.querySelector("link[rel='icon'][type='image/svg+xml']");
      if (link) link.href = href;
    }

    // ── Session persistence ──
    var sessionKey = '__term_session';

    function saveSession() {
      try {
        sessionStorage.setItem(sessionKey, JSON.stringify({
          html: output.innerHTML,
          history: history,
          scrollTop: output.scrollTop,
        }));
      } catch(e) {}
    }

    function restoreSession() {
      try {
        var data = JSON.parse(sessionStorage.getItem(sessionKey));
        if (data && data.html) {
          output.innerHTML = data.html;
          history = data.history || [];
          histIdx = history.length;
          requestAnimationFrame(function() {
            output.scrollTop = data.scrollTop || output.scrollHeight;
          });
          return true;
        }
      } catch(e) {}
      return false;
    }

    // ── Open / Close API ──
    window.openTerminal = function() {
      terminal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      setFavicon(faviconCode);
      document.title = 'ramon@portfolio:~';

      // Restore previous session or show fresh MOTD
      if (!restoreSession()) {
        output.innerHTML = '';
        input.value = '';
        showMotd(function() { input.focus(); });
      } else {
        input.value = '';
        input.focus();
      }
    };

    window.closeTerminal = function() {
      saveSession();
      terminal.classList.remove('is-open');
      document.body.style.overflow = 'auto';
      document.documentElement.style.overflow = 'auto';
      input.blur();
      setFavicon(faviconNormal);
      document.title = 'Home \u26A1 Ramon Riera';
    };

  }
</script>
