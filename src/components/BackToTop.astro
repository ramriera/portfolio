---
// Floating "back to top" button — appears after scrolling down,
// smooth-scrolls to the top of the page. Present on every page via BaseLayout.
---

<button
  id="back-to-top"
  class="back-to-top"
  type="button"
  aria-label="Volver arriba"
  title="Volver arriba"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M12 19V5" class="btt-stroke" />
    <path d="M6 11L12 5L18 11" class="btt-stroke" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: #1a1a1a;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.04);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .back-to-top:hover {
    background: #D97757;
    transform: translateY(-2px) scale(1.05);
  }

  .back-to-top:active {
    transform: translateY(0) scale(0.95);
  }

  .btt-stroke {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* On desktop the "CODE" FAB sits at bottom-right — stack this above it */
  @media (min-width: 1024px) {
    .back-to-top {
      bottom: 5.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: opacity 0.2s ease;
      transform: none;
    }
    .back-to-top.is-visible {
      transform: none;
    }
    .back-to-top:hover {
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    const toggle = () => {
      if (window.scrollY > 400) {
        btn.classList.add('is-visible');
      } else {
        btn.classList.remove('is-visible');
      }
    };

    // Passive listener for smooth scroll performance
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();

    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
