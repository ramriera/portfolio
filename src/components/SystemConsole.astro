<!-- System Console — only visible in Code Mode -->
<div id="system-console" class="system-console">
  <div class="system-console-header">
    <div class="system-console-tabs">
      <span class="system-console-tab active">TERMINAL</span>
      <span class="system-console-tab">OUTPUT</span>
      <span class="system-console-tab">PROBLEMS</span>
    </div>
    <div class="system-console-actions">
      <button id="console-clear" class="system-console-action" aria-label="Clear console" title="Clear">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
      </button>
      <button id="console-toggle" class="system-console-action" aria-label="Toggle console" title="Toggle">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>
  </div>
  <div id="console-body" class="system-console-body">
    <div id="console-lines" class="system-console-lines"></div>
  </div>
</div>

<script>
  function initSystemConsole() {
    const consoleEl = document.getElementById('system-console');
    const body = document.getElementById('console-body');
    const lines = document.getElementById('console-lines');
    const clearBtn = document.getElementById('console-clear');
    const toggleBtn = document.getElementById('console-toggle');
    if (!consoleEl || !body || !lines) return;

    let isCollapsed = false;
    let lineCount = 0;
    const MAX_LINES = 80;

    // ── Helpers ──

    function timestamp(): string {
      const d = new Date();
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}:${String(d.getSeconds()).padStart(2, '0')}`;
    }

    type LogLevel = 'INFO' | 'SYSTEM' | 'INSPECT' | 'VIEW' | 'DEBUG' | 'WARN' | 'COFFEE' | 'READY';

    function log(level: LogLevel, message: string) {
      if (!document.body.classList.contains('code-mode')) return;
      if (!lines) return;

      const line = document.createElement('div');
      line.className = 'console-line';

      const ts = document.createElement('span');
      ts.className = 'console-ts';
      ts.textContent = `[${timestamp()}]`;

      const tag = document.createElement('span');
      tag.className = `console-tag console-tag--${level.toLowerCase()}`;
      tag.textContent = `[${level}]`;

      const msg = document.createElement('span');
      msg.className = 'console-msg';
      msg.textContent = ` ${message}`;

      line.appendChild(ts);
      line.appendChild(tag);
      line.appendChild(msg);
      lines.appendChild(line);

      lineCount++;
      // Prune old lines
      while (lineCount > MAX_LINES && lines.firstChild) {
        lines.removeChild(lines.firstChild);
        lineCount--;
      }

      // Auto-scroll
      body!.scrollTop = body!.scrollHeight;
    }

    // ── Expose global log function ──
    (window as any).__consoleLog = log;

    // ── Toggle / Clear ──

    toggleBtn?.addEventListener('click', () => {
      isCollapsed = !isCollapsed;
      consoleEl.classList.toggle('collapsed', isCollapsed);
      const svg = toggleBtn.querySelector('svg');
      if (svg) svg.style.transform = isCollapsed ? 'rotate(180deg)' : '';
    });

    clearBtn?.addEventListener('click', () => {
      if (lines) {
        lines.innerHTML = '';
        lineCount = 0;
      }
      log('SYSTEM', 'Console cleared.');
    });

    // ── Boot sequence ──

    function bootSequence() {
      const page = document.title.split(' - ')[0] || 'Portfolio';
      log('SYSTEM', 'Code Mode: ENABLED. Injecting Design Tokens...');

      setTimeout(() => log('INFO', `Initializing page: ${page}... Done.`), 400);
      setTimeout(() => {
        const componentCount = document.querySelectorAll('[data-component]').length;
        const tokenCount = document.querySelectorAll('[data-token]').length;
        log('INFO', `Scanned ${componentCount} components, ${tokenCount} token annotations.`);
      }, 900);
      setTimeout(() => log('READY', 'System console ready. Monitoring user events.'), 1400);
    }

    // ── Code Mode toggle listener ──

    const codeToggle = document.getElementById('code-mode-toggle');
    codeToggle?.addEventListener('click', () => {
      // Small delay to let code-mode class toggle
      setTimeout(() => {
        if (document.body.classList.contains('code-mode')) {
          bootSequence();
        } else {
          log('SYSTEM', 'Code Mode: DISABLED. Tokens retracted.');
        }
      }, 50);
    });

    // Boot if already in code mode
    if (document.body.classList.contains('code-mode')) {
      bootSequence();
    }

    // ── Scroll tracking — log sections entering viewport ──

    const sectionObserverMap = new WeakSet<Element>();
    const sectionNames: Map<Element, string> = new Map();

    function setupScrollTracking() {
      const sections = document.querySelectorAll('section[data-component], section .container-custom > [data-component]');
      const headings = document.querySelectorAll('h1, h2');

      // Map sections to readable names
      headings.forEach(h => {
        const section = h.closest('section');
        if (section && !sectionNames.has(section)) {
          const text = (h as HTMLElement).textContent?.trim().replace(/\|$/, '').trim() || '';
          if (text) sectionNames.set(section, text);
        }
      });

      const scrollObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            if (!document.body.classList.contains('code-mode')) return;
            if (sectionObserverMap.has(entry.target)) return;
            sectionObserverMap.add(entry.target);

            const name = sectionNames.get(entry.target)
              || (entry.target as HTMLElement).getAttribute('data-component')
              || 'Unknown Section';
            log('VIEW', `Section "${name}" in viewport.`);
          });
        },
        { threshold: 0.2 }
      );

      document.querySelectorAll('section').forEach(s => scrollObserver.observe(s));
    }

    setupScrollTracking();

    // ── Inspector hover tracking ──

    function setupInspectorTracking() {
      const inspectables = document.querySelectorAll<HTMLElement>('[data-component]');
      inspectables.forEach(el => {
        el.addEventListener('mouseenter', () => {
          if (!document.body.classList.contains('code-mode')) return;
          const name = el.getAttribute('data-component');
          if (name) {
            log('INSPECT', `<${name} /> selected. Reading tokens...`);
          }
        });
      });
    }

    setupInspectorTracking();

    // ── Witty periodic logs ──

    const wittyMessages: [LogLevel, string][] = [
      ['DEBUG', 'Pixel perfection check: 100% accurate.'],
      ['COFFEE', 'User energy level: Low. Suggesting more espresso.'],
      ['DEBUG', 'Design system integrity: Nominal.'],
      ['DEBUG', 'Checking border-radius consistency... All round. Literally.'],
      ['INFO', 'Tailwind classes optimized. Zero unused utilities detected.'],
      ['DEBUG', 'Searching for missing semicolons... None found. Impressive.'],
      ['COFFEE', 'Caffeine levels optimal. Creativity at 110%.'],
      ['DEBUG', 'Running accessibility audit... All contrast ratios pass.'],
      ['DEBUG', 'Fonts loaded: Inter, JetBrains Mono, Space Grotesk. Looking sharp.'],
      ['INFO', 'No console.log() statements detected in production. Good job.'],
      ['DEBUG', 'Dark mode? Removed. We live in the light now.'],
      ['COFFEE', 'Espresso machine API: 200 OK.'],
    ];

    let wittyIndex = 0;
    let wittyInterval: ReturnType<typeof setInterval> | null = null;

    function startWittyLogs() {
      if (wittyInterval) return;
      wittyInterval = setInterval(() => {
        if (!document.body.classList.contains('code-mode')) return;
        const [level, msg] = wittyMessages[wittyIndex % wittyMessages.length];
        log(level, msg);
        wittyIndex++;
      }, 12000 + Math.random() * 8000); // Every 12-20 seconds
    }

    function stopWittyLogs() {
      if (wittyInterval) {
        clearInterval(wittyInterval);
        wittyInterval = null;
      }
    }

    // Start if already in code mode
    if (document.body.classList.contains('code-mode')) {
      startWittyLogs();
    }

    codeToggle?.addEventListener('click', () => {
      setTimeout(() => {
        if (document.body.classList.contains('code-mode')) {
          startWittyLogs();
        } else {
          stopWittyLogs();
        }
      }, 50);
    });

    // ── Navigation tracking ──

    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('code-mode')) return;
      const link = (e.target as HTMLElement).closest('a[href]');
      if (link && !link.closest('#system-console')) {
        const href = link.getAttribute('href');
        if (href && href.startsWith('/')) {
          log('INFO', `Navigating to ${href}...`);
        }
      }
    });
  }

  initSystemConsole();
  document.addEventListener('astro:page-load', initSystemConsole);
</script>
