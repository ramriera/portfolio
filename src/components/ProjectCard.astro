---
import { Image } from 'astro:assets';
import { resolveImage } from '@/utils/images';

interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
  brandColor?: string;
  gridSpan?: 3 | 2;
  variant?: 'default' | 'hero';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'auto' | 'high' | 'low';
  index?: number;
}

const { slug, title, category, cover, brandColor, variant = 'default', loading = 'lazy', fetchpriority = 'auto', index } = Astro.props;
const coverImage = resolveImage(cover);
const indexLabel = typeof index === 'number' ? String(index).padStart(2, '0') : null;
---

<a
  href={`/projects/${slug}`}
  class:list={['proj-card', `proj-card--${variant}`, 'group']}
  data-component="ProjectCard"
  data-slug={slug}
>
  <div class="proj-card-media" style={brandColor ? `background-color: ${brandColor}` : ''}>
    {coverImage ? (
      <Image
        src={coverImage}
        alt={title}
        class="proj-card-img"
        loading={loading}
        decoding={loading === 'eager' ? 'sync' : 'async'}
        fetchpriority={fetchpriority}
        widths={[600, 1000, 1600]}
        sizes={variant === 'hero' ? '100vw' : '(max-width: 768px) 100vw, 50vw'}
      />
    ) : (
      <img src={cover} alt={title} class="proj-card-img" loading={loading} decoding="async" />
    )}

    <div class="proj-card-scrim" aria-hidden="true"></div>

    <div class="proj-card-overlay">
      <div class="proj-card-top">
        {indexLabel && <span class="proj-card-index">{indexLabel}</span>}
        <span class="proj-card-cat">{category}</span>
      </div>
      <div class="proj-card-foot">
        <h3 class="proj-card-title">{title}</h3>
        <span class="proj-card-cta">
          Explora el proyecto
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  .proj-card {
    display: block;
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    isolation: isolate;
  }

  .proj-card-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
  }
  .proj-card--hero .proj-card-media {
    aspect-ratio: 16 / 8;
  }
  @media (max-width: 640px) {
    .proj-card--hero .proj-card-media { aspect-ratio: 4 / 3; }
  }

  .proj-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .proj-card:hover .proj-card-img { transform: scale(1.04); }

  /* Legibility scrims — subtle top + stronger bottom */
  .proj-card-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0,0,0,0.28) 0%, rgba(0,0,0,0) 22%),
      linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.12) 38%, rgba(0,0,0,0) 62%);
    transition: opacity 0.4s ease;
    opacity: 0.9;
  }
  .proj-card:hover .proj-card-scrim { opacity: 1; }

  .proj-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem 1.4rem;
    color: #fff;
  }
  .proj-card--hero .proj-card-overlay { padding: 1.75rem 2rem; }

  .proj-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .proj-card-index { color: rgba(255,255,255,0.92); }
  .proj-card-cat { color: rgba(255,255,255,0.78); }

  .proj-card-foot { display: flex; flex-direction: column; gap: 0.4rem; }
  .proj-card-title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 1px 20px rgba(0,0,0,0.35);
  }
  .proj-card--hero .proj-card-title { font-size: clamp(1.75rem, 3.5vw, 2.75rem); }

  .proj-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s var(--ease-out-expo), gap 0.2s ease;
  }
  .proj-card:hover .proj-card-cta { opacity: 1; transform: translateY(0); }
  .proj-card:hover .proj-card-cta { gap: 0.7rem; }

  /* Touch devices: keep the CTA visible (no hover) */
  @media (hover: none) {
    .proj-card-cta { opacity: 1; transform: none; }
  }
</style>
