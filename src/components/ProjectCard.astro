---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
}

const { slug, title, client, year, category, tags, description, cover, featured } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class:list={[
    'project-card group relative block rounded-2xl overflow-hidden card-hover',
    featured ? 'lg:col-span-2' : '',
  ]}
>
  <!-- Full-size image background -->
  <div class="relative aspect-[16/12]">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover grayscale transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105"
      loading="lazy"
    />

    <!-- Permanent dark gradient at bottom for readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900/90 via-dark-900/30 to-transparent"></div>

    <!-- Hover overlay for extra info -->
    <div class="absolute inset-0 bg-dark-900/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

    <!-- Year badge — always visible -->
    <div class="absolute top-4 right-4">
      <span class="px-3 py-1.5 text-xs font-medium rounded-full bg-white/15 backdrop-blur-sm text-white/80">
        {year}
      </span>
    </div>

    <!-- Bottom content — always visible: title + tags -->
    <div class="absolute bottom-0 left-0 right-0 p-6">
      <!-- Extra info — only on hover -->
      <div class="overflow-hidden transition-all duration-500 ease-out-expo max-h-0 opacity-0 group-hover:max-h-40 group-hover:opacity-100">
        <span class="text-xs font-medium text-primary-400 uppercase tracking-wider">{client}</span>
        <p class="text-sm text-dark-300 line-clamp-2 mt-2 mb-4">
          {description}
        </p>
      </div>

      <!-- Title — always visible -->
      <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-white mb-3 group-hover:text-primary-400 transition-colors duration-300">
        {title}
      </h3>

      <!-- Tags — always visible -->
      <div class="flex flex-wrap gap-2">
        {tags.slice(0, 3).map((tag) => (
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-white/10 backdrop-blur-sm text-white/80">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Arrow indicator — hover only -->
    <div class="absolute top-4 left-4 w-10 h-10 rounded-full bg-primary-500 flex items-center justify-center text-white transform -translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out-expo">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>
