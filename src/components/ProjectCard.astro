---
import { Image } from 'astro:assets';
import { resolveImage } from '@/utils/images';

interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
  brandColor?: string;
  gridSpan?: 3 | 2;
  variant?: 'default' | 'featured' | 'tall';
}

const { slug, title, client, year, category, tags, description, cover, featured, brandColor, gridSpan = 2, variant = 'default' } = Astro.props;
const isWide = gridSpan === 3;
const coverImage = resolveImage(cover);
---

<a
  href={`/projects/${slug}`}
  class="project-card group block cursor-pointer"
  data-component="ProjectCard"
  data-slug={slug}
  data-token="$radius-2xl: 1rem / 16px|$spacing-gap: 1rem → 1.5rem"
>
  <!-- Image container -->
  <div>
    <div
      class="card-image-wrap relative overflow-hidden rounded-2xl border border-neutral-200 aspect-video"
      style={brandColor ? `background-color: ${brandColor}` : ''}
    >
      {coverImage ? (
        <Image
          src={coverImage}
          alt={title}
          class="card-mockup w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          data-token="$object-fit: cover"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 600px"
        />
      ) : (
        <img
          src={cover}
          alt={title}
          class="card-mockup w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          data-token="$object-fit: cover"
        />
      )}
    </div>
  </div>

  <!-- Text content -->
  <div class="mt-5 md:mt-6">
    <h3 class:list={[
        'font-bold tracking-tight text-neutral-900 group-hover:text-primary-600 transition-colors duration-300',
        isWide ? 'text-xl md:text-2xl' : 'text-lg md:text-xl',
      ]}
      data-token="$font-weight: 700 (bold)|$color-text: neutral-900|$color-hover: primary-600">
      {title}
    </h3>

    <p class="mt-2.5 text-sm md:text-base leading-relaxed text-neutral-400 line-clamp-2"
      data-token="$font-size: 0.875rem → 1rem (md)|$color-text-muted: neutral-400|$line-height: relaxed">
      {description}
    </p>

    <div class="flex flex-wrap items-center gap-2.5 mt-5" data-component="TagGroup" data-token="$spacing-gap: 0.625rem / 10px">
      {tags.slice(0, 3).map((tag) => (
        <span class="card-tag">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>

<style>
  .project-card {
    transition: opacity 0.3s ease;
  }

  .card-image-wrap {
    transition: box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-image-wrap {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  .card-mockup {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.5s ease;
  }

  .project-card:hover .card-mockup {
    transform: scale(1.05);
  }

  .card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.03);
    color: theme('colors.neutral.400');
    white-space: nowrap;
    transition: background 0.25s ease,
                color 0.25s ease;
  }

  .project-card:hover .card-tag {
    background: rgba(0, 0, 0, 0.05);
    color: theme('colors.neutral.500');
  }
</style>
