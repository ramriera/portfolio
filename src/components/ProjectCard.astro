---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
}

const { slug, title, client, year, category, tags, description, cover, featured } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class:list={[
    'project-card group relative block rounded-2xl overflow-hidden cursor-pointer',
    featured ? 'lg:col-span-2' : '',
  ]}
>
  <div class="relative aspect-[3/2]">
    <!-- Image mockup -->
    <img
      src={cover}
      alt={title}
      class="card-mockup w-full h-full object-cover"
      loading="lazy"
    />

    <!-- Gradient overlay -->
    <div class="card-gradient absolute inset-0"></div>

    <!-- Inset shadow for depth -->
    <div class="absolute inset-0 rounded-2xl card-inset-shadow pointer-events-none"></div>

    <!-- Bottom content -->
    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
      <!-- Title -->
      <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-white mb-2">
        {title}
      </h3>

      <!-- Description -->
      <p class="card-description text-sm leading-relaxed mb-4 line-clamp-2">
        {description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap items-center gap-2">
        {tags.slice(0, 4).map((tag) => (
          <span class="card-tag">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  /* Card base */
  .project-card {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover {
    transform: scale(1.02);
  }

  /* Gradient background */
  .card-gradient {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.6) 40%,
      rgba(0, 0, 0, 0.15) 70%,
      rgba(0, 0, 0, 0.05) 100%
    );
    transition: background 0.4s ease;
  }

  .project-card:hover .card-gradient {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.65) 40%,
      rgba(0, 0, 0, 0.2) 70%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  /* Inset shadow for depth/relief */
  .card-inset-shadow {
    box-shadow: inset 0 2px 20px rgba(0, 0, 0, 0.3),
                inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Image/Mockup */
  .card-mockup {
    filter: saturate(1.1) brightness(1.05);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.5s ease;
  }

  .project-card:hover .card-mockup {
    transform: translateY(-5px) scale(1.02);
    filter: saturate(1.25) brightness(1.1);
  }

  /* Description text */
  .card-description {
    color: #F8FAFC;
    line-height: 1.6;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .card-description {
    opacity: 1;
  }

  /* Tags */
  .card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(4px);
    white-space: nowrap;
    transition: background 0.25s ease,
                color 0.25s ease,
                border-color 0.25s ease;
  }

  .card-tag:hover {
    background: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.95);
    border-color: rgba(255, 255, 255, 0.15);
  }
</style>
