---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
  brandColor?: string;
  gridSpan?: 3 | 2;
  variant?: 'default' | 'featured' | 'tall';
}

const { slug, title, client, year, category, tags, description, cover, featured, brandColor, gridSpan = 2, variant = 'default' } = Astro.props;
const isWide = gridSpan === 3;
---

<a
  href={`/projects/${slug}`}
  class="project-card group block cursor-pointer"
  data-component="ProjectCard"
  data-token="$radius-2xl: 1rem / 16px|$spacing-gap: 1rem → 1.5rem"
>
  <!-- Image container -->
  <div
    class="card-image-wrap relative overflow-hidden rounded-2xl"
    style={brandColor ? `background-color: ${brandColor}` : ''}
  >
    <img
      src={cover}
      alt={title}
      class="card-mockup w-full h-full object-cover"
      loading="lazy"
      data-token="$object-fit: cover"
    />
  </div>

  <!-- Text content — outside the image -->
  <div class="mt-4 md:mt-5">
    <h3 class:list={[
        'font-bold tracking-tight text-dark-900 group-hover:text-primary-600 transition-colors duration-300',
        isWide ? 'text-xl md:text-2xl' : 'text-lg md:text-xl',
      ]}
      data-token="$font-weight: 700 (bold)|$color-text: #1a1918|$color-hover: #c4613f">
      {title}
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-dark-500 line-clamp-2"
      data-token="$font-size-sm: 0.875rem / 14px|$color-text-muted: #7c766c|$line-height: 1.6">
      {description}
    </p>

    <div class="flex flex-wrap items-center gap-2 mt-3" data-component="TagGroup" data-token="$spacing-gap: 0.5rem / 8px">
      {tags.slice(0, 3).map((tag) => (
        <span class="card-tag">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>

<style>
  /* Card base — no outer shadow/border, breathes with whitespace */
  .project-card {
    transition: opacity 0.3s ease;
  }

  /* Image wrapper */
  .card-image-wrap {
    transition: box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-image-wrap {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  /* Image — only the image scales on hover */
  .card-mockup {
    filter: saturate(1.05) brightness(1.02);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.5s ease;
  }

  .project-card:hover .card-mockup {
    transform: scale(1.05);
    filter: saturate(1.15) brightness(1.05);
  }

  /* Tags — clean, muted style */
  .card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.625rem;
    font-size: 0.7rem;
    font-weight: 500;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.06);
    color: rgba(0, 0, 0, 0.5);
    white-space: nowrap;
    transition: background 0.25s ease,
                color 0.25s ease;
  }

  .project-card:hover .card-tag {
    background: rgba(0, 0, 0, 0.06);
    color: rgba(0, 0, 0, 0.65);
  }
</style>
