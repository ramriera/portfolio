---
import { Image } from 'astro:assets';
import { resolveImage } from '@/utils/images';

interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
  brandColor?: string;
  gridSpan?: 3 | 2;
  variant?: 'default' | 'featured' | 'tall';
}

const { slug, title, client, year, category, tags, description, cover, featured, brandColor, gridSpan = 2, variant = 'default' } = Astro.props;
const isWide = gridSpan === 3;
const coverImage = resolveImage(cover);

// IDE mode: generate a PascalCase filename from slug
const fileName = slug
  .split('-')
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join('') + '.tsx';

// Line numbers for the code block
const codeLines = [
  { num: 1, tokens: [{ type: 'keyword', text: 'const' }, { type: 'plain', text: ' ' }, { type: 'constant', text: 'project' }, { type: 'plain', text: ' ' }, { type: 'punct', text: '=' }, { type: 'plain', text: ' ' }, { type: 'punct', text: '{' }] },
  { num: 2, tokens: [{ type: 'key', text: '  client' }, { type: 'punct', text: ':' }, { type: 'plain', text: ' ' }, { type: 'string', text: `"${client}"` }, { type: 'punct', text: ',' }] },
  { num: 3, tokens: [{ type: 'key', text: '  year' }, { type: 'punct', text: ':' }, { type: 'plain', text: ' ' }, { type: 'number', text: year }, { type: 'punct', text: ',' }] },
  { num: 4, tokens: [{ type: 'key', text: '  category' }, { type: 'punct', text: ':' }, { type: 'plain', text: ' ' }, { type: 'string', text: `"${category}"` }, { type: 'punct', text: ',' }] },
  { num: 5, tokens: [{ type: 'key', text: '  tags' }, { type: 'punct', text: ':' }, { type: 'plain', text: ' ' }, { type: 'punct', text: '[' }, ...tags.slice(0, 3).flatMap((t, i) => [
    ...(i > 0 ? [{ type: 'punct' as const, text: ', ' }] : []),
    { type: 'string' as const, text: `"${t}"` }
  ]), { type: 'punct', text: ']' }, { type: 'punct', text: ',' }] },
  { num: 6, tokens: [{ type: 'key', text: '  brief' }, { type: 'punct', text: ':' }, { type: 'plain', text: ' ' }, { type: 'keyword', text: '()' }, { type: 'plain', text: ' ' }, { type: 'keyword', text: '=>' }, { type: 'plain', text: ' ' }, { type: 'punct', text: '{' }] },
  { num: 7, tokens: [{ type: 'comment', text: `    /* ${description.slice(0, 56)}${description.length > 56 ? '…' : ''} */` }] },
  { num: 8, tokens: [{ type: 'plain', text: '  ' }, { type: 'punct', text: '}' }, { type: 'punct', text: ',' }] },
  { num: 9, tokens: [{ type: 'punct', text: '}' }, { type: 'punct', text: ';' }] },
];
---

<a
  href={`/projects/${slug}`}
  class="project-card group block cursor-pointer"
  data-component="ProjectCard"
  data-slug={slug}
  data-token="$radius-2xl: 1rem / 16px|$spacing-gap: 1rem → 1.5rem"
>
  <!-- ═══ IDE Tab Bar (code-mode only) ═══ -->
  <div class="ide-tab-bar">
    <div class="ide-tab">
      <svg class="ide-tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
      </svg>
      <span class="ide-tab-name">{fileName}</span>
      <span class="ide-tab-modified" title="Modified"></span>
      <span class="ide-tab-close" aria-hidden="true">×</span>
    </div>
  </div>

  <!-- ═══ Image container ═══ -->
  <div class="ide-preview-wrap">
    <div
      class="card-image-wrap relative overflow-hidden rounded-2xl border border-neutral-200 aspect-video"
      style={brandColor ? `background-color: ${brandColor}` : ''}
    >
      {coverImage ? (
        <Image
          src={coverImage}
          alt={title}
          class="card-mockup w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          data-token="$object-fit: cover"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 600px"
        />
      ) : (
        <img
          src={cover}
          alt={title}
          class="card-mockup w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          data-token="$object-fit: cover"
        />
      )}
      <!-- Grid overlay for IDE preview (code-mode only) -->
      <div class="ide-grid-overlay" aria-hidden="true"></div>
      <!-- Scan line effect on hover (code-mode only) -->
      <div class="ide-scanline" aria-hidden="true"></div>
    </div>
  </div>

  <!-- ═══ Design Mode: normal text content ═══ -->
  <div class="mt-5 md:mt-6 ide-design-content">
    <h3 class:list={[
        'font-bold tracking-tight text-neutral-900 group-hover:text-primary-600 transition-colors duration-300',
        isWide ? 'text-xl md:text-2xl' : 'text-lg md:text-xl',
      ]}
      data-token="$font-weight: 700 (bold)|$color-text: neutral-900|$color-hover: primary-600">
      {title}
    </h3>

    <p class="mt-2.5 text-sm md:text-base leading-relaxed text-neutral-400 line-clamp-2"
      data-token="$font-size: 0.875rem → 1rem (md)|$color-text-muted: neutral-400|$line-height: relaxed">
      {description}
    </p>

    <div class="flex flex-wrap items-center gap-2.5 mt-5" data-component="TagGroup" data-token="$spacing-gap: 0.625rem / 10px">
      {tags.slice(0, 3).map((tag) => (
        <span class="card-tag">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <!-- ═══ Code Mode: TypeScript schema view ═══ -->
  <div class="ide-code-content">
    <div class="ide-code-block">
      {codeLines.map((line) => (
        <div class="ide-line" data-line={line.num}>
          <span class="ide-gutter">{line.num}</span>
          <span class="ide-code">
            {line.tokens.map((tok) => (
              <span class={`ide-tok-${tok.type}`}>{tok.text}</span>
            ))}
          </span>
        </div>
      ))}
    </div>

    <!-- Terminal log footer — navigable command line -->
    <div class="ide-terminal" data-slug={slug}>
      <span class="ide-gutter ide-terminal-gutter">10</span>
      <span class="ide-terminal-code">
        <span class="ide-cmd-prompt">&gt;</span> <span class="ide-cmd-text">open</span> <span class="ide-cmd-file">{fileName.replace('.tsx', '')}</span><span class="ide-cmd-cursor">_</span>
      </span>
    </div>
  </div>
</a>

<style>
  /* ═══════════════════════════════════════
     DESIGN MODE (default)
     ═══════════════════════════════════════ */

  .project-card {
    transition: opacity 0.3s ease;
  }

  .card-image-wrap {
    transition: box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-image-wrap {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  .card-mockup {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.5s ease;
  }

  .project-card:hover .card-mockup {
    transform: scale(1.05);
  }

  .card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.03);
    color: theme('colors.neutral.400');
    white-space: nowrap;
    transition: background 0.25s ease,
                color 0.25s ease;
  }

  .project-card:hover .card-tag {
    background: rgba(0, 0, 0, 0.05);
    color: theme('colors.neutral.500');
  }

  /* Hidden in design mode */
  .ide-tab-bar,
  .ide-code-content,
  .ide-grid-overlay,
  .ide-scanline {
    display: none;
  }

  /* ═══════════════════════════════════════
     CODE MODE — IDE transformation
     ═══════════════════════════════════════ */

  /* ── Tab bar ── */
  :global(.code-mode) .ide-tab-bar {
    display: flex;
    align-items: center;
    height: 34px;
    background: var(--cm-bg-surface);
    border: 1px solid var(--cm-border);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    padding: 0 4px;
    overflow: hidden;
  }

  :global(.code-mode) .ide-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    padding: 0 12px;
    background: var(--cm-bg-card);
    border-right: 1px solid var(--cm-border);
    font-family: theme('fontFamily.mono');
    font-size: 0.72rem;
    color: var(--cm-text-secondary);
    white-space: nowrap;
    position: relative;
  }

  /* Active tab indicator — top border glow */
  :global(.code-mode) .ide-tab::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cm-function);
    opacity: 0.8;
  }

  :global(.code-mode) .ide-tab-icon {
    width: 12px;
    height: 12px;
    color: var(--cm-function);
    flex-shrink: 0;
  }

  :global(.code-mode) .ide-tab-name {
    color: var(--cm-text);
  }

  :global(.code-mode) .ide-tab-modified {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cm-bg-hover);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  :global(.code-mode) .project-card:hover .ide-tab-modified {
    background: var(--cm-string);
    box-shadow: 0 0 6px rgba(80, 250, 123, 0.5);
  }

  :global(.code-mode) .ide-tab-close {
    font-size: 0.85rem;
    color: var(--cm-text-muted);
    opacity: 0;
    transition: opacity 0.2s ease;
    margin-left: 2px;
  }

  :global(.code-mode) .project-card:hover .ide-tab-close {
    opacity: 0.7;
  }

  /* ── Image container in code mode — Preview panel ── */
  :global(.code-mode) .ide-preview-wrap .card-image-wrap {
    border-radius: 0;
    border: 1px solid var(--cm-border);
    border-top: none;
  }

  :global(.code-mode) .ide-grid-overlay {
    display: block;
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(139, 233, 253, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 233, 253, 0.04) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 2;
  }

  :global(.code-mode) .ide-scanline {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(139, 233, 253, 0.3) 20%,
      rgba(139, 233, 253, 0.6) 50%,
      rgba(139, 233, 253, 0.3) 80%,
      transparent
    );
    box-shadow: 0 0 12px rgba(139, 233, 253, 0.3);
    pointer-events: none;
    z-index: 3;
    opacity: 0;
    top: 0;
    transition: opacity 0.3s ease;
  }

  :global(.code-mode) .project-card:hover .ide-scanline {
    opacity: 1;
    animation: ide-scan 2.5s ease-in-out infinite;
  }

  /* ── Code block (replaces text content) ── */
  :global(.code-mode) .ide-design-content {
    display: none;
  }

  :global(.code-mode) .ide-code-content {
    display: block;
    background: var(--cm-bg-card);
    border: 1px solid var(--cm-border);
    border-top: none;
    padding: 12px 0 0 0;
    font-family: theme('fontFamily.mono');
    font-size: 0.73rem;
    line-height: 1.7;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :global(.code-mode) .project-card:hover .ide-code-content {
    border-color: rgba(139, 233, 253, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3), 0 0 30px rgba(139, 233, 253, 0.03);
  }

  :global(.code-mode) .ide-code-block {
    padding: 0 14px 10px 0;
  }

  /* ── Line + Gutter ── */
  :global(.code-mode) .ide-line {
    display: flex;
    align-items: baseline;
    padding: 0 0 0 0;
    border-radius: 0;
    position: relative;
    transition: background 0.15s ease;
  }

  :global(.code-mode) .ide-line:hover {
    background: var(--cm-bg-hover);
  }

  /* Active line indicator — left bar (VS Code style) */
  :global(.code-mode) .ide-line::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    width: 2px;
    background: transparent;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.code-mode) .ide-line:hover::before {
    background: var(--cm-function);
    box-shadow: 0 0 6px rgba(139, 233, 253, 0.4);
  }

  :global(.code-mode) .ide-gutter {
    display: inline-block;
    width: 36px;
    text-align: right;
    padding-right: 12px;
    color: var(--cm-text-muted);
    opacity: 0.3;
    user-select: none;
    flex-shrink: 0;
    font-size: inherit;
    line-height: inherit;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  :global(.code-mode) .ide-line:hover .ide-gutter {
    color: var(--cm-function);
    opacity: 0.9;
  }

  :global(.code-mode) .ide-code {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Syntax tokens ── */
  :global(.code-mode) .ide-tok-keyword  { color: var(--cm-keyword); }
  :global(.code-mode) .ide-tok-constant { color: var(--cm-constant, #f1fa8c); }
  :global(.code-mode) .ide-tok-string   { color: var(--cm-string); }
  :global(.code-mode) .ide-tok-number   { color: var(--cm-attr); }
  :global(.code-mode) .ide-tok-key      { color: var(--cm-function); }
  :global(.code-mode) .ide-tok-punct    { color: var(--cm-text-muted); }
  :global(.code-mode) .ide-tok-comment  { color: var(--cm-comment); font-style: italic; opacity: 0.5; }
  :global(.code-mode) .ide-tok-plain    { color: var(--cm-text-secondary); }

  /* ── Terminal footer — command line style ── */
  :global(.code-mode) .ide-terminal {
    display: flex;
    align-items: baseline;
    white-space: nowrap;
    border-top: 1px solid var(--cm-border);
    font-family: theme('fontFamily.mono');
    font-size: 0.73rem;
    line-height: 1.7;
    color: var(--cm-text-muted);
    border-radius: 0 0 8px 8px;
    overflow: hidden;
    position: relative;
    transition: background 0.15s ease;
  }

  :global(.code-mode) .ide-terminal:hover {
    background: var(--cm-bg-hover);
  }

  :global(.code-mode) .ide-terminal::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2px;
    bottom: 2px;
    width: 2px;
    background: transparent;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.code-mode) .ide-terminal:hover::before {
    background: var(--cm-string, #50fa7b);
    box-shadow: 0 0 6px rgba(80, 250, 123, 0.4);
  }

  :global(.code-mode) .ide-terminal-gutter {
    opacity: 0.3;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  :global(.code-mode) .ide-terminal:hover .ide-terminal-gutter {
    color: var(--cm-string, #50fa7b);
    opacity: 1;
  }

  :global(.code-mode) .ide-terminal-code {
    flex: 1;
    min-width: 0;
  }

  :global(.code-mode) .ide-cmd-prompt {
    color: var(--cm-text-muted, #7d8590);
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }

  :global(.code-mode) .ide-terminal:hover .ide-cmd-prompt {
    color: var(--cm-function, #8be9fd);
    text-shadow: 0 0 8px rgba(139, 233, 253, 0.3);
  }

  :global(.code-mode) .ide-cmd-text {
    color: var(--cm-keyword, #bd93f9);
  }

  :global(.code-mode) .ide-cmd-file {
    color: var(--cm-string, #50fa7b);
    transition: text-shadow 0.15s ease;
  }

  :global(.code-mode) .ide-terminal:hover .ide-cmd-file {
    text-shadow: 0 0 8px rgba(80, 250, 123, 0.25);
  }

  :global(.code-mode) .ide-cmd-cursor {
    color: var(--cm-string, #50fa7b);
    animation: ide-blink 1s step-end infinite;
    font-weight: 700;
    margin-left: 1px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  :global(.code-mode) .ide-terminal:hover .ide-cmd-cursor {
    opacity: 1;
  }

  /* ── Card border in code mode ── */
  :global(.code-mode) .project-card {
    border: 1px solid transparent;
    border-radius: 8px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  :global(.code-mode) .project-card:hover {
    border-color: rgba(139, 233, 253, 0.25);
    box-shadow: 0 0 25px rgba(139, 233, 253, 0.04);
  }

  /* Disable design mode hover effects in code mode */
  :global(.code-mode) .project-card:hover .card-image-wrap {
    box-shadow: none;
  }

  :global(.code-mode) .project-card:hover .card-mockup {
    transform: none;
  }

  /* ── Animations ── */
  @keyframes ide-scan {
    0%   { top: 0%; }
    50%  { top: calc(100% - 2px); }
    100% { top: 0%; }
  }

  @keyframes ide-blink {
    0%, 100% { opacity: 0.8; }
    50%      { opacity: 0; }
  }
</style>

<script>
  // Terminal log interaction — update on click
  document.querySelectorAll<HTMLElement>('.ide-terminal').forEach((terminal) => {
    const card = terminal.closest('.project-card') as HTMLAnchorElement | null;
    if (!card) return;

    const slug = terminal.dataset.slug || '';
    const codeEl = terminal.querySelector('.ide-terminal-code');
    if (!codeEl) return;

    card.addEventListener('mousedown', () => {
      codeEl.innerHTML =
        `<span class="ide-cmd-prompt">&gt;</span> <span class="ide-cmd-text">navigating</span> <span class="ide-cmd-file">/projects/${slug}</span><span class="ide-cmd-cursor">_</span>`;
    });
  });
</script>
