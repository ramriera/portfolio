---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
}

const { slug, title, client, year, category, tags, description, cover, featured } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class:list={[
    'project-card group relative block rounded-2xl overflow-hidden',
    featured ? 'lg:col-span-2' : '',
  ]}
>
  <div class="relative aspect-[16/10]">
    <img
      src={cover}
      alt={title}
      class="w-full h-full object-cover grayscale transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-105"
      loading="lazy"
    />

    <!-- Permanent dark gradient at bottom -->
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900/90 via-dark-900/30 to-transparent"></div>

    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-dark-900/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

    <!-- Year badge -->
    <div class="absolute top-4 right-4">
      <span class="px-3 py-1.5 text-xs font-medium rounded-full bg-white/15 backdrop-blur-sm text-white/80">
        {year}
      </span>
    </div>

    <!-- Bottom content -->
    <div class="absolute bottom-0 left-0 right-0 p-6">
      <!-- Client — slides UP above title on hover -->
      <div class="card-client-reveal">
        <span class="text-xs font-medium text-primary-400 uppercase tracking-wider">{client}</span>
      </div>

      <!-- Title — always visible, sits between client (above) and description (below) -->
      <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-white mb-1 group-hover:text-primary-400 transition-colors duration-300">
        {title}
      </h3>

      <!-- Description — slides DOWN below title on hover -->
      <div class="card-desc-reveal">
        <p class="text-sm text-dark-300 line-clamp-2">
          {description}
        </p>
      </div>

      <!-- Spacer -->
      <div class="h-3"></div>

      <!-- Tags — first always visible, rest slide in from right on hover -->
      <div class="flex items-center gap-2 overflow-hidden">
        {tags.slice(0, 3).map((tag, i) => (
          <span
            class:list={[
              'inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-white/10 backdrop-blur-sm text-white/80 transition-all duration-300 group-hover:bg-primary-500/20 group-hover:text-primary-400 whitespace-nowrap flex-shrink-0',
              i > 0 ? 'card-tag-hidden' : '',
            ]}
            style={i > 0 ? `transition-delay: ${i * 60}ms` : ''}
          >
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Arrow indicator — bottom right, no background -->
    <div class="absolute bottom-6 right-6 text-white/60 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 group-hover:text-primary-400 transition-all duration-500 ease-out-expo">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>

<style>
  /* Client name — slides up from behind title */
  .card-client-reveal {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(6px);
    transition:
      max-height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .group:hover .card-client-reveal {
    max-height: 2rem;
    opacity: 1;
    transform: translateY(0);
  }

  /* Description — slides down from behind title */
  .card-desc-reveal {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-6px);
    transition:
      max-height 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.05s,
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.08s,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
  }

  .group:hover .card-desc-reveal {
    max-height: 5rem;
    opacity: 1;
    transform: translateY(0);
  }

  /* Tags — hidden ones slide in from right */
  .card-tag-hidden {
    max-width: 0;
    opacity: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: -0.5rem;
    transition:
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .group:hover .card-tag-hidden {
    max-width: 12rem;
    opacity: 1;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    margin-left: 0;
  }

  /* Card lift on hover */
  .project-card {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover {
    transform: translateY(-4px);
  }
</style>
