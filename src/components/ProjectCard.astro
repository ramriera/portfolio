---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
  brandColor?: string;
  gridSpan?: 3 | 2;
  variant?: 'default' | 'featured' | 'tall';
}

const { slug, title, client, year, category, tags, description, cover, featured, brandColor, gridSpan = 2, variant = 'default' } = Astro.props;
const isWide = gridSpan === 3;
---

<a
  href={`/projects/${slug}`}
  class="project-card group block cursor-pointer"
  data-component="ProjectCard"
  data-token="$radius-2xl: 1rem / 16px|$spacing-gap: 1rem → 1.5rem"
>
  <!-- Image container -->
  <div
    class:list={['card-image-wrap relative overflow-hidden rounded-2xl', slug === 'massimo-dutti-conversion' && 'card-image-wrap--editorial']}
    style={brandColor ? `background-color: ${brandColor}` : ''}
  >
    <img
      src={cover}
      alt={title}
      class:list={['card-mockup w-full h-full object-cover', slug === 'massimo-dutti-conversion' && 'card-mockup--elevated']}
      loading="lazy"
      data-token="$object-fit: cover"
    />
  </div>

  <!-- Text content — outside the image -->
  <div class="mt-5 md:mt-6">
    <h3 class:list={[
        'font-bold tracking-tight text-dark-900 group-hover:text-primary-600 transition-colors duration-300',
        isWide ? 'text-xl md:text-2xl' : 'text-lg md:text-xl',
      ]}
      data-token="$font-weight: 700 (bold)|$color-text: dark-900|$color-hover: primary-600">
      {title}
    </h3>

    <p class="mt-2.5 text-sm md:text-base leading-relaxed text-dark-400 line-clamp-2"
      data-token="$font-size: 0.875rem → 1rem (md)|$color-text-muted: dark-400|$line-height: relaxed">
      {description}
    </p>

    <div class="flex flex-wrap items-center gap-2 mt-4" data-component="TagGroup" data-token="$spacing-gap: 0.5rem / 8px">
      {tags.slice(0, 3).map((tag) => (
        <span class="card-tag">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>

<style>
  /* Card base — no outer shadow/border, breathes with whitespace */
  .project-card {
    transition: opacity 0.3s ease;
  }

  /* Image wrapper */
  .card-image-wrap {
    transition: box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-image-wrap {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }

  /* Image — only the image scales on hover */
  .card-mockup {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.5s ease;
  }

  .project-card:hover .card-mockup {
    transform: scale(1.05);
  }

  /* Tags — near-invisible pill, text is what reads */
  .card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.03);
    color: theme('colors.dark.400');
    white-space: nowrap;
    transition: background 0.25s ease,
                color 0.25s ease;
  }

  .project-card:hover .card-tag {
    background: rgba(0, 0, 0, 0.05);
    color: theme('colors.dark.500');
  }

  /* Massimo Dutti — editorial luxury feel */
  .card-image-wrap--editorial {
    background: radial-gradient(ellipse at 50% 40%, #FAF9F6 0%, #F0EFEB 60%, #E8E6E1 100%) !important;
    padding: 2rem 2rem 0;
  }

  @media (min-width: 768px) {
    .card-image-wrap--editorial {
      padding: 2.5rem 3rem 0;
    }
  }

  .card-mockup--elevated {
    object-fit: contain !important;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.12)) drop-shadow(0 8px 16px rgba(0, 0, 0, 0.06));
  }

  .project-card:hover .card-mockup--elevated {
    filter: drop-shadow(0 28px 50px rgba(0, 0, 0, 0.15)) drop-shadow(0 12px 20px rgba(0, 0, 0, 0.08));
  }
</style>
