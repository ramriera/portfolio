---
interface Props {
  slug: string;
  title: string;
  client: string;
  year: string;
  category: string;
  tags: string[];
  description: string;
  cover: string;
  featured?: boolean;
  variant?: 'default' | 'featured' | 'tall' | 'wide';
}

const { slug, title, client, year, category, tags, description, cover, featured, variant = 'default' } = Astro.props;
const isFeatured = variant === 'featured';
const isTall = variant === 'tall';
const isWide = variant === 'wide';
---

<a
  href={`/projects/${slug}`}
  class:list={[
    'project-card group relative block rounded-2xl overflow-hidden cursor-pointer',
    isTall ? 'h-full' : '',
    featured ? 'md:col-span-2' : '',
  ]}
  data-component="ProjectCard"
  data-token="$radius-2xl: 1rem / 16px|$spacing-padding: 1.5rem → 2rem (md)"
>
  <div class:list={['relative aspect-[4/3]', isTall ? 'md:aspect-auto md:h-full' : isFeatured ? 'md:aspect-[21/9] md:max-h-[520px]' : 'md:aspect-[16/9]']}>
    <!-- Image mockup -->
    <img
      src={cover}
      alt={title}
      class="card-mockup w-full h-full object-cover object-center"
      loading="lazy"
      data-token="$filter-saturate: 1.1|$filter-brightness: 1.05|$object-fit: cover|$object-position: center"
    />

    <!-- Gradient overlay -->
    <div class="card-gradient absolute inset-0"
      data-token="$color-gradient-start: rgba(0,0,0,0.92)|$color-gradient-end: rgba(0,0,0,0.05)|$gradient-direction: to top"></div>

    <!-- Inset shadow for depth -->
    <div class="absolute inset-0 rounded-2xl card-inset-shadow pointer-events-none"></div>

    <!-- Bottom content -->
    <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6">
      <!-- Title -->
      <h3 class:list={[
          'font-bold tracking-tight text-white mb-3',
          isFeatured ? 'text-2xl sm:text-3xl md:text-4xl lg:text-5xl' : 'text-xl sm:text-2xl md:text-3xl',
        ]}
        data-token="$font-size-heading-sm: 1.25rem → 1.5rem|$font-weight: 700 (bold)|$color-text: #ffffff">
        {title}
      </h3>

      <!-- Tags - all visible -->
      <div class="flex flex-wrap items-center gap-2" data-component="TagGroup" data-token="$spacing-gap: 0.5rem / 8px">
        {tags.slice(0, 4).map((tag) => (
          <span class="card-tag">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  /* Card base */
  .project-card {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover {
    transform: scale(1.02);
  }

  /* Gradient background */
  .card-gradient {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.45) 35%,
      rgba(0, 0, 0, 0.1) 65%,
      rgba(0, 0, 0, 0.03) 100%
    );
    transition: background 0.4s ease;
  }

  .project-card:hover .card-gradient {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.5) 35%,
      rgba(0, 0, 0, 0.15) 65%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  /* Inset shadow for depth/relief */
  .card-inset-shadow {
    box-shadow: inset 0 2px 20px rgba(0, 0, 0, 0.3),
                inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  }

  /* Image/Mockup */
  .card-mockup {
    filter: saturate(1.1) brightness(1.05);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.5s ease;
  }

  .project-card:hover .card-mockup {
    transform: translateY(-5px) scale(1.02);
    filter: saturate(1.25) brightness(1.1);
  }

  /* Tags — light, minimal chips */
  .card-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border-radius: 9999px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.7);
    white-space: nowrap;
    transition: border-color 0.25s ease,
                color 0.25s ease;
  }

  .project-card:hover .card-tag {
    border-color: rgba(255, 255, 255, 0.4);
    color: rgba(255, 255, 255, 0.9);
  }
</style>
