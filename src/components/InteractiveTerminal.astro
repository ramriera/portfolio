---

---

<!-- Interactive Terminal — fullscreen overlay when Code Mode is active on Home -->
<div id="interactive-terminal" class="interactive-terminal">
  <div class="term-window">
    <!-- Title bar -->
    <div class="term-titlebar">
      <div class="term-dots">
        <span style="background:#ff5f57"></span>
        <span style="background:#febc2e"></span>
        <span style="background:#28c840"></span>
      </div>
      <span class="term-title">ramon@portfolio:~</span>
      <button id="term-minimize" class="term-minimize" aria-label="Minimizar terminal" title="Minimizar">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
    </div>

    <!-- Output area -->
    <div id="term-output" class="term-output" tabindex="-1"></div>

    <!-- Input line -->
    <div class="term-input-row">
      <span class="term-prompt"><span class="term-prompt-user">ramon</span><span class="term-prompt-at">@</span><span class="term-prompt-host">portfolio</span><span class="term-prompt-colon">:</span><span class="term-prompt-path">~</span><span class="term-prompt-dollar">$</span></span>
      <input
        id="term-input"
        class="term-input"
        type="text"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Terminal input"
      />
    </div>
  </div>
</div>

<script>
function initInteractiveTerminal() {
  const terminal = document.getElementById('interactive-terminal');
  const output = document.getElementById('term-output');
  const input = document.getElementById('term-input') as HTMLInputElement | null;
  const minimizeBtn = document.getElementById('term-minimize');
  if (!terminal || !output || !input) return;

  // Guard against double-init
  if ((terminal as any).__initialized) return;
  (terminal as any).__initialized = true;

  let history: string[] = [];
  let historyIndex = -1;
  let isMinimized = false;
  let typewriterQueue: Promise<void> = Promise.resolve();

  // ── Section & project data ──
  const sections: Record<string, { desc: string; path: string }> = {
    about:    { desc: 'Sobre mi — Experiencia y trayectoria', path: '/about' },
    projects: { desc: 'Proyectos — Casos de estudio destacados', path: '/projects' },
    contact:  { desc: 'Contacto — Hablemos de tu proyecto', path: '/#contact' },
  };

  const projectList = [
    { slug: 'massimo-dutti-conversion',      name: 'Massimo Dutti',  tag: 'E-commerce',      desc: 'Optimizacion de conversion' },
    { slug: 'iberia-flight-experience',       name: 'Iberia',         tag: 'Travel',           desc: 'Experiencia de vuelo digital' },
    { slug: 'banco-sabadell-design-system',   name: 'Banco Sabadell', tag: 'Design System',    desc: 'Sistema de diseno enterprise' },
    { slug: 'imaginbank-digital-banking',     name: 'imaginBank',     tag: 'Fintech',          desc: 'Banca digital mobile-first' },
    { slug: 'solotemazos-music-platform',     name: 'Solotemazos',    tag: 'Entertainment',    desc: 'Plataforma de musica urbana' },
    { slug: 'movefast-startup-platform',      name: 'MoveFast',       tag: 'SaaS',             desc: 'Plataforma startup builder' },
  ];

  // ── Helpers ──
  function span(cls: string, text: string): string {
    return `<span class="t-${cls}">${escHtml(text)}</span>`;
  }

  function escHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function appendLine(html: string) {
    const div = document.createElement('div');
    div.className = 'term-line';
    div.innerHTML = html;
    output.appendChild(div);
  }

  function appendEmpty() {
    appendLine('&nbsp;');
  }

  function scrollToBottom() {
    output.scrollTop = output.scrollHeight;
  }

  // ── Typewriter effect ──
  function typewriteLines(lines: string[], baseDelay = 18): Promise<void> {
    return new Promise<void>((resolve) => {
      let i = 0;
      function nextLine() {
        if (i >= lines.length) {
          scrollToBottom();
          resolve();
          return;
        }
        appendLine(lines[i]);
        scrollToBottom();
        i++;
        setTimeout(nextLine, baseDelay + Math.random() * 12);
      }
      nextLine();
    });
  }

  function enqueueTypewriter(lines: string[], delay = 18) {
    typewriterQueue = typewriterQueue.then(() => typewriteLines(lines, delay));
  }

  // ── MOTD (Message of the Day) ──
  function printMotd() {
    const asciiArt = [
      '&nbsp;',
      `<span class="t-accent">  ____                                  ____  _                </span>`,
      `<span class="t-accent"> |  _ \\ __ _ _ __ ___   ___  _ __      |  _ \\(_) ___ _ __ __ _ </span>`,
      `<span class="t-accent"> | |_) / _\` | '_ \` _ \\ / _ \\| '_ \\     | |_) | |/ _ \\ '__/ _\` |</span>`,
      `<span class="t-accent"> |  _ &lt; (_| | | | | | | (_) | | | |    |  _ &lt;| |  __/ | | (_| |</span>`,
      `<span class="t-accent"> |_| \\_\\__,_|_| |_| |_|\\___/|_| |_|    |_| \\_\\_|\\___|_|  \\__,_|</span>`,
      '&nbsp;',
      `${span('muted', 'UX Lead & Product Designer')} ${span('comment', '// ramonriera.design')}`,
      `${span('muted', 'Design Systems | DesignOps | Product Strategy')}`,
      '&nbsp;',
      `${span('string', 'Bienvenido a la consola interactiva.')} Escribe ${span('keyword', 'help')} para ver los comandos disponibles.`,
      `${span('comment', '\u2500'.repeat(60))}`,
      '&nbsp;',
    ];
    enqueueTypewriter(asciiArt, 25);
  }

  // ── Command processor ──
  const commands: Record<string, (args: string[]) => void> = {
    help(_args) {
      const lines = [
        '&nbsp;',
        `${span('keyword', 'Comandos disponibles:')}`,
        '&nbsp;',
        `  ${span('function', 'help'.padEnd(14))} ${span('muted', 'Muestra esta ayuda')}`,
        `  ${span('function', 'whoami'.padEnd(14))} ${span('muted', 'Sobre Ramon Riera')}`,
        `  ${span('function', 'ls'.padEnd(14))} ${span('muted', 'Lista secciones de la web')}`,
        `  ${span('function', 'ls projects'.padEnd(14))} ${span('muted', 'Lista proyectos destacados')}`,
        `  ${span('function', 'cd [seccion]'.padEnd(14))} ${span('muted', 'Navega a una seccion (about, projects, contact)')}`,
        `  ${span('function', 'open [slug]'.padEnd(14))} ${span('muted', 'Abre un proyecto por su slug')}`,
        `  ${span('function', 'skills'.padEnd(14))} ${span('muted', 'Muestra habilidades tecnicas')}`,
        `  ${span('function', 'social'.padEnd(14))} ${span('muted', 'Muestra links de redes sociales')}`,
        `  ${span('function', 'cv'.padEnd(14))} ${span('muted', 'Descarga el CV')}`,
        `  ${span('function', 'clear'.padEnd(14))} ${span('muted', 'Limpia la terminal')}`,
        `  ${span('function', 'history'.padEnd(14))} ${span('muted', 'Muestra historial de comandos')}`,
        `  ${span('function', 'date'.padEnd(14))} ${span('muted', 'Fecha y hora actual')}`,
        `  ${span('function', 'neofetch'.padEnd(14))} ${span('muted', 'Informacion del sistema')}`,
        `  ${span('function', 'exit'.padEnd(14))} ${span('muted', 'Volver al modo visual')}`,
        '&nbsp;',
        `${span('comment', 'Tip: Usa \u2191\u2193 para navegar el historial de comandos.')}`,
        '&nbsp;',
      ];
      enqueueTypewriter(lines);
    },

    whoami(_args) {
      const lines = [
        '&nbsp;',
        `${span('keyword', 'Ramon Riera')}`,
        `${span('function', 'UX Lead & Senior Product Designer')}`,
        '&nbsp;',
        `${span('muted', 'Ubicacion:')}     Barcelona, ES`,
        `${span('muted', 'Empresa:')}       Doctori.com (2021-presente)`,
        `${span('muted', 'Especialidad:')}  Design Systems, DesignOps, Product Strategy`,
        `${span('muted', 'Email:')}         hello@ramonriera.design`,
        `${span('muted', 'Web:')}           ramonriera.design`,
        '&nbsp;',
        `${span('comment', '// Puente entre diseno y frontend escalable')}`,
        '&nbsp;',
      ];
      enqueueTypewriter(lines);
    },

    ls(args) {
      const target = args[0]?.toLowerCase();

      if (target === 'projects' || target === 'proyectos') {
        const lines = [
          '&nbsp;',
          `  ${span('muted', '#'.padEnd(5))} ${span('muted', 'Proyecto'.padEnd(18))} ${span('muted', 'Categoria'.padEnd(16))} ${span('muted', 'Descripcion')}`,
          `  ${span('comment', '\u2500'.repeat(70))}`,
        ];
        projectList.forEach((p, i) => {
          const num = `[${String(i + 1).padStart(2, '0')}]`;
          lines.push(`  ${span('constant', num.padEnd(5))} ${span('string', p.name.padEnd(18))} ${span('keyword', p.tag.padEnd(16))} ${span('muted', p.desc)}`);
        });
        lines.push('&nbsp;');
        lines.push(`${span('comment', `Total: ${projectList.length} proyectos`)} ${span('muted', '|')} ${span('comment', 'Usa')} ${span('keyword', 'open <nombre>')} ${span('comment', 'para abrir')}`);
        lines.push('&nbsp;');
        enqueueTypewriter(lines);
        return;
      }

      const lines = [
        '&nbsp;',
        `  ${span('muted', 'Seccion'.padEnd(14))} ${span('muted', 'Descripcion')}`,
        `  ${span('comment', '\u2500'.repeat(50))}`,
      ];
      Object.entries(sections).forEach(([key, val]) => {
        lines.push(`  ${span('function', key.padEnd(14))} ${span('muted', val.desc)}`);
      });
      lines.push('&nbsp;');
      enqueueTypewriter(lines);
    },

    cd(args) {
      const target = args[0]?.toLowerCase();

      if (!target) {
        appendLine(`${span('error', 'Uso:')} cd &lt;seccion&gt;`);
        appendLine(`${span('muted', 'Secciones:')} ${Object.keys(sections).join(', ')}`);
        scrollToBottom();
        return;
      }

      if (target === '~' || target === 'home' || target === '/') {
        appendLine(`${span('muted', 'Ya estas en ~/')}`);
        scrollToBottom();
        return;
      }

      const section = sections[target];
      if (section) {
        appendLine(`${span('string', `Navegando a ${section.path}...`)}`);
        scrollToBottom();
        setTimeout(() => {
          window.location.href = section.path;
        }, 400);
      } else {
        appendLine(`${span('error', `cd: ${target}: No existe esa seccion`)}`);
        appendLine(`${span('muted', 'Secciones disponibles:')} ${Object.keys(sections).join(', ')}`);
        scrollToBottom();
      }
    },

    open(args) {
      const query = args.join(' ').toLowerCase();
      if (!query) {
        appendLine(`${span('error', 'Uso:')} open &lt;nombre-proyecto&gt;`);
        appendLine(`${span('muted', 'Escribe')} ${span('keyword', 'ls projects')} ${span('muted', 'para ver los disponibles.')}`);
        scrollToBottom();
        return;
      }

      const project = projectList.find(p =>
        p.name.toLowerCase().includes(query) ||
        p.slug.includes(query)
      );

      if (project) {
        appendLine(`${span('string', `Abriendo ${project.name}...`)}`);
        scrollToBottom();
        setTimeout(() => {
          window.location.href = `/projects/${project.slug}`;
        }, 400);
      } else {
        appendLine(`${span('error', `No se encontro un proyecto con "${escHtml(query)}"`)}`);
        projectList.forEach(p => {
          appendLine(`  ${span('string', p.name)}`);
        });
        scrollToBottom();
      }
    },

    skills(_args) {
      const lines = [
        '&nbsp;',
        `${span('keyword', 'Design')}`,
        `  ${span('function', 'Figma')} ${span('muted', '|')} ${span('function', 'Design Systems')} ${span('muted', '|')} ${span('function', 'Prototyping')} ${span('muted', '|')} ${span('function', 'User Research')}`,
        '&nbsp;',
        `${span('keyword', 'Frontend')}`,
        `  ${span('string', 'HTML/CSS')} ${span('muted', '|')} ${span('string', 'Tailwind')} ${span('muted', '|')} ${span('string', 'Astro')} ${span('muted', '|')} ${span('string', 'React')} ${span('muted', '|')} ${span('string', 'TypeScript')}`,
        '&nbsp;',
        `${span('keyword', 'Operations')}`,
        `  ${span('constant', 'DesignOps')} ${span('muted', '|')} ${span('constant', 'Design Tokens')} ${span('muted', '|')} ${span('constant', 'CI/CD')} ${span('muted', '|')} ${span('constant', 'Storybook')}`,
        '&nbsp;',
      ];
      enqueueTypewriter(lines);
    },

    social(_args) {
      const lines = [
        '&nbsp;',
        `  ${span('function', 'LinkedIn')}   ${span('string', 'linkedin.com/in/ramonrieradepares')}`,
        `  ${span('function', 'Medium')}     ${span('string', 'medium.com/@ramriera')}`,
        `  ${span('function', 'Email')}      ${span('string', 'hello@ramonriera.design')}`,
        `  ${span('function', 'Web')}        ${span('string', 'ramonriera.design')}`,
        '&nbsp;',
      ];
      enqueueTypewriter(lines);
    },

    cv(_args) {
      const lines = [
        `${span('string', 'Descargando CV...')}`,
        '&nbsp;',
        `${span('muted', 'Abriendo CV-Ramon-Riera-Depares.pdf en nueva pestana...')}`,
      ];
      enqueueTypewriter(lines, 30);
      typewriterQueue = typewriterQueue.then(() => {
        setTimeout(() => {
          window.open('/docs/CV-Ramon-Riera-Depares.pdf', '_blank');
        }, 300);
      });
    },

    history(_args) {
      const lines = ['&nbsp;'];
      if (history.length === 0) {
        lines.push(`${span('muted', 'Historial vacio.')}`);
      } else {
        history.forEach((cmd, i) => {
          lines.push(`  ${span('muted', String(i + 1).padStart(4))}  ${escHtml(cmd)}`);
        });
      }
      lines.push('&nbsp;');
      enqueueTypewriter(lines);
    },

    date(_args) {
      const now = new Date();
      const formatted = now.toLocaleDateString('es-ES', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      const time = now.toLocaleTimeString('es-ES');
      appendLine(`${span('string', `${formatted}, ${time}`)}`);
      scrollToBottom();
    },

    neofetch(_args) {
      const infoLines = [
        [`${span('keyword', 'OS')}`,          `Astro 5.17 + Tailwind 3.4`],
        [`${span('keyword', 'Host')}`,         `ramonriera.design`],
        [`${span('keyword', 'Kernel')}`,       `Vercel Edge Network`],
        [`${span('keyword', 'Shell')}`,        `InteractiveTerminal v2.0`],
        [`${span('keyword', 'Resolution')}`,   `${window.innerWidth}x${window.innerHeight}`],
        [`${span('keyword', 'Theme')}`,        `Dracula (Code Mode)`],
        [`${span('keyword', 'Icons')}`,        `Custom SVG`],
        [`${span('keyword', 'Font')}`,         `JetBrains Mono, Inter, Space Grotesk`],
        [`${span('keyword', 'Uptime')}`,       `${new Date().getFullYear() - 2017} years designing`],
      ];

      const asciiLogo = [
        '    ____  ____  ',
        '   / __ \\/ __ \\ ',
        '  / /_/ / /_/ / ',
        ' / _, _/ _, _/  ',
        '/_/ |_/_/ |_|   ',
        '                ',
      ];

      const lines = ['&nbsp;'];
      const maxLen = Math.max(asciiLogo.length, infoLines.length);

      for (let i = 0; i < maxLen; i++) {
        const art = i < asciiLogo.length ? `<span class="t-accent">${escHtml(asciiLogo[i])}</span>` : ' '.repeat(16);
        const info = i < infoLines.length ? `${infoLines[i][0].padEnd(40)}  ${infoLines[i][1]}` : '';
        lines.push(`${art}   ${info}`);
      }
      lines.push('&nbsp;');
      enqueueTypewriter(lines, 30);
    },

    clear(_args) {
      output.innerHTML = '';
    },

    exit(_args) {
      appendLine(`${span('string', 'Switching to Visual Mode...')}`);
      scrollToBottom();
      setTimeout(() => {
        const toggle = document.getElementById('code-mode-toggle');
        if (toggle) toggle.click();
      }, 300);
    },
  };

  // ── Process input ──
  function processCommand(raw: string) {
    const trimmed = raw.trim();
    if (!trimmed) return;

    // Echo the command
    appendLine(
      `<span class="term-prompt-echo">` +
        `<span class="t-string">ramon</span>` +
        `<span class="t-muted">@</span>` +
        `<span class="t-string">portfolio</span>` +
        `<span class="t-muted">:~$</span>` +
      `</span>  ${escHtml(trimmed)}`
    );

    // Parse
    const parts = trimmed.split(/\s+/);
    const cmd = parts[0].toLowerCase();
    const args = parts.slice(1);

    // Add to history
    history.push(trimmed);
    historyIndex = history.length;

    // Execute
    const handler = commands[cmd];
    if (handler) {
      handler(args);
    } else {
      appendLine(`${span('error', `comando no encontrado: ${escHtml(cmd)}`)}`);
      appendLine(`${span('muted', 'Escribe')} ${span('keyword', 'help')} ${span('muted', 'para ver los comandos disponibles.')}`);
    }

    scrollToBottom();
  }

  // ── Input events ──
  input.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') {
      processCommand(input.value);
      input.value = '';
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (historyIndex > 0) {
        historyIndex--;
        input.value = history[historyIndex];
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex < history.length - 1) {
        historyIndex++;
        input.value = history[historyIndex];
      } else {
        historyIndex = history.length;
        input.value = '';
      }
    } else if (e.key === 'Tab') {
      e.preventDefault();
      const partial = input.value.trim().toLowerCase();
      const allCmds = Object.keys(commands);
      const matches = allCmds.filter(c => c.startsWith(partial));
      if (matches.length === 1) {
        input.value = matches[0] + ' ';
      } else if (matches.length > 1) {
        appendLine(`${span('muted', matches.join('  '))}`);
        scrollToBottom();
      }
    } else if (e.key === 'l' && e.ctrlKey) {
      e.preventDefault();
      commands.clear([]);
    }
  });

  // ── Global focus: any click on the fullscreen terminal focuses input ──
  terminal.addEventListener('click', () => {
    input.focus();
  });

  // Minimize/restore
  minimizeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    isMinimized = !isMinimized;
    terminal.classList.toggle('term-minimized', isMinimized);
  });

  // ── Fullscreen: hide everything else, lock body scroll ──
  function enterFullscreen() {
    document.body.classList.add('terminal-fullscreen');
  }

  function exitFullscreen() {
    document.body.classList.remove('terminal-fullscreen');
  }

  // ── Code mode visibility ──
  function updateVisibility() {
    const isCodeMode = document.body.classList.contains('code-mode');
    const isHome = window.location.pathname.replace(/\/$/, '') === '' ||
                   window.location.pathname === '/';
    const shouldShow = isCodeMode && isHome;
    terminal.classList.toggle('term-active', shouldShow);

    if (shouldShow) {
      enterFullscreen();
      if (output.children.length === 0) {
        printMotd();
      }
      setTimeout(() => input.focus(), 100);
    } else {
      exitFullscreen();
    }
  }

  updateVisibility();

  // Listen for code mode toggle
  const codeToggle = document.getElementById('code-mode-toggle');
  codeToggle?.addEventListener('click', () => {
    setTimeout(updateVisibility, 100);
  });

  // Re-init on Astro navigation
  document.addEventListener('astro:page-load', () => {
    (terminal as any).__initialized = false;
  });
}

initInteractiveTerminal();
document.addEventListener('astro:page-load', initInteractiveTerminal);
</script>

<style>
  /* ── Interactive Terminal — Fullscreen Overlay ── */
  .interactive-terminal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: #1a1918;
    padding: 0;
    overflow: hidden;
  }

  .interactive-terminal.term-active {
    display: flex;
    align-items: stretch;
    justify-content: center;
  }

  .interactive-terminal.term-minimized .term-output,
  .interactive-terminal.term-minimized .term-input-row {
    display: none;
  }

  /* ── Terminal Window — fills the overlay ── */
  .term-window {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    background: #1e1e2e;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── Title Bar ── */
  .term-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: #181825;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    user-select: none;
    -webkit-user-select: none;
    flex-shrink: 0;
  }

  .term-dots {
    display: flex;
    gap: 7px;
  }

  .term-dots span {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    display: block;
  }

  .term-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--cm-text-muted, #7d8590);
    letter-spacing: 0.02em;
    flex: 1;
  }

  .term-minimize {
    background: none;
    border: none;
    color: var(--cm-text-muted, #7d8590);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .term-minimize:hover {
    color: var(--cm-text, #e6edf3);
    background: rgba(255, 255, 255, 0.08);
  }

  /* ── Output Area — fills remaining space ── */
  .term-output {
    flex: 1;
    padding: 1.5rem 2rem;
    overflow-y: auto;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.75;
    color: var(--cm-text, #e6edf3);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  .term-output::-webkit-scrollbar {
    width: 6px;
  }

  .term-output::-webkit-scrollbar-track {
    background: transparent;
  }

  .term-output::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
  }

  /* ── Input Row ── */
  .term-input-row {
    display: flex;
    align-items: center;
    padding: 0.75rem 2rem 1.25rem;
    gap: 0.625rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  .term-prompt {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .term-prompt-user,
  .term-prompt-host {
    color: var(--cm-string, #50fa7b);
    font-weight: 700;
  }

  .term-prompt-at,
