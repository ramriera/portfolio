---
interface Props {
  direction?: 'up' | 'left' | 'right' | 'scale';
  delay?: string;
  class?: string;
}

const { direction = 'up', delay = '0', class: className = '' } = Astro.props;

const revealDirection = direction === 'up' ? '' : direction;
---

<div
  data-reveal={revealDirection}
  data-delay={delay}
  class={className}
>
  <slot />
</div>
