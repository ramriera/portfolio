---
interface Props {
  label: string;
  variant?: 'default' | 'primary' | 'outline';
  size?: 'sm' | 'md';
}

const { label, variant = 'default', size = 'sm' } = Astro.props;

const variants = {
  default: 'bg-dark-100 text-dark-600',
  primary: 'bg-primary-500/10 text-primary-500',
  outline: 'border border-dark-200 text-dark-600',
};

const sizes = {
  sm: 'px-3 py-1 text-xs',
  md: 'px-4 py-1.5 text-sm',
};
---

<span class:list={['inline-flex items-center font-medium rounded-full', variants[variant], sizes[size]]}
  data-component="Tag" data-token="$radius-full: 9999px|$font-weight: 500 (medium)">
  {label}
</span>
