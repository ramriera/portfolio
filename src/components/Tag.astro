---
interface Props {
  label: string;
  variant?: 'default' | 'primary' | 'outline';
  size?: 'sm' | 'md';
}

const { label, variant = 'default', size = 'sm' } = Astro.props;

const variants = {
  default: 'bg-dark-100 dark:bg-dark-800 text-dark-600 dark:text-dark-300',
  primary: 'bg-primary-500/15 dark:bg-primary-500/20 text-primary-700 dark:text-primary-300',
  outline: 'border border-dark-200 dark:border-dark-700 text-dark-600 dark:text-dark-400',
};

const sizes = {
  sm: 'px-3 py-1 text-xs',
  md: 'px-4 py-1.5 text-sm',
};
---

<span class:list={['inline-flex items-center font-medium rounded-full', variants[variant], sizes[size]]}>
  {label}
</span>
