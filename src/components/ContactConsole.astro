---
import { siteConfig } from '@/utils/data';

interface Props {
  headingHtml?: string;
  description?: string;
}

const {
  headingHtml = '¿Tienes un <span class="text-primary-500">proyecto</span> en mente?',
  description = 'Diseño y construyo el producto de principio a fin. Cuéntame el problema y hablemos de cómo llevarlo de la estrategia a producción.',
} = Astro.props;
---

<section class="section-padding" data-component="CallToAction">
  <div class="container-custom text-center">
    <div data-reveal class="mb-6 flex justify-center">
      <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
          <g class="icon-ruler-idle">
            <path d="M6 38L6 8L36 38H6Z" class="icon-stroke icon-draw" />
            <path d="M12 38L12 20L24 38" class="icon-accent icon-draw-delay" />
            <line x1="6" y1="14" x2="11" y2="14" class="icon-stroke icon-draw" />
            <line x1="6" y1="20" x2="10" y2="20" class="icon-stroke icon-draw" />
            <line x1="6" y1="26" x2="11" y2="26" class="icon-stroke icon-draw" />
            <line x1="6" y1="32" x2="10" y2="32" class="icon-stroke icon-draw" />
          </g>
          <g class="icon-ruler-pencil">
            <line x1="32" y1="4" x2="38" y2="10" class="icon-accent" />
            <line x1="32" y1="4" x2="30" y2="2" class="icon-accent" />
            <circle cx="38" cy="10" r="1.2" class="icon-accent-fill" />
          </g>
        </svg>
      </span>
    </div>
    <h2 data-reveal data-delay="100" class="heading-lg mb-6 sm:whitespace-nowrap"
      data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)"
      set:html={headingHtml} />
    <p data-reveal data-delay="200" class="text-body text-lg mb-10"
      data-token="$font-family-sans: Inter|$color-text-muted: #7c766c|$font-size-lg: 1.125rem / 18px">
      {description}
    </p>
    <div data-reveal data-delay="300" class="flex flex-wrap items-center justify-center gap-4"
      data-component="CTAButtons" data-token="$spacing-gap: 1rem / 16px">
      <a href={`mailto:${siteConfig.email}`} class="btn-primary text-base"
        data-component="ButtonContact"
        data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$radius-full: 9999px">
        Contactar
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
        class="btn-outline text-base"
        data-component="ButtonCV"
        data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px">
        Descargar CV
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
        </svg>
      </a>
    </div>
  </div>
</section>
