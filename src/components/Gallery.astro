---
interface Props {
  images: string[];
  alt: string;
}

const { images, alt } = Astro.props;
---

<div class="space-y-4">
  <!-- Main image -->
  <div class="rounded-2xl overflow-hidden dashed-border">
    <img
      id="gallery-main"
      src={images[0]}
      alt={alt}
      class="w-full aspect-video object-cover transition-all duration-500"
    />
  </div>

  <!-- Thumbnails -->
  {images.length > 1 && (
    <div class="grid grid-cols-4 gap-3">
      {images.map((img, i) => (
        <button
          class:list={[
            'gallery-thumb rounded-lg overflow-hidden dashed-border transition-all duration-300 hover:opacity-100',
            i === 0 ? 'ring-2 ring-primary-500 opacity-100' : 'opacity-60',
          ]}
          data-src={img}
        >
          <img
            src={img}
            alt={`${alt} - ${i + 1}`}
            class="w-full aspect-video object-cover"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  const mainImg = document.getElementById('gallery-main') as HTMLImageElement;
  const thumbs = document.querySelectorAll('.gallery-thumb');

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.getAttribute('data-src');
      if (mainImg && src) {
        mainImg.style.opacity = '0';
        setTimeout(() => {
          mainImg.src = src;
          mainImg.style.opacity = '1';
        }, 200);

        thumbs.forEach((t) => {
          t.classList.remove('ring-2', 'ring-primary-500', 'opacity-100');
          t.classList.add('opacity-60');
        });
        thumb.classList.add('ring-2', 'ring-primary-500', 'opacity-100');
        thumb.classList.remove('opacity-60');
      }
    });
  });
</script>
