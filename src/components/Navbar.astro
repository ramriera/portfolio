---
import { navLinks, siteConfig } from '@/utils/data';
import CodeModeToggle from '@/components/CodeModeToggle.astro';

const currentPath = Astro.url.pathname;

// Code mode: map nav links to filenames and icon types
const fileMap: Record<string, { file: string; icon: 'ts' | 'md' | 'sh' }> = {
  '/': { file: 'index.ts', icon: 'ts' },
  '/about': { file: 'about.tsx', icon: 'ts' },
  '/projects': { file: 'projects.config.ts', icon: 'ts' },
};

// Breadcrumb section name from current path
const pathSegments = currentPath.replace(/\/$/, '').split('/').filter(Boolean);
const isProjectDetail = pathSegments[0] === 'projects' && pathSegments.length >= 2;
const isProjectsListing = pathSegments[0] === 'projects' && pathSegments.length === 1;
const projectSlug = isProjectDetail ? pathSegments[1] : '';
const projectFileName = isProjectDetail
  ? projectSlug.replace(/-/g, '_') + '.config.ts'
  : '';
const rawSection = pathSegments.length === 0 ? '/' : '/' + pathSegments[0];
const sectionName = fileMap[rawSection]?.file || (pathSegments.length === 0 ? 'index' : pathSegments[0]);
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out-expo navbar-base"
  data-component="Navbar"
>
  <div class="container-custom">
    <nav class="flex items-center justify-between h-20">

      <!-- ═══ DESIGN MODE: Logo ═══ -->
      <a href="/" id="logo" class="logo relative z-10 flex items-center gap-3 nav-design-logo" data-component="Logo">
        <span class="logo-name">Ramon Riera</span>
        <span class="logo-divider"></span>
        <span class="logo-role">UX Lead</span>
      </a>

      <!-- ═══ CODE MODE: Breadcrumb path ═══ -->
      <div class="nav-code-breadcrumb" aria-hidden="true">
        <span class="ncb-segment">ramonriera</span>
        <span class="ncb-sep">/</span>
        <span class="ncb-segment">src</span>
        <span class="ncb-sep">/</span>
        {isProjectDetail ? (
          <>
            <span class="ncb-segment">projects</span>
            <span class="ncb-sep">/</span>
            <span class="ncb-active" id="ncb-section">{projectFileName}</span>
          </>
        ) : isProjectsListing ? (
          <>
            <span class="ncb-segment">projects</span>
            <span class="ncb-sep">/</span>
            <span class="ncb-active" id="ncb-section">{sectionName}</span>
          </>
        ) : (
          <>
            <span class="ncb-segment">pages</span>
            <span class="ncb-sep">/</span>
            <span class="ncb-active" id="ncb-section">{sectionName}</span>
          </>
        )}
      </div>

      <!-- ═══ DESIGN MODE: Desktop Navigation ═══ -->
      <div class="hidden lg:flex items-center gap-1 nav-design-links">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-full transition-all duration-300',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-primary-500 bg-primary-500/10'
                : 'text-neutral-500 hover:text-neutral-900',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- ═══ CODE MODE: File tabs ═══ -->
      <div class="nav-code-tabs" aria-hidden="true">
        {navLinks.map((link) => {
          const info = fileMap[link.href] || { file: link.label, icon: 'ts' };
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={['nct-tab', isActive && 'nct-tab--active']}
            >
              {info.icon === 'ts' && (
                <svg class="nct-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />
                </svg>
              )}
              {info.icon === 'md' && (
                <svg class="nct-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              )}
              <span class="nct-filename">{info.file}</span>
              <span class="nct-modified"></span>
            </a>
          );
        })}
      </div>

      <!-- ═══ Actions area ═══ -->
      <div class="flex items-center gap-5">
        <!-- Design mode: toggle + CTA -->
        <div class="hidden lg:block nav-design-toggle">
          <CodeModeToggle />
        </div>
        <a
          href={`mailto:${siteConfig.email}`}
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-900 text-white text-sm font-medium rounded-full transition-all duration-300 hover:bg-neutral-800 hover:shadow-md hover:shadow-neutral-900/10 group/btn hero-cta-normal"
        >
          Hablemos
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Code mode: Visual Mode button (triggers toggle) -->
        <button class="nav-code-run-btn" id="nav-visual-mode-btn" aria-label="Switch to Visual Mode">
          <span class="nav-run-icon">&#9655;</span>
          <span class="nav-run-label">Visual Mode</span>
        </button>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden relative z-10 p-2 rounded-lg hover:bg-neutral-100 transition-colors"
          aria-label="Abrir menú"
        >
          <div class="w-6 h-5 flex flex-col justify-between" id="hamburger">
            <span class="block w-full h-0.5 bg-neutral-900 transition-all duration-300 origin-left"></span>
            <span class="block w-full h-0.5 bg-neutral-900 transition-all duration-300"></span>
            <span class="block w-3/4 h-0.5 bg-neutral-900 transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile Navigation — OUTSIDE header so transform: translateY(-100%) on navbar doesn't break fixed positioning -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-white z-[60] flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-out-expo overscroll-none mobile-menu-overlay"
>
  <!-- Close button -->
  <button
    id="mobile-menu-close"
    class="absolute top-6 right-6 p-2 rounded-lg hover:bg-neutral-100 transition-colors z-10"
    aria-label="Cerrar menú"
  >
    <svg class="w-7 h-7 text-neutral-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <nav class="flex flex-col items-center gap-2">
    {navLinks.map((link, i) => (
      <a
        href={link.href}
        class:list={[
          'text-3xl font-bold tracking-tight transition-all duration-300 py-2',
          currentPath === link.href
            ? 'text-primary-500'
            : 'text-neutral-400 hover:text-neutral-900',
        ]}
        style={`transition-delay: ${i * 50}ms`}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <a
    href={`mailto:${siteConfig.email}`}
    class="mt-6 btn-primary text-lg hero-cta-normal"
  >
    Hablemos
  </a>
  <a href={`mailto:${siteConfig.email}`} class="mt-6 hero-cta-code" data-component="ButtonRunCmd">
    <span class="hero-cta-prompt">&gt;</span> run <span class="hero-cta-cmd">send_email.sh</span><span class="hero-cta-cursor">_</span>
  </a>
</div>

<!-- Spacer for fixed navbar -->
<div class="h-20"></div>

<style>
  /* Navbar base — always glassmorphism-ready, safe-area aware */
  .navbar-base {
    padding-top: env(safe-area-inset-top, 0px);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.85);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                background 0.5s ease,
                box-shadow 0.5s ease;
    will-change: transform;
    contain: layout style;
  }

  .nav-scrolled {
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }

  /* Hide on scroll down */
  .navbar-hidden {
    transform: translateY(-100%);
  }

  :global(.code-mode) .navbar-base {
    background: rgba(20, 20, 19, 0.85);
  }

  :global(.code-mode) .nav-scrolled {
    background: rgba(20, 20, 19, 0.9);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  :global(.code-mode .mobile-menu-overlay) {
    background: #141413;
  }

  .logo-name {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    color: #1a1918;
    white-space: nowrap;
    letter-spacing: -0.03em;
  }

  .logo-divider {
    width: 1px;
    height: 1.1rem;
    background: rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  .logo-role {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: rgba(0, 0, 0, 0.45);
    white-space: nowrap;
  }

  /* ═══ CODE MODE — IDE Header Transformation ═══ */

  /* Hide design elements in code mode */
  .nav-code-breadcrumb,
  .nav-code-tabs,
  .nav-code-run-btn {
    display: none;
  }

  :global(.code-mode) .nav-design-logo,
  :global(.code-mode) .nav-design-links,
  :global(.code-mode) .nav-design-toggle,
  :global(.code-mode) .hero-cta-normal {
    display: none !important;
  }

  :global(.code-mode) .nav-code-breadcrumb {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .ncb-segment {
    color: var(--cm-text-muted, #7d8590);
  }

  .ncb-sep {
    color: var(--cm-text-muted, #7d8590);
    opacity: 0.4;
  }

  .ncb-active {
    color: var(--cm-text-secondary, #c9d1d9);
    font-weight: 500;
  }

  /* ── File tabs ── */
  :global(.code-mode) .nav-code-tabs {
    display: flex;
    align-items: center;
    gap: 0;
    height: 100%;
  }

  .nct-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--cm-text-muted, #7d8590);
    text-decoration: none;
    border-top: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
    position: relative;
  }

  .nct-tab:hover {
    color: var(--cm-function, #8be9fd);
    background: var(--cm-bg-card, rgba(255, 255, 255, 0.03));
    border-top-color: rgba(139, 233, 253, 0.4);
  }

  .nct-tab--active {
    color: var(--cm-text, #e6edf3);
    border-top-color: var(--cm-function, #8be9fd);
    background: var(--cm-bg-surface, rgba(255, 255, 255, 0.04));
  }

  .nct-tab--active .nct-icon {
    color: var(--cm-function, #8be9fd);
  }

  .nct-icon {
    width: 13px;
    height: 13px;
    color: var(--cm-text-muted, #7d8590);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .nct-tab:hover .nct-icon {
    color: var(--cm-function, #8be9fd);
  }

  .nct-filename {
    line-height: 1;
  }

  .nct-modified {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .nct-tab--active .nct-modified {
    background: var(--cm-string, #50fa7b);
    box-shadow: 0 0 4px rgba(80, 250, 123, 0.4);
  }

  /* ── Visual Mode run button ── */
  :global(.code-mode) .nav-code-run-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.4rem 0.85rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--cm-text-muted, #7d8590);
    background: transparent;
    border: 1px solid var(--cm-border, #30363d);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  :global(.code-mode) .nav-code-run-btn:hover {
    color: var(--cm-function, #8be9fd);
    border-color: var(--cm-function, #8be9fd);
    background: rgba(139, 233, 253, 0.06);
    box-shadow: 0 0 15px rgba(139, 233, 253, 0.15);
  }

  .nav-run-icon {
    font-size: 0.6rem;
    line-height: 1;
    transition: color 0.2s ease;
  }

  :global(.code-mode) .nav-code-run-btn:hover .nav-run-icon {
    color: var(--cm-function, #8be9fd);
    text-shadow: 0 0 6px rgba(139, 233, 253, 0.4);
  }

  /* ── Code mode: hide hamburger, always show tabs ── */
  :global(.code-mode) #mobile-menu-btn {
    display: none !important;
  }

  /* ── Responsive: compact tabs on smaller screens ── */
  @media (max-width: 768px) {
    .nct-tab {
      padding: 0.35rem 0.6rem;
      font-size: 0.62rem;
      gap: 4px;
    }

    .nct-icon {
      width: 11px;
      height: 11px;
    }

    .nct-modified {
      display: none;
    }

    :global(.code-mode) .nav-code-breadcrumb {
      font-size: 0.62rem;
    }

    :global(.code-mode) .nav-code-run-btn {
      font-size: 0.6rem;
      padding: 0.3rem 0.6rem;
    }

    .nav-run-label {
      display: none;
    }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  let isMenuOpen = false;

  // Scroll-hide state
  let lastKnownScroll = 0;
  let prevScroll = 0;
  const SCROLL_THRESHOLD = 8; // px before toggling visibility

  window.addEventListener('scroll', () => {
    if (isMenuOpen) return;

    lastKnownScroll = window.scrollY;

    if (navbar) {
      // Glassmorphism on scroll
      if (lastKnownScroll > 50) {
        navbar.classList.add('nav-scrolled');
      } else {
        navbar.classList.remove('nav-scrolled');
      }

      // Scroll-hide: hide on scroll down, show on scroll up
      const delta = lastKnownScroll - prevScroll;
      if (delta > SCROLL_THRESHOLD && lastKnownScroll > 100) {
        navbar.classList.add('navbar-hidden');
      } else if (delta < -SCROLL_THRESHOLD || lastKnownScroll < 50) {
        navbar.classList.remove('navbar-hidden');
      }
    }

    prevScroll = lastKnownScroll;
  }, { passive: true });

  const mobileMenuClose = document.getElementById('mobile-menu-close');

  let scrollPosition = 0;

  function lockScroll() {
    scrollPosition = window.scrollY;
    lastKnownScroll = scrollPosition;
    document.body.style.overflow = 'hidden';
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollPosition}px`;
    document.body.style.width = '100%';
  }

  function unlockScroll() {
    document.body.style.overflow = '';
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    document.documentElement.style.scrollBehavior = 'auto';
    window.scrollTo(0, scrollPosition);
    document.documentElement.style.scrollBehavior = '';

    if (navbar) {
      // Ensure navbar is visible after closing menu
      navbar.classList.remove('navbar-hidden');
      if (scrollPosition > 50) {
        navbar.classList.add('nav-scrolled');
      } else {
        navbar.classList.remove('nav-scrolled');
      }
    }
  }

  let isAnimating = false;

  function resetHamburger() {
    if (!hamburger) return;
    const spans = hamburger.querySelectorAll('span');
    spans[0].style.transform = '';
    spans[1].style.opacity = '1';
    spans[2].style.transform = '';
    spans[2].style.width = '75%';
  }

  function closeMenu() {
    if (!mobileMenu || !hamburger || isAnimating) return;
    isAnimating = true;
    isMenuOpen = false;
    mobileMenu.classList.add('pointer-events-none');
    mobileMenu.classList.add('opacity-0');
    mobileMenu.classList.remove('opacity-100');
    resetHamburger();

    const safetyTimer = setTimeout(() => {
      unlockScroll();
      isAnimating = false;
    }, 600);

    mobileMenu.addEventListener('transitionend', function handler(e) {
      if (e.propertyName !== 'opacity') return;
      mobileMenu.removeEventListener('transitionend', handler);
      clearTimeout(safetyTimer);
      unlockScroll();
      isAnimating = false;
    }, { once: false });
  }

  function openMenu() {
    if (!mobileMenu || !hamburger || isAnimating) return;
    isAnimating = true;
    isMenuOpen = true;
    lockScroll();
    mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenu.classList.add('opacity-100');
    const spans = hamburger.querySelectorAll('span');
    spans[0].style.transform = 'rotate(45deg) translateY(2px)';
    spans[1].style.opacity = '0';
    spans[2].style.transform = 'rotate(-45deg) translateY(-2px)';
    spans[2].style.width = '100%';

    // Ensure navbar stays visible while menu is open
    if (navbar) navbar.classList.remove('navbar-hidden');

    const safetyTimer = setTimeout(() => {
      isAnimating = false;
    }, 600);

    mobileMenu.addEventListener('transitionend', function handler(e) {
      if (e.propertyName !== 'opacity') return;
      mobileMenu.removeEventListener('transitionend', handler);
      clearTimeout(safetyTimer);
      isAnimating = false;
    }, { once: false });
  }

  mobileMenuClose?.addEventListener('click', closeMenu);

  mobileMenuBtn?.addEventListener('click', () => {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // ── Visual Mode button triggers the existing CodeModeToggle ──
  const visualModeBtn = document.getElementById('nav-visual-mode-btn');
  visualModeBtn?.addEventListener('click', () => {
    const toggle = document.getElementById('code-mode-toggle');
    if (toggle) toggle.click();
  });
</script>
