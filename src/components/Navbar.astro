---
import { navLinks } from '@/utils/data';

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out-expo"
>
  <div class="container-custom">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="relative z-10 group flex items-center h-10 overflow-hidden">
        <!-- Full wordmark: visible at top -->
        <svg
          id="logo-full"
          class="h-7 w-auto transition-all duration-500 ease-out-expo"
          viewBox="0 0 520 50"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- R mark (matching existing logo style) -->
          <rect x="0" y="0" width="50" height="50" rx="12" fill="currentColor" class="text-primary-500" />
          <text x="13" y="36" font-family="Inter, system-ui, sans-serif" font-size="32" font-weight="700" fill="white">R</text>

          <!-- "Ramon Riera" text -->
          <text x="64" y="35" font-family="Inter, system-ui, sans-serif" font-size="28" font-weight="600" fill="currentColor" class="text-dark-100" letter-spacing="-0.5">
            Ramon Riera
          </text>
        </svg>

        <!-- Small icon: visible on scroll -->
        <img
          id="logo-icon"
          src="https://ramonriera.design/wp-content/uploads/2024/12/logo-blanco-64x64-2.svg"
          alt="Ramon Riera"
          class="h-9 w-auto absolute left-0 top-1/2 transition-all duration-500 ease-out-expo translate-y-full opacity-0"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-full transition-all duration-300',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-primary-400 bg-primary-500/10'
                : 'text-dark-400 hover:text-dark-100',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <a
          href="mailto:ramriera28@gmail.com"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-dark-100 text-dark-900 text-sm font-medium rounded-full transition-all duration-300 hover:bg-dark-200 hover:shadow-md hover:shadow-dark-900/10 group/btn"
        >
          Hablemos
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden relative z-10 p-2 rounded-lg hover:bg-dark-800 transition-colors"
          aria-label="Abrir menú"
        >
          <div class="w-6 h-5 flex flex-col justify-between" id="hamburger">
            <span class="block w-full h-0.5 bg-dark-100 transition-all duration-300 origin-left"></span>
            <span class="block w-full h-0.5 bg-dark-100 transition-all duration-300"></span>
            <span class="block w-3/4 h-0.5 bg-dark-100 transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-dark-950 z-40 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-out-expo"
  >
    <nav class="flex flex-col items-center gap-2">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class:list={[
            'text-3xl font-bold tracking-tight transition-all duration-300 py-2',
            currentPath === link.href
              ? 'text-primary-500'
              : 'text-dark-400 hover:text-dark-100',
          ]}
          style={`transition-delay: ${i * 50}ms`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="mailto:ramriera28@gmail.com"
      class="mt-8 btn-primary text-lg"
    >
      Hablemos
    </a>
  </div>
</header>

<!-- Spacer for fixed navbar -->
<div class="h-20"></div>

<script>
  const navbar = document.getElementById('navbar');
  const logoFull = document.getElementById('logo-full');
  const logoIcon = document.getElementById('logo-icon');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  let isMenuOpen = false;
  let lastScroll = 0;
  let isScrolled = false;

  // Scroll behavior
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (navbar) {
      if (currentScroll > 50) {
        navbar.classList.add('bg-dark-950/80', 'backdrop-blur-xl');
      } else {
        navbar.classList.remove('bg-dark-950/80', 'backdrop-blur-xl');
      }

      if (currentScroll > lastScroll && currentScroll > 200 && !isMenuOpen) {
        navbar.style.transform = 'translateY(-100%)';
      } else {
        navbar.style.transform = 'translateY(0)';
      }
    }

    // Logo swap: full wordmark → icon
    if (currentScroll > 80 && !isScrolled) {
      isScrolled = true;
      if (logoFull) {
        logoFull.style.transform = 'translateY(100%)';
        logoFull.style.opacity = '0';
      }
      if (logoIcon) {
        logoIcon.style.transform = 'translateY(-50%)';
        logoIcon.style.opacity = '1';
      }
    } else if (currentScroll <= 80 && isScrolled) {
      isScrolled = false;
      if (logoFull) {
        logoFull.style.transform = 'translateY(0)';
        logoFull.style.opacity = '1';
      }
      if (logoIcon) {
        logoIcon.style.transform = 'translateY(100%)';
        logoIcon.style.opacity = '0';
      }
    }

    lastScroll = currentScroll;
  }, { passive: true });

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (mobileMenu && hamburger) {
      if (isMenuOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu.classList.add('opacity-100');
        document.body.style.overflow = 'hidden';
        const spans = hamburger.querySelectorAll('span');
        spans[0].style.transform = 'rotate(45deg) translateY(2px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translateY(-2px)';
        spans[2].style.width = '100%';
      } else {
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100');
        document.body.style.overflow = '';
        const spans = hamburger.querySelectorAll('span');
        spans[0].style.transform = '';
        spans[1].style.opacity = '1';
        spans[2].style.transform = '';
        spans[2].style.width = '75%';
      }
    }
  });
</script>
