---
import ThemeToggle from './ThemeToggle.astro';
import { navLinks } from '@/utils/data';

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out-expo"
>
  <div class="container-custom">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="relative z-10 group flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-primary-500 flex items-center justify-center text-white font-bold text-lg transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3">
          R
        </div>
        <span class="font-bold text-lg tracking-tight hidden sm:block">
          Ramon<span class="text-primary-500">.</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-primary-500 bg-primary-50 dark:bg-primary-500/10'
                : 'text-dark-600 dark:text-dark-400 hover:text-dark-900 dark:hover:text-dark-100 hover:bg-dark-50 dark:hover:bg-dark-800/50',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <ThemeToggle />
        <a
          href="/contact"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-dark-900 dark:bg-dark-100 text-white dark:text-dark-900 text-sm font-semibold rounded-lg transition-all duration-300 hover:bg-primary-500 hover:text-white dark:hover:bg-primary-500 dark:hover:text-white hover:shadow-lg hover:shadow-primary-500/25"
        >
          Hablemos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden relative z-10 p-2 rounded-lg hover:bg-dark-100 dark:hover:bg-dark-800 transition-colors"
          aria-label="Abrir menú"
        >
          <div class="w-6 h-5 flex flex-col justify-between" id="hamburger">
            <span class="block w-full h-0.5 bg-dark-900 dark:bg-dark-100 transition-all duration-300 origin-left"></span>
            <span class="block w-full h-0.5 bg-dark-900 dark:bg-dark-100 transition-all duration-300"></span>
            <span class="block w-3/4 h-0.5 bg-dark-900 dark:bg-dark-100 transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-white dark:bg-dark-950 z-40 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-out-expo"
  >
    <nav class="flex flex-col items-center gap-2">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class:list={[
            'text-3xl font-bold tracking-tight transition-all duration-300 py-2',
            currentPath === link.href
              ? 'text-primary-500'
              : 'text-dark-400 hover:text-dark-900 dark:hover:text-dark-100',
          ]}
          style={`transition-delay: ${i * 50}ms`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="/contact"
      class="mt-8 btn-primary text-lg"
    >
      Hablemos
    </a>
  </div>
</header>

<!-- Spacer for fixed navbar -->
<div class="h-20"></div>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  let isMenuOpen = false;
  let lastScroll = 0;

  // Scroll behavior
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (navbar) {
      if (currentScroll > 50) {
        navbar.classList.add('bg-white/80', 'dark:bg-dark-950/80', 'backdrop-blur-xl', 'shadow-sm', 'shadow-dark-900/5');
      } else {
        navbar.classList.remove('bg-white/80', 'dark:bg-dark-950/80', 'backdrop-blur-xl', 'shadow-sm', 'shadow-dark-900/5');
      }

      if (currentScroll > lastScroll && currentScroll > 200 && !isMenuOpen) {
        navbar.style.transform = 'translateY(-100%)';
      } else {
        navbar.style.transform = 'translateY(0)';
      }
    }
    lastScroll = currentScroll;
  }, { passive: true });

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (mobileMenu && hamburger) {
      if (isMenuOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu.classList.add('opacity-100');
        document.body.style.overflow = 'hidden';
        const spans = hamburger.querySelectorAll('span');
        spans[0].style.transform = 'rotate(45deg) translateY(2px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translateY(-2px)';
        spans[2].style.width = '100%';
      } else {
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100');
        document.body.style.overflow = '';
        const spans = hamburger.querySelectorAll('span');
        spans[0].style.transform = '';
        spans[1].style.opacity = '1';
        spans[2].style.transform = '';
        spans[2].style.width = '75%';
      }
    }
  });
</script>
