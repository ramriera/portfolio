---
import { navLinks } from '@/utils/data';

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out-expo"
>
  <div class="container-custom">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo: contracts from "Ramon Riera · UX Engineer" → "RR" -->
      <a href="/" id="logo" class="logo relative z-10 flex items-center gap-3">
        <span class="logo-name">
          <span class="logo-letter">R</span><span class="logo-collapse c1">amon</span><span class="logo-collapse c2">&nbsp;</span><span class="logo-letter">R</span><span class="logo-collapse c3">iera</span>
        </span>
        <span class="logo-divider"></span>
        <span class="logo-role logo-collapse c4">UX Engineer</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-full transition-all duration-300',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-primary-400 bg-primary-500/10'
                : 'text-dark-400 hover:text-dark-100',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <a
          href="mailto:ramriera28@gmail.com"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-dark-100 text-dark-900 text-sm font-medium rounded-full transition-all duration-300 hover:bg-dark-200 hover:shadow-md hover:shadow-dark-900/10 group/btn"
        >
          Hablemos
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden relative z-10 p-2 rounded-lg hover:bg-dark-800 transition-colors"
          aria-label="Abrir menú"
        >
          <div class="w-6 h-5 flex flex-col justify-between" id="hamburger">
            <span class="block w-full h-0.5 bg-dark-100 transition-all duration-300 origin-left"></span>
            <span class="block w-full h-0.5 bg-dark-100 transition-all duration-300"></span>
            <span class="block w-3/4 h-0.5 bg-dark-100 transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-dark-950 z-40 flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-out-expo"
  >
    <nav class="flex flex-col items-center gap-2">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class:list={[
            'text-3xl font-bold tracking-tight transition-all duration-300 py-2',
            currentPath === link.href
              ? 'text-primary-500'
              : 'text-dark-400 hover:text-dark-100',
          ]}
          style={`transition-delay: ${i * 50}ms`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href="mailto:ramriera28@gmail.com"
      class="mt-8 btn-primary text-lg"
    >
      Hablemos
    </a>
  </div>
</header>

<!-- Spacer for fixed navbar -->
<div class="h-20"></div>

<style>
  .logo-name {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    color: white;
    display: inline-flex;
    white-space: nowrap;
    letter-spacing: -0.03em;
  }

  .logo-letter {
    display: inline-block;
  }

  .logo-divider {
    width: 1px;
    height: 1.1rem;
    background: rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
    transition:
      opacity 1.4s cubic-bezier(0.22, 1, 0.36, 1),
      width 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .logo-role {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .logo-collapse {
    display: inline-block;
    max-width: 12em;
    opacity: 1;
    overflow: hidden;
    vertical-align: bottom;
    transition:
      max-width 1.4s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Staggered delays — expanding */
  .logo-collapse.c1 { transition-delay: 0s; }
  .logo-collapse.c2 { transition-delay: 0.06s; }
  .logo-collapse.c3 { transition-delay: 0.12s; }
  .logo-collapse.c4 { transition-delay: 0.05s; }

  /* Contracted state */
  .logo.contracted .logo-collapse {
    max-width: 0;
    opacity: 0;
  }

  /* Staggered delays — contracting (reverse order) */
  .logo.contracted .logo-collapse.c1 { transition-delay: 0.12s; }
  .logo.contracted .logo-collapse.c2 { transition-delay: 0.06s; }
  .logo.contracted .logo-collapse.c3 { transition-delay: 0s; }
  .logo.contracted .logo-collapse.c4 { transition-delay: 0s; }

  .logo.contracted .logo-divider {
    opacity: 0;
    width: 0;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const logo = document.getElementById('logo');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  let isMenuOpen = false;
  let lastScroll = 0;
  let isContracted = false;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    // Navbar background
    if (navbar) {
      if (currentScroll > 50) {
        navbar.classList.add('bg-dark-950/80', 'backdrop-blur-xl');
      } else {
        navbar.classList.remove('bg-dark-950/80', 'backdrop-blur-xl');
      }

      // Hide/show on scroll direction
      if (currentScroll > lastScroll && currentScroll > 200 && !isMenuOpen) {
        navbar.style.transform = 'translateY(-100%)';
      } else {
        navbar.style.transform = 'translateY(0)';
      }
    }

    // Logo contraction: "Ramon Riera" → "RR"
    if (currentScroll > 200 && !isContracted) {
      isContracted = true;
      logo?.classList.add('contracted');
    } else if (currentScroll <= 200 && isContracted) {
      isContracted = false;
      logo?.classList.remove('contracted');
    }

    lastScroll = currentScroll;
  }, { passive: true });

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (mobileMenu && hamburger) {
      if (isMenuOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu.classList.add('opacity-100');
        document.body.style.overflow = 'hidden';
        const spans = hamburger.querySelectorAll('span');
        spans[0].style.transform = 'rotate(45deg) translateY(2px)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'rotate(-45deg) translateY(-2px)';
        spans[2].style.width = '100%';
      } else {
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100');
        document.body.style.overflow = '';
        const spans = hamburger.querySelectorAll('span');
        spans[0].style.transform = '';
        spans[1].style.opacity = '1';
        spans[2].style.transform = '';
        spans[2].style.width = '75%';
      }
    }
  });
</script>
