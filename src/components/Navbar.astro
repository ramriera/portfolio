---
import { navLinks, siteConfig } from '@/utils/data';
import CodeModeToggle from '@/components/CodeModeToggle.astro';

const currentPath = Astro.url.pathname;
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out-expo"
  data-component="Navbar"
>
  <div class="container-custom">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo: static identity -->
      <a href="/" id="logo" class="logo relative z-10 flex items-center gap-3" data-component="Logo">
        <span class="logo-name">Ramon Riera</span>
        <span class="logo-divider"></span>
        <span class="logo-role">UX Lead</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-full transition-all duration-300',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-primary-500 bg-primary-500/10'
                : 'text-dark-500 hover:text-dark-900',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-5">
        <div class="hidden lg:block">
          <CodeModeToggle />
        </div>
        <a
          href={`mailto:${siteConfig.email}`}
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 bg-dark-900 text-white text-sm font-medium rounded-full transition-all duration-300 hover:bg-dark-800 hover:shadow-md hover:shadow-dark-900/10 group/btn"
        >
          Hablemos
          <svg class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden relative z-10 p-2 rounded-lg hover:bg-dark-100 transition-colors"
          aria-label="Abrir menú"
        >
          <div class="w-6 h-5 flex flex-col justify-between" id="hamburger">
            <span class="block w-full h-0.5 bg-dark-900 transition-all duration-300 origin-left"></span>
            <span class="block w-full h-0.5 bg-dark-900 transition-all duration-300"></span>
            <span class="block w-3/4 h-0.5 bg-dark-900 transition-all duration-300 origin-left"></span>
          </div>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="fixed inset-0 bg-white z-[60] flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-out-expo overscroll-none mobile-menu-overlay"
  >
    <!-- Close button -->
    <button
      id="mobile-menu-close"
      class="absolute top-6 right-6 p-2 rounded-lg hover:bg-dark-100 transition-colors z-10"
      aria-label="Cerrar menú"
    >
      <svg class="w-7 h-7 text-dark-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <nav class="flex flex-col items-center gap-2">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class:list={[
            'text-3xl font-bold tracking-tight transition-all duration-300 py-2',
            currentPath === link.href
              ? 'text-primary-500'
              : 'text-dark-400 hover:text-dark-900',
          ]}
          style={`transition-delay: ${i * 50}ms`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <a
      href={`mailto:${siteConfig.email}`}
      class="mt-6 btn-primary text-lg"
    >
      Hablemos
    </a>
  </div>
</header>

<!-- Spacer for fixed navbar -->
<div class="h-20"></div>

<style>
  .nav-scrolled {
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
  }

  :global(.code-mode) .nav-scrolled {
    background: rgba(20, 20, 19, 0.85);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
  }

  :global(.code-mode) .mobile-menu-overlay {
    background: #141413;
  }

  .logo-name {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    color: #1a1918;
    white-space: nowrap;
    letter-spacing: -0.03em;
  }

  .logo-divider {
    width: 1px;
    height: 1.1rem;
    background: rgba(0, 0, 0, 0.2);
    flex-shrink: 0;
  }

  .logo-role {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 400;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: rgba(0, 0, 0, 0.45);
    white-space: nowrap;
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger');
  let isMenuOpen = false;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    // Navbar background
    if (navbar) {
      if (currentScroll > 50) {
        navbar.classList.add('backdrop-blur-xl', 'nav-scrolled');
      } else {
        navbar.classList.remove('backdrop-blur-xl', 'nav-scrolled');
      }
    }
  }, { passive: true });

  const mobileMenuClose = document.getElementById('mobile-menu-close');

  let scrollPosition = 0;

  function lockScroll() {
    scrollPosition = window.scrollY;
    document.body.style.overflow = 'hidden';
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollPosition}px`;
    document.body.style.width = '100%';
  }

  function unlockScroll() {
    document.body.style.overflow = '';
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    // Bypass smooth scroll to restore position instantly
    document.documentElement.style.scrollBehavior = 'auto';
    window.scrollTo(0, scrollPosition);
    document.documentElement.style.scrollBehavior = '';
  }

  let isAnimating = false;

  function resetHamburger() {
    if (!hamburger) return;
    const spans = hamburger.querySelectorAll('span');
    spans[0].style.transform = '';
    spans[1].style.opacity = '1';
    spans[2].style.transform = '';
    spans[2].style.width = '75%';
  }

  function closeMenu() {
    if (!mobileMenu || !hamburger || isAnimating) return;
    isAnimating = true;
    isMenuOpen = false;
    mobileMenu.classList.add('pointer-events-none');
    mobileMenu.classList.add('opacity-0');
    mobileMenu.classList.remove('opacity-100');
    resetHamburger();
    // Wait for fade-out to finish before unlocking scroll
    mobileMenu.addEventListener('transitionend', function handler(e) {
      if (e.propertyName !== 'opacity') return;
      mobileMenu.removeEventListener('transitionend', handler);
      unlockScroll();
      isAnimating = false;
    }, { once: false });
  }

  function openMenu() {
    if (!mobileMenu || !hamburger || isAnimating) return;
    isAnimating = true;
    isMenuOpen = true;
    lockScroll();
    mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
    mobileMenu.classList.add('opacity-100');
    const spans = hamburger.querySelectorAll('span');
    spans[0].style.transform = 'rotate(45deg) translateY(2px)';
    spans[1].style.opacity = '0';
    spans[2].style.transform = 'rotate(-45deg) translateY(-2px)';
    spans[2].style.width = '100%';
    mobileMenu.addEventListener('transitionend', function handler(e) {
      if (e.propertyName !== 'opacity') return;
      mobileMenu.removeEventListener('transitionend', handler);
      isAnimating = false;
    }, { once: false });
  }

  mobileMenuClose?.addEventListener('click', closeMenu);

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close menu when a nav link is clicked
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
