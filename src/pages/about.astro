<script>
  class Typewriter {
    private el: HTMLElement;
    private words: string[];
    private wordEl: HTMLElement;
    private cursorEl: HTMLElement;
    private current = 0;
    private charIndex = 0;
    private isDeleting = false;
    private readonly typeSpeed = 80;
    private readonly deleteSpeed = 50;
    private readonly pauseBetween = 3000;

    constructor(el: HTMLElement) {
      this.el = el;
      this.words = JSON.parse(el.dataset.typewriter || '[]');
      this.wordEl = el.querySelector('.typewriter-word')!;
      this.cursorEl = el.querySelector('.typewriter-cursor')!;
      if (this.words.length) this.tick();
    }

    private tick() {
      const word = this.words[this.current];

      if (!this.isDeleting) {
        this.charIndex++;
        this.wordEl.textContent = word.slice(0, this.charIndex);

        if (this.charIndex === word.length) {
          this.isDeleting = false;
          setTimeout(() => {
            this.isDeleting = true;
            this.tick();
          }, this.pauseBetween);
          return;
        }
        setTimeout(() => this.tick(), this.typeSpeed);
      } else {
        this.charIndex--;
        this.wordEl.textContent = word.slice(0, this.charIndex);

        if (this.charIndex === 0) {
          this.isDeleting = false;
          this.current = (this.current + 1) % this.words.length;
          setTimeout(() => this.tick(), this.typeSpeed * 3);
          return;
        }
        setTimeout(() => this.tick(), this.deleteSpeed);
      }
    }
  }

  document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach(el => new Typewriter(el));
</script>

