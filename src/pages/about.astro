---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import profileImg from '@/assets/shared/foto-perfil.png';
import { siteConfig, mainTimeline, consultingBlock } from '@/utils/data';
import ContactConsole from '@/components/ContactConsole.astro';
import WordsCarousel from '@/components/WordsCarousel.astro';

const aboutWords = ['creador', 'arquitecto', 'constructor'];
---

<BaseLayout
  title="About ⚡ Ramon Riera"
  description="Conoce a Ramon Riera, Design Systems & Strategy Lead especializado en UX Strategy, DesignOps y Product Design."
>
  <!-- Hero (design mode) -->
  <section class="section-padding about-hero-design" data-component="AboutHero">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <!-- Lightbulb body -->
              <path d="M16 28C16 24 12 22 12 16C12 10.5 16.5 6 22 6C27.5 6 32 10.5 32 16C32 22 28 24 28 28" class="icon-stroke icon-draw" />
              <!-- Bulb base -->
              <path d="M16 28H28" class="icon-stroke icon-draw-delay" />
              <path d="M17 32H27" class="icon-stroke icon-draw-delay" />
              <path d="M19 36H25" class="icon-accent icon-draw-delay" />
              <!-- Filament -->
              <g class="icon-bulb-glow">
                <path d="M19 18C19 18 20.5 20 22 20C23.5 20 25 18 25 18" class="icon-accent icon-draw-delay" />
              </g>
              <!-- Light rays -->
              <line x1="22" y1="1" x2="22" y2="4" class="icon-accent icon-bulb-ray-1" stroke-width="1.5" />
              <line x1="35" y1="8" x2="33" y2="10" class="icon-accent icon-bulb-ray-2" stroke-width="1.5" />
              <line x1="9" y1="8" x2="11" y2="10" class="icon-accent icon-bulb-ray-3" stroke-width="1.5" />
              <line x1="38" y1="16" x2="35" y2="16" class="icon-accent icon-bulb-ray-1" stroke-width="1.5" />
              <line x1="6" y1="16" x2="9" y2="16" class="icon-accent icon-bulb-ray-2" stroke-width="1.5" />
            </svg>
          </span>
        </div>
        <!-- Title (same element for both modes, CSS handles skin) -->
        <h1 data-reveal data-delay="100" class="heading-xl about-heading mb-8"
          data-token="$font-size-heading-xl: clamp(2.25rem, 5vw, 4.5rem)|$font-weight: 600 (semibold)|$spacing-bottom: 2rem / 32px">
          <span class="whitespace-nowrap">Diseñador, pensador,</span><br />
          <span class="text-primary-500"><WordsCarousel words={aboutWords} interval={3000} /></span>
        </h1>

        <!-- Subtitle (same element for both modes) -->
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl"
          data-token="$font-family-sans: Inter|$color-text-muted: #7c766c">
          Con más de 6 años de experiencia, he dedicado mi carrera a crear productos digitales que combinan estética, usabilidad y estrategia de negocio.
        </p>
      </div>
    </div>
  </section>

  <!-- Hero (code mode): personal.config.ts -->
  <section class="section-padding about-hero-code" data-component="AboutHeroCode">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div class="file-block about-hero-window">
          <div class="file-block__titlebar">
            <div class="pmd-dots">
              <span class="pmd-dot" style="background:#ff5f57"></span>
              <span class="pmd-dot" style="background:#febc2e"></span>
              <span class="pmd-dot" style="background:#28c840"></span>
            </div>
            <span class="file-block__filename">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline;vertical-align:-2px;margin-right:4px;color:#3178c6">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h3a3 3 0 010 6H9m6-6v10"/>
              </svg>
              personal.config.ts
            </span>
            <span class="file-block__tab">
              <span class="file-block__tab-branch">main*</span>
            </span>
          </div>
          <div class="file-block__body">
            <div class="file-block__line"><span class="file-block__gutter">1</span><span class="file-block__code"><span class="pmd-keyword">import type</span> <span class="pmd-bracket">{`{`}</span> <span class="pmd-fn">Profile</span> <span class="pmd-bracket">{`}`}</span> <span class="pmd-keyword">from</span> <span class="pmd-string">'@types'</span><span class="pmd-punct">;</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">2</span><span class="file-block__code"></span></div>
            <div class="file-block__line"><span class="file-block__gutter">3</span><span class="file-block__code"><span class="pmd-keyword">export const</span> <span class="pmd-fn">personalProfile</span><span class="pmd-punct">:</span> <span class="pmd-fn">Profile</span> <span class="pmd-punct">=</span> <span class="pmd-bracket">{`{`}</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">4</span><span class="file-block__code">  <span class="pmd-key">name</span><span class="pmd-punct">:</span> <span class="pmd-string">"Ramón Riera"</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">5</span><span class="file-block__code">  <span class="pmd-key">role</span><span class="pmd-punct">:</span> <span class="pmd-string">"UX Lead & Product Designer"</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">6</span><span class="file-block__code">  <span class="pmd-key">experience</span><span class="pmd-punct">:</span> <span class="pmd-string">"8+ years"</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">7</span><span class="file-block__code">  <span class="pmd-key">status</span><span class="pmd-punct">:</span> <span class="pmd-impact">"available_for_new_projects"</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">8</span><span class="file-block__code"></span></div>
            <div class="file-block__line"><span class="file-block__gutter">9</span><span class="file-block__code">  <span class="pmd-key">specialties</span><span class="pmd-punct">:</span> <span class="pmd-bracket">[</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">10</span><span class="file-block__code">    <span class="pmd-string">"Design Systems"</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">11</span><span class="file-block__code">    <span class="pmd-string">"Product Strategy"</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">12</span><span class="file-block__code">    <span class="pmd-string">"UX Operations"</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">13</span><span class="file-block__code">  <span class="pmd-bracket">]</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">14</span><span class="file-block__code"></span></div>
            <div class="file-block__line"><span class="file-block__gutter">15</span><span class="file-block__code">  <span class="pmd-key">vision</span><span class="pmd-punct">:</span> <span class="pmd-bracket">{`{`}</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">16</span><span class="file-block__code">    <span class="pmd-key">data_driven</span><span class="pmd-punct">:</span> <span class="pmd-impact">true</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">17</span><span class="file-block__code">    <span class="pmd-key">user_centric</span><span class="pmd-punct">:</span> <span class="pmd-impact">true</span><span class="pmd-punct">,</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">18</span><span class="file-block__code">    <span class="pmd-key">outcome_focused</span><span class="pmd-punct">:</span> <span class="pmd-impact">true</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">19</span><span class="file-block__code">  <span class="pmd-bracket">{`}`}</span></span></div>
            <div class="file-block__line"><span class="file-block__gutter">20</span><span class="file-block__code"><span class="pmd-bracket">{`}`}</span><span class="pmd-punct">;</span></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo + Bio -->
  <section class="pb-20" data-component="BiographySection">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-16">
        <!-- Photo -->
        <div data-reveal="left" class="lg:col-span-2">
          <div class="lg:sticky lg:top-28">
            <!-- Design mode photo -->
            <div class="rounded-2xl overflow-hidden dashed-border mb-6 about-pg-photo-design">
              <Image
                src={profileImg}
                alt="Ramon Riera"
                class="w-full aspect-[4/5] object-cover grayscale hover:grayscale-0 transition-[filter] duration-700"
                loading="lazy"
                decoding="async"
                widths={[400, 800]}
                sizes="(max-width: 1024px) 100vw, 40vw"
              />
            </div>
            <!-- Code mode photo: Asset Viewer -->
            <div class="mb-6 about-pg-photo-code">
              <div class="asset-preview">
                <div class="asset-preview__toolbar">
                  <div class="asset-preview__path">
                    <svg class="asset-preview__path-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span class="asset-preview__path-dir">assets</span>
                    <span class="asset-preview__path-sep">&gt;</span>
                    <span class="asset-preview__path-dir">shared</span>
                    <span class="asset-preview__path-sep">&gt;</span>
                    <span class="asset-preview__path-file">foto_perfil.png</span>
                  </div>
                  <div class="asset-preview__dims">
                    <span>800 × 1000</span>
                    <span class="asset-preview__dims-sep">|</span>
                    <span>PNG</span>
                  </div>
                </div>
                <div class="asset-preview__canvas">
                  <div class="asset-preview__img-wrap">
                    <Image
                      src={profileImg}
                      alt="Ramon Riera"
                      class="asset-preview__img"
                      loading="lazy"
                      decoding="async"
                      widths={[400, 800]}
                      sizes="(max-width: 1024px) 100vw, 40vw"
                    />
                  </div>
                </div>
                <div class="asset-preview__status">
                  <span class="asset-preview__status-item">Layer: Profile</span>
                  <span class="asset-preview__status-sep">|</span>
                  <span class="asset-preview__status-item">Format: PNG</span>
                </div>
              </div>
            </div>

            <!-- Social links: Normal mode -->
            <div class="flex items-center gap-4 social-normal" data-component="SocialLinks" data-token="$spacing-gap: 1rem / 16px">
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
              </a>
              <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" /></svg>
              </a>
            </div>
            <!-- Social links: Code mode (import syntax with icons) -->
            <div class="social-code flex flex-col gap-2">
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-import social-import--linkedin">
                <svg class="social-import-icon w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <span class="code-keyword">import</span> {'{'} <span class="code-import-name">LinkedIn</span> {'}'} <span class="code-keyword">from</span> <span class="code-string">'@socials'</span>
              </a>
              <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" class="social-import social-import--medium">
                <svg class="social-import-icon w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
                <span class="code-keyword">import</span> {'{'} <span class="code-import-name">Medium</span> {'}'} <span class="code-keyword">from</span> <span class="code-string">'@blog'</span>
              </a>
              <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer" class="social-import social-import--cv">
                <svg class="social-import-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" /></svg>
                <span class="code-fn">fetch</span><span class="code-parens">(</span><span class="code-string">'/cv_riera.pdf'</span><span class="code-parens">)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Bio content -->
        <div class="lg:col-span-3 space-y-12">
          <div data-reveal>
            <h2 class="heading-md mb-6">Mi historia</h2>
            <!-- Normal mode: prose paragraphs -->
            <div class="bio-prose space-y-4 text-body">
              <p>
                Empecé mi carrera como <strong>diseñador gráfico</strong>, pero rápidamente descubrí que mi verdadera pasión estaba en la <strong>intersección entre diseño y tecnología</strong>. El mundo digital me fascinó por su capacidad de crear experiencias que impactan a millones de personas.
              </p>
              <p>
                A lo largo de estos años he tenido el privilegio de trabajar con empresas como <strong>Banco Sabadell</strong>, <strong>Iberia</strong>, y <strong>Doctori</strong>, donde he podido aplicar mi experiencia en <strong>Design Systems</strong>, <strong>Product Design</strong> y <strong>Design Operations</strong> para transformar productos digitales complejos en experiencias intuitivas.
              </p>
              <p>
                Mi enfoque combina metodologías como <strong>Design Thinking</strong>, <strong>Lean UX</strong> y <strong>Agile</strong>, siempre con el usuario en el centro. Creo firmemente que el diseño no es solo cómo se ve algo, sino <strong>cómo funciona, cómo se siente y qué problema resuelve</strong>.
              </p>
              <p>
                Cuando no estoy diseñando, probablemente estoy explorando nuevas herramientas, leyendo sobre <strong>psicología cognitiva</strong> o experimentando con <strong>código creativo</strong>.
              </p>
            </div>
            <!-- Code mode: bio.md file-block (lines 1–25) -->
            <div class="about-code-block about-bio-code">
              <div class="file-block">
                <div class="file-block__titlebar">
                  <div class="pmd-dots">
                    <span class="pmd-dot" style="background:#ff5f57"></span>
                    <span class="pmd-dot" style="background:#febc2e"></span>
                    <span class="pmd-dot" style="background:#28c840"></span>
                  </div>
                  <span class="file-block__filename">bio.md</span>
                  <span class="file-block__tab">bio.md</span>
                </div>
                <div class="file-block__body">
                  <div class="file-block__line"><span class="file-block__gutter">1</span><span class="file-block__code"><span class="pmd-comment">/**</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">2</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@module</span> ramon-riera</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">3</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@version</span> 8.0.0</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">4</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@description</span></span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">5</span><span class="file-block__code"><span class="pmd-comment"> *</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">6</span><span class="file-block__code"><span class="pmd-comment"> * Empecé mi carrera como diseñador gráfico, pero rápidamente</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">7</span><span class="file-block__code"><span class="pmd-comment"> * descubrí que mi verdadera pasión estaba en la intersección</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">8</span><span class="file-block__code"><span class="pmd-comment"> * entre <span class="pmd-impact">diseño</span> y <span class="pmd-impact">tecnología</span>.</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">9</span><span class="file-block__code"><span class="pmd-comment"> *</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">10</span><span class="file-block__code"><span class="pmd-comment"> * He tenido el privilegio de trabajar con empresas como</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">11</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-impact">Banco Sabadell</span>, <span class="pmd-impact">Iberia</span>, y <span class="pmd-impact">Doctori</span>, aplicando mi</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">12</span><span class="file-block__code"><span class="pmd-comment"> * experiencia en <span class="pmd-impact">Design Systems</span>, <span class="pmd-impact">Product Design</span> y</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">13</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-impact">Design Operations</span>.</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">14</span><span class="file-block__code"><span class="pmd-comment"> *</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">15</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@methodology</span> <span class="pmd-impact">Design Thinking</span> | <span class="pmd-impact">Lean UX</span> | <span class="pmd-impact">Agile</span></span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">16</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@philosophy</span> El diseño no es solo cómo se ve algo,</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">17</span><span class="file-block__code"><span class="pmd-comment"> *   sino cómo funciona, cómo se siente y qué problema resuelve.</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">18</span><span class="file-block__code"><span class="pmd-comment"> *</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">19</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@idle</span> Explorando herramientas, leyendo sobre psicología</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">20</span><span class="file-block__code"><span class="pmd-comment"> *   cognitiva o experimentando con código creativo.</span></span></div>
                  <div class="file-block__line"><span class="file-block__gutter">21</span><span class="file-block__code"><span class="pmd-comment"> *</span></span></div>
