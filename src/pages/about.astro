---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { services, siteConfig } from '@/utils/data';

const process = [
  {
    step: '01',
    title: 'Descubrimiento',
    description: 'Entiendo el problema, los usuarios y el contexto de negocio a través de investigación y workshops.',
  },
  {
    step: '02',
    title: 'Estrategia',
    description: 'Defino la visión del producto, la arquitectura de información y los flujos de usuario clave.',
  },
  {
    step: '03',
    title: 'Diseño',
    description: 'Creo wireframes, prototipos y diseños de alta fidelidad, iterando con feedback constante.',
  },
  {
    step: '04',
    title: 'Validación',
    description: 'Testing con usuarios reales, análisis de datos y refinamiento basado en resultados.',
  },
  {
    step: '05',
    title: 'Entrega',
    description: 'Handoff detallado al equipo de desarrollo con specs, assets y documentación completa.',
  },
  {
    step: '06',
    title: 'Iteración',
    description: 'Monitorización post-lanzamiento y mejora continua basada en métricas y feedback.',
  },
];

const timeline = [
  { year: '2024', role: 'Senior UX/UI Designer', company: 'Doctori.com', description: 'Liderando Design Ops y el Design System para la plataforma de salud digital.' },
  { year: '2022', role: 'UX/UI Designer', company: 'Iberia', description: 'Rediseño de la experiencia digital de vuelo y sistemas de check-in.' },
  { year: '2021', role: 'Design System Lead', company: 'Banco Sabadell', description: 'Creación e implementación del design system corporativo.' },
  { year: '2020', role: 'UX Designer', company: 'iSalud Corporate', description: 'Rediseño del comparador de seguros y optimización de conversión.' },
  { year: '2018', role: 'UI Designer', company: 'Leemons', description: 'Diseño de interfaces para plataforma educativa innovadora.' },
  { year: '2016', role: 'Junior Designer', company: 'Freelance', description: 'Inicio de carrera profesional con proyectos de branding y web design.' },
];

const values = [
  { title: 'Usuario primero', description: 'Cada decisión de diseño parte de una necesidad real del usuario. La empatía es la base de todo.' },
  { title: 'Simplicidad', description: 'Lo simple es siempre más difícil. Elimino lo innecesario para que lo esencial brille.' },
  { title: 'Consistencia', description: 'Los sistemas de diseño no son solo componentes - son el lenguaje común de un equipo.' },
  { title: 'Colaboración', description: 'El mejor diseño nace de la colaboración multidisciplinar. Diseño con, no para.' },
];
---

<BaseLayout
  title="Sobre mí - Ramon Riera"
  description="Conoce a Ramon Riera, Senior UX/UI Designer especializado en Design Systems y Product Design."
>
  <!-- Hero -->
  <section class="section-padding" data-component="AboutHero">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8 flex items-center gap-3">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <!-- Head -->
              <circle cx="18" cy="12" r="6" class="icon-stroke icon-draw" />
              <!-- Body -->
              <path d="M18 18C12 18 8 23 8 29V36" class="icon-stroke icon-draw" />
              <path d="M18 18C24 18 28 23 28 29V36" class="icon-stroke icon-draw-delay" />
              <!-- Waving hand -->
              <g class="icon-hand-wave">
                <path d="M30 8L34 4" class="icon-accent" stroke-width="2" />
                <path d="M32 12L37 10" class="icon-accent" stroke-width="2" />
                <path d="M28 16L26 22" class="icon-stroke" stroke-width="1.8" />
                <circle cx="34" cy="4" r="1.2" class="icon-accent-fill" />
              </g>
              <!-- Sparkle lines -->
              <line x1="36" y1="6" x2="39" y2="5" class="icon-accent icon-wave-line-1" stroke-width="1.5" />
              <line x1="37" y1="14" x2="40" y2="14" class="icon-accent icon-wave-line-2" stroke-width="1.5" />
            </svg>
          </span>
          <span class="text-sm font-medium text-primary-500 tracking-wide">Sobre mí</span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-8"
          data-token="$font-size-heading-xl: clamp(2.25rem, 5vw, 4.5rem)|$font-weight: 600 (semibold)|$spacing-bottom: 2rem / 32px">
          Diseñador, pensador,
          <span class="text-primary-500"
            data-token="$color-primary-500: #D97757">creador</span>
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl"
          data-token="$font-family-sans: Inter|$color-text-muted: #7c766c">
          Con más de 8 años de experiencia, he dedicado mi carrera a crear productos digitales que combinan estética, usabilidad y estrategia de negocio.
        </p>
      </div>
    </div>
  </section>

  <!-- Photo + Bio -->
  <section class="pb-20" data-component="BiographySection">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">
        <!-- Photo -->
        <div data-reveal="left" class="lg:col-span-2">
          <div class="sticky top-28">
            <div class="rounded-2xl overflow-hidden dashed-border mb-6">
              <img
                src="/assets/shared/foto-perfil.png"
                alt="Ramon Riera"
                class="w-full aspect-[4/5] object-cover"
              />
            </div>

            <!-- Social links -->
            <div class="flex items-center gap-4" data-component="SocialLinks" data-token="$spacing-gap: 1rem / 16px">
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
              </a>
              <a href={siteConfig.social.dribbble} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.375 0 0 5.375 0 12s5.375 12 12 12 12-5.375 12-12S18.625 0 12 0zm7.938 5.563a10.18 10.18 0 012.312 6.375c-.338-.063-3.725-.75-7.125-.325a16.28 16.28 0 00-.45-1.075c-.15-.35-.313-.7-.488-1.05 3.75-1.525 5.45-3.713 5.75-4.113v.188zM12 1.75c2.625 0 5.025 1.013 6.813 2.663-.25.35-1.763 2.4-5.375 3.75A68.345 68.345 0 0010 2C10.638 1.85 11.3 1.75 12 1.75zM8.113 2.625a52.27 52.27 0 013.45 7.5c-4.35 1.163-8.188 1.138-8.6 1.138A10.305 10.305 0 018.112 2.625zM1.75 12v-.313c.4.013 5 .075 9.65-1.325.263.525.525 1.063.763 1.6l-.35.088c-4.875 1.575-7.463 5.875-7.788 6.413A10.196 10.196 0 011.75 12zm3.538 7.95c.213-.363 2.163-4.163 7.413-6.088a43.08 43.08 0 012 7.175A10.206 10.206 0 0112 22.25a10.22 10.22 0 01-6.713-2.3zm8.575 1.625a46.54 46.54 0 00-1.875-6.813c3.125-.5 5.875.325 6.225.425a10.244 10.244 0 01-4.35 6.388z"/></svg>
              </a>
              <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Bio content -->
        <div class="lg:col-span-3 space-y-12">
          <div data-reveal>
            <h2 class="heading-md mb-6">Mi historia</h2>
            <div class="space-y-4 text-body">
              <p>
                Empecé mi carrera como diseñador gráfico, pero rápidamente descubrí que mi verdadera pasión estaba en la intersección entre diseño y tecnología. El mundo digital me fascinó por su capacidad de crear experiencias que impactan a millones de personas.
              </p>
              <p>
                A lo largo de estos años he tenido el privilegio de trabajar con empresas como Banco Sabadell, Iberia, y Doctori, donde he podido aplicar mi experiencia en Design Systems, Product Design y Design Operations para transformar productos digitales complejos en experiencias intuitivas.
              </p>
              <p>
                Mi enfoque combina metodologías como Design Thinking, Lean UX y Agile, siempre con el usuario en el centro. Creo firmemente que el diseño no es solo cómo se ve algo, sino cómo funciona, cómo se siente y qué problema resuelve.
              </p>
              <p>
                Cuando no estoy diseñando, probablemente estoy explorando nuevas herramientas, leyendo sobre psicología cognitiva o experimentando con código creativo.
              </p>
            </div>
          </div>

          <!-- Values -->
          <div data-reveal data-component="ValuesGrid">
            <h2 class="heading-md mb-6">Mis valores</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {values.map((value) => (
                <div class="p-6 rounded-xl dashed-border" data-component="ValueCard" data-token="$spacing-padding: 1.5rem / 24px|$radius-xl: 0.75rem / 12px">
                  <h3 class="font-bold text-lg mb-2">{value.title}</h3>
                  <p class="text-body-sm">{value.description}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Timeline -->
          <div data-reveal data-component="CareerTimeline">
            <h2 class="heading-md mb-8">Trayectoria</h2>
            <div class="space-y-0">
              {timeline.map((item, i) => (
                <div class="relative pl-8 pb-8 border-l-2 border-dark-200 last:pb-0 last:border-l-transparent group">
                  <div class="absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-white border-2 border-primary-500 group-hover:bg-primary-500 transition-colors duration-300"></div>
                  <span class="text-xs text-primary-500 font-semibold">{item.year}</span>
                  <h3 class="font-bold text-lg mt-1">{item.role}</h3>
                  <p class="text-sm font-medium text-dark-400 mb-2">{item.company}</p>
                  <p class="text-body-sm">{item.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="section-padding" data-component="TechStackSection">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div data-reveal class="mb-6">
          <span class="text-sm font-medium text-primary-500 tracking-wide">Stack</span>
        </div>
        <h2 data-reveal data-delay="100" class="heading-lg mb-4">
          Herramientas que <span class="text-primary-500">domino</span>
        </h2>
        <p data-reveal data-delay="200" class="text-body">
          Un ecosistema de herramientas que me permiten diseñar, desarrollar y escalar productos digitales.
        </p>
      </div>

      <!-- Stack container with fixed min-height to prevent layout shift -->
      <div class="tech-stack-container" data-reveal data-delay="300">
        <!-- Normal Mode: Icon Grid -->
        <div class="tech-stack-grid" data-component="TechStackGrid" data-token="$grid-columns: 3|$gap: 2rem / 32px">
          <!-- Design Column -->
          <div class="p-8 rounded-2xl dashed-border bg-white" data-component="StackColumn">
            <h3 class="text-xs font-semibold text-primary-500 tracking-widest uppercase mb-8">Design</h3>
            <div class="space-y-5">
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-1 0-.83.67-1.5 1.5-1.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9zM6.5 13c-.83 0-1.5-.67-1.5-1.5S5.67 10 6.5 10s1.5.67 1.5 1.5S7.33 13 6.5 13zm3-4C8.67 9 8 8.33 8 7.5S8.67 6 9.5 6s1.5.67 1.5 1.5S10.33 9 9.5 9zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 6 14.5 6s1.5.67 1.5 1.5S15.33 9 14.5 9zm3 4c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Figma</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Tokens Studio</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.745 3A23.933 23.933 0 003 12c0 3.183.62 6.22 1.745 9M19.255 3C20.38 5.78 21 8.817 21 12s-.62 6.22-1.745 9m-13.51-9h12.51" /><circle cx="12" cy="12" r="3" /></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Variables</span>
              </div>
            </div>
          </div>

          <!-- Development Column -->
          <div class="p-8 rounded-2xl dashed-border bg-white" data-component="StackColumn">
            <h3 class="text-xs font-semibold text-primary-500 tracking-widest uppercase mb-8">Development</h3>
            <div class="space-y-5">
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.31 0-.592.06-.846.18C4.803 2.18 4.157 4.16 4.59 7.068c-2.57.9-4.157 2.277-4.157 3.936 0 1.66 1.587 3.037 4.157 3.936-.433 2.908.213 4.889 1.667 5.555.254.12.536.18.846.18 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.604 4.887 2.604.31 0 .592-.06.846-.18 1.454-.666 2.1-2.647 1.667-5.555 2.57-.9 4.157-2.277 4.157-3.936 0-1.659-1.587-3.036-4.157-3.936.433-2.908-.213-4.889-1.667-5.555a1.986 1.986 0 0 0-.846-.18zM12 15.065a3.065 3.065 0 1 1 0-6.13 3.065 3.065 0 0 1 0 6.13z"/></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">React</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Tailwind</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm-1.243 20.844l-.189-.09c-.395-.191-.587-.36-.587-.72v-.84c0-.54-.16-1.2-.9-1.2h-.28c-1.6 0-3.01-1.19-3.01-2.79v-.36c0-.26.22-.48.48-.48h.4c.28 0 .48.22.48.48v.36c0 .89.73 1.35 1.65 1.35h.28c1.16 0 2.34.77 2.34 2.64v.84c0 .36.1.42.19.48.42.21.48.78.09 1.07-.12.08-.33.21-.94.27zm3.576-.27c-.61-.06-.82-.19-.94-.27-.39-.29-.33-.86.09-1.07.09-.06.19-.12.19-.48v-.84c0-1.87 1.18-2.64 2.34-2.64h.28c.92 0 1.65-.46 1.65-1.35v-.36c0-.26.2-.48.48-.48h.4c.26 0 .48.22.48.48v.36c0 1.6-1.41 2.79-3.01 2.79h-.28c-.74 0-.9.66-.9 1.2v.84c0 .36-.192.529-.587.72l-.189.09z"/></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Storybook</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="currentColor"><path d="M11.998 0C5.373 0 0 5.373 0 12.002 0 17.302 3.438 21.8 8.207 23.387c.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12.002 24 5.373 18.627 0 11.998 0z"/></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Git</span>
              </div>
            </div>
          </div>

          <!-- Strategy Column -->
          <div class="p-8 rounded-2xl dashed-border bg-white" data-component="StackColumn">
            <h3 class="text-xs font-semibold text-primary-500 tracking-widest uppercase mb-8">Strategy</h3>
            <div class="space-y-5">
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" /></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Linear</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.992 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Agile</span>
              </div>
              <div class="flex items-center gap-4 group">
                <div class="w-10 h-10 rounded-lg bg-dark-50 flex items-center justify-center group-hover:bg-primary-50 transition-colors">
                  <svg class="w-5 h-5 text-dark-500 group-hover:text-primary-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                </div>
                <span class="text-sm font-medium text-dark-700">Documentation</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Code Mode: JSON Profile -->
        <div class="tech-stack-json" data-component="JSONProfile">
          <div class="json-window">
            <div class="json-titlebar">
              <div class="json-dots">
                <span class="json-dot json-dot--red"></span>
                <span class="json-dot json-dot--yellow"></span>
                <span class="json-dot json-dot--green"></span>
              </div>
              <span class="json-filename">profile.json</span>
            </div>
            <pre class="json-body"><code><span class="json-bracket">{</span>
  <span class="json-key">"profile"</span><span class="json-colon">:</span> <span class="json-string">"Ramon Riera"</span><span class="json-comma">,</span>
  <span class="json-key">"role"</span><span class="json-colon">:</span> <span class="json-string">"Design Systems Lead"</span><span class="json-comma">,</span>
  <span class="json-key">"stack"</span><span class="json-colon">:</span> <span class="json-bracket">{</span>
    <span class="json-key">"design"</span><span class="json-colon">:</span> <span class="json-bracket">[</span><span class="json-string">"Figma"</span><span class="json-comma">,</span> <span class="json-string">"Tokens Studio"</span><span class="json-comma">,</span> <span class="json-string">"Variables"</span><span class="json-bracket">]</span><span class="json-comma">,</span>
    <span class="json-key">"dev"</span><span class="json-colon">:</span> <span class="json-bracket">[</span><span class="json-string">"React"</span><span class="json-comma">,</span> <span class="json-string">"Tailwind"</span><span class="json-comma">,</span> <span class="json-string">"Storybook"</span><span class="json-comma">,</span> <span class="json-string">"Git"</span><span class="json-bracket">]</span><span class="json-comma">,</span>
    <span class="json-key">"ops"</span><span class="json-colon">:</span> <span class="json-bracket">[</span><span class="json-string">"Linear"</span><span class="json-comma">,</span> <span class="json-string">"Agile"</span><span class="json-comma">,</span> <span class="json-string">"Documentation"</span><span class="json-bracket">]</span>
  <span class="json-bracket">}</span><span class="json-comma">,</span>
  <span class="json-key">"metrics"</span><span class="json-colon">:</span> <span class="json-bracket">{</span>
    <span class="json-key">"efficiency_boost"</span><span class="json-colon">:</span> <span class="json-string">"<span class="json-number">+40%</span>"</span><span class="json-comma">,</span>
    <span class="json-key">"component_adoption"</span><span class="json-colon">:</span> <span class="json-string">"<span class="json-number">95%</span>"</span>
  <span class="json-bracket">}</span>
<span class="json-bracket">}</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialties -->
  <section class="section-padding" data-component="SpecialtiesSection">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div data-reveal class="mb-6">
          <span class="text-sm font-medium text-primary-500 tracking-wide">Especialidades</span>
        </div>
        <h2 data-reveal data-delay="100" class="heading-lg mb-4">
          Lo que hago <span class="text-primary-500">mejor</span>
        </h2>
        <p data-reveal data-delay="200" class="text-body">
          Combinando diseño estratégico con ejecución técnica para crear productos digitales excepcionales.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <div
            data-reveal
            data-delay={String(i * 100)}
            class="group p-8 rounded-2xl dashed-border bg-white card-hover"
            data-component="ServiceCard" data-token="$spacing-padding: 2rem / 32px|$radius-2xl: 1rem / 16px"
          >
            <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center mb-6 group-hover:bg-primary-500 group-hover:text-white transition-all duration-300">
              <svg class="w-6 h-6 text-primary-500 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                {service.icon === 'layout' && <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />}
                {service.icon === 'layers' && <path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />}
                {service.icon === 'box' && <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />}
                {service.icon === 'settings' && <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />}
                {service.icon === 'settings' && <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />}
                {service.icon === 'star' && <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />}
                {service.icon === 'search' && <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />}
              </svg>
            </div>
            <h3 class="heading-sm mb-3">{service.title}</h3>
            <p class="text-body-sm">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section-padding" data-component="ProcessSection">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div data-reveal class="mb-6">
          <span class="text-sm font-medium text-primary-500 tracking-wide">Proceso</span>
        </div>
        <h2 data-reveal data-delay="100" class="heading-lg mb-4">
          Cómo <span class="text-primary-500">trabajo</span>
        </h2>
        <p data-reveal data-delay="200" class="text-body">
          Un proceso iterativo y colaborativo que garantiza resultados alineados con tus objetivos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {process.map((item, i) => (
          <div data-reveal data-delay={String(i * 100)} class="relative p-8 rounded-2xl dashed-border bg-white"
            data-component="ProcessStep" data-token="$spacing-padding: 2rem / 32px|$radius-2xl: 1rem / 16px">
            <span class="text-6xl font-black text-dark-100 absolute top-4 right-6">
              {item.step}
            </span>
            <div class="relative z-10">
              <h3 class="heading-sm mb-3">{item.title}</h3>
              <p class="text-body-sm">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding" data-component="CallToAction">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <h2 data-reveal class="heading-lg mb-6">
        ¿Listo para empezar?
      </h2>
      <p data-reveal data-delay="100" class="text-body text-lg mb-10">
        Cuéntame sobre tu proyecto y veamos cómo puedo ayudarte a alcanzar tus objetivos de diseño.
      </p>
      <div data-reveal data-delay="200" class="flex flex-wrap items-center justify-center gap-4">
        <a href={`mailto:${siteConfig.email}`} class="btn-primary text-base"
          data-component="ButtonPrimary"
          data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href={`mailto:${siteConfig.email}`} class="btn-outline text-base"
          data-component="ButtonOutline"
          data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px">
          {siteConfig.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
