    color: var(--color-primary-500, #D97757);
    position: relative;
  }

  .typewriter-word {
    display: inline-block;
    border-bottom: 2px solid currentColor;
    padding-bottom: 2px;
  }

  .typewriter-cursor {
    display: inline-block;
    animation: blink-cursor 0.7s step-end infinite;
    font-weight: 300;
    margin-left: 1px;
    color: currentColor;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Code mode overrides ── */
  .typewriter-slot--code {
    color: var(--cm-tag, #ff79c6);
  }

  body.code-mode .typewriter-slot {
    color: var(--cm-tag, #ff79c6);
  }

  body.code-mode .typewriter-word {
    border-bottom-color: var(--cm-tag, #ff79c6);
  }
</style>

