---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import profileImg from '@/assets/shared/foto-perfil.png';
import { siteConfig, mainTimeline, consultingBlock } from '@/utils/data';
---

<BaseLayout
  title="About ⚡ Ramon Riera"
  description="Conoce a Ramon Riera, Design Systems & Strategy Lead especializado en UX Strategy, DesignOps y Product Design."
>
  <!-- Hero -->
  <section class="section-padding" data-component="AboutHero">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <!-- Lightbulb body -->
              <path d="M16 28C16 24 12 22 12 16C12 10.5 16.5 6 22 6C27.5 6 32 10.5 32 16C32 22 28 24 28 28" class="icon-stroke icon-draw" />
              <!-- Bulb base -->
              <path d="M16 28H28" class="icon-stroke icon-draw-delay" />
              <path d="M17 32H27" class="icon-stroke icon-draw-delay" />
              <path d="M19 36H25" class="icon-accent icon-draw-delay" />
              <!-- Filament -->
              <g class="icon-bulb-glow">
                <path d="M19 18C19 18 20.5 20 22 20C23.5 20 25 18 25 18" class="icon-accent icon-draw-delay" />
              </g>
              <!-- Light rays -->
              <line x1="22" y1="1" x2="22" y2="4" class="icon-accent icon-bulb-ray-1" stroke-width="1.5" />
              <line x1="35" y1="8" x2="33" y2="10" class="icon-accent icon-bulb-ray-2" stroke-width="1.5" />
              <line x1="9" y1="8" x2="11" y2="10" class="icon-accent icon-bulb-ray-3" stroke-width="1.5" />
              <line x1="38" y1="16" x2="35" y2="16" class="icon-accent icon-bulb-ray-1" stroke-width="1.5" />
              <line x1="6" y1="16" x2="9" y2="16" class="icon-accent icon-bulb-ray-2" stroke-width="1.5" />
            </svg>
          </span>
        </div>
        <!-- Normal mode title -->
        <h1 data-reveal data-delay="100" class="heading-xl mb-8 about-title-normal"
          data-token="$font-size-heading-xl: clamp(2.25rem, 5vw, 4.5rem)|$font-weight: 600 (semibold)|$spacing-bottom: 2rem / 32px">
          Diseñador, pensador,
          <span class="text-primary-500"
            data-token="$color-primary-500: #D97757">creador</span>
        </h1>
        <!-- Code mode title: console.log -->
        <h1 data-reveal data-delay="100" class="heading-xl mb-8 about-title-code">
          <span class="code-fn">console</span><span class="code-punct">.</span><span class="code-fn">log</span><span class="code-punct">(</span><span class="code-str">"Diseñador, pensador, </span><span class="code-accent">creador</span><span class="code-str">"</span><span class="code-punct">)</span>
        </h1>

        <!-- Normal mode description -->
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl about-desc-normal"
          data-token="$font-family-sans: Inter|$color-text-muted: #7c766c">
          Con más de 8 años de experiencia, he dedicado mi carrera a crear productos digitales que combinan estética, usabilidad y estrategia de negocio.
        </p>
        <!-- Code mode description: comment block -->
        <div data-reveal data-delay="200" class="about-desc-code">
          <span>/*</span><br/>
          <span>&nbsp;* Con más de 8 años de experiencia, he dedicado mi carrera</span><br/>
          <span>&nbsp;* a crear <span class="comment-highlight">productos digitales</span> que combinan estética,</span><br/>
          <span>&nbsp;* <span class="comment-highlight">usabilidad</span> y <span class="comment-highlight">estrategia de negocio</span>.</span><br/>
          <span>&nbsp;*/</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo + Bio -->
  <section class="pb-20" data-component="BiographySection">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-16">
        <!-- Photo -->
        <div data-reveal="left" class="lg:col-span-2">
          <div class="lg:sticky lg:top-28">
            <div class="rounded-2xl overflow-hidden dashed-border mb-6">
              <Image
                src={profileImg}
                alt="Ramon Riera"
                class="w-full aspect-[4/5] object-cover grayscale hover:grayscale-0 transition-[filter] duration-700"
                loading="lazy"
                decoding="async"
                widths={[400, 800]}
                sizes="(max-width: 1024px) 100vw, 40vw"
              />
            </div>

            <!-- Social links -->
            <div class="flex items-center gap-4" data-component="SocialLinks" data-token="$spacing-gap: 1rem / 16px">
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
              </a>
              <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg dashed-border hover:bg-primary-50 hover:border-primary-500 transition-all duration-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" /></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Bio content -->
        <div class="lg:col-span-3 space-y-12">
          <div data-reveal>
            <h2 class="heading-md mb-6">Mi historia</h2>
            <!-- Normal mode: prose paragraphs -->
            <div class="bio-prose space-y-4 text-body">
              <p>
                Empecé mi carrera como diseñador gráfico, pero rápidamente descubrí que mi verdadera pasión estaba en la intersección entre diseño y tecnología. El mundo digital me fascinó por su capacidad de crear experiencias que impactan a millones de personas.
              </p>
              <p>
                A lo largo de estos años he tenido el privilegio de trabajar con empresas como Banco Sabadell, Iberia, y Doctori, donde he podido aplicar mi experiencia en Design Systems, Product Design y Design Operations para transformar productos digitales complejos en experiencias intuitivas.
              </p>
              <p>
                Mi enfoque combina metodologías como Design Thinking, Lean UX y Agile, siempre con el usuario en el centro. Creo firmemente que el diseño no es solo cómo se ve algo, sino cómo funciona, cómo se siente y qué problema resuelve.
              </p>
              <p>
                Cuando no estoy diseñando, probablemente estoy explorando nuevas herramientas, leyendo sobre psicología cognitiva o experimentando con código creativo.
              </p>
            </div>
            <!-- Code mode: README / JSDoc comment block -->
            <div class="bio-readme">
              <div class="readme-window">
                <div class="readme-titlebar">
                  <div class="readme-dots">
                    <span class="json-dot json-dot--red"></span>
                    <span class="json-dot json-dot--yellow"></span>
                    <span class="json-dot json-dot--green"></span>
                  </div>
                  <span class="readme-filename">
                    <svg class="readme-file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                    README.md
                  </span>
                  <span class="readme-tab-active">README.md</span>
                </div>
                <pre class="readme-body"><code><span class="readme-comment">/**</span>
<span class="readme-comment"> * <span class="readme-tag">@module</span> ramon-riera</span>
<span class="readme-comment"> * <span class="readme-tag">@version</span> 8.0.0</span>
<span class="readme-comment"> * <span class="readme-tag">@description</span></span>
<span class="readme-comment"> *</span>
<span class="readme-comment"> * Empecé mi carrera como diseñador gráfico, pero rápidamente</span>
<span class="readme-comment"> * descubrí que mi verdadera pasión estaba en la intersección</span>
<span class="readme-comment"> * entre <span class="readme-highlight">diseño</span> y <span class="readme-highlight">tecnología</span>. El mundo digital me fascinó</span>
<span class="readme-comment"> * por su capacidad de crear experiencias que impactan a</span>
<span class="readme-comment"> * millones de personas.</span>
<span class="readme-comment"> *</span>
<span class="readme-comment"> * He tenido el privilegio de trabajar con empresas como</span>
<span class="readme-comment"> * <span class="readme-highlight">Banco Sabadell</span>, <span class="readme-highlight">Iberia</span>, y <span class="readme-highlight">Doctori</span>, aplicando mi</span>
<span class="readme-comment"> * experiencia en Design Systems, Product Design y Design</span>
<span class="readme-comment"> * Operations para transformar productos digitales complejos</span>
<span class="readme-comment"> * en experiencias intuitivas.</span>
<span class="readme-comment"> *</span>
<span class="readme-comment"> * <span class="readme-tag">@methodology</span> Design Thinking | Lean UX | Agile</span>
<span class="readme-comment"> * <span class="readme-tag">@philosophy</span> El diseño no es solo cómo se ve algo,</span>
<span class="readme-comment"> *   sino cómo funciona, cómo se siente y qué problema resuelve.</span>
<span class="readme-comment"> *</span>
<span class="readme-comment"> * <span class="readme-tag">@idle</span> Explorando herramientas, leyendo sobre psicología</span>
<span class="readme-comment"> *   cognitiva o experimentando con código creativo.</span>
<span class="readme-comment"> *</span>
<span class="readme-comment"> * <span class="readme-tag">@license</span> MIT</span>
<span class="readme-comment"> */</span></code></pre>
              </div>
            </div>
          </div>

          <!-- Cómo trabajo — Visual Mode -->
          <div data-reveal data-component="ProcessSection">
            <h2 class="heading-md mb-8 process-title-normal">Cómo trabajo</h2>
            <h2 class="heading-md mb-8 process-title-code"><span class="code-comment">// </span>how_i_work<span class="code-punct">()</span></h2>

            <!-- Normal mode: 2×2 grid with SVG diagrams -->
            <div class="process-grid-normal grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Discovery -->
              <div class="process-card group p-5 md:p-6 rounded-2xl dashed-border bg-white">
                <div class="flex items-start gap-4 mb-4">
                  <div class="process-card-icon flex-shrink-0 w-12 h-12 rounded-xl dashed-border flex items-center justify-center bg-dark-50 group-hover:bg-primary-50 transition-colors duration-300">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" class="text-dark-400 group-hover:text-primary-500 transition-colors duration-300">
                      <circle cx="9" cy="10" r="5" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.6"/>
                      <circle cx="19" cy="10" r="5" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.6"/>
                      <circle cx="14" cy="18" r="5" stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.6"/>
                      <circle cx="14" cy="12.5" r="1.5" fill="currentColor" opacity="0.8"/>
                    </svg>
                  </div>
                  <div>
                    <span class="process-card-step text-[10px] font-semibold tracking-[0.2em] uppercase text-primary-500">01</span>
                    <h3 class="font-bold text-lg">Discovery</h3>
                  </div>
                </div>
                <p class="text-body-sm">Enmarco el problema antes de producir. Entrevistas con stakeholders, análisis de datos y alineación de diseño con objetivos de negocio.</p>
              </div>

              <!-- Sistemas -->
              <div class="process-card group p-5 md:p-6 rounded-2xl dashed-border bg-white">
                <div class="flex items-start gap-4 mb-4">
                  <div class="process-card-icon flex-shrink-0 w-12 h-12 rounded-xl dashed-border flex items-center justify-center bg-dark-50 group-hover:bg-primary-50 transition-colors duration-300">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" class="text-dark-400 group-hover:text-primary-500 transition-colors duration-300">
                      <rect x="3" y="3" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2" fill="none"/>
                      <rect x="17" y="3" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
                      <rect x="3" y="17" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
                      <rect x="17" y="17" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2" fill="none"/>
                      <line x1="11" y1="7" x2="17" y2="7" stroke="currentColor" stroke-width="1" opacity="0.4"/>
                      <line x1="7" y1="15" x2="7" y2="17" stroke="currentColor" stroke-width="1" opacity="0.4"/>
                      <line x1="21" y1="11" x2="21" y2="17" stroke="currentColor" stroke-width="1" opacity="0.4"/>
                    </svg>
                  </div>
                  <div>
                    <span class="process-card-step text-[10px] font-semibold tracking-[0.2em] uppercase text-primary-500">02</span>
                    <h3 class="font-bold text-lg">Sistemas</h3>
                  </div>
                </div>
                <p class="text-body-sm">Traduzco investigación en arquitectura: design tokens, librerías de componentes y patrones reutilizables que escalan entre productos.</p>
              </div>

              <!-- Implementación -->
              <div class="process-card group p-5 md:p-6 rounded-2xl dashed-border bg-white">
                <div class="flex items-start gap-4 mb-4">
                  <div class="process-card-icon flex-shrink-0 w-12 h-12 rounded-xl dashed-border flex items-center justify-center bg-dark-50 group-hover:bg-primary-50 transition-colors duration-300">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" class="text-dark-400 group-hover:text-primary-500 transition-colors duration-300">
                      <path d="M8 8L3 14L8 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M20 8L25 14L20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <line x1="16" y1="5" x2="12" y2="23" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
                    </svg>
                  </div>
                  <div>
                    <span class="process-card-step text-[10px] font-semibold tracking-[0.2em] uppercase text-primary-500">03</span>
                    <h3 class="font-bold text-lg">Implementación</h3>
                  </div>
                </div>
                <p class="text-body-sm">Trabajo codo a codo con desarrollo. Gestiono handoff, reviso implementación y aseguro que la intención de diseño sobreviva al código.</p>
              </div>

              <!-- Iteración -->
              <div class="process-card group p-5 md:p-6 rounded-2xl dashed-border bg-white">
                <div class="flex items-start gap-4 mb-4">
                  <div class="process-card-icon flex-shrink-0 w-12 h-12 rounded-xl dashed-border flex items-center justify-center bg-dark-50 group-hover:bg-primary-50 transition-colors duration-300">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" class="text-dark-400 group-hover:text-primary-500 transition-colors duration-300">
                      <path d="M21 10C21 6.134 17.866 3 14 3C11.28 3 8.92 4.573 7.8 6.85" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M7 18C7 21.866 10.134 25 14 25C16.72 25 19.08 23.427 20.2 21.15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M5 7L7.8 6.85L8 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M23 21L20.2 21.15L20 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="14" cy="14" r="2" fill="currentColor" opacity="0.5"/>
                    </svg>
                  </div>
                  <div>
                    <span class="process-card-step text-[10px] font-semibold tracking-[0.2em] uppercase text-primary-500">04</span>
                    <h3 class="font-bold text-lg">Iteración</h3>
                  </div>
                </div>
                <p class="text-body-sm">Mido el éxito con métricas reales: adopción, consistencia, velocidad. Feedback loops con usuarios y equipos definen cuándo el producto está terminado.</p>
              </div>
            </div>

            <!-- Code mode: pipeline flow -->
            <div class="process-grid-code">
              <div class="process-pipeline">
                <div class="process-pipeline-window">
                  <div class="process-pipeline-titlebar">
                    <div class="json-dots">
                      <span class="json-dot json-dot--red"></span>
                      <span class="json-dot json-dot--yellow"></span>
                      <span class="json-dot json-dot--green"></span>
                    </div>
                    <span class="process-pipeline-filename">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                      workflow.ts
                    </span>
                  </div>
                  <pre class="process-pipeline-body"><code><span class="pp-keyword">const</span> <span class="pp-fn">designPipeline</span> <span class="pp-punct">=</span> <span class="pp-bracket">[</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">stage</span><span class="pp-punct">:</span> <span class="pp-string">"discovery"</span><span class="pp-punct">,</span>
    <span class="pp-key">actions</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"stakeholder interviews"</span><span class="pp-punct">,</span> <span class="pp-string">"data analysis"</span><span class="pp-punct">,</span> <span class="pp-string">"goal alignment"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-key">output</span><span class="pp-punct">:</span> <span class="pp-string">"shared direction"</span>
  <span class="pp-bracket">{"}"}</span><span class="pp-punct">,</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">stage</span><span class="pp-punct">:</span> <span class="pp-string">"systems"</span><span class="pp-punct">,</span>
    <span class="pp-key">actions</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"tokens"</span><span class="pp-punct">,</span> <span class="pp-string">"components"</span><span class="pp-punct">,</span> <span class="pp-string">"patterns"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-key">output</span><span class="pp-punct">:</span> <span class="pp-string">"scalable architecture"</span>
  <span class="pp-bracket">{"}"}</span><span class="pp-punct">,</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">stage</span><span class="pp-punct">:</span> <span class="pp-string">"implementation"</span><span class="pp-punct">,</span>
    <span class="pp-key">actions</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"handoff"</span><span class="pp-punct">,</span> <span class="pp-string">"code review"</span><span class="pp-punct">,</span> <span class="pp-string">"QA"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-key">output</span><span class="pp-punct">:</span> <span class="pp-string">"design-faithful code"</span>
  <span class="pp-bracket">{"}"}</span><span class="pp-punct">,</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">stage</span><span class="pp-punct">:</span> <span class="pp-string">"iteration"</span><span class="pp-punct">,</span>
    <span class="pp-key">actions</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"metrics"</span><span class="pp-punct">,</span> <span class="pp-string">"feedback loops"</span><span class="pp-punct">,</span> <span class="pp-string">"adoption tracking"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-key">output</span><span class="pp-punct">:</span> <span class="pp-string">"continuous improvement"</span>
  <span class="pp-bracket">{"}"}</span>
<span class="pp-bracket">]</span><span class="pp-punct">;</span></code></pre>
                </div>
              </div>
            </div>
          </div>

          <!-- Design Principles -->
          <div data-reveal data-component="DesignPrinciples">
            <!-- Normal mode -->
            <h2 class="heading-md mb-8 principles-title-normal">Principios de Diseño</h2>
            <h2 class="heading-md mb-8 principles-title-code"><span class="code-comment">// </span>design_principles</h2>

            <div class="principles-normal">
              <div class="space-y-4">
                <div class="group p-5 md:p-6 rounded-2xl dashed-border bg-white hover:border-primary-300 transition-all duration-300">
                  <div class="flex items-start gap-4">
                    <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center text-primary-500 font-mono text-sm font-bold">01</span>
                    <div>
