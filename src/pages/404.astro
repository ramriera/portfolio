---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 ⚡ Ramon Riera">
  <section class="min-h-[70vh] flex items-center justify-center">
    <div class="container-custom text-center">
      <div data-reveal class="mb-8">
        <span class="text-[10rem] sm:text-[14rem] font-black text-dark-100 leading-none select-none">
          404
        </span>
      </div>
      <h1 data-reveal data-delay="100" class="heading-lg mb-4">
        Página no encontrada
      </h1>
      <p data-reveal data-delay="200" class="text-body text-lg mb-10 max-w-md mx-auto">
        La página que buscas no existe o ha sido movida. Vuelve al inicio para continuar navegando.
      </p>
      <div data-reveal data-delay="300">
        <a href="/" class="btn-primary text-base">
          Volver al inicio
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
