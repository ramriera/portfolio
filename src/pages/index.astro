---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

// 3-row editorial grid: 60/40, 40/60, 60/40
const projectOrder = [
  'massimo-dutti-conversion',   // Row 1: 60% (col-span-3)
  'iberia-flight-experience',   // Row 1: 40% (col-span-2)
  'banco-sabadell-design-system', // Row 2: 40% (col-span-2)
  'imaginbank-digital-banking', // Row 2: 60% (col-span-3)
  'solotemazos-music-platform', // Row 3: 60% (col-span-3)
  'movefast-startup-platform',  // Row 3: 40% (col-span-2)
];
const featuredProjects = projectOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);
---

<BaseLayout title="Home ⚡ Ramon Riera">
  <!-- Hero -->
  <HeroSection />

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects - Vertical Grid -->
  <section class="section-padding" data-component="FeaturedProjects">
    <div class="container-custom">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12 md:mb-16">
        <div>
          <div data-reveal class="mb-6 flex items-center gap-3">
            <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-rocket-launch">
                  <!-- Rocket body -->
                  <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                  <!-- Window -->
                  <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                  <!-- Left fin -->
                  <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                  <!-- Right fin -->
                  <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
                </g>
                <!-- Flame particles -->
                <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
                <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
                <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
              </svg>
            </span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg"
            data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)">
            Trabajo <span class="text-primary-500"
              data-token="$color-primary-500: #D97757">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm btn-viewall-normal"
          data-reveal
          data-component="ButtonOutline"
          data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/projects" class="btn-viewall-code" data-reveal data-component="ButtonViewAllCode">
          <span class="code-fn">projects</span><span class="code-dot">.</span><span class="code-method">listAll</span><span class="code-parens">()</span>
          <svg class="btn-code-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid — 3 rows, alternating 60/40 rhythm -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-x-5 gap-y-10 md:gap-x-8 md:gap-y-14 lg:gap-y-16"
        data-component="ProjectGrid"
        data-token="$grid-cols: 1 → 5 (md)|$spacing-gap-x: 2rem|$spacing-gap-y: 3.5rem → 4rem">
        {featuredProjects.map((project, i) => {
          const span = project.gridSpan ?? 2;
          const colClass = span === 3 ? 'md:col-span-3' : 'md:col-span-2';
          return (
            <div data-reveal data-delay={String(i * 100)} class:list={[colClass, 'project-grid-item']}>
              <ProjectCard {...project} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding" data-component="CallToAction">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <div data-reveal class="mb-6 flex justify-center">
        <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
            <g class="icon-ruler-idle">
              <!-- Set square outer -->
              <path d="M6 38L6 8L36 38H6Z" class="icon-stroke icon-draw" />
              <!-- Inner cutout -->
              <path d="M12 38L12 20L24 38" class="icon-accent icon-draw-delay" />
              <!-- Ruler ticks on left edge -->
              <line x1="6" y1="14" x2="11" y2="14" class="icon-stroke icon-draw" />
              <line x1="6" y1="20" x2="10" y2="20" class="icon-stroke icon-draw" />
              <line x1="6" y1="26" x2="11" y2="26" class="icon-stroke icon-draw" />
              <line x1="6" y1="32" x2="10" y2="32" class="icon-stroke icon-draw" />
            </g>
            <!-- Pencil drawing -->
            <g class="icon-ruler-pencil">
              <line x1="32" y1="4" x2="38" y2="10" class="icon-accent" />
              <line x1="32" y1="4" x2="30" y2="2" class="icon-accent" />
              <circle cx="38" cy="10" r="1.2" class="icon-accent-fill" />
            </g>
          </svg>
        </span>
      </div>
      <h2 data-reveal data-delay="100" class="heading-lg mb-5 whitespace-nowrap"
        data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)|$spacing-bottom: 1.25rem / 20px">
        ¿Tienes un <span class="text-primary-500"
          data-token="$color-primary-500: #D97757">proyecto</span> en mente?
      </h2>
      <p data-reveal data-delay="200" class="text-body text-lg mb-10"
        data-token="$font-family-sans: Inter|$color-text-muted: #7c766c|$spacing-bottom: 2.5rem / 40px">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="300" class="flex flex-wrap items-center justify-center gap-4">
        <a href={`mailto:${siteConfig.email}`} class="btn-primary text-base hero-cta-normal"
          data-component="ButtonPrimary"
          data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href={`mailto:${siteConfig.email}`} class="hero-cta-code" data-component="ButtonRunCmd">
          <span class="hero-cta-prompt">&gt;</span> run <span class="hero-cta-cmd">send_email.sh</span><span class="hero-cta-cursor">_</span>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-outline text-base btn-cv-normal"
          data-component="ButtonCV">
          Descargar CV
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-cv-code"
          data-component="ButtonCVCode">
          <svg class="btn-code-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
          </svg>
          <span class="code-fn">get</span><span class="code-parens">(</span><span class="code-string">'cv.pdf'</span><span class="code-parens">)</span>
        </a>
      </div>
    </div>
  </section>
<style>
  /* Force uniform image height within grid rows so text aligns horizontally */
  /* Mobile: taller / more square ratio so projects look substantial */
  .project-grid-item :global(.card-image-wrap) {
    aspect-ratio: 4 / 3;
    height: auto;
  }
  @media (min-width: 768px) {
    .project-grid-item :global(.card-image-wrap) {
      aspect-ratio: auto;
      height: 300px;
    }
  }
  @media (min-width: 1024px) {
    .project-grid-item :global(.card-image-wrap) {
      height: 340px;
    }
  }
</style>
</BaseLayout>
