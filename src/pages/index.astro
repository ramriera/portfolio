---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

const projectOrder = [
  'massimo-dutti-conversion',
  'movefast-startup-platform',
  'banco-sabadell-design-system',
  'imaginbank-digital-banking',
  'iberia-flight-experience',
  'solotemazos-music-platform',
];
const featuredProjects = projects
  .filter((p) => p.featured)
  .sort((a, b) => {
    const aIdx = projectOrder.indexOf(a.slug);
    const bIdx = projectOrder.indexOf(b.slug);
    if (aIdx === -1 && bIdx === -1) return 0;
    if (aIdx === -1) return 1;
    if (bIdx === -1) return 1;
    return aIdx - bIdx;
  });

// Process image map — TODO: reemplazar con imágenes de proceso reales
const processImages: Record<string, string> = {
  'massimo-dutti-conversion': '/assets/projects/massimo-dutti/proceso-wireframe.png',
  'movefast-startup-platform': '/assets/projects/movefast/proceso-flow.png',
  'banco-sabadell-design-system': '/assets/projects/sabadell/proceso-tokens.png',
  'imaginbank-digital-banking': '/assets/projects/imaginbank/proceso-heuristica.png',
  'iberia-flight-experience': '/assets/projects/iberia/proceso-sistema.png',
  'solotemazos-music-platform': '/assets/projects/solotemazos/proceso-prototipo.png',
};

// Helper to get process image, falling back to project cover
function getProcessImage(slug: string, cover: string): string {
  // TODO: cuando existan las imágenes de proceso reales, eliminar el fallback al cover
  return cover;
}

const p1 = featuredProjects[0]; // Massimo Dutti — featured full-width
const p2 = featuredProjects[1]; // MoveFast — grid 50%
const p3 = featuredProjects[2]; // Banco Sabadell — grid 50%
const p4 = featuredProjects[3]; // Imaginbank — compact horizontal
const p5 = featuredProjects[4]; // Iberia — compact horizontal
const p6 = featuredProjects[5]; // SoloTemazos — secondary
---

<BaseLayout title="Ramon Riera · UX Lead">
  <!-- Hero -->
  <HeroSection />

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects - Vertical Grid -->
  <section class="section-padding" data-component="FeaturedProjects">
    <div class="container-custom">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-8 mb-16">
        <div>
          <div data-reveal class="mb-6 flex items-center gap-3">
            <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-rocket-launch">
                  <!-- Rocket body -->
                  <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                  <!-- Window -->
                  <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                  <!-- Left fin -->
                  <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                  <!-- Right fin -->
                  <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
                </g>
                <!-- Flame particles -->
                <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
                <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
                <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
              </svg>
            </span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg"
            data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)">
            Trabajo <span class="text-primary-500"
              data-token="$color-primary-500: #D97757">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm"
          data-reveal
          data-component="ButtonOutline"
          data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid — Varied rhythm layout -->
      <div class="space-y-8" data-component="ProjectGrid">

        <!-- Row 1: Featured full-width (Massimo Dutti) -->
        {p1 && (
          <div data-reveal>
            <ProjectCard {...p1} variant="featured" processImage={getProcessImage(p1.slug, p1.cover)} />
          </div>
        )}

        <!-- Row 2: Two-column grid (MoveFast + Banco Sabadell) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {p2 && (
            <div data-reveal data-delay="100">
              <ProjectCard {...p2} processImage={getProcessImage(p2.slug, p2.cover)} />
            </div>
          )}
          {p3 && (
            <div data-reveal data-delay="200">
              <ProjectCard {...p3} processImage={getProcessImage(p3.slug, p3.cover)} />
            </div>
          )}
        </div>

        <!-- Row 3: Compact horizontal cards (Imaginbank + Iberia) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {p4 && (
            <div data-reveal data-delay="100">
              <ProjectCard {...p4} variant="compact" processImage={getProcessImage(p4.slug, p4.cover)} />
            </div>
          )}
          {p5 && (
            <div data-reveal data-delay="200">
              <ProjectCard {...p5} variant="compact" processImage={getProcessImage(p5.slug, p5.cover)} />
            </div>
          )}
        </div>

        <!-- Row 4: Secondary card (SoloTemazos) -->
        {p6 && (
          <div data-reveal data-delay="100" class="max-w-2xl">
            <ProjectCard {...p6} variant="secondary" processImage={getProcessImage(p6.slug, p6.cover)} />
          </div>
        )}

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding" data-component="CallToAction">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <div data-reveal class="mb-6 flex justify-center">
        <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
            <g class="icon-ruler-idle">
              <!-- Set square outer -->
              <path d="M6 38L6 8L36 38H6Z" class="icon-stroke icon-draw" />
              <!-- Inner cutout -->
              <path d="M12 38L12 20L24 38" class="icon-accent icon-draw-delay" />
              <!-- Ruler ticks on left edge -->
              <line x1="6" y1="14" x2="11" y2="14" class="icon-stroke icon-draw" />
              <line x1="6" y1="20" x2="10" y2="20" class="icon-stroke icon-draw" />
              <line x1="6" y1="26" x2="11" y2="26" class="icon-stroke icon-draw" />
              <line x1="6" y1="32" x2="10" y2="32" class="icon-stroke icon-draw" />
            </g>
            <!-- Pencil drawing -->
            <g class="icon-ruler-pencil">
              <line x1="32" y1="4" x2="38" y2="10" class="icon-accent" />
              <line x1="32" y1="4" x2="30" y2="2" class="icon-accent" />
              <circle cx="38" cy="10" r="1.2" class="icon-accent-fill" />
            </g>
          </svg>
        </span>
      </div>
      <h2 data-reveal data-delay="100" class="heading-lg mb-6"
        data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)|$spacing-bottom: 1.5rem / 24px">
        ¿Tienes un <span class="text-primary-500"
          data-token="$color-primary-500: #D97757">proyecto</span> en mente?
      </h2>
      <p data-reveal data-delay="200" class="text-body text-lg mb-10"
        data-token="$font-family-sans: Inter|$color-text-muted: #7c766c|$spacing-bottom: 2.5rem / 40px">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="300" class="flex flex-wrap items-center justify-center gap-4">
        <a href={`mailto:${siteConfig.email}`} class="btn-primary text-base"
          data-component="ButtonPrimary"
          data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-outline text-base btn-cv-normal"
          data-component="ButtonCV">
          Descargar CV
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-cv-code"
          data-component="ButtonCVCode">
          <span class="btn-cv-prompt">&gt;</span> ramon-riera <span class="btn-cv-flag">--download-cv</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
