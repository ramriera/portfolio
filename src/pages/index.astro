---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import CapabilitiesSection from '@/components/CapabilitiesSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ContactConsole from '@/components/ContactConsole.astro';
import { projects } from '@/utils/data';

// First project leads full-width (hero), the rest fill a 2-column grid
const projectOrder = [
  'doctori-insurance-platform',
  'massimo-dutti-conversion',
  'iberia-flight-experience',
  'banco-sabadell-design-system',
  'imaginbank-digital-banking',
];
const featuredProjects = projectOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);
const [lead, ...rest] = featuredProjects;
---

<BaseLayout title="Home ⚡ Ramon Riera">
  <!-- Hero -->
  <HeroSection />

  <!-- Sobre mí — capabilities band -->
  <CapabilitiesSection />

  <!-- Featured Projects -->
  <section class="section-padding" data-component="FeaturedProjects">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-10 md:mb-14">
        <div>
          <div data-reveal class="kicker mb-4">Trabajo seleccionado</div>
          <h2 data-reveal data-delay="100" class="heading-lg">
            Proyectos <span class="text-primary-500">destacados</span>
          </h2>
        </div>
        <a href="/projects" class="btn-outline text-sm" data-reveal>
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Lead project — full width -->
      {lead && (
        <div data-reveal class="mb-6 md:mb-8">
          <ProjectCard {...lead} index={1} variant="hero" loading="eager" fetchpriority="high" />
        </div>
      )}

      <!-- Rest — 2-column grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {rest.map((project, i) => (
          <div data-reveal data-delay={String(i * 100)}>
            <ProjectCard {...project} index={i + 2} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactConsole />
</BaseLayout>
