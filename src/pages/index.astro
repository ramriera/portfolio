---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout title="Ramon Riera — Senior UX/UI Designer | Design Systems & Product Design">
  <!-- Hero -->
  <HeroSection />

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects — Vertical Grid -->
  <section class="section-padding !pb-0">
    <div class="container-custom">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-8 mb-16">
        <div>
          <div data-reveal class="mb-6 flex items-center gap-3">
            <span class="section-icon">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-star-spin">
                  <!-- 4-point starburst -->
                  <path d="M22 4L24.5 17.5L38 14L26.5 22L38 30L24.5 26.5L22 40L19.5 26.5L6 30L17.5 22L6 14L19.5 17.5L22 4Z" class="icon-stroke icon-draw" />
                  <!-- Inner diamond -->
                  <path d="M22 14L26 22L22 30L18 22L22 14Z" class="icon-accent icon-draw-delay" />
                </g>
                <!-- Radiating rays -->
                <line x1="22" y1="1" x2="22" y2="5" class="icon-accent icon-ray-1" />
                <line x1="22" y1="39" x2="22" y2="43" class="icon-accent icon-ray-2" />
                <line x1="1" y1="22" x2="5" y2="22" class="icon-accent icon-ray-3" />
                <line x1="39" y1="22" x2="43" y2="22" class="icon-accent icon-ray-4" />
              </svg>
            </span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg">
            Trabajo <span class="text-primary-500">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm"
          data-reveal
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project, i) => (
          <div data-reveal data-delay={String(i * 100)}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA — same look & feel as services -->
  <section class="section-padding">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <h2 data-reveal class="heading-lg mb-6">
        ¿Tienes un proyecto en mente?
      </h2>
      <p data-reveal data-delay="100" class="text-body text-lg mb-10">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="200" class="flex flex-wrap items-center justify-center gap-4">
        <a href="mailto:ramriera28@gmail.com" class="btn-primary text-base">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href={`mailto:${siteConfig.email}`} class="btn-outline text-base">
          {siteConfig.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
