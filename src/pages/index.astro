---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ContactConsole from '@/components/ContactConsole.astro';
import InteractiveTerminal from '@/components/InteractiveTerminal.astro';
import { projects } from '@/utils/data';

// 3-row editorial grid: 60/40, 40/60, 60/40
const projectOrder = [
  'massimo-dutti-conversion',   // Row 1: 60% (col-span-3)
  'iberia-flight-experience',   // Row 1: 40% (col-span-2)
  'banco-sabadell-design-system', // Row 2: 40% (col-span-2)
  'imaginbank-digital-banking', // Row 2: 60% (col-span-3)
  'solotemazos-music-platform', // Row 3: 60% (col-span-3)
  'movefast-startup-platform',  // Row 3: 40% (col-span-2)
];
const featuredProjects = projectOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);
---

<BaseLayout title="Home ⚡ Ramon Riera">
  <!-- Interactive Terminal (Code Mode) — fullscreen overlay -->
  <InteractiveTerminal />

  <!-- Hero -->
  <HeroSection />

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects - Vertical Grid -->
  <section class="section-padding" data-component="FeaturedProjects">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12 md:mb-16">
        <div>
          <div data-reveal class="mb-6 flex items-center gap-3">
            <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-rocket-launch">
                  <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                  <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                  <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                  <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
                </g>
                <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
                <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
                <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
              </svg>
            </span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg"
            data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)">
            Trabajo <span class="text-primary-500"
              data-token="$color-primary-500: #D97757">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm"
          data-reveal
          data-component="ButtonOutline"
          data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-x-5 gap-y-10 md:gap-x-8 md:gap-y-14 lg:gap-y-16"
        data-component="ProjectGrid"
        data-token="$grid-cols: 1 → 5 (md)|$spacing-gap-x: 2rem|$spacing-gap-y: 3.5rem → 4rem">
        {featuredProjects.map((project, i) => {
          const span = project.gridSpan ?? 2;
          const colClass = span === 3 ? 'md:col-span-3' : 'md:col-span-2';
          return (
            <div data-reveal data-delay={String(i * 100)} class:list={[colClass, 'project-grid-item']}>
              <ProjectCard {...project} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactConsole />

<style>
  .project-grid-item :global(.card-image-wrap) {
    aspect-ratio: 4 / 3;
    height: auto;
  }
  @media (min-width: 768px) {
    .project-grid-item :global(.card-image-wrap) {
      aspect-ratio: auto;
      height: 300px;
    }
  }
  @media (min-width: 1024px) {
    .project-grid-item :global(.card-image-wrap) {
      height: 340px;
    }
  }
</style>
</BaseLayout>
