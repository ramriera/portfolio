---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/utils/data';

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout title="Ramon Riera — Senior UX/UI Designer | Design Systems & Product Design">
  <!-- Hero -->
  <HeroSection />

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects — Vertical Grid -->
  <section class="section-padding">
    <div class="container-custom">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-8 mb-16">
        <div>
          <div data-reveal class="mb-6 flex items-center gap-3">
            <span class="section-icon">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-rocket-launch">
                  <!-- Rocket body -->
                  <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                  <!-- Window -->
                  <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                  <!-- Left fin -->
                  <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                  <!-- Right fin -->
                  <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
                </g>
                <!-- Flame particles -->
                <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
                <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
                <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
              </svg>
            </span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg">
            Trabajo <span class="text-primary-500">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm"
          data-reveal
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project, i) => (
          <div data-reveal data-delay={String(i * 100)}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA — same look & feel as services -->
  <section class="section-padding">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <h2 data-reveal class="heading-lg mb-6">
        ¿Tienes un proyecto en mente?
      </h2>
      <p data-reveal data-delay="100" class="text-body text-lg mb-10">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="200">
        <a href="mailto:ramriera28@gmail.com" class="btn-primary text-base">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
