---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

// 3-row editorial grid: 60/40, 40/60, 60/40
const projectOrder = [
  'massimo-dutti-conversion',   // Row 1: 60% (col-span-3)
  'iberia-flight-experience',   // Row 1: 40% (col-span-2)
  'banco-sabadell-design-system', // Row 2: 40% (col-span-2)
  'imaginbank-digital-banking', // Row 2: 60% (col-span-3)
  'solotemazos-music-platform', // Row 3: 60% (col-span-3)
  'movefast-startup-platform',  // Row 3: 40% (col-span-2)
];
const featuredProjects = projectOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);
---

<BaseLayout title="Home ⚡ Ramon Riera">
  <!-- Hero -->
  <HeroSection />

  <!-- Bento Grid: Strategic Pillars -->
  <section class="section-padding" data-component="BentoGrid">
    <div class="container-custom">
      <!-- Normal mode -->
      <div class="bento-normal">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-5">

          <!-- Design Systems — Large card (2 cols, 2 rows) -->
          <div class="bento-card group md:col-span-2 md:row-span-2 p-6 md:p-8 rounded-2xl dashed-border bg-white relative overflow-hidden" data-reveal>
            <div class="bento-card-glow"></div>
            <span class="bento-label font-mono text-[10px] font-semibold tracking-[0.2em] uppercase text-dark-400 mb-4 block">01 &mdash; Core Pillar</span>
            <h3 class="text-xl md:text-2xl font-bold text-dark-900 mb-3">Scalable Design Systems</h3>
            <p class="text-body-sm mb-6 max-w-sm">Creación de librerías de componentes atómicos con foco en accesibilidad y consistencia cross-platform.</p>

            <!-- Mini component library preview -->
            <div class="bento-ds-preview mt-auto">
              <div class="flex flex-col gap-3 p-4 rounded-xl bg-dark-50 dashed-border">
                <!-- Row: Buttons -->
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-dark-900 text-white text-[11px] font-medium">Primary</span>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full border border-dark-300 text-dark-700 text-[11px] font-medium">Secondary</span>
                  <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-primary-50 text-primary-600 text-[11px] font-medium">Accent</span>
                </div>
                <!-- Row: Toggle + Dropdown -->
                <div class="flex items-center gap-3">
                  <!-- Toggle -->
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-[18px] bg-primary-500 rounded-full relative">
                      <div class="absolute right-[2px] top-[2px] w-[14px] h-[14px] bg-white rounded-full"></div>
                    </div>
                    <span class="text-[10px] text-dark-400 font-mono">active</span>
                  </div>
                  <!-- Dropdown -->
                  <div class="flex items-center gap-1 px-2.5 py-1 rounded-md border border-dark-200 text-[11px] text-dark-500">
                    <span>Select variant</span>
                    <svg class="w-3 h-3 text-dark-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </div>
                </div>
                <!-- Row: Input -->
                <div class="flex items-center gap-2">
                  <div class="flex-1 px-2.5 py-1 rounded-md border border-dark-200 text-[11px] text-dark-300 font-mono bg-white">placeholder_text</div>
                  <div class="w-6 h-6 rounded-md bg-dark-900 flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Design Tokens — Top right -->
          <div class="bento-card group md:col-span-2 p-6 rounded-2xl dashed-border bg-white relative overflow-hidden" data-reveal data-delay="100">
            <div class="bento-card-glow"></div>
            <span class="bento-label font-mono text-[10px] font-semibold tracking-[0.2em] uppercase text-dark-400 mb-4 block">02 &mdash; Foundation</span>
            <h3 class="text-xl font-bold text-dark-900 mb-2">Token Architecture</h3>
            <p class="text-body-sm mb-5">Single Source of Truth multiplataforma.</p>

            <!-- Token JSON visual -->
            <div class="bento-tokens-preview rounded-xl bg-dark-50 dashed-border p-4 font-mono text-[11px] leading-relaxed overflow-hidden">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-dark-400">{</span>
              </div>
              <div class="flex items-center gap-2 pl-4">
                <span class="text-primary-500">"color.brand.primary"</span>
                <span class="text-dark-300">:</span>
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-3 h-3 rounded-sm bg-primary-500 inline-block flex-shrink-0"></span>
                  <span class="text-dark-600">"#D97757"</span>
                </span>
              </div>
              <div class="flex items-center gap-2 pl-4">
                <span class="text-primary-500">"spacing.base"</span>
                <span class="text-dark-300">:</span>
                <span class="text-dark-600">"0.5rem"</span>
              </div>
              <div class="flex items-center gap-2 pl-4">
                <span class="text-primary-500">"radius.card"</span>
                <span class="text-dark-300">:</span>
                <span class="text-dark-600">"1rem"</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-dark-400">}</span>
              </div>
            </div>
          </div>

          <!-- Product Strategy — Bottom right -->
          <div class="bento-card group md:col-span-2 p-6 rounded-2xl dashed-border bg-white relative overflow-hidden" data-reveal data-delay="200">
            <div class="bento-card-glow"></div>
            <span class="bento-label font-mono text-[10px] font-semibold tracking-[0.2em] uppercase text-dark-400 mb-4 block">03 &mdash; Impact</span>
            <h3 class="text-xl font-bold text-dark-900 mb-2">Strategic Product Design</h3>
            <p class="text-body-sm mb-5">Alineación de objetivos de negocio con necesidades de usuario mediante métricas reales.</p>

            <!-- Strategy visual: mini flow -->
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-dark-50 dashed-border text-[11px] font-medium text-dark-600">
                <svg class="w-3.5 h-3.5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                Business Goals
              </span>
              <svg class="w-4 h-4 text-dark-300 flex-shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-primary-50 border border-primary-200 text-[11px] font-bold text-primary-700">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
                Design
              </span>
              <svg class="w-4 h-4 text-dark-300 flex-shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-dark-50 dashed-border text-[11px] font-medium text-dark-600">
                User Needs
                <svg class="w-3.5 h-3.5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Code mode -->
      <div class="bento-code">
        <div class="bento-code-window">
          <div class="bento-code-titlebar">
            <div class="json-dots">
              <span class="json-dot json-dot--red"></span>
              <span class="json-dot json-dot--yellow"></span>
              <span class="json-dot json-dot--green"></span>
            </div>
            <span class="bento-code-filename">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
              pillars.config.ts
            </span>
          </div>
          <pre class="bento-code-body"><code><span class="pp-keyword">export const</span> <span class="pp-fn">strategicPillars</span> <span class="pp-punct">=</span> <span class="pp-bracket">[</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">name</span><span class="pp-punct">:</span> <span class="pp-string">"Scalable Design Systems"</span><span class="pp-punct">,</span>
    <span class="pp-key">scope</span><span class="pp-punct">:</span> <span class="pp-string">"core"</span><span class="pp-punct">,</span>
    <span class="pp-key">stack</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"Figma"</span><span class="pp-punct">,</span> <span class="pp-string">"Storybook"</span><span class="pp-punct">,</span> <span class="pp-string">"Tokens"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-comment">// Atomic component libraries — accessibility & consistency</span>
  <span class="pp-bracket">{"}"}</span><span class="pp-punct">,</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">name</span><span class="pp-punct">:</span> <span class="pp-string">"Token Architecture"</span><span class="pp-punct">,</span>
    <span class="pp-key">scope</span><span class="pp-punct">:</span> <span class="pp-string">"foundation"</span><span class="pp-punct">,</span>
    <span class="pp-key">format</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"CSS"</span><span class="pp-punct">,</span> <span class="pp-string">"iOS"</span><span class="pp-punct">,</span> <span class="pp-string">"Android"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-comment">// Single Source of Truth — multi-platform delivery</span>
  <span class="pp-bracket">{"}"}</span><span class="pp-punct">,</span>
  <span class="pp-bracket">{"{"}</span>
    <span class="pp-key">name</span><span class="pp-punct">:</span> <span class="pp-string">"Strategic Product Design"</span><span class="pp-punct">,</span>
    <span class="pp-key">scope</span><span class="pp-punct">:</span> <span class="pp-string">"impact"</span><span class="pp-punct">,</span>
    <span class="pp-key">metrics</span><span class="pp-punct">:</span> <span class="pp-bracket">[</span><span class="pp-string">"adoption"</span><span class="pp-punct">,</span> <span class="pp-string">"NPS"</span><span class="pp-punct">,</span> <span class="pp-string">"velocity"</span><span class="pp-bracket">]</span><span class="pp-punct">,</span>
    <span class="pp-comment">// Business goals ↔ user needs alignment</span>
  <span class="pp-bracket">{"}"}</span>
<span class="pp-bracket">]</span> <span class="pp-keyword">as const</span><span class="pp-punct">;</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects - Vertical Grid -->
  <section class="section-padding" data-component="FeaturedProjects">
    <div class="container-custom">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-12 md:mb-16">
        <div>
          <div data-reveal class="mb-6 flex items-center gap-3">
            <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
                <g class="icon-rocket-launch">
                  <!-- Rocket body -->
                  <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                  <!-- Window -->
                  <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                  <!-- Left fin -->
                  <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                  <!-- Right fin -->
                  <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
                </g>
                <!-- Flame particles -->
                <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
                <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
                <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
              </svg>
            </span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg"
            data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)">
            Trabajo <span class="text-primary-500"
              data-token="$color-primary-500: #D97757">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm"
          data-reveal
          data-component="ButtonOutline"
          data-token="$color-border-btn-outline: #d4cfc5|$color-text-btn-outline: #403d38|$radius-full: 9999px"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid — 3 rows, alternating 60/40 rhythm -->
      <div class="grid grid-cols-1 md:grid-cols-5 gap-x-5 gap-y-10 md:gap-x-8 md:gap-y-14 lg:gap-y-16"
        data-component="ProjectGrid"
        data-token="$grid-cols: 1 → 5 (md)|$spacing-gap-x: 2rem|$spacing-gap-y: 3.5rem → 4rem">
        {featuredProjects.map((project, i) => {
          const span = project.gridSpan ?? 2;
          const colClass = span === 3 ? 'md:col-span-3' : 'md:col-span-2';
          return (
            <div data-reveal data-delay={String(i * 100)} class:list={[colClass, 'project-grid-item']}>
              <ProjectCard {...project} />
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding" data-component="CallToAction">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <div data-reveal class="mb-6 flex justify-center">
        <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
            <g class="icon-ruler-idle">
              <!-- Set square outer -->
              <path d="M6 38L6 8L36 38H6Z" class="icon-stroke icon-draw" />
              <!-- Inner cutout -->
              <path d="M12 38L12 20L24 38" class="icon-accent icon-draw-delay" />
              <!-- Ruler ticks on left edge -->
              <line x1="6" y1="14" x2="11" y2="14" class="icon-stroke icon-draw" />
              <line x1="6" y1="20" x2="10" y2="20" class="icon-stroke icon-draw" />
              <line x1="6" y1="26" x2="11" y2="26" class="icon-stroke icon-draw" />
              <line x1="6" y1="32" x2="10" y2="32" class="icon-stroke icon-draw" />
            </g>
            <!-- Pencil drawing -->
            <g class="icon-ruler-pencil">
              <line x1="32" y1="4" x2="38" y2="10" class="icon-accent" />
              <line x1="32" y1="4" x2="30" y2="2" class="icon-accent" />
              <circle cx="38" cy="10" r="1.2" class="icon-accent-fill" />
            </g>
          </svg>
        </span>
      </div>
      <h2 data-reveal data-delay="100" class="heading-lg mb-5"
        data-token="$font-size-heading-lg: clamp(1.875rem, 4vw, 3rem)|$font-weight: 600 (semibold)|$spacing-bottom: 1.25rem / 20px">
        ¿Tienes un <span class="text-primary-500"
          data-token="$color-primary-500: #D97757">proyecto</span> en mente?
      </h2>
      <p data-reveal data-delay="200" class="text-body text-lg mb-10"
        data-token="$font-family-sans: Inter|$color-text-muted: #7c766c|$spacing-bottom: 2.5rem / 40px">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="300" class="flex flex-wrap items-center justify-center gap-4">
        <a href={`mailto:${siteConfig.email}`} class="btn-primary text-base"
          data-component="ButtonPrimary"
          data-token="$color-bg-btn-primary: #1a1918|$color-text-btn-primary: #ffffff|$spacing-padding: 0.875rem 1.75rem|$radius-full: 9999px">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-outline text-base btn-cv-normal"
          data-component="ButtonCV">
          Descargar CV
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-cv-code"
          data-component="ButtonCVCode">
          <span class="btn-cv-prompt">&gt;</span> ramon-riera <span class="btn-cv-flag">--download-cv</span>
        </a>
      </div>
    </div>
  </section>
<style>
  /* Force uniform image height within grid rows so text aligns horizontally */
  /* Mobile: taller / more square ratio so projects look substantial */
  .project-grid-item :global(.card-image-wrap) {
    aspect-ratio: 4 / 3;
    height: auto;
  }
  @media (min-width: 768px) {
    .project-grid-item :global(.card-image-wrap) {
      aspect-ratio: auto;
      height: 300px;
    }
  }
  @media (min-width: 1024px) {
    .project-grid-item :global(.card-image-wrap) {
      height: 340px;
    }
  }
</style>
</BaseLayout>
