---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout title="Ramon Riera — Senior UX/UI Designer | Design Systems & Product Design">
  <!-- Hero -->
  <HeroSection />

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects — Vertical Grid -->
  <section class="section-padding">
    <div class="container-custom">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-8 mb-16">
        <div>
          <div data-reveal class="mb-6">
            <span class="text-sm font-medium text-primary-500 tracking-wide">Proyectos</span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg">
            Trabajo <span class="text-primary-500">destacado</span>
          </h2>
        </div>
        <a
          href="/projects"
          class="btn-outline text-sm"
          data-reveal
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project, i) => (
          <div data-reveal data-delay={String(i * 100)}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Contact -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="relative rounded-3xl bg-dark-900 dark:bg-dark-800 p-14 md:p-24 overflow-hidden">
        <!-- Background decorations -->
        <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-primary-500/[0.07] blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-primary-500/[0.07] blur-3xl"></div>

        <div class="relative z-10 text-center max-w-3xl mx-auto">
          <h2 data-reveal class="heading-lg text-white mb-8">
            ¿Tienes un proyecto en mente?
          </h2>
          <p data-reveal data-delay="100" class="text-lg text-dark-400 mb-10 leading-relaxed">
            Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
          </p>

          <!-- Social icons -->
          <div data-reveal data-delay="150" class="flex items-center justify-center gap-4 mb-10">
            <!-- LinkedIn -->
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500 hover:bg-primary-500/10 transition-all duration-300"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <!-- Medium -->
            <a
              href={siteConfig.social.medium}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500 hover:bg-primary-500/10 transition-all duration-300"
              aria-label="Medium"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
            </a>
            <!-- Email -->
            <a
              href="mailto:ramriera28@gmail.com"
              class="w-12 h-12 rounded-full border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500 hover:bg-primary-500/10 transition-all duration-300"
              aria-label="Email"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            </a>
            <!-- CV -->
            <a
              href="/cv-ramon-riera.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full border border-dark-700 flex items-center justify-center text-dark-400 hover:text-white hover:border-primary-500 hover:bg-primary-500/10 transition-all duration-300"
              aria-label="Descargar CV"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
            </a>
          </div>

          <div data-reveal data-delay="200" class="flex flex-wrap items-center justify-center gap-4">
            <a href="mailto:ramriera28@gmail.com" class="group/cta inline-flex items-center gap-2 px-7 py-3.5 bg-white text-dark-900 font-medium rounded-full transition-all duration-300 hover:bg-dark-100 hover:shadow-lg text-base">
              Empecemos a hablar
              <svg class="w-4 h-4 transition-transform duration-300 group-hover/cta:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href={`mailto:${siteConfig.email}`} class="inline-flex items-center gap-2 px-7 py-3.5 text-dark-400 hover:text-white font-medium rounded-full border border-dark-700 hover:border-dark-500 transition-all duration-300">
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
