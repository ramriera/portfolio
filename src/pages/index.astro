---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout title="Ramon Riera — Senior UX/UI Designer | Design Systems & Product Design">
  <!-- Hero -->
  <HeroSection />

  <!-- Clients marquee -->
  <section class="py-12 border-t border-b border-dark-100 dark:border-dark-800 overflow-hidden">
    <div class="container-custom mb-6">
      <p class="text-xs font-mono uppercase tracking-widest text-dark-400 dark:text-dark-500 text-center">
        Empresas con las que he trabajado
      </p>
    </div>
    <div class="flex items-center gap-16 animate-[marquee_30s_linear_infinite]">
      {['Banco Sabadell', 'Iberia', 'Doctori', 'iSalud', 'Leemons', 'Ready2', 'MoveFast', 'Imaginbank', 'Banco Sabadell', 'Iberia', 'Doctori', 'iSalud'].map((client) => (
        <span class="text-lg font-bold text-dark-300 dark:text-dark-600 whitespace-nowrap tracking-tight">
          {client}
        </span>
      ))}
    </div>
  </section>

  <!-- About -->
  <AboutSection />

  <!-- Featured Projects -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800 bg-dark-50/50 dark:bg-dark-900/50">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-16">
        <div>
          <div data-reveal class="flex items-center gap-3 mb-6">
            <div class="h-px w-12 bg-primary-500"></div>
            <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">Proyectos</span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg">
            Trabajo <span class="gradient-text">destacado</span>
          </h2>
        </div>
        <a
          data-reveal
          data-delay="200"
          href="/projects"
          class="btn-outline text-sm"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project, i) => (
          <div data-reveal data-delay={String(i * 150)}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Contact -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800">
    <div class="container-custom">
      <div class="relative rounded-3xl bg-dark-900 dark:bg-dark-800 p-12 md:p-20 overflow-hidden">
        <!-- Background decorations -->
        <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-primary-500/10 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-primary-500/10 blur-3xl"></div>

        <div class="relative z-10 text-center max-w-3xl mx-auto">
          <h2 data-reveal class="heading-lg text-white mb-6">
            ¿Tienes un proyecto en mente?
          </h2>
          <p data-reveal data-delay="100" class="text-lg text-dark-300 mb-10">
            Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
          </p>
          <div data-reveal data-delay="200" class="flex flex-wrap items-center justify-center gap-4">
            <a href="/contact" class="btn-primary text-base bg-primary-500 hover:bg-primary-400">
              Empecemos a hablar
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href={`mailto:${siteConfig.email}`} class="inline-flex items-center gap-2 px-6 py-3 text-dark-300 hover:text-white font-semibold transition-colors duration-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
