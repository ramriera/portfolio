---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import AboutSection from '@/components/AboutSection.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ContactForm from '@/components/ContactForm.astro';
import { projects, services, skills, testimonials, siteConfig } from '@/utils/data';

const featuredProjects = projects.filter((p) => p.featured);
const skillCategories = {
  design: 'Diseño',
  methodology: 'Metodología',
  dev: 'Desarrollo',
  tools: 'Herramientas',
};
---

<BaseLayout title="Ramon Riera — Senior UX/UI Designer | Design Systems & Product Design">
  <!-- Hero -->
  <HeroSection />

  <!-- Clients marquee -->
  <section class="py-12 border-t border-b border-dark-100 dark:border-dark-800 overflow-hidden">
    <div class="container-custom mb-6">
      <p class="text-xs font-mono uppercase tracking-widest text-dark-400 dark:text-dark-500 text-center">
        Empresas con las que he trabajado
      </p>
    </div>
    <div class="flex items-center gap-16 animate-[marquee_30s_linear_infinite]">
      {['Banco Sabadell', 'Iberia', 'Doctori', 'iSalud', 'Leemons', 'Ready2', 'MoveFast', 'Imaginbank', 'Banco Sabadell', 'Iberia', 'Doctori', 'iSalud'].map((client) => (
        <span class="text-lg font-bold text-dark-300 dark:text-dark-600 whitespace-nowrap tracking-tight">
          {client}
        </span>
      ))}
    </div>
  </section>

  <!-- About -->
  <AboutSection />

  <!-- Services / Specialties -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div data-reveal class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-12 bg-primary-500"></div>
          <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">Especialidades</span>
          <div class="h-px w-12 bg-primary-500"></div>
        </div>
        <h2 data-reveal data-delay="100" class="heading-lg mb-4">
          Lo que hago <span class="gradient-text">mejor</span>
        </h2>
        <p data-reveal data-delay="200" class="text-body">
          Combinando diseño estratégico con ejecución técnica para crear productos digitales excepcionales.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <div
            data-reveal
            data-delay={String(i * 100)}
            class="group p-8 rounded-2xl dashed-border bg-white dark:bg-dark-900 card-hover"
          >
            <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-500/10 flex items-center justify-center mb-6 group-hover:bg-primary-500 group-hover:text-white transition-all duration-300">
              <svg class="w-6 h-6 text-primary-500 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                {service.icon === 'layout' && <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />}
                {service.icon === 'layers' && <path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />}
                {service.icon === 'box' && <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />}
                {service.icon === 'settings' && <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />}
                {service.icon === 'settings' && <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />}
                {service.icon === 'star' && <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />}
                {service.icon === 'search' && <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />}
              </svg>
            </div>
            <h3 class="heading-sm mb-3">{service.title}</h3>
            <p class="text-body-sm">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800 bg-dark-50/50 dark:bg-dark-900/50">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-6 mb-16">
        <div>
          <div data-reveal class="flex items-center gap-3 mb-6">
            <div class="h-px w-12 bg-primary-500"></div>
            <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">Proyectos</span>
          </div>
          <h2 data-reveal data-delay="100" class="heading-lg">
            Trabajo <span class="gradient-text">destacado</span>
          </h2>
        </div>
        <a
          data-reveal
          data-delay="200"
          href="/projects"
          class="btn-outline text-sm"
        >
          Ver todos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {featuredProjects.map((project, i) => (
          <div data-reveal data-delay={String(i * 150)}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div data-reveal class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-12 bg-primary-500"></div>
          <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">Skills</span>
          <div class="h-px w-12 bg-primary-500"></div>
        </div>
        <h2 data-reveal data-delay="100" class="heading-lg mb-4">
          Herramientas y <span class="gradient-text">habilidades</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {Object.entries(skillCategories).map(([key, label], catIndex) => (
          <div data-reveal data-delay={String(catIndex * 100)}>
            <h3 class="text-sm font-mono font-bold uppercase tracking-widest text-primary-500 mb-4">
              {label}
            </h3>
            <div class="space-y-3">
              {skills
                .filter((s) => s.category === key)
                .map((skill) => (
                  <div class="group flex items-center gap-3 p-3 rounded-lg hover:bg-dark-50 dark:hover:bg-dark-800/50 transition-colors duration-300">
                    <div class="w-2 h-2 rounded-full bg-primary-500 group-hover:scale-125 transition-transform duration-300"></div>
                    <span class="text-sm font-medium text-dark-700 dark:text-dark-300">{skill.name}</span>
                  </div>
                ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800 bg-dark-50/50 dark:bg-dark-900/50">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div data-reveal class="flex items-center justify-center gap-3 mb-6">
          <div class="h-px w-12 bg-primary-500"></div>
          <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">Testimonios</span>
          <div class="h-px w-12 bg-primary-500"></div>
        </div>
        <h2 data-reveal data-delay="100" class="heading-lg">
          Lo que dicen <span class="gradient-text">de mí</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((testimonial, i) => (
          <div
            data-reveal
            data-delay={String(i * 150)}
            class="p-8 rounded-2xl dashed-border bg-white dark:bg-dark-900 card-hover"
          >
            <!-- Quote icon -->
            <svg class="w-10 h-10 text-primary-500/20 mb-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <p class="text-body mb-6 italic">
              "{testimonial.text}"
            </p>
            <div class="flex items-center gap-4">
              <img
                src={testimonial.avatar}
                alt={testimonial.name}
                class="w-12 h-12 rounded-full object-cover"
                loading="lazy"
              />
              <div>
                <p class="font-semibold text-dark-900 dark:text-dark-100">{testimonial.name}</p>
                <p class="text-sm text-dark-400 dark:text-dark-500">{testimonial.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Contact -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800">
    <div class="container-custom">
      <div class="relative rounded-3xl bg-dark-900 dark:bg-dark-800 p-12 md:p-20 overflow-hidden">
        <!-- Background decorations -->
        <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-primary-500/10 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full bg-primary-500/10 blur-3xl"></div>

        <div class="relative z-10 text-center max-w-3xl mx-auto">
          <h2 data-reveal class="heading-lg text-white mb-6">
            ¿Tienes un proyecto en mente?
          </h2>
          <p data-reveal data-delay="100" class="text-lg text-dark-300 mb-10">
            Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
          </p>
          <div data-reveal data-delay="200" class="flex flex-wrap items-center justify-center gap-4">
            <a href="/contact" class="btn-primary text-base bg-primary-500 hover:bg-primary-400">
              Empecemos a hablar
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href={`mailto:${siteConfig.email}`} class="inline-flex items-center gap-2 px-6 py-3 text-dark-300 hover:text-white font-semibold transition-colors duration-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
