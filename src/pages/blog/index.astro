---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import { blogPosts } from '@/utils/data';
---

<BaseLayout
  title="Blog ⚡ Ramon Riera"
  description="Artículos sobre UX/UI Design, Design Systems, Design Ops y metodologías de diseño."
>
  <!-- Hero -->
  <section class="section-padding pb-12">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <!-- Pencil body -->
              <path d="M8 36L12 20L32 8L36 12L24 32Z" class="icon-stroke icon-draw" />
              <!-- Pencil tip -->
              <path d="M8 36L12 20L16 24Z" class="icon-accent icon-draw-delay" />
              <!-- Pencil eraser -->
              <path d="M32 8L36 12L38 10L34 6Z" class="icon-stroke icon-draw-delay" />
              <!-- Writing lines -->
              <g class="icon-ruler-pencil">
                <line x1="18" y1="4" x2="28" y2="4" class="icon-accent" stroke-width="1.5" />
                <line x1="20" y1="8" x2="26" y2="8" class="icon-accent" stroke-width="1.5" />
              </g>
            </svg>
          </span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-8">
          Pensamientos y
          <span class="text-primary-500">aprendizajes</span>
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl">
          Reflexiones sobre diseño, metodologías, herramientas y lecciones aprendidas en el camino.
        </p>
      </div>
    </div>
  </section>

  <!-- Blog grid -->
  <section class="pb-32">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {blogPosts.map((post, i) => (
          <article
            data-reveal
            data-delay={String(i * 100)}
            class="group rounded-2xl overflow-hidden dashed-border bg-white card-hover"
          >
            <div class="relative overflow-hidden aspect-[16/9]">
              <img
                src={post.cover}
                alt={post.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-103"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 flex gap-2">
                {post.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-white/90 backdrop-blur-sm">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-4 text-xs text-dark-400 mb-3">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span>·</span>
                <span>{post.readTime} lectura</span>
              </div>
              <h2 class="heading-sm mb-3 group-hover:text-primary-500 transition-colors duration-300">
                {post.title}
              </h2>
              <p class="text-body-sm line-clamp-3">
                {post.excerpt}
              </p>
              <div class="mt-4 flex items-center gap-2 text-primary-500 font-semibold text-sm group-hover:gap-3 transition-all duration-300">
                Leer artículo
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
