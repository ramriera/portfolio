---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import { labExperiments } from '@/utils/data';
---

<BaseLayout
  title="Lab — Ramon Riera"
  description="Experimentos de diseño, prototipos y exploraciones creativas."
>
  <!-- Hero -->
  <section class="section-padding pb-12">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="flex items-center gap-3 mb-8">
          <div class="h-px w-12 bg-primary-500"></div>
          <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">Lab</span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-8">
          Experimentos y
          <span class="gradient-text">exploraciones</span>
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl">
          Un espacio para experimentar con ideas, técnicas y conceptos fuera de los proyectos comerciales. Aquí es donde juego, aprendo y rompo cosas.
        </p>
      </div>
    </div>
  </section>

  <!-- Experiments grid -->
  <section class="pb-32">
    <div class="container-custom">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-8">
        {labExperiments.map((experiment, i) => (
          <div
            data-reveal
            data-delay={String(i * 100)}
            class="group rounded-2xl overflow-hidden dashed-border bg-white dark:bg-dark-900 card-hover cursor-pointer"
          >
            <div class="relative overflow-hidden aspect-[16/10]">
              <img
                src={experiment.cover}
                alt={experiment.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900/80 via-dark-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end">
                <div class="p-6">
                  <span class="text-white font-semibold text-sm flex items-center gap-2">
                    Explorar
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
            <div class="p-6">
              <h3 class="heading-sm mb-2 group-hover:text-primary-500 transition-colors duration-300">
                {experiment.title}
              </h3>
              <p class="text-body-sm mb-4">{experiment.description}</p>
              <div class="flex flex-wrap gap-2">
                {experiment.tags.map((tag) => (
                  <Tag label={tag} />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
