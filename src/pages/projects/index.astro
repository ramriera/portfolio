---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects, siteConfig } from '@/utils/data';

const projectOrder = ['massimo-dutti-conversion', 'banco-sabadell-design-system', 'imaginbank-digital-banking', 'movefast-startup-platform', 'solotemazos-music-platform', 'iberia-flight-experience'];
const sortedProjects = [...projects].sort((a, b) => {
  const aIdx = projectOrder.indexOf(a.slug);
  const bIdx = projectOrder.indexOf(b.slug);
  if (aIdx === -1 && bIdx === -1) return 0;
  if (aIdx === -1) return 1;
  if (bIdx === -1) return 1;
  return aIdx - bIdx;
});
const categories = ['Todas', ...new Set(projects.map((p) => p.category))];
---

<BaseLayout
  title="Proyectos - Ramon Riera"
  description="Portfolio de proyectos de UX/UI Design, Design Systems y Product Design."
>
  <!-- Hero -->
  <section class="section-padding pb-12" data-component="ProjectsHero">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-rocket-launch">
                <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
              </g>
              <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
              <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
              <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
            </svg>
          </span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-8">
          Trabajos <span class="text-primary-500">seleccionados</span>
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl">
          Una selección de proyectos que representan mi enfoque en diseño de experiencia de usuario, sistemas de diseño y producto digital.
        </p>
      </div>

      <!-- Filters -->
      <div data-reveal data-delay="300" class="flex flex-wrap gap-2 mt-12" id="project-filters"
        data-component="FilterGroup" data-token="$spacing-gap: 0.5rem / 8px">
        {categories.map((cat) => (
          <button
            class:list={[
              'filter-btn px-5 py-2 text-sm font-medium rounded-full transition-all duration-300',
              cat === 'Todas'
                ? 'bg-primary-500/10 text-primary-500'
                : 'bg-dark-100 text-dark-600 hover:bg-dark-200',
            ]}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects grid -->
  <section class="pb-32" data-component="ProjectsListing">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid"
        data-component="ProjectGrid" data-token="$grid-cols: 1 → 2 (md)|$spacing-gap: 2rem / 32px">
        {sortedProjects.map((project, i) => (
          <div
            data-reveal
            data-delay={String(i * 100)}
            data-category={project.category}
            class="project-item"
          >
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding" data-component="CallToAction">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <div data-reveal class="mb-6 flex justify-center">
        <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
            <g class="icon-ruler-idle">
              <path d="M6 38L6 8L36 38H6Z" class="icon-stroke icon-draw" />
              <path d="M12 38L12 20L24 38" class="icon-accent icon-draw-delay" />
              <line x1="6" y1="14" x2="11" y2="14" class="icon-stroke icon-draw" />
              <line x1="6" y1="20" x2="10" y2="20" class="icon-stroke icon-draw" />
              <line x1="6" y1="26" x2="11" y2="26" class="icon-stroke icon-draw" />
              <line x1="6" y1="32" x2="10" y2="32" class="icon-stroke icon-draw" />
            </g>
            <g class="icon-ruler-pencil">
              <line x1="32" y1="4" x2="38" y2="10" class="icon-accent" />
              <line x1="32" y1="4" x2="30" y2="2" class="icon-accent" />
              <circle cx="38" cy="10" r="1.2" class="icon-accent-fill" />
            </g>
          </svg>
        </span>
      </div>
      <h2 data-reveal data-delay="100" class="heading-lg mb-6">
        ¿Tienes un <span class="text-primary-500">proyecto</span> en mente?
      </h2>
      <p data-reveal data-delay="200" class="text-body text-lg mb-10">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="300" class="flex flex-wrap items-center justify-center gap-4">
        <a href={`mailto:${siteConfig.email}`} class="btn-primary text-base">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-outline text-base btn-cv-normal"
          data-component="ButtonCV">
          Descargar CV
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 13h6m-6 4h4" />
          </svg>
        </a>
        <a href="/docs/CV-Ramon-Riera-Depares.pdf" target="_blank" rel="noopener noreferrer"
          class="btn-cv-code"
          data-component="ButtonCVCode">
          <span class="btn-cv-prompt">&gt;</span> ramon-riera <span class="btn-cv-flag">--download-cv</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active button
      filterBtns.forEach((b) => {
        b.classList.remove('bg-primary-500/10', 'text-primary-500');
        b.classList.add('bg-dark-100', 'text-dark-600');
      });
      btn.classList.remove('bg-dark-100', 'text-dark-600');
      btn.classList.add('bg-primary-500/10', 'text-primary-500');

      // Filter projects
      projectItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'Todas' || category === filter) {
          (item as HTMLElement).style.display = '';
          (item as HTMLElement).style.opacity = '0';
          setTimeout(() => {
            (item as HTMLElement).style.opacity = '1';
            (item as HTMLElement).style.transition = 'opacity 0.3s ease';
          }, 50);
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
