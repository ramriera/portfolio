---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/utils/data';

const categories = ['Todos', ...new Set(projects.map((p) => p.category))];
---

<BaseLayout
  title="Proyectos — Ramon Riera"
  description="Portfolio de proyectos de UX/UI Design, Design Systems y Product Design."
>
  <!-- Hero -->
  <section class="section-padding pb-12">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8">
          <span class="text-sm font-medium text-primary-500 tracking-wide">Proyectos</span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-8">
          Trabajo <span class="text-primary-500">seleccionado</span>
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl">
          Una selección de proyectos que representan mi enfoque en diseño de experiencia de usuario, sistemas de diseño y producto digital.
        </p>
      </div>

      <!-- Filters -->
      <div data-reveal data-delay="300" class="flex flex-wrap gap-2 mt-12" id="project-filters">
        {categories.map((cat) => (
          <button
            class:list={[
              'filter-btn px-5 py-2 text-sm font-medium rounded-full transition-all duration-300',
              cat === 'Todos'
                ? 'bg-primary-500 text-white'
                : 'bg-dark-100 dark:bg-dark-800 text-dark-600 dark:text-dark-400 hover:bg-dark-200 dark:hover:bg-dark-700',
            ]}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects grid -->
  <section class="pb-32">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
        {projects.map((project, i) => (
          <div
            data-reveal
            data-delay={String(i * 100)}
            data-category={project.category}
            class="project-item"
          >
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <div data-reveal class="mb-6 flex justify-center">
        <span class="section-icon">
          <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
            <g class="icon-ruler-idle">
              <path d="M6 38L6 8L36 38H6Z" class="icon-stroke icon-draw" />
              <path d="M12 38L12 20L24 38" class="icon-accent icon-draw-delay" />
              <line x1="6" y1="14" x2="10" y2="14" class="icon-stroke icon-draw" />
              <line x1="6" y1="20" x2="9" y2="20" class="icon-stroke icon-draw" />
              <line x1="6" y1="26" x2="10" y2="26" class="icon-stroke icon-draw" />
              <line x1="6" y1="32" x2="9" y2="32" class="icon-stroke icon-draw" />
            </g>
            <line x1="34" y1="4" x2="38" y2="8" class="icon-accent icon-ruler-pencil" />
            <circle cx="36" cy="6" r="1" class="icon-accent icon-ruler-pencil" />
          </svg>
        </span>
      </div>
      <h2 data-reveal data-delay="100" class="heading-lg mb-6">
        ¿Tienes un <span class="text-primary-500">proyecto</span> en mente?
      </h2>
      <p data-reveal data-delay="200" class="text-body text-lg mb-10">
        Me encantaría escuchar tu idea. Hablemos sobre cómo puedo ayudarte a crear algo extraordinario.
      </p>
      <div data-reveal data-delay="300">
        <a href="mailto:ramriera28@gmail.com" class="btn-primary text-base">
          Contactar
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active button
      filterBtns.forEach((b) => {
        b.classList.remove('bg-primary-500', 'text-white');
        b.classList.add('bg-dark-100', 'dark:bg-dark-800', 'text-dark-600', 'dark:text-dark-400');
      });
      btn.classList.remove('bg-dark-100', 'dark:bg-dark-800', 'text-dark-600', 'dark:text-dark-400');
      btn.classList.add('bg-primary-500', 'text-white');

      // Filter projects
      projectItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'Todos' || category === filter) {
          (item as HTMLElement).style.display = '';
          (item as HTMLElement).style.opacity = '0';
          setTimeout(() => {
            (item as HTMLElement).style.opacity = '1';
            (item as HTMLElement).style.transition = 'opacity 0.3s ease';
          }, 50);
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
