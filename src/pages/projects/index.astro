---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import WordsCarousel from '@/components/WordsCarousel.astro';

import ContactConsole from '@/components/ContactConsole.astro';

const projectWords = ['seleccionados', 'estratégicos', 'construidos', 'desplegados', 'destacados'];
import { projects, siteConfig } from '@/utils/data';

const projectOrder = ['massimo-dutti-conversion', 'banco-sabadell-design-system', 'imaginbank-digital-banking', 'movefast-startup-platform', 'solotemazos-music-platform', 'iberia-flight-experience'];
const sortedProjects = [...projects].sort((a, b) => {
  const aIdx = projectOrder.indexOf(a.slug);
  const bIdx = projectOrder.indexOf(b.slug);
  if (aIdx === -1 && bIdx === -1) return 0;
  if (aIdx === -1) return 1;
  if (bIdx === -1) return 1;
  return aIdx - bIdx;
});
const filterCategories = ['Todas', 'Product Design', 'UX Design', 'Design Systems', 'Service Design', 'UX Research'];

// Map tags → filter categories
const tagToFilters: Record<string, string[]> = {
  'Product Design': ['Product Design'],
  'UX Design': ['UX Design'],
  'Visual Design': ['UX Design'],
  'Mobile-First Design': ['UX Design'],
  'Heuristic Analysis': ['UX Design'],
  'Design Systems': ['Design Systems'],
  'Design Ops': ['Design Systems'],
  'Atomic Design': ['Design Systems'],
  'Service Design': ['Service Design'],
  'E-commerce': ['Service Design'],
  'Nonprofit': ['Service Design'],
  'UX Research': ['UX Research'],
  'Design Thinking': ['UX Research'],
};

function getProjectFilters(tags: string[]): string[] {
  const filters = new Set<string>();
  tags.forEach((tag) => {
    (tagToFilters[tag] || []).forEach((f) => filters.add(f));
  });
  return [...filters];
}
---

<BaseLayout
  title="Projects ⚡ Ramon Riera"
  description="Portfolio de proyectos de UX/UI Design, Design Systems y Product Design."
>
  <!-- Hero: Design mode -->
  <section class="section-padding pb-12 projects-hero-design" data-component="ProjectsHero">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-8">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-rocket-launch">
                <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
              </g>
              <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
              <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
              <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
            </svg>
          </span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-8 sm:whitespace-nowrap">
          Proyectos <span class="text-primary-500"><WordsCarousel words={projectWords} interval={3000} /></span>
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl max-w-3xl">
          Una selección de proyectos que representan mi enfoque en diseño de experiencia de usuario, sistemas de diseño y producto digital.
        </p>
      </div>

      <!-- Filters: Design mode -->
      <div data-reveal data-delay="300" class="flex flex-wrap gap-2 mt-12" id="project-filters"
        data-component="FilterGroup" data-token="$spacing-gap: 0.5rem / 8px">
        {filterCategories.map((cat) => (
          <button
            class:list={[
              'filter-btn px-5 py-2 text-sm font-medium rounded-full transition-all duration-300',
              cat === 'Todas'
                ? 'bg-primary-500/10 text-primary-500'
                : 'bg-neutral-100 text-neutral-600 hover:bg-neutral-200',
            ]}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Hero: Code mode — projects.config.ts console -->
  <section class="section-padding pb-12 projects-hero-code" data-component="ProjectsHeroCode">
    <div class="container-custom">
      <div class="file-block">
        <div class="file-block__titlebar">
          <div class="pmd-dots">
            <span class="json-dot json-dot--red"></span>
            <span class="json-dot json-dot--yellow"></span>
            <span class="json-dot json-dot--green"></span>
          </div>
          <span class="file-block__filename">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline;vertical-align:-2px;margin-right:4px;color:#3178c6">
              <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h3a3 3 0 010 6H9m6-6v10"/>
            </svg>
            projects.config.ts
          </span>
          <span class="file-block__tab">projects.config.ts</span>
        </div>
        <div class="file-block__body">
          <!-- JSDoc header -->
          <div class="file-block__line"><span class="file-block__gutter">1</span><span class="file-block__code"><span class="pmd-comment">/**</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">2</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@module</span> Projects</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">3</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@description</span></span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">4</span><span class="file-block__code"><span class="pmd-comment"> *   Selección de proyectos que representan mi enfoque en</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">5</span><span class="file-block__code"><span class="pmd-comment"> *   diseño de experiencia, sistemas de diseño y producto digital.</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">6</span><span class="file-block__code"><span class="pmd-comment"> *</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">7</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@stack</span> UX Research · Product Design · Design Systems · DesignOps</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">8</span><span class="file-block__code"><span class="pmd-comment"> * <span class="pmd-keyword">@author</span> Ramon Riera</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">9</span><span class="file-block__code"><span class="pmd-comment"> */</span></span></div>
          <!-- Empty -->
          <div class="file-block__line"><span class="file-block__gutter">10</span><span class="file-block__code"></span></div>
          <!-- Interface -->
          <div class="file-block__line"><span class="file-block__gutter">11</span><span class="file-block__code"><span class="pmd-keyword">interface</span> <span class="pmd-fn">ProjectFilter</span> <span class="pmd-bracket">{`{`}</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">12</span><span class="file-block__code">  <span class="pmd-key">type</span><span class="pmd-punct">:</span> {filterCategories.map((cat, i) => (
            <><span class="pmd-string">"{cat}"</span>{i < filterCategories.length - 1 && <span class="pf-filter-sep"> | </span>}</>
          ))}<span class="pmd-punct">;</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">13</span><span class="file-block__code"><span class="pmd-bracket">{`}`}</span></span></div>
          <!-- Empty -->
          <div class="file-block__line"><span class="file-block__gutter">14</span><span class="file-block__code"></span></div>
          <!-- Interaction hint -->
          <div class="file-block__line"><span class="file-block__gutter">15</span><span class="file-block__code"><span class="pmd-comment">// Click on a type to filter the project gallery</span></span></div>
          <!-- Empty -->
          <div class="file-block__line"><span class="file-block__gutter">16</span><span class="file-block__code"></span></div>
          <!-- Export const with interactive filters -->
          <div class="file-block__line"><span class="file-block__gutter">17</span><span class="file-block__code"><span class="pmd-keyword">export const</span> <span class="pmd-fn">currentFilter</span><span class="pmd-punct">:</span> <span class="pmd-fn">ProjectFilter</span> <span class="pmd-punct">=</span> <span class="pmd-bracket">{`{`}</span></span></div>
          <div class="file-block__line pf-filter-line"><span class="file-block__gutter">18</span><span class="file-block__code">  <span class="pmd-key">type</span><span class="pmd-punct">:</span> <span class="pf-filter-options">{filterCategories.map((cat, i) => (
            <><button class:list={['pf-filter-btn filter-btn', cat === 'Todas' && 'pf-filter-btn--active']} data-filter={cat}><span class="pf-filter-quote">"</span>{cat}<span class="pf-filter-quote">"</span></button>{i < filterCategories.length - 1 && <span class="pf-filter-sep"> | </span>}</>
          ))}</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">19</span><span class="file-block__code"><span class="pmd-bracket">{`}`}</span><span class="pmd-punct">;</span></span></div>
          <!-- Empty -->
          <div class="file-block__line"><span class="file-block__gutter">20</span><span class="file-block__code"></span></div>
          <!-- Execute section -->
          <div class="file-block__line"><span class="file-block__gutter">21</span><span class="file-block__code"><span class="pmd-comment">// -- Execute query --</span></span></div>
          <div class="file-block__line"><span class="file-block__gutter">22</span><span class="file-block__code"></span></div>
          <!-- Run command (dynamic) -->
          <a class="pf-run-line file-block__line" id="pf-run-cmd" href="#projects-grid">
            <span class="file-block__gutter">23</span>
            <span class="file-block__code">
              <span class="pmd-fn">&gt;</span> <span class="pmd-bracket">run</span> <span class="pmd-fn">projects</span><span class="pmd-punct">.</span><span class="pmd-string">applyFilter</span><span class="pmd-punct">(</span><span class="pmd-constant" id="pf-active-filter">"Todas"</span><span class="pmd-punct">)</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects grid -->
  <section class="pb-32" data-component="ProjectsListing">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid"
        data-component="ProjectGrid" data-token="$grid-cols: 1 → 2 (md)|$spacing-gap: 2rem / 32px">
        {sortedProjects.map((project, i) => (
          <div
            data-reveal
            data-delay={String(i * 100)}
            data-category={project.category}
            data-filters={JSON.stringify(getProjectFilters(project.tags))}
            class="project-item"
          >
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <ContactConsole />
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectItems = document.querySelectorAll('.project-item');
  const grid = document.getElementById('projects-grid') as HTMLElement;

  function applyFilter(filter: string | null) {
    if (!filter) return;

    // Update design-mode buttons
    filterBtns.forEach((b) => {
      if (!b.classList.contains('pf-filter-btn')) {
        b.classList.remove('bg-primary-500/10', 'text-primary-500');
        b.classList.add('bg-neutral-100', 'text-neutral-600');
      }
    });
    document.querySelectorAll(`.filter-btn:not(.pf-filter-btn)[data-filter="${filter}"]`).forEach((b) => {
      b.classList.remove('bg-neutral-100', 'text-neutral-600');
      b.classList.add('bg-primary-500/10', 'text-primary-500');
    });

    // Update code-mode buttons
    document.querySelectorAll('.pf-filter-btn').forEach((b) => {
      b.classList.remove('pf-filter-btn--active');
    });
    document.querySelectorAll(`.pf-filter-btn[data-filter="${filter}"]`).forEach((b) => {
      b.classList.add('pf-filter-btn--active');
    });

    // Update dynamic run line: applyFilter("activeCategory")
    const activeFilterEl = document.getElementById('pf-active-filter');
    if (activeFilterEl) {
      activeFilterEl.textContent = `"${filter}"`;
    }

    // Flash grid opacity to simulate console processing
    grid.style.transition = 'opacity 0.15s ease';
    grid.style.opacity = '0.4';
    setTimeout(() => {
      grid.style.transition = 'opacity 0.3s ease';
      grid.style.opacity = '1';
    }, 150);

    // Classify items into hiding / showing
    const hiding: HTMLElement[] = [];
    const showing: HTMLElement[] = [];

    projectItems.forEach((item) => {
      const el = item as HTMLElement;
      const filters = JSON.parse(el.getAttribute('data-filters') || '[]');
      if (filter === 'Todas' || filters.includes(filter)) {
        showing.push(el);
      } else {
        hiding.push(el);
      }
    });

    // 1. Lock the grid height to prevent layout shift
    const startHeight = grid.offsetHeight;
    grid.style.height = `${startHeight}px`;
    grid.style.overflow = 'hidden';

    // 2. Fade out + scale down items being hidden
    hiding.forEach((el) => {
      el.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
      el.style.opacity = '0';
      el.style.transform = 'scale(0.95)';
    });

    // 3. After fade-out, toggle visibility and animate to new height
    setTimeout(() => {
      hiding.forEach((el) => {
        el.style.display = 'none';
      });
      showing.forEach((el) => {
        el.style.display = '';
        el.style.opacity = '0';
        el.style.transform = 'scale(0.97) translateY(8px)';
      });

      // Measure the target height
      grid.style.height = 'auto';
      const endHeight = grid.offsetHeight;

      // Animate from startHeight → endHeight
      grid.style.height = `${startHeight}px`;
      void grid.offsetHeight; // force reflow
      grid.style.transition = 'height 0.4s cubic-bezier(0.22, 1, 0.36, 1)';
      grid.style.height = `${endHeight}px`;

      // Staggered fade-in for showing items
      showing.forEach((el, i) => {
        el.style.transition = `opacity 0.35s ease ${i * 50}ms, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1) ${i * 50}ms`;
        void el.offsetHeight; // force reflow per item
        el.style.opacity = '1';
        el.style.transform = 'scale(1) translateY(0)';
      });

      // Clean up inline styles after all animations complete
      const cleanupDelay = 400 + showing.length * 50;
      setTimeout(() => {
        grid.style.height = '';
        grid.style.overflow = '';
        grid.style.transition = '';
        showing.forEach((el) => {
          el.style.transition = '';
          el.style.transform = '';
        });
      }, cleanupDelay);
    }, 250);
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      applyFilter(filter);

      // Scroll filters into view to prevent page jump
      const filtersEl = document.getElementById('project-filters');
      if (filtersEl) {
        const rect = filtersEl.getBoundingClientRect();
        if (rect.top < 0) {
          filtersEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
