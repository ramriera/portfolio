---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import Tag from '@/components/Tag.astro';
import { projects } from '@/utils/data';
import type { CaseSection } from '@/utils/data';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const otherProjects = projects.filter((p) => p.slug !== project.slug).slice(0, 2);
const hasCaseStudy = !!project.caseSections?.length;
const meta = project.projectMeta;
---

<BaseLayout
  title={`${project.title} - Ramon Riera`}
  description={project.description}
  image={project.cover}
>
  <!-- Hero -->
  <section class="section-padding pb-12">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-6">
          <span class="section-icon">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-rocket-launch">
                <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
              </g>
              <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
              <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
              <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
            </svg>
          </span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-6">
          {project.title}
        </h1>
        <p data-reveal data-delay="200" class="text-body text-xl mb-8">
          {project.description}
        </p>
        <div data-reveal data-delay="300" class="flex flex-wrap gap-2">
          {project.tags.map((tag: string) => (
            <Tag label={tag} variant="primary" size="md" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Hero Image - parallax zoom -->
  <section class="pb-20">
    <div class="container-custom">
      <div data-reveal class="rounded-2xl overflow-hidden dashed-border">
        <div class="parallax-cover-wrapper">
          <img
            src={project.cover}
            alt={project.title}
            class="parallax-cover-img w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Project metadata - horizontal layout -->
  <section class="pb-16">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
      <div data-reveal class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Left: Info cards (vertical) -->
        <div class="grid grid-cols-1 gap-4">
          <!-- Fecha -->
          <div class="flex items-start gap-3 p-5 rounded-xl bg-dark-100/60 dark:bg-dark-800/60">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-dark-200/80 dark:bg-dark-700/80 flex items-center justify-center">
              <svg class="w-5 h-5 text-dark-500 dark:text-dark-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
              </svg>
            </div>
            <div>
              <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-1">Fecha</h4>
              <p class="font-semibold text-sm">{project.year}</p>
            </div>
          </div>

          {meta && (
            <!-- Duración -->
            <div class="flex items-start gap-3 p-5 rounded-xl bg-dark-100/60 dark:bg-dark-800/60">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-dark-200/80 dark:bg-dark-700/80 flex items-center justify-center">
                <svg class="w-5 h-5 text-dark-500 dark:text-dark-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-1">Duración</h4>
                <p class="font-semibold text-sm">{meta.duration}</p>
              </div>
            </div>
          )}
        </div>

        <!-- Right: Skills -->
        {meta && (
          <div class="flex items-start gap-4 p-5 rounded-xl bg-dark-100/60 dark:bg-dark-800/60">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-dark-200/80 dark:bg-dark-700/80 flex items-center justify-center">
              <svg class="w-5 h-5 text-dark-500 dark:text-dark-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
            </div>
            <div>
              <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Skills</h4>
              <div class="flex flex-wrap gap-2">
                {meta.skills.map((skill: string) => (
                  <Tag label={skill} />
                ))}
              </div>
            </div>
          </div>
        )}

        {!meta && (
          <div class="flex items-start gap-4 p-5 rounded-xl bg-dark-100/60 dark:bg-dark-800/60">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-dark-200/80 dark:bg-dark-700/80 flex items-center justify-center">
              <svg class="w-5 h-5 text-dark-500 dark:text-dark-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
              </svg>
            </div>
            <div>
              <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Stack</h4>
              <div class="flex flex-wrap gap-2">
                {project.stack.map((tool: string) => (
                  <Tag label={tool} />
                ))}
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Links (only GitHub, no live button) -->
      <div data-reveal data-delay="200" class="flex flex-wrap gap-3 mt-6">
        {project.githubUrl && (
          <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-sm">
            Ver en GitHub
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        )}
      </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="pb-20">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto space-y-12">
        {!hasCaseStudy && (
          <>
            <div data-reveal>
              <h2 class="heading-md mb-6">Sobre el proyecto</h2>
              <p class="text-body text-lg">{project.longDescription}</p>
            </div>
            <div data-reveal>
              <h2 class="heading-md mb-6">El reto</h2>
              <p class="text-body text-lg">{project.challenge}</p>
            </div>
            <div data-reveal>
              <h2 class="heading-md mb-6">La solución</h2>
              <p class="text-body text-lg">{project.solution}</p>
            </div>
          </>
        )}

        {hasCaseStudy && (
          <>
            <div data-reveal>
              <h2 class="heading-md mb-6">Sobre el proyecto</h2>
              <p class="text-body text-lg mb-6">{project.longDescription}</p>
              <p class="text-body text-lg">{project.challenge}</p>
            </div>
            <div data-reveal>
              <h2 class="heading-md mb-6">Solución propuesta</h2>
              <p class="text-body text-lg">{project.solution}</p>
            </div>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- Case Study Sections -->
  {hasCaseStudy && project.caseSections!.map((section: CaseSection, idx: number) => {
    const prevLabel = idx > 0 ? project.caseSections![idx - 1].label : '';
    const showLabel = section.label !== prevLabel;
    return (
    <section class={showLabel && idx > 0 ? 'pt-24 pb-24' : 'pb-24'}>
      <div class="container-custom">

        {/* Center layout */}
        {section.layout === 'center' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content && (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed">{section.content}</p>
            )}
            {section.bullets && (
              <ul data-reveal data-delay="300" class="mt-6 space-y-3">
                {section.bullets.map((bullet: string) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-body text-base">{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}

        {/* Left-right: image left, text right */}
        {section.layout === 'left-right' && (
          <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
            <div class="space-y-4">
              {section.images?.map((img: string) => (
                <div data-reveal class="rounded-xl overflow-hidden">
                  <img src={img} alt={section.title} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
            <div>
              {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
              <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
              {section.content?.split('\n\n').map((paragraph: string) => (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
              ))}
              {section.highlight && (
                <blockquote data-reveal data-delay="300" class="mt-6 pl-5 border-l-4 border-primary-500 bg-primary-500/5 dark:bg-primary-500/10 rounded-r-xl py-4 pr-5">
                  <p class="text-base font-semibold text-dark-800 dark:text-dark-100 leading-relaxed">
                    <span class="text-primary-500 font-bold">Insight Clave:</span> {section.highlight}
                  </p>
                </blockquote>
              )}
            </div>
          </div>
          </div>
        )}

        {/* Right-left: text left, image right */}
        {section.layout === 'right-left' && (
          <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
            <div>
              {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
              <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
              {section.content?.split('\n\n').map((paragraph: string) => (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
              ))}
              {section.highlight && (
                <blockquote data-reveal data-delay="300" class="mt-6 pl-5 border-l-4 border-primary-500 bg-primary-500/5 dark:bg-primary-500/10 rounded-r-xl py-4 pr-5">
                  <p class="text-base font-semibold text-dark-800 dark:text-dark-100 leading-relaxed">
                    <span class="text-primary-500 font-bold">Insight Clave:</span> {section.highlight}
                  </p>
                </blockquote>
              )}
            </div>
            <div class="space-y-4">
              {section.images?.map((img: string) => (
                <div data-reveal class="rounded-xl overflow-hidden">
                  <img src={img} alt={section.title} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
          </div>
        )}

        {/* Full image */}
        {section.layout === 'full-image' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content && (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-10">{section.content}</p>
            )}
            <div class="space-y-6">
              {section.images?.map((img: string) => (
                <div data-reveal class="rounded-xl overflow-hidden">
                  <img src={img} alt={section.title} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Image grid */}
        {section.layout === 'image-grid' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content?.split('\n\n').map((paragraph: string) => (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
            ))}
            {section.highlight && (
              <blockquote data-reveal data-delay="300" class="mt-6 mb-10 pl-5 border-l-4 border-primary-500 bg-primary-500/5 dark:bg-primary-500/10 rounded-r-xl py-4 pr-5">
                <p class="text-base font-semibold text-dark-800 dark:text-dark-100 leading-relaxed">
                  <span class="text-primary-500 font-bold">Insight Clave:</span> {section.highlight}
                </p>
              </blockquote>
            )}
            <div class={`grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6 ${!section.highlight ? 'mt-10' : ''}`}>
              {section.images?.map((img: string, i: number) => (
                <div data-reveal data-delay={String(i * 80)} class="rounded-xl overflow-hidden">
                  <img src={img} alt={`${section.title} ${i + 1}`} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Screens grid - mobile mockups */}
        {section.layout === 'screens-grid' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content && (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-10">{section.content}</p>
            )}
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
              {section.images?.map((img: string, i: number) => (
                <div data-reveal data-delay={String(i * 60)} class="rounded-xl overflow-hidden">
                  <img src={img} alt={`Pantalla ${i + 1}`} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Figma embed */}
        {section.layout === 'figma-embed' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content && (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-10">{section.content}</p>
            )}
            {section.figmaUrl && (
              <div data-reveal class="rounded-2xl overflow-hidden border border-[#3f3f46]">
                <iframe
                  src={section.figmaUrl}
                  class="w-full border-0 h-[800px]"
                  allowfullscreen
                  loading="lazy"
                />
              </div>
            )}
          </div>
        )}

        {/* Whimsical embed */}
        {section.layout === 'whimsical-embed' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content?.split('\n\n').map((paragraph: string) => (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
            ))}
            <div class="space-y-8 mt-10">
              {section.embeds?.map((url: string, i: number) => (
                <div data-reveal data-delay={String(i * 120)} class="rounded-2xl overflow-hidden dashed-border">
                  <iframe
                    src={url}
                    class="w-full border-0 h-[300px] sm:h-[400px] md:h-[500px]"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Mermaid diagram */}
        {section.layout === 'mermaid' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content && (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-10">{section.content}</p>
            )}
            {section.mermaidCode && (
              <div data-reveal data-delay="300" class="rounded-2xl overflow-hidden border border-dark-200 dark:border-dark-700 bg-white dark:bg-dark-900 p-8 md:p-12">
                <pre class="mermaid flex justify-center">{section.mermaidCode}</pre>
              </div>
            )}
            {section.highlight && (
              <blockquote data-reveal data-delay="400" class="mt-8 pl-5 border-l-4 border-primary-500 bg-primary-500/5 dark:bg-primary-500/10 rounded-r-xl py-4 pr-5">
                <p class="text-base font-semibold text-dark-800 dark:text-dark-100 leading-relaxed">
                  <span class="text-primary-500 font-bold">Insight Clave:</span> {section.highlight}
                </p>
              </blockquote>
            )}
          </div>
        )}

        {/* Web embed - live website preview */}
        {section.layout === 'web-embed' && (
          <div class="max-w-4xl mx-auto">
            {showLabel && <h2 data-reveal class="text-base font-semibold text-primary-500 tracking-wide">{section.label}</h2>}
            <h3 data-reveal data-delay="100" class="heading-md mt-1 mb-6">{section.title}</h3>
            {section.content?.split('\n\n').map((paragraph: string) => (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
            ))}
            {section.embedUrl && (
              <div data-reveal class="mt-10 rounded-2xl overflow-hidden dashed-border">
                <iframe
                  src={section.embedUrl}
                  class="w-full border-0 h-[480px] sm:h-[600px] md:h-[800px]"
                  loading="lazy"
                  title={section.title}
                  sandbox="allow-scripts allow-same-origin allow-popups"
                />
              </div>
            )}
            {section.embedUrl && (
              <div data-reveal data-delay="300" class="mt-4 text-center">
