---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Tag from '@/components/Tag.astro';
import OptImage from '@/components/OptImage.astro';
import ContactConsole from '@/components/ContactConsole.astro';
import { projects } from '@/utils/data';
import type { CaseSection } from '@/utils/data';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const otherProjects = projects.filter((p) => p.slug !== project.slug).slice(0, 2);
const hasCaseStudy = !!project.caseSections?.length;
const meta = project.projectMeta;

// Code mode: slug to filename
const projectFileName = project.slug.replace(/-/g, '_') + '.config.ts';

// Code mode: next/prev project navigation
const projectIndex = projects.findIndex((p) => p.slug === project.slug);
const nextProject = projects[(projectIndex + 1) % projects.length];
const prevProject = projects[(projectIndex - 1 + projects.length) % projects.length];

function md(text: string): string {
  return text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<BaseLayout
  title={`${project.title} ⚡ Ramon Riera`}
  description={project.description}
  image={project.cover}
>
  <!-- Hero -->
  <section class="section-padding pb-12" data-component="ProjectHero">
    <div class="container-custom">
      <div class="max-w-4xl">
        <div data-reveal class="mb-6">
          <span class="section-icon" data-component="IconBadge" data-token="$spacing-size: 56px|$radius-icon: 14px">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="section-icon-svg">
              <g class="icon-rocket-launch">
                <path d="M22 6C22 6 14 14 14 26L18 30L22 32L26 30L30 26C30 14 22 6 22 6Z" class="icon-stroke icon-draw" />
                <circle cx="22" cy="18" r="3" class="icon-accent icon-draw-delay" />
                <path d="M14 26L10 32L18 30" class="icon-stroke icon-draw" />
                <path d="M30 26L34 32L26 30" class="icon-stroke icon-draw" />
              </g>
              <circle cx="20" cy="36" r="1.2" class="icon-accent icon-flame-1" />
              <circle cx="24" cy="37" r="1" class="icon-accent icon-flame-2" />
              <circle cx="22" cy="39" r="0.8" class="icon-accent icon-flame-3" />
            </svg>
          </span>
        </div>
        <h1 data-reveal data-delay="100" class="heading-xl mb-6"
          data-token="$font-size-heading-xl: clamp(2.25rem, 5vw, 4.5rem)|$font-weight: 600 (semibold)">
          {project.title}
        </h1>
        <p data-reveal data-delay="200" class="text-body text-lg sm:text-xl mb-8">
          {project.description}
        </p>
        <div data-reveal data-delay="300" class="flex flex-wrap gap-2"
          data-component="TagGroup" data-token="$spacing-gap: 0.5rem / 8px">
          {project.tags.map((tag: string) => (
            <Tag label={tag} variant="primary" size="md" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CODE MODE: Project Metadata Window ═══ -->
  <section class="section-padding pb-12 cm-project-hero" data-component="ProjectMetaWindow">
    <div class="container-custom">
        <div class="pmd-window">
          <div class="pmd-titlebar">
            <div class="pmd-dots">
              <span class="pmd-dot" style="background:#ff5f57"></span>
              <span class="pmd-dot" style="background:#febc2e"></span>
              <span class="pmd-dot" style="background:#28c840"></span>
            </div>
            <span class="pmd-filename">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="display:inline;vertical-align:-2px;margin-right:4px;color:#3178c6">
                <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h3a3 3 0 010 6H9m6-6v10"/>
              </svg>
              {projectFileName}
            </span>
            <span class="pmd-tab">{projectFileName}</span>
          </div>
          <div class="pmd-body">
            {/* ── Line 1: export const ── */}
            <div class="pmd-line"><span class="pmd-gutter">1</span><span class="pmd-code"><span class="pmd-comment">// {project.title} — Project Configuration</span></span></div>
            <div class="pmd-line"><span class="pmd-gutter">2</span><span class="pmd-code"></span></div>
            <div class="pmd-line"><span class="pmd-gutter">3</span><span class="pmd-code"><span class="pmd-keyword">export</span> <span class="pmd-keyword">const</span> <span class="pmd-fn">{project.slug.replace(/-/g, '_')}</span> <span class="pmd-punct">=</span> <span class="pmd-bracket">{'{'}</span></span></div>
            {/* ── Core metadata ── */}
            <div class="pmd-line"><span class="pmd-gutter">4</span><span class="pmd-code">  <span class="pmd-key">client</span><span class="pmd-punct">:</span> <span class="pmd-string">"{project.client}"</span><span class="pmd-punct">,</span></span></div>
            <div class="pmd-line"><span class="pmd-gutter">5</span><span class="pmd-code">  <span class="pmd-key">role</span><span class="pmd-punct">:</span> <span class="pmd-string">"{meta?.role || project.category}"</span><span class="pmd-punct">,</span></span></div>
            <div class="pmd-line"><span class="pmd-gutter">6</span><span class="pmd-code">  <span class="pmd-key">year</span><span class="pmd-punct">:</span> <span class="pmd-number">{project.year}</span><span class="pmd-punct">,</span></span></div>
            {meta?.industry && (
              <div class="pmd-line"><span class="pmd-gutter">7</span><span class="pmd-code">  <span class="pmd-key">industry</span><span class="pmd-punct">:</span> <span class="pmd-string">"{meta.industry}"</span><span class="pmd-punct">,</span></span></div>
            )}
            {meta?.duration && (
              <div class="pmd-line"><span class="pmd-gutter">{meta?.industry ? 8 : 7}</span><span class="pmd-code">  <span class="pmd-key">duration</span><span class="pmd-punct">:</span> <span class="pmd-string">"{meta.duration}"</span><span class="pmd-punct">,</span></span></div>
            )}
            {meta?.output && (
              <div class="pmd-line"><span class="pmd-gutter">{(meta?.industry ? 1 : 0) + (meta?.duration ? 1 : 0) + 7}</span><span class="pmd-code">  <span class="pmd-key">output</span><span class="pmd-punct">:</span> <span class="pmd-string">"{meta.output}"</span><span class="pmd-punct">,</span></span></div>
            )}
            {/* ── Blank line separator ── */}
            {(() => {
              let ln = 7 + (meta?.industry ? 1 : 0) + (meta?.duration ? 1 : 0) + (meta?.output ? 1 : 0);
              const blankLn = ln++;
              const stackLn = ln++;
              const tagsLn = ln++;
              const emptyLn = ln++;
              const commentLn = ln++;
              const impactOpenLn = ln++;
              const impactLines = project.results.map((_: string, i: number) => ln + i);
              ln += project.results.length;
              const impactCloseLn = ln++;
              const closeLn = ln++;
              return (
                <>
                  <div class="pmd-line"><span class="pmd-gutter">{blankLn}</span><span class="pmd-code"></span></div>
                  <div class="pmd-line"><span class="pmd-gutter">{stackLn}</span><span class="pmd-code">  <span class="pmd-key">stack</span><span class="pmd-punct">:</span> <span class="pmd-bracket">[</span>{project.stack.map((s: string, i: number) => <><span class="pmd-string">"{s}"</span>{i < project.stack.length - 1 ? <span class="pmd-punct">, </span> : ''}</>)}<span class="pmd-bracket">]</span><span class="pmd-punct">,</span></span></div>
                  <div class="pmd-line"><span class="pmd-gutter">{tagsLn}</span><span class="pmd-code">  <span class="pmd-key">tags</span><span class="pmd-punct">:</span> <span class="pmd-bracket">[</span>{project.tags.map((t: string, i: number) => <><span class="pmd-string">"{t}"</span>{i < project.tags.length - 1 ? <span class="pmd-punct">, </span> : ''}</>)}<span class="pmd-bracket">]</span><span class="pmd-punct">,</span></span></div>
                  <div class="pmd-line"><span class="pmd-gutter">{emptyLn}</span><span class="pmd-code"></span></div>
                  <div class="pmd-line"><span class="pmd-gutter">{commentLn}</span><span class="pmd-code">  <span class="pmd-comment">// Impact & Results</span></span></div>
                  <div class="pmd-line"><span class="pmd-gutter">{impactOpenLn}</span><span class="pmd-code">  <span class="pmd-key">impact</span><span class="pmd-punct">:</span> <span class="pmd-bracket">[</span></span></div>
                  {project.results.map((result: string, i: number) => (
                    <div class="pmd-line pmd-line--impact">
                      <span class="pmd-gutter">{impactLines[i]}</span>
                      <span class="pmd-code">    <span class="pmd-impact">"{result}"</span>{i < project.results.length - 1 ? <span class="pmd-punct">,</span> : ''}</span>
                    </div>
                  ))}
                  <div class="pmd-line"><span class="pmd-gutter">{impactCloseLn}</span><span class="pmd-code">  <span class="pmd-bracket">]</span></span></div>
                  <div class="pmd-line"><span class="pmd-gutter">{closeLn}</span><span class="pmd-code"><span class="pmd-bracket">{'}'}</span><span class="pmd-punct">;</span></span></div>
                </>
              );
            })()}
          </div>
        </div>
    </div>
  </section>

  <!-- Hero Image - parallax zoom (design mode) -->
  <section class="case-section cm-project-cover-design" data-component="ParallaxCover">
    <div class="container-custom">
      <div data-reveal class="rounded-2xl overflow-hidden dashed-border">
        <div class="parallax-cover-wrapper">
          <OptImage
            src={project.cover}
            alt={project.title}
            class="parallax-cover-img w-full h-auto object-cover"
            loading="eager"
            widths={[800, 1200, 1600]}
            sizes="100vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Hero Image - Asset Preview (code mode) -->
  <section class="case-section cm-project-cover-code" data-component="AssetPreview">
    <div class="container-custom">
        <div class="asset-preview">
          <!-- Toolbar: path + dimensions -->
          <div class="asset-preview__toolbar">
            <div class="asset-preview__path">
              <svg class="asset-preview__path-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
              <span class="asset-preview__path-dir">assets</span>
              <span class="asset-preview__path-sep">&gt;</span>
              <span class="asset-preview__path-dir">projects</span>
              <span class="asset-preview__path-sep">&gt;</span>
              <span class="asset-preview__path-file">{project.slug}_cover.png</span>
            </div>
            <div class="asset-preview__dims">
              <span>1600 × 900</span>
              <span class="asset-preview__dims-sep">|</span>
              <span>PNG</span>
            </div>
          </div>
          <!-- Canvas: grid bg + image + cyan glow -->
          <div class="asset-preview__canvas">
            <div class="asset-preview__img-wrap">
              <OptImage
                src={project.cover}
                alt={project.title}
                class="asset-preview__img"
                loading="eager"
                widths={[800, 1200, 1600]}
                sizes="100vw"
              />
            </div>
          </div>
          <!-- Status bar -->
          <div class="asset-preview__status">
            <span class="asset-preview__status-item">Layer: Hero Cover</span>
            <span class="asset-preview__status-sep">|</span>
            <span class="asset-preview__status-item">Status: Production</span>
            <span class="asset-preview__status-sep">|</span>
            <span class="asset-preview__status-item">High Fidelity</span>
          </div>
        </div>
    </div>
  </section>

  <!-- Project metadata sidebar + About content (design mode) -->
  <section class="case-section cm-project-sidebar-design">
    <div class="container-custom">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">

          <!-- Sidebar (1/3): Metadata stacked vertically -->
          <div data-reveal class="lg:col-span-1" data-component="ProjectSidebar" data-token="$spacing-gap: 1rem / 16px|$position: sticky top-8">
            <div class="flex flex-col gap-4 lg:sticky lg:top-8">
              <!-- Fecha -->
              <div class="meta-card flex items-start gap-3 p-5 rounded-xl bg-neutral-100/60"
                data-component="MetaCard" data-token="$spacing-padding: 1.25rem / 20px|$radius-xl: 0.75rem / 12px|$color-bg-surface: rgba(243,241,237,0.6)">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-neutral-200/80 flex items-center justify-center">
                  <svg class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-medium uppercase tracking-wider text-neutral-400 mb-1">Fecha</h4>
                  <p class="font-semibold text-sm">{project.year}</p>
                </div>
              </div>

              {meta && (
                <!-- Duración -->
                <div class="meta-card flex items-start gap-3 p-5 rounded-xl bg-neutral-100/60">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-neutral-200/80 flex items-center justify-center">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-neutral-400 mb-1">Duración</h4>
                    <p class="font-semibold text-sm">{meta.duration}</p>
                  </div>
                </div>
              )}

              {meta && (
                <!-- Rol -->
                <div class="meta-card flex items-start gap-3 p-5 rounded-xl bg-neutral-100/60">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-neutral-200/80 flex items-center justify-center">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-neutral-400 mb-1">Rol</h4>
                    <p class="font-semibold text-sm">{meta.role}</p>
                  </div>
                </div>
              )}

              {meta && (
                <!-- Industria -->
                <div class="meta-card flex items-start gap-3 p-5 rounded-xl bg-neutral-100/60">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-neutral-200/80 flex items-center justify-center">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-neutral-400 mb-1">Industria</h4>
                    <p class="font-semibold text-sm">{meta.industry}</p>
                  </div>
                </div>
              )}

              <!-- Skills / Stack -->
              {meta && (
                <div class="meta-card flex items-start gap-4 p-5 rounded-xl bg-neutral-100/60"
                  data-component="SkillBadgeGroup" data-token="$spacing-gap: 0.5rem / 8px|$spacing-padding: 1.25rem / 20px">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-neutral-200/80 flex items-center justify-center">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-neutral-400 mb-2">Skills</h4>
                    <div class="flex flex-wrap gap-2">
                      {meta.skills.map((skill: string) => (
                        <Tag label={skill} />
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {!meta && (
                <div class="meta-card flex items-start gap-4 p-5 rounded-xl bg-neutral-100/60">
                  <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-neutral-200/80 flex items-center justify-center">
                    <svg class="w-5 h-5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-neutral-400 mb-2">Stack</h4>
                    <div class="flex flex-wrap gap-2">
                      {project.stack.map((tool: string) => (
                        <Tag label={tool} />
                      ))}
                    </div>
                  </div>
                </div>
              )}

              <!-- GitHub link -->
              {project.githubUrl && (
                <div class="mt-2">
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-outline text-sm w-full justify-center">
                    Ver en GitHub
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>

          <!-- Main content (2/3): About the project -->
          <div class="lg:col-span-2 space-y-12" data-component="ProjectContent">
            {!hasCaseStudy && (
              <>
                <div data-reveal>
                  <h2 class="heading-md mb-6">Sobre el proyecto</h2>
                  <p class="text-body max-w-prose">{project.longDescription}</p>
                </div>
                <div data-reveal>
                  <h2 class="heading-md mb-6">El reto</h2>
                  <p class="text-body max-w-prose">{project.challenge}</p>
                </div>
                <div data-reveal>
                  <h2 class="heading-md mb-6">La solución</h2>
                  <p class="text-body">{project.solution}</p>
                </div>
              </>
            )}

            {hasCaseStudy && (
              <>
                <div data-reveal>
                  <h2 class="heading-md mb-6">Sobre el proyecto</h2>
                  {project.longDescription.split('\n\n').map((paragraph: string) => (
                    <p class="text-body mb-6 max-w-prose" set:html={md(paragraph)} />
                  ))}
                  <p class="text-body mb-8 max-w-prose" set:html={md(project.challenge)} />
                  {project.checks && project.checks.length > 0 && (
                    <ul class="space-y-3">
                      {project.checks.map((check: string) => (
                        <li class="flex items-start gap-3">
                          <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
