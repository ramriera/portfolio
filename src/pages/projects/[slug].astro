---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import Tag from '@/components/Tag.astro';
import { projects } from '@/utils/data';
import type { CaseSection } from '@/utils/data';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const otherProjects = projects.filter((p) => p.slug !== project.slug).slice(0, 2);
const hasCaseStudy = !!project.caseSections?.length;
const meta = project.projectMeta;
---

<BaseLayout
  title={`${project.title} — Ramon Riera`}
  description={project.description}
  image={project.cover}
>
  <!-- Hero -->
  <section class="section-padding pb-12">
    <div class="container-custom">
      <div class="max-w-4xl">
        <h1 data-reveal class="heading-xl mb-6">
          {project.title}
        </h1>
        <p data-reveal data-delay="100" class="text-body text-xl mb-8">
          {project.description}
        </p>
        <div data-reveal data-delay="200" class="flex flex-wrap gap-2">
          {project.tags.map((tag: string) => (
            <Tag label={tag} variant="primary" size="md" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Hero Image — parallax zoom -->
  <section class="pb-20">
    <div class="container-custom">
      <div data-reveal class="rounded-2xl overflow-hidden dashed-border">
        <div class="parallax-cover-wrapper">
          <img
            src={project.cover}
            alt={project.title}
            class="parallax-cover-img w-full h-auto object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content: sidebar + main -->
  <section class="pb-20">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        <!-- Sidebar — vertical -->
        <div class="lg:col-span-1 order-2 lg:order-1">
          <div class="sticky top-28 space-y-8">
            <div data-reveal class="space-y-6">
              <div>
                <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Cliente</h4>
                <p class="font-semibold">{project.client}</p>
              </div>
              <div>
                <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Año</h4>
                <p class="font-semibold">{project.year}</p>
              </div>
              <div>
                <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Categoría</h4>
                <p class="font-semibold">{project.category}</p>
              </div>
              {meta && (
                <>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Rol</h4>
                    <p class="font-semibold text-sm">{meta.role}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Duración</h4>
                    <p class="font-semibold">{meta.duration}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Herramientas</h4>
                    <div class="flex flex-wrap gap-2">
                      {meta.tools.map((tool: string) => (
                        <Tag label={tool} />
                      ))}
                    </div>
                  </div>
                  <div>
                    <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Skills</h4>
                    <div class="flex flex-wrap gap-2">
                      {meta.skills.map((skill: string) => (
                        <Tag label={skill} />
                      ))}
                    </div>
                  </div>
                </>
              )}
              {!meta && (
                <div>
                  <h4 class="text-xs font-medium uppercase tracking-wider text-dark-400 dark:text-dark-500 mb-2">Stack</h4>
                  <div class="flex flex-wrap gap-2">
                    {project.stack.map((tool: string) => (
                      <Tag label={tool} />
                    ))}
                  </div>
                </div>
              )}
            </div>

            <!-- Links -->
            <div data-reveal data-delay="100" class="space-y-3">
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full justify-center text-sm">
                  Ver proyecto live
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-outline w-full justify-center text-sm">
                  Ver en GitHub
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Main content -->
        <div class="lg:col-span-2 order-1 lg:order-2 space-y-12">
          {!hasCaseStudy && (
            <>
              <div data-reveal>
                <h2 class="heading-md mb-6">Sobre el proyecto</h2>
                <p class="text-body text-lg">{project.longDescription}</p>
              </div>
              <div data-reveal>
                <h2 class="heading-md mb-6">El reto</h2>
                <p class="text-body text-lg">{project.challenge}</p>
              </div>
              <div data-reveal>
                <h2 class="heading-md mb-6">La solución</h2>
                <p class="text-body text-lg">{project.solution}</p>
              </div>
            </>
          )}

          {hasCaseStudy && (
            <>
              <div data-reveal>
                <h2 class="heading-md mb-6">Sobre el proyecto</h2>
                <p class="text-body text-lg mb-6">{project.longDescription}</p>
                <p class="text-body text-lg">{project.challenge}</p>
              </div>
              <div data-reveal>
                <h2 class="heading-md mb-6">Solución propuesta</h2>
                <p class="text-body text-lg">{project.solution}</p>
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Case Study Sections -->
  {hasCaseStudy && project.caseSections!.map((section: CaseSection, idx: number) => (
    <section class="pb-24">
      <div class="container-custom">

        {/* Center layout */}
        {section.layout === 'center' && (
          <div class="max-w-3xl mx-auto">
            <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
            <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
            {section.content && (
              <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed">{section.content}</p>
            )}
            {section.bullets && (
              <ul data-reveal data-delay="300" class="mt-6 space-y-3">
                {section.bullets.map((bullet: string) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-body text-base">{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}

        {/* Left-right: image left, text right */}
        {section.layout === 'left-right' && (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
            <div class="space-y-4">
              {section.images?.map((img: string) => (
                <div data-reveal class="rounded-2xl overflow-hidden">
                  <img src={img} alt={section.title} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
            <div>
              <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
              <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
              {section.content?.split('\n\n').map((paragraph: string) => (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
              ))}
            </div>
          </div>
        )}

        {/* Right-left: text left, image right */}
        {section.layout === 'right-left' && (
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
            <div>
              <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
              <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
              {section.content?.split('\n\n').map((paragraph: string) => (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed mb-4">{paragraph}</p>
              ))}
            </div>
            <div class="space-y-4">
              {section.images?.map((img: string) => (
                <div data-reveal class="rounded-2xl overflow-hidden">
                  <img src={img} alt={section.title} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Full image */}
        {section.layout === 'full-image' && (
          <div>
            <div class="max-w-3xl mx-auto mb-10">
              <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
              <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
              {section.content && (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed">{section.content}</p>
              )}
            </div>
            {section.images?.map((img: string) => (
              <div data-reveal class="rounded-2xl overflow-hidden">
                <img src={img} alt={section.title} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
              </div>
            ))}
          </div>
        )}

        {/* Image grid */}
        {section.layout === 'image-grid' && (
          <div>
            <div class="max-w-3xl mx-auto mb-10">
              <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
              <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
              {section.content && (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed">{section.content}</p>
              )}
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {section.images?.map((img: string, i: number) => (
                <div data-reveal data-delay={String(i * 80)} class="rounded-2xl overflow-hidden">
                  <img src={img} alt={`${section.title} ${i + 1}`} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Screens grid — mobile mockups */}
        {section.layout === 'screens-grid' && (
          <div>
            <div class="max-w-3xl mx-auto mb-10">
              <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
              <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
              {section.content && (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed">{section.content}</p>
              )}
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
              {section.images?.map((img: string, i: number) => (
                <div data-reveal data-delay={String(i * 60)} class="rounded-xl overflow-hidden shadow-lg shadow-dark-900/10">
                  <img src={img} alt={`Pantalla ${i + 1}`} class="lightbox-trigger w-full h-auto object-cover cursor-zoom-in" loading="lazy" />
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Figma embed */}
        {section.layout === 'figma-embed' && (
          <div>
            <div class="max-w-3xl mx-auto mb-10">
              <span data-reveal class="text-sm font-medium text-primary-500 tracking-wide">{section.label}</span>
              <h2 data-reveal data-delay="100" class="heading-md mt-4 mb-6">{section.title}</h2>
              {section.content && (
                <p data-reveal data-delay="200" class="text-body text-lg leading-relaxed">{section.content}</p>
              )}
            </div>
            {section.figmaUrl && (
              <div data-reveal class="rounded-2xl overflow-hidden dashed-border aspect-[9/16] sm:aspect-[3/4] md:aspect-[4/3] max-w-4xl mx-auto">
                <iframe
                  src={section.figmaUrl}
                  class="w-full h-full border-0"
                  allowfullscreen
                  loading="lazy"
                />
              </div>
            )}
          </div>
        )}

      </div>
    </section>
  ))}

  <!-- Resultados -->
  <section class="pb-24">
    <div class="container-custom">
      <div class="relative rounded-3xl bg-dark-900 dark:bg-dark-800 p-12 md:p-20 overflow-hidden">
        <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-primary-500/[0.07] blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full bg-primary-500/[0.07] blur-3xl"></div>

        <div class="relative z-10">
          <div class="text-center mb-12">
            <span data-reveal class="text-sm font-medium text-primary-400 tracking-wide">Impacto</span>
            <h2 data-reveal data-delay="100" class="heading-lg text-white mt-4">Resultados</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {project.results.map((result: string, i: number) => (
              <div data-reveal data-delay={String(i * 100)} class="flex items-start gap-4 p-6 rounded-xl bg-white/5 border border-white/10">
                <svg class="w-6 h-6 text-primary-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-white font-medium">{result}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other projects -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="flex items-end justify-between mb-12">
        <h2 data-reveal class="heading-lg">
          Otros <span class="text-primary-500">proyectos</span>
        </h2>
        <a data-reveal href="/projects" class="btn-outline text-sm">
          Ver todos
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {otherProjects.map((p, i) => (
          <div data-reveal data-delay={String(i * 150)}>
            <a href={`/projects/${p.slug}`} class="project-card group block rounded-2xl overflow-hidden dashed-border card-hover bg-white dark:bg-dark-900">
              <div class="relative overflow-hidden aspect-[16/10]">
                <img src={p.cover} alt={p.title} class="project-card-image w-full h-full object-cover" loading="lazy" />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1.5 text-xs font-semibold rounded-full bg-white/90 dark:bg-dark-900/90 backdrop-blur-sm">{p.category}</span>
                </div>
              </div>
              <div class="p-6">
                <span class="text-xs font-medium text-primary-500 uppercase tracking-wider">{p.client}</span>
                <h3 class="heading-sm mt-2 group-hover:text-primary-500 transition-colors">{p.title}</h3>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox overlay -->
  <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm cursor-zoom-out" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white transition-colors z-10" aria-label="Cerrar">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl" alt="" />
  </div>
</BaseLayout>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    if (!lightbox || !lightboxImg) return;

    document.querySelectorAll('.lightbox-trigger').forEach((img) => {
      img.addEventListener('click', () => {
        const src = (img as HTMLImageElement).src;
        const alt = (img as HTMLImageElement).alt;
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    function close() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = '';
      lightboxImg.src = '';
    }

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    closeBtn?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) close();
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

<script>
  function initParallaxCover() {
    const img = document.querySelector('.parallax-cover-img') as HTMLElement | null;
    if (!img) return;

    const wrapper = img.closest('.parallax-cover-wrapper') as HTMLElement | null;
    if (!wrapper) return;

    function onScroll() {
      const rect = wrapper!.getBoundingClientRect();
      const viewH = window.innerHeight;
      // progress: 0 when element enters viewport bottom, 1 when it leaves top
      const progress = Math.min(Math.max((viewH - rect.top) / (viewH + rect.height), 0), 1);
      const scale = 1 + progress * 0.15; // zoom from 1x to 1.15x
      img!.style.transform = `scale(${scale})`;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  initParallaxCover();
  document.addEventListener('astro:page-load', initParallaxCover);
</script>

