---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import Tag from '@/components/Tag.astro';
import { projects } from '@/utils/data';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const otherProjects = projects.filter((p) => p.slug !== project.slug).slice(0, 2);
---

<BaseLayout
  title={`${project.title} — Ramon Riera`}
  description={project.description}
  image={project.cover}
>
  <!-- Hero -->
  <section class="section-padding pb-12">
    <div class="container-custom">
      <!-- Breadcrumb -->
      <div data-reveal class="flex items-center gap-2 text-sm text-dark-400 dark:text-dark-500 mb-8">
        <a href="/" class="hover:text-primary-500 transition-colors">Inicio</a>
        <span>/</span>
        <a href="/projects" class="hover:text-primary-500 transition-colors">Proyectos</a>
        <span>/</span>
        <span class="text-dark-700 dark:text-dark-300">{project.title}</span>
      </div>

      <div class="max-w-4xl">
        <div data-reveal data-delay="100" class="flex items-center gap-3 mb-6">
          <span class="text-sm font-mono font-medium text-primary-500 uppercase tracking-widest">{project.client} — {project.year}</span>
        </div>
        <h1 data-reveal data-delay="200" class="heading-xl mb-6">
          {project.title}
        </h1>
        <p data-reveal data-delay="300" class="text-body text-xl mb-8">
          {project.description}
        </p>
        <div data-reveal data-delay="400" class="flex flex-wrap gap-2">
          {project.tags.map((tag: string) => (
            <Tag label={tag} variant="primary" size="md" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="pb-20">
    <div class="container-custom">
      <div data-reveal>
        <Gallery images={project.gallery} alt={project.title} />
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="pb-20">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        <!-- Sidebar -->
        <div class="lg:col-span-1 order-2 lg:order-1">
          <div class="sticky top-28 space-y-8">
            <!-- Project info -->
            <div data-reveal class="space-y-6">
              <div>
                <h4 class="text-xs font-mono uppercase tracking-widest text-dark-400 dark:text-dark-500 mb-2">Cliente</h4>
                <p class="font-semibold">{project.client}</p>
              </div>
              <div>
                <h4 class="text-xs font-mono uppercase tracking-widest text-dark-400 dark:text-dark-500 mb-2">Año</h4>
                <p class="font-semibold">{project.year}</p>
              </div>
              <div>
                <h4 class="text-xs font-mono uppercase tracking-widest text-dark-400 dark:text-dark-500 mb-2">Categoría</h4>
                <p class="font-semibold">{project.category}</p>
              </div>
              <div>
                <h4 class="text-xs font-mono uppercase tracking-widest text-dark-400 dark:text-dark-500 mb-2">Stack</h4>
                <div class="flex flex-wrap gap-2">
                  {project.stack.map((tool: string) => (
                    <Tag label={tool} />
                  ))}
                </div>
              </div>
            </div>

            <!-- Links -->
            <div data-reveal data-delay="100" class="space-y-3">
              {project.liveUrl && (
                <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full justify-center text-sm">
                  Ver proyecto live
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              )}
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn-outline w-full justify-center text-sm">
                  Ver en GitHub
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Main content -->
        <div class="lg:col-span-2 order-1 lg:order-2 space-y-12">
          <div data-reveal>
            <h2 class="heading-md mb-6">Sobre el proyecto</h2>
            <p class="text-body text-lg">{project.longDescription}</p>
          </div>

          <div data-reveal>
            <h2 class="heading-md mb-6">El reto</h2>
            <p class="text-body text-lg">{project.challenge}</p>
          </div>

          <div data-reveal>
            <h2 class="heading-md mb-6">La solución</h2>
            <p class="text-body text-lg">{project.solution}</p>
          </div>

          <div data-reveal>
            <h2 class="heading-md mb-6">Resultados</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {project.results.map((result: string) => (
                <div class="flex items-start gap-3 p-4 rounded-xl dashed-border">
                  <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-sm font-medium">{result}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other projects -->
  <section class="section-padding border-t border-dark-100 dark:border-dark-800 bg-dark-50/50 dark:bg-dark-900/50">
    <div class="container-custom">
      <div class="flex items-end justify-between mb-12">
        <h2 data-reveal class="heading-lg">
          Otros <span class="gradient-text">proyectos</span>
        </h2>
        <a data-reveal href="/projects" class="btn-outline text-sm">
          Ver todos
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {otherProjects.map((p, i) => (
          <div data-reveal data-delay={String(i * 150)}>
            <a href={`/projects/${p.slug}`} class="project-card group block rounded-2xl overflow-hidden dashed-border card-hover bg-white dark:bg-dark-900">
              <div class="relative overflow-hidden aspect-[16/10]">
                <img src={p.cover} alt={p.title} class="project-card-image w-full h-full object-cover" loading="lazy" />
                <div class="absolute top-4 left-4">
                  <span class="px-3 py-1.5 text-xs font-semibold rounded-full bg-white/90 dark:bg-dark-900/90 backdrop-blur-sm">{p.category}</span>
                </div>
              </div>
              <div class="p-6">
                <span class="text-xs font-medium text-primary-500 uppercase tracking-wider">{p.client}</span>
                <h3 class="heading-sm mt-2 group-hover:text-primary-500 transition-colors">{p.title}</h3>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
