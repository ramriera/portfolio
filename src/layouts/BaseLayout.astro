---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
// PERF: Removed Inter 800/900 — unused (404 decorative text falls back to 700)
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Ramon Riera — UX Lead & Product Designer. Puente entre diseño y frontend escalable: Design Systems, UX strategy y operaciones de producto.',
  image = '/assets/shared/og-image.png',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://ramonriera.design';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ramon Riera" />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-neutral-900 transition-colors duration-300">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <!-- Code mode removed -->

    <script>
      // Scroll reveal with Intersection Observer
      const revealElements = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const delay = entry.target.getAttribute('data-delay') || '0';
              setTimeout(() => {
                entry.target.classList.add('revealed');
              }, parseInt(delay));
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
      );
      revealElements.forEach((el) => observer.observe(el));
    </script>


    <!-- Golden Polish: Performance, Micro-copy, Dynamic Title & Signature -->
    <script>
      (function goldenPolish() {
        // ═══════════════════════════════════════════════════════
        // 1. PERFORMANCE CHECK — Console diagnostics on load
        // ═══════════════════════════════════════════════════════
        function printPerformanceDiag() {
          const style = 'color:#50fa7b;font-weight:bold';
          const styleSystem = 'color:#8be9fd;font-weight:bold';
          console.log('%c[PERF] Lighthouse Score: 100/100', style);
          console.log('%c[PERF] Core Web Vitals: OPTIMIZED', style);
          console.log('%c[PERF] First Contentful Paint: 0.8s', style);
          console.log('%c[SYSTEM] Portfolio build: v2.4.0-stable', styleSystem);
        }

        // ═══════════════════════════════════════════════════════
        // 2. MICRO-COPY — Intersection Observer contextual logs
        // ═══════════════════════════════════════════════════════
        const sectionMessages: Record<string, { logged: boolean; msg: string }> = {
          HeroSection:       { logged: false, msg: '[CONTEXT] Loading Product Strategy & Experience data.' },
          AboutSection:      { logged: false, msg: '[CONTEXT] Scanning skill matrix and career trajectory...' },
          FeaturedProjects:  { logged: false, msg: '[CONTEXT] Analyzing Design System scalability...' },
          ProjectsHero:      { logged: false, msg: '[CONTEXT] Analyzing Design System scalability...' },
          CallToAction:      { logged: false, msg: '[CONTEXT] User intent detected. Preparing contact protocols...' },
          Footer:            { logged: false, msg: '[SYSTEM] Ready for deployment. Waiting for command: /hire_ramon' },
        };

        const styleContext = 'color:#f1fa8c;font-style:italic';
        const styleSystem2 = 'color:#8be9fd;font-weight:bold';

        function initMicroCopy() {
          const sections = document.querySelectorAll<HTMLElement>('[data-component]');
          const microObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const name = (entry.target as HTMLElement).getAttribute('data-component') || '';
                const section = sectionMessages[name];
                if (section && !section.logged) {
                  section.logged = true;
                  const s = name === 'Footer' ? styleSystem2 : styleContext;
                  console.log(`%c${section.msg}`, s);
                }
              });
            },
            { threshold: 0.2 }
          );
          sections.forEach((el) => microObserver.observe(el));
        }

        // Humorous periodic debug messages
        const debugMessages = [
          '[DEBUG] Pixel perfection verified. No artifacts found.',
          '[MEMORY] User engagement levels increasing...',
          '[DEBUG] Design tokens synchronized across 3 platforms.',
          '[PERF] Render pipeline optimized. Zero layout shifts detected.',
          '[DEBUG] Accessibility audit passed. WCAG 2.1 AA compliant.',
          '[MEMORY] Component library integrity: 100%.',
          '[DEBUG] Color contrast ratios within optimal range.',
          '[PERF] Asset compression: maximum efficiency achieved.',
          '[DEBUG] Grid system alignment verified. 0px deviation.',
          '[MEMORY] UX heuristic evaluation score: exceptional.',
        ];

        function startPeriodicLogs() {
          setInterval(() => {
            const msg = debugMessages[Math.floor(Math.random() * debugMessages.length)];
            console.log(`%c${msg}`, 'color:#bd93f9');
          }, 30000);
        }

        // ═══════════════════════════════════════════════════════
        // 3. DYNAMIC TAB TITLE — Route mapping
        // ═══════════════════════════════════════════════════════

        const routeNames: Record<string, string> = {
          '/': 'Home',
          '/about': 'About',
          '/projects': 'Projects',
          '/projects/imaginbank-digital-banking': 'Imaginbank',
          '/projects/massimo-dutti-conversion': 'Massimo Dutti',
          '/projects/solotemazos-music-platform': 'SoloTemazos',
          '/projects/banco-sabadell-design-system': 'Banco Sabadell',
          '/projects/iberia-flight-experience': 'Iberia',
          '/projects/movefast-startup-platform': 'MoveFast',
          '/projects/global-helping': 'Global Helping',
        };

        function syncTitle() {
          const path = window.location.pathname.replace(/\/$/, '') || '/';
          const name = routeNames[path];
          if (name) {
            document.title = `${name} ⚡ Ramon Riera`;
            return;
          }
          if (path.startsWith('/projects/')) {
            const slug = path.split('/projects/')[1] || '';
            const pretty = slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            document.title = `${pretty} ⚡ Ramon Riera`;
            return;
          }
          document.title = 'Ramon Riera';
        }

        // Initial sync
        syncTitle();

        // Welcome-back message when tab regains focus
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            console.log('%c[SYSTEM] Welcome back, user. Resuming session...', 'color:#8be9fd;font-weight:bold');
          }
        });

        // ═══════════════════════════════════════════════════════
        // 4. ASCII SIGNATURE — Easter Egg in console
        // ═══════════════════════════════════════════════════════
        function printSignature() {
          const sig = [
            '',
            '  ╔══════════════════════════════════════════════════════╗',
            '  ║                                                      ║',
            '  ║   ██████   █████  ███    ███  ██████  ███    ██      ║',
            '  ║   ██   ██ ██   ██ ████  ████ ██    ██ ████   ██      ║',
            '  ║   ██████  ███████ ██ ████ ██ ██    ██ ██ ██  ██      ║',
            '  ║   ██   ██ ██   ██ ██  ██  ██ ██    ██ ██  ██ ██      ║',
            '  ║   ██   ██ ██   ██ ██      ██  ██████  ██   ████      ║',
            '  ║                                                      ║',
            '  ║   Product Designer & Design Systems Expert           ║',
            '  ║   ramonriera.design                                  ║',
            '  ║                                                      ║',
            '  ╚══════════════════════════════════════════════════════╝',
            '',
          ].join('\n');
          console.log(`%c${sig}`, 'color:#D97757;font-family:monospace;font-size:11px;line-height:1.2');
          console.log(
            '%c[RAMON_RIERA] — Product Designer & Design Systems Expert',
            'color:#D97757;font-weight:bold;font-size:13px;padding:4px 0'
          );
        }

        // ── Boot Sequence ──
        window.addEventListener('load', () => {
          printPerformanceDiag();
          initMicroCopy();
          startPeriodicLogs();
          printSignature();
        });

        // Re-sync on client-side navigation (Astro page transitions)
        document.addEventListener('astro:page-load', () => {
          syncTitle();
          initMicroCopy();
        });
      })();
    </script>
  <script>
    import { inject, track } from '@vercel/analytics';
    import { injectSpeedInsights } from '@vercel/speed-insights';

    // Flag yourself: visit any page with ?notrack to disable analytics
    if (new URLSearchParams(window.location.search).has('notrack')) {
      localStorage.setItem('notrack', '1');
    }

    const isOwner = localStorage.getItem('notrack') === '1';

    inject({ beforeSend: (event) => isOwner ? null : event });
    // PERF: sampleRate 0.1 = 10% of traffic (valid metrics, less network overhead)
    injectSpeedInsights({
      sampleRate: 0.1,
      beforeSend: (data) => isOwner ? null : data,
    });

    // ── Custom event tracking ──

    // Contact CTA clicks (mailto links)
    document.querySelectorAll<HTMLAnchorElement>('a[href^="mailto:"]').forEach((link) => {
      link.addEventListener('click', () => {
        track('contact_click', { location: link.closest('nav') ? 'navbar' : link.closest('footer') ? 'footer' : 'page' });
      });
    });

    // Project card clicks
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/projects/"]').forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('href')?.replace('/projects/', '') || '';
        track('project_click', { project: slug });
      });
    });

    // Project filter clicks
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || '';
        track('filter_click', { category: filter });
      });
    });

    // External link clicks (LinkedIn, GitHub, etc.)
    document.querySelectorAll<HTMLAnchorElement>('a[target="_blank"]').forEach((link) => {
      link.addEventListener('click', () => {
        track('external_link', { url: link.href });
      });
    });
  </script>
  </body>
</html>
