---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Ramon Riera - Senior UX/UI Designer. Especializado en Design Systems, Product Design y Design Operations.',
  image = '/images/og-image.jpg',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://ramonriera.design';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ramon Riera" />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preconnect for fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-dark-50 dark:bg-dark-950 text-dark-900 dark:text-dark-100 transition-colors duration-300">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Theme: respect saved preference, then system preference, default light
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
          document.body.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.body.classList.remove('dark');
        }

        // Code Mode: restore from localStorage
        if (localStorage.getItem('code-mode') === 'on') {
          document.documentElement.classList.add('code-mode');
          document.body.classList.add('code-mode');
        }
      })();
    </script>

    <!-- Token Inspector tooltip + focus overlay (only used in code mode) -->
    <div id="inspector-focus-overlay"></div>
    <div id="token-inspector-tooltip"></div>

    <script>
      // ── Token Inspector: Component Architecture + Design Token tooltips ──
      function initTokenInspector() {
        const tooltip = document.getElementById('token-inspector-tooltip');
        const overlay = document.getElementById('inspector-focus-overlay');
        if (!tooltip) return;

        let currentTarget: HTMLElement | null = null;
        let rafId: number | null = null;

        // Parse pipe-separated token string into structured data
        function parseTokenString(raw: string): { label: string; rows: { name: string; value: string; swatch?: string }[] } {
          const lines = raw.split('|');
          const rows = lines.map(line => {
            const parts = line.split(':').map(s => s.trim());
            const name = parts[0] || '';
            const value = parts.slice(1).join(':').trim();
            const hexMatch = value.match(/#[0-9a-fA-F]{3,8}/);
            return { name, value, ...(hexMatch ? { swatch: hexMatch[0] } : {}) };
          });
          const firstName = rows[0]?.name?.toLowerCase() || '';
          let label = 'Token';
          if (firstName.includes('color') || firstName.includes('gradient')) label = 'Color';
          else if (firstName.includes('spacing') || firstName.includes('gap') || firstName.includes('padding')) label = 'Spacing';
          else if (firstName.includes('font') || firstName.includes('typo')) label = 'Typography';
          else if (firstName.includes('radius')) label = 'Border Radius';
          else if (firstName.includes('shadow')) label = 'Shadow';
          else if (firstName.includes('filter')) label = 'Filter';
          else if (firstName.includes('grid')) label = 'Layout';
          else if (firstName.includes('aspect') || firstName.includes('object')) label = 'Media';
          return { label, rows };
        }

        // Build tooltip HTML with optional component name + token rows
        function renderTooltip(componentName: string | null, tokenData: { label: string; rows: { name: string; value: string; swatch?: string }[] } | null): string {
          let html = '';

          // Component header
          if (componentName) {
            html += `<div class="token-component">`;
            html += `<span class="tag-bracket">&lt;</span>`;
            html += `<span class="tag-name">${componentName}</span>`;
            html += `<span class="tag-bracket"> /&gt;</span>`;
            html += `</div>`;
          }

          // Token rows grouped by label
          if (tokenData) {
            html += `<div class="token-label">${tokenData.label}</div>`;
            for (const row of tokenData.rows) {
              html += `<div class="token-row">`;
              if (row.swatch) {
                html += `<span class="token-swatch" style="background:${row.swatch}"></span>`;
              }
              html += `<span class="token-name">${row.name}</span>`;
              if (row.value) {
                html += `<span style="color:#5c6370">:</span> <span class="token-value">${row.value}</span>`;
              }
              html += `</div>`;
            }
          }

          return html;
        }

        function positionTooltip(e: MouseEvent) {
          if (!tooltip) return;
          const gap = 14;
          const rect = tooltip.getBoundingClientRect();
          let x = e.clientX + gap;
          let y = e.clientY + gap;

          if (x + rect.width > window.innerWidth - 8) {
            x = e.clientX - rect.width - gap;
          }
          if (y + rect.height > window.innerHeight - 8) {
            y = e.clientY - rect.height - gap;
          }
          if (x < 8) x = 8;
          if (y < 8) y = 8;

          tooltip.style.left = `${x}px`;
          tooltip.style.top = `${y}px`;
        }

        function onMouseMove(e: MouseEvent) {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => positionTooltip(e));
        }

        function onMouseEnter(e: MouseEvent) {
          const el = (e.currentTarget as HTMLElement);
          if (!document.body.classList.contains('code-mode')) return;

          const componentName = el.getAttribute('data-component');
          const tokenRaw = el.getAttribute('data-token');

          // Must have at least one attribute
          if (!componentName && !tokenRaw) return;

          let tokenData: { label: string; rows: { name: string; value: string; swatch?: string }[] } | null = null;
          if (tokenRaw) {
            try {
              tokenData = JSON.parse(tokenRaw);
            } catch {
              tokenData = parseTokenString(tokenRaw);
            }
          }

          currentTarget = el;
          tooltip.innerHTML = renderTooltip(componentName, tokenData);
          positionTooltip(e);

          tooltip.offsetHeight;
          tooltip.classList.add('visible');

          // Focus overlay (Easter Egg) — activate for component-level elements
          if (componentName && overlay) {
            el.classList.add('inspector-focused');
            overlay.classList.add('active');
          }
        }

        function onMouseLeave() {
          if (currentTarget) {
            currentTarget.classList.remove('inspector-focused');
          }
          currentTarget = null;
          tooltip.classList.remove('visible');
          overlay?.classList.remove('active');
        }

        // Attach listeners — use event delegation to handle specificity
        // Elements with both data-component and data-token, or either one
        function attachListeners() {
          const elements = document.querySelectorAll<HTMLElement>('[data-token], [data-component]');
          elements.forEach(el => {
            el.addEventListener('mouseenter', onMouseEnter);
            el.addEventListener('mousemove', onMouseMove);
            el.addEventListener('mouseleave', onMouseLeave);
          });
        }

        // Smart specificity: stop propagation on nested inspectable elements
        // so inner elements take priority over outer ones
        function setupSpecificity() {
          const elements = document.querySelectorAll<HTMLElement>('[data-token], [data-component]');
          elements.forEach(el => {
            el.addEventListener('mouseenter', (e: MouseEvent) => {
              e.stopPropagation();
            });
          });
        }

        attachListeners();
        setupSpecificity();

        const codeToggle = document.getElementById('code-mode-toggle');
        codeToggle?.addEventListener('click', () => {
          tooltip.classList.remove('visible');
          overlay?.classList.remove('active');
          if (currentTarget) {
            currentTarget.classList.remove('inspector-focused');
            currentTarget = null;
          }
        });
      }

      initTokenInspector();
      document.addEventListener('astro:page-load', initTokenInspector);
    </script>

    <script>
      // Scroll reveal with Intersection Observer
      const revealElements = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const delay = entry.target.getAttribute('data-delay') || '0';
              setTimeout(() => {
                entry.target.classList.add('revealed');
              }, parseInt(delay));
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
      );
      revealElements.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
