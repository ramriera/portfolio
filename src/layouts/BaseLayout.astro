---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import SystemConsole from '@/components/SystemConsole.astro';
import { inject } from '@vercel/analytics';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@/styles/global.css';

inject();

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = 'Ramon Riera — UX Lead & Product Designer. Puente entre diseño y frontend escalable: Design Systems, UX strategy y operaciones de producto.',
  image = '/assets/shared/og-image.png',
  canonicalUrl,
} = Astro.props;

const siteUrl = 'https://ramonriera.design';
const currentUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Ramon Riera" />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}${image}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50 text-neutral-900 transition-colors duration-300">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Code Mode: restore from localStorage (desktop only — lg breakpoint 1024px)
      (function() {
        if (window.innerWidth >= 1024 && localStorage.getItem('code-mode') === 'on') {
          document.documentElement.classList.add('code-mode');
          document.body.classList.add('code-mode');
          // Instant title switch to avoid flicker
          var p = window.location.pathname.replace(/\/$/, '') || '/';
          if (p === '/') document.title = 'root@ramonriera:~/portfolio';
          else if (p === '/about') document.title = 'root@ramonriera:~/about.md';
          else if (p.indexOf('/projects/') === 0) {
            var slug = p.split('/projects/')[1];
            var shortNames = {'imaginbank-digital-banking':'imaginbank','massimo-dutti-conversion':'massimo-dutti','solotemazos-music-platform':'solotemazos','banco-sabadell-design-system':'banco-sabadell','iberia-flight-experience':'iberia','movefast-startup-platform':'movefast','global-helping':'global-helping'};
            document.title = 'root@ramonriera:~/projects/' + (shortNames[slug] || slug);
          }
          else if (p === '/projects') document.title = 'root@ramonriera:~/projects';
          else document.title = 'root@ramonriera:~' + p;
        }
      })();
    </script>

    <!-- Token Inspector tooltip + focus overlay + box-model overlay (only used in code mode) -->
    <div id="inspector-focus-overlay"></div>
    <div id="token-inspector-tooltip"></div>
    <div id="inspector-box-model-overlay">
      <div id="box-model-margin"></div>
      <div id="box-model-border"></div>
      <div id="box-model-padding"></div>
      <div id="box-model-content"></div>
    </div>

    <!-- System Console (only used in code mode) -->
    <SystemConsole />

    <script>
      // ── Advanced Technical Inspector: Layout, Architecture & Live Computed Styles ──
      function initTokenInspector() {
        const tooltip = document.getElementById('token-inspector-tooltip');
        const overlay = document.getElementById('inspector-focus-overlay');
        const boxOverlay = document.getElementById('inspector-box-model-overlay');
        const boxMargin = document.getElementById('box-model-margin');
        const boxBorder = document.getElementById('box-model-border');
        const boxPadding = document.getElementById('box-model-padding');
        const boxContent = document.getElementById('box-model-content');
        if (!tooltip) return;

        let currentTarget: HTMLElement | null = null;
        let rafId: number | null = null;

        // ── RGB → HEX conversion ──
        function rgbToHex(rgb: string): string {
          const match = rgb.match(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/);
          if (!match) return rgb;
          const [, r, g, b] = match;
          return '#' + [r, g, b].map(c => parseInt(c).toString(16).padStart(2, '0')).join('');
        }

        function normalizeColor(val: string): string {
          const v = val.trim();
          if (v.startsWith('rgb')) return rgbToHex(v).toUpperCase();
          if (v.startsWith('#')) return v.toUpperCase();
          return v;
        }

        // ── CSS Variable → Token Name mapping ──
        function buildTokenMap(): Record<string, string> {
          const map: Record<string, string> = {};
          const isCodeMode = document.documentElement.classList.contains('code-mode');

          try {
            for (const sheet of document.styleSheets) {
              try {
                for (const rule of sheet.cssRules) {
                  const style = rule as CSSStyleRule;
                  if (!style.selectorText) continue;
                  const isRoot = style.selectorText === ':root';
                  const isCodeRule = style.selectorText.includes('.code-mode');
                  if (!isRoot && !isCodeRule) continue;
                  if (isCodeRule && !isCodeMode) continue;

                  for (let i = 0; i < style.style.length; i++) {
                    const prop = style.style[i];
                    if (!prop.startsWith('--')) continue;
                    const rawVal = style.style.getPropertyValue(prop).trim();
                    const hex = normalizeColor(rawVal);
                    if (isCodeRule || !map[hex]) map[hex] = prop;
                  }
                }
              } catch { /* cross-origin */ }
            }
          } catch { /* no sheets */ }

          const aliases: Record<string, string> = {
            '#D97757': '--color-primary-500',
            '#FAF9F7': '--color-neutral-50',   '#F3F1ED': '--color-neutral-100',
            '#E8E4DD': '--color-neutral-200',   '#D4CFC5': '--color-neutral-300',
            '#A8A196': '--color-neutral-400',   '#7C766C': '--color-neutral-500',
            '#5C574F': '--color-neutral-600',   '#403D38': '--color-neutral-700',
            '#2A2825': '--color-neutral-800',   '#1A1918': '--color-neutral-900',
            '#141413': '--color-neutral-950',
            '#FDF6F3': '--color-primary-50', '#FCEAE2': '--color-primary-100',
            '#F9D5C5': '--color-primary-200','#F4B89D': '--color-primary-300',
            '#EC9372': '--color-primary-400','#C4613F': '--color-primary-600',
            '#A34D32': '--color-primary-700','#86412D': '--color-primary-800',
            '#6F3828': '--color-primary-900',
          };
          for (const [hex, token] of Object.entries(aliases)) {
            if (!map[hex]) map[hex] = token;
          }
          return map;
        }

        let tokenMap = buildTokenMap();
        const mapObserver = new MutationObserver(() => { tokenMap = buildTokenMap(); });
        mapObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // ── Token categorization ──
        function categorizeToken(name: string): string {
          const n = name.toLowerCase();
          if (n.includes('color') || n.includes('gradient') || n.includes('bg') || n.includes('text')) return 'Color';
          if (n.includes('spacing') || n.includes('gap') || n.includes('padding') || n.includes('margin')) return 'Spacing';
          if (n.includes('font') || n.includes('typo')) return 'Typography';
          if (n.includes('radius')) return 'Border Radius';
          if (n.includes('shadow')) return 'Shadow';
          if (n.includes('filter')) return 'Filter';
          if (n.includes('grid') || n.includes('position')) return 'Layout';
          if (n.includes('aspect') || n.includes('object')) return 'Media';
          if (n.includes('border')) return 'Border';
          return 'Token';
        }

        function isColorToken(name: string): boolean {
          const n = name.toLowerCase();
          return n.includes('color') || n.includes('bg') || n.includes('gradient')
            || n.includes('text') || n.includes('border');
        }

        function cssPropertyForToken(name: string): string | null {
          const n = name.toLowerCase();
          if (n.includes('bg') || n.includes('background')) return 'backgroundColor';
          if (n.includes('text') || n.includes('color-text')) return 'color';
          if (n.includes('border-color') || (n.includes('border') && n.includes('color'))) return 'borderColor';
          if (n.includes('color')) return 'color';
          return null;
        }

        // ── Parse tokens with live computed overrides ──
        type TokenRow = { name: string; value: string; swatch?: string };
        type TokenGroup = { label: string; rows: TokenRow[] };

        function parseTokenString(raw: string, el: HTMLElement): { groups: TokenGroup[] } {
          const lines = raw ? raw.split('|') : [];
          const groupMap: Record<string, TokenRow[]> = {};
          const computed = getComputedStyle(el);

          for (const line of lines) {
            if (!line.trim()) continue;
            const parts = line.split(':').map(s => s.trim());
            const name = parts[0] || '';
            let value = parts.slice(1).join(':').trim();
            let swatch: string | undefined;

            if (isColorToken(name)) {
              const cssProp = cssPropertyForToken(name);
              if (cssProp) {
                const liveVal = (computed as any)[cssProp];
                if (liveVal && liveVal !== 'rgba(0, 0, 0, 0)' && liveVal !== 'transparent') {
                  const hex = normalizeColor(liveVal);
                  const tokenAlias = tokenMap[hex];
                  value = tokenAlias ? `${tokenAlias} → ${hex}` : hex;
                  swatch = hex;
                }
              }
              if (!swatch) {
                const hexMatch = value.match(/#[0-9a-fA-F]{3,8}/);
                if (hexMatch) swatch = hexMatch[0];
              }
            } else {
              const hexMatch = value.match(/#[0-9a-fA-F]{3,8}/);
              if (hexMatch) swatch = hexMatch[0];
            }

            const label = categorizeToken(name);
            if (!groupMap[label]) groupMap[label] = [];
            groupMap[label].push({ name, value, ...(swatch ? { swatch } : {}) });
          }

          // Inject live computed colors not already declared
          const existingNames = lines.map(l => l.split(':')[0].trim().toLowerCase());
          const liveColorProps: [string, string, string][] = [
            ['backgroundColor', '$computed-bg', 'Color'],
            ['color', '$computed-text', 'Color'],
            ['borderColor', '$computed-border', 'Border'],
          ];
          for (const [cssProp, tokenName, label] of liveColorProps) {
            const alreadyCovered = existingNames.some(n =>
              (cssProp === 'backgroundColor' && (n.includes('bg') || n.includes('background'))) ||
              (cssProp === 'color' && (n.includes('text') || (n.includes('color') && !n.includes('bg') && !n.includes('border')))) ||
              (cssProp === 'borderColor' && n.includes('border'))
            );
            if (alreadyCovered) continue;
            const liveVal = (computed as any)[cssProp];
            if (liveVal && liveVal !== 'rgba(0, 0, 0, 0)' && liveVal !== 'transparent') {
              const hex = normalizeColor(liveVal);
              if (hex === '#000000' && cssProp === 'borderColor') continue;
              const tokenAlias = tokenMap[hex];
              const displayVal = tokenAlias ? `${tokenAlias} → ${hex}` : hex;
              if (!groupMap[label]) groupMap[label] = [];
              groupMap[label].push({ name: tokenName, value: displayVal, swatch: hex });
            }
          }

          return { groups: Object.entries(groupMap).map(([label, rows]) => ({ label, rows })) };
        }

        // ── Extract live layout & architecture metrics ──
        function getLayoutMetrics(el: HTMLElement): { display: string; gap: string; padding: string; zIndex: string; width: number; height: number; borderRadius: string; position: string } {
          const cs = getComputedStyle(el);
          const rect = el.getBoundingClientRect();
          return {
            display: cs.display,
            gap: cs.gap && cs.gap !== 'normal' ? cs.gap : '',
            padding: cs.padding,
            zIndex: cs.zIndex,
            width: Math.round(rect.width),
            height: Math.round(rect.height),
            borderRadius: cs.borderRadius,
            position: cs.position,
          };
        }

        // ── Box Model Overlay: padding + margin visualization ──
        function showBoxModel(el: HTMLElement) {
          if (!boxOverlay || !boxMargin || !boxPadding || !boxContent || !boxBorder) return;
          const cs = getComputedStyle(el);
          const rect = el.getBoundingClientRect();

          const mt = parseFloat(cs.marginTop) || 0;
          const mr = parseFloat(cs.marginRight) || 0;
          const mb = parseFloat(cs.marginBottom) || 0;
          const ml = parseFloat(cs.marginLeft) || 0;
          const bt = parseFloat(cs.borderTopWidth) || 0;
          const br = parseFloat(cs.borderRightWidth) || 0;
          const bb = parseFloat(cs.borderBottomWidth) || 0;
          const blw = parseFloat(cs.borderLeftWidth) || 0;
          const pt = parseFloat(cs.paddingTop) || 0;
          const pr = parseFloat(cs.paddingRight) || 0;
          const pb = parseFloat(cs.paddingBottom) || 0;
          const pl = parseFloat(cs.paddingLeft) || 0;

          const scrollX = window.scrollX;
          const scrollY = window.scrollY;

          // Margin layer (outermost)
          boxOverlay.style.display = 'block';
          boxMargin.style.top = `${rect.top + scrollY - mt}px`;
          boxMargin.style.left = `${rect.left + scrollX - ml}px`;
          boxMargin.style.width = `${rect.width + ml + mr}px`;
          boxMargin.style.height = `${rect.height + mt + mb}px`;

          // Border layer
          boxBorder.style.top = `${rect.top + scrollY}px`;
          boxBorder.style.left = `${rect.left + scrollX}px`;
          boxBorder.style.width = `${rect.width}px`;
          boxBorder.style.height = `${rect.height}px`;

          // Padding layer
          boxPadding.style.top = `${rect.top + scrollY + bt}px`;
          boxPadding.style.left = `${rect.left + scrollX + blw}px`;
          boxPadding.style.width = `${rect.width - blw - br}px`;
          boxPadding.style.height = `${rect.height - bt - bb}px`;

          // Content layer (innermost)
          boxContent.style.top = `${rect.top + scrollY + bt + pt}px`;
          boxContent.style.left = `${rect.left + scrollX + blw + pl}px`;
          boxContent.style.width = `${rect.width - blw - br - pl - pr}px`;
          boxContent.style.height = `${rect.height - bt - bb - pt - pb}px`;
        }

        function hideBoxModel() {
          if (boxOverlay) boxOverlay.style.display = 'none';
        }

        // ── Build tooltip HTML ──
        function renderTooltip(componentName: string | null, tokenData: { groups: TokenGroup[] } | null, metrics: ReturnType<typeof getLayoutMetrics> | null): string {
          let html = '';

          // Component header
          if (componentName) {
            html += `<div class="token-component">`;
            html += `<span class="tag-bracket">&lt;</span>`;
            html += `<span class="tag-name">${componentName}</span>`;
            html += `<span class="tag-bracket"> /&gt;</span>`;
            html += `</div>`;
          }

          // Layout & Architecture block
          if (metrics) {
            html += `<div class="token-label">Layout</div>`;
            // Display + position
            const isFlexGrid = metrics.display === 'flex' || metrics.display === 'inline-flex'
              || metrics.display === 'grid' || metrics.display === 'inline-grid';
            html += `<div class="token-row"><span class="token-name">display</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.display}</span></div>`;

            if (metrics.position !== 'static') {
              html += `<div class="token-row"><span class="token-name">position</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.position}</span></div>`;
            }

            // Gap (for flex/grid) or padding
            if (isFlexGrid && metrics.gap) {
              html += `<div class="token-row"><span class="token-name">gap</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.gap}</span></div>`;
            }
            if (metrics.padding && metrics.padding !== '0px') {
              html += `<div class="token-row"><span class="token-name">padding</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.padding}</span></div>`;
            }

            // Border radius
            if (metrics.borderRadius && metrics.borderRadius !== '0px') {
              html += `<div class="token-row"><span class="token-name">radius</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.borderRadius}</span></div>`;
            }

            // Size
            html += `<div class="token-label">Size</div>`;
            html += `<div class="token-row"><span class="token-name">dimensions</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.width} × ${metrics.height} px</span></div>`;

            // Z-index
            if (metrics.zIndex !== 'auto' && metrics.zIndex !== '0') {
              html += `<div class="token-row"><span class="token-name">z-index</span><span style="color:#6272a4">:</span> <span class="token-value">${metrics.zIndex}</span></div>`;
            }
          }

          // Token groups (Color, Spacing, Typography, etc.)
          if (tokenData && tokenData.groups) {
            for (const group of tokenData.groups) {
              html += `<div class="token-label">${group.label}</div>`;
              for (const row of group.rows) {
                html += `<div class="token-row">`;
                if (row.swatch) {
                  html += `<span class="token-swatch" style="background:${row.swatch}"></span>`;
                }
                html += `<span class="token-name">${row.name}</span>`;
                if (row.value) {
                  html += `<span style="color:#6272a4">:</span> <span class="token-value">${row.value}</span>`;
                }
                html += `</div>`;
              }
            }
          }

          return html;
        }

        // ── Tooltip positioning ──
        function positionTooltip(e: MouseEvent) {
          if (!tooltip) return;
          const gap = 14;
          const rect = tooltip.getBoundingClientRect();
          let x = e.clientX + gap;
          let y = e.clientY + gap;

          if (x + rect.width > window.innerWidth - 8) x = e.clientX - rect.width - gap;
          if (y + rect.height > window.innerHeight - 8) y = e.clientY - rect.height - gap;
          if (x < 8) x = 8;
          if (y < 8) y = 8;

          tooltip.style.left = `${x}px`;
          tooltip.style.top = `${y}px`;
        }

        function onMouseMove(e: MouseEvent) {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(() => positionTooltip(e));
        }

        function onMouseEnter(e: MouseEvent) {
          const el = (e.currentTarget as HTMLElement);
          if (!document.body.classList.contains('code-mode')) return;

          const componentName = el.getAttribute('data-component');
          const tokenRaw = el.getAttribute('data-token');
          if (!componentName && !tokenRaw) return;

          // Parse tokens
          let tokenData: { groups: TokenGroup[] } | null = null;
          if (tokenRaw) {
            try {
              const parsed = JSON.parse(tokenRaw);
              if (parsed.groups) tokenData = parsed;
              else if (parsed.label && parsed.rows) tokenData = { groups: [parsed] };
            } catch {
              tokenData = parseTokenString(tokenRaw, el);
            }
          } else {
            tokenData = parseTokenString('', el);
          }

          // Get live layout metrics
          const metrics = getLayoutMetrics(el);

          currentTarget = el;
          tooltip.innerHTML = renderTooltip(componentName, tokenData, metrics);
          positionTooltip(e);

          tooltip.offsetHeight;
          tooltip.classList.add('visible');

          // Show box-model overlay
          showBoxModel(el);

          if (componentName && overlay) {
            el.classList.add('inspector-focused');
            overlay.classList.add('active');
          }

          // Console feedback — DevTools-style inspect log
          if (componentName) {
            console.log(
              `%c[INSPECT]%c Element %c<${componentName} />%c selected. Analyzing architecture...`,
              'color:#50fa7b;font-weight:bold',
              'color:#f8f8f2',
              'color:#f1fa8c;font-weight:bold',
              'color:#f8f8f2'
            );
          }
        }

        function onMouseLeave() {
          if (currentTarget) {
            currentTarget.classList.remove('inspector-focused');
          }
          currentTarget = null;
          tooltip.classList.remove('visible');
          overlay?.classList.remove('active');
          hideBoxModel();
        }

        function attachListeners() {
          const elements = document.querySelectorAll<HTMLElement>('[data-token], [data-component]');
          elements.forEach(el => {
            el.addEventListener('mouseenter', onMouseEnter);
            el.addEventListener('mousemove', onMouseMove);
            el.addEventListener('mouseleave', onMouseLeave);
          });
        }

        function setupSpecificity() {
          const elements = document.querySelectorAll<HTMLElement>('[data-token], [data-component]');
          elements.forEach(el => {
            el.addEventListener('mouseenter', (e: MouseEvent) => {
              e.stopPropagation();
            });
          });
        }

        attachListeners();
        setupSpecificity();

        // Update box-model on scroll/resize for accuracy
        let scrollRaf: number | null = null;
        function onScrollResize() {
          if (scrollRaf) cancelAnimationFrame(scrollRaf);
          scrollRaf = requestAnimationFrame(() => {
            if (currentTarget) showBoxModel(currentTarget);
          });
        }
        window.addEventListener('scroll', onScrollResize, { passive: true });
        window.addEventListener('resize', onScrollResize, { passive: true });

        const codeToggle = document.getElementById('code-mode-toggle');
        codeToggle?.addEventListener('click', () => {
          tooltip.classList.remove('visible');
          overlay?.classList.remove('active');
          hideBoxModel();
          if (currentTarget) {
            currentTarget.classList.remove('inspector-focused');
            currentTarget = null;
          }
        });
      }

      initTokenInspector();
      document.addEventListener('astro:page-load', initTokenInspector);
    </script>

    <script>
      // Scroll reveal with Intersection Observer
      const revealElements = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const delay = entry.target.getAttribute('data-delay') || '0';
              setTimeout(() => {
                entry.target.classList.add('revealed');
              }, parseInt(delay));
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
      );
      revealElements.forEach((el) => observer.observe(el));
    </script>


    <!-- Golden Polish: Performance, Micro-copy, Dynamic Favicon & Signature -->
    <script>
      (function goldenPolish() {
        // ═════════════════════���═════════════════════════════════
        // 1. PERFORMANCE CHECK — Console diagnostics on load
        // ═══════════════════════════════════════════════════════
        function printPerformanceDiag() {
          const style = 'color:#50fa7b;font-weight:bold';
          const styleSystem = 'color:#8be9fd;font-weight:bold';
          console.log('%c[PERF] Lighthouse Score: 100/100', style);
          console.log('%c[PERF] Core Web Vitals: OPTIMIZED', style);
          console.log('%c[PERF] First Contentful Paint: 0.8s', style);
          console.log('%c[SYSTEM] Portfolio build: v2.4.0-stable', styleSystem);
        }

        // ═══════════════════════════════════════════════════════
        // 2. MICRO-COPY — Intersection Observer contextual logs
        // ═══════════════════════════════════════════════════════
        const sectionMessages: Record<string, { logged: boolean; msg: string }> = {
          HeroSection:       { logged: false, msg: '[CONTEXT] Loading Product Strategy & Experience data.' },
          AboutSection:      { logged: false, msg: '[CONTEXT] Scanning skill matrix and career trajectory...' },
          FeaturedProjects:  { logged: false, msg: '[CONTEXT] Analyzing Design System scalability...' },
          ProjectsHero:      { logged: false, msg: '[CONTEXT] Analyzing Design System scalability...' },
          CallToAction:      { logged: false, msg: '[CONTEXT] User intent detected. Preparing contact protocols...' },
          Footer:            { logged: false, msg: '[SYSTEM] Ready for deployment. Waiting for command: /hire_ramon' },
        };

        const styleContext = 'color:#f1fa8c;font-style:italic';
        const styleSystem2 = 'color:#8be9fd;font-weight:bold';

        function initMicroCopy() {
          const sections = document.querySelectorAll<HTMLElement>('[data-component]');
          const microObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const name = (entry.target as HTMLElement).getAttribute('data-component') || '';
                const section = sectionMessages[name];
                if (section && !section.logged) {
                  section.logged = true;
                  const s = name === 'Footer' ? styleSystem2 : styleContext;
                  console.log(`%c${section.msg}`, s);
                }
              });
            },
            { threshold: 0.2 }
          );
          sections.forEach((el) => microObserver.observe(el));
        }

        // Humorous periodic debug messages
        const debugMessages = [
          '[DEBUG] Pixel perfection verified. No artifacts found.',
          '[MEMORY] User engagement levels increasing...',
          '[DEBUG] Design tokens synchronized across 3 platforms.',
          '[PERF] Render pipeline optimized. Zero layout shifts detected.',
          '[DEBUG] Accessibility audit passed. WCAG 2.1 AA compliant.',
          '[MEMORY] Component library integrity: 100%.',
          '[DEBUG] Color contrast ratios within optimal range.',
          '[PERF] Asset compression: maximum efficiency achieved.',
          '[DEBUG] Grid system alignment verified. 0px deviation.',
          '[MEMORY] UX heuristic evaluation score: exceptional.',
        ];

        function startPeriodicLogs() {
          setInterval(() => {
            const msg = debugMessages[Math.floor(Math.random() * debugMessages.length)];
            console.log(`%c${msg}`, 'color:#bd93f9');
          }, 30000);
        }

        // ═══════════════════════════════════════════════════════
        // 3. DYNAMIC FAVICON — Changes based on Code Mode
        // ═══════════════════════════════════════════════════════

        // Unified SVG favicon generator — shared viewBox & base structure
        // Accent color synced with --accent-color in :root (global.css)
        const FAVICON_ACCENT = '#D97757';

        const FAVICON_CODE_BG = '#1a5c1a';

        function buildFavicon(mode: 'normal' | 'code-on' | 'code-off'): string {
          let bg = '#1A1918';
          let inner = '';
          if (mode === 'normal') {
            // Minimalist "R" in white
            inner = `<text x="32" y="44" font-family="'Space Grotesk',sans-serif" font-size="36" font-weight="700" fill="#FFFFFF" text-anchor="middle">R</text>`;
          } else {
            // Green console background with blinking cursor
            bg = FAVICON_CODE_BG;
            const opacity = mode === 'code-on' ? '1' : '0.15';
            inner = `<rect x="27" y="12" width="10" height="40" rx="3" fill="${FAVICON_ACCENT}" opacity="${opacity}"/>`;
          }
          return `<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="${bg}"/>${inner}</svg>`;
        }

        function svgToDataUri(svg: string): string {
          return 'data:image/svg+xml,' + encodeURIComponent(svg);
        }

        const faviconNormal = svgToDataUri(buildFavicon('normal'));
        const faviconCodeOn = svgToDataUri(buildFavicon('code-on'));
        const faviconCodeOff = svgToDataUri(buildFavicon('code-off'));

        let faviconBlinkInterval: ReturnType<typeof setInterval> | null = null;

        function setFavicon(href: string) {
          let link = document.querySelector<HTMLLinkElement>("link[rel='icon'][type='image/svg+xml']");
          if (link) {
            link.href = href;
          }
        }

        function startFaviconBlink() {
          stopFaviconBlink();
          let visible = true;
          faviconBlinkInterval = setInterval(() => {
            visible = !visible;
            setFavicon(visible ? faviconCodeOn : faviconCodeOff);
          }, 1000);
        }

        function stopFaviconBlink() {
          if (faviconBlinkInterval !== null) {
            clearInterval(faviconBlinkInterval);
            faviconBlinkInterval = null;
          }
        }

        function syncFavicon() {
          const isCode = document.documentElement.classList.contains('code-mode');
          if (isCode) {
            setFavicon(faviconCodeOn);
            startFaviconBlink();
          } else {
            stopFaviconBlink();
            setFavicon(faviconNormal);
          }
        }

        // Normal favicon is now theme-independent (dark container + white R glyph)
        // No need to adapt to system theme changes

        // ═══════════════════════════════════════════════════════
        // 3b. DYNAMIC TAB TITLE — Route mapping & dual-mode titles
        // ═══════════════════════════════════════════════════════

        // Route → friendly name mapping for Normal Mode
        const routeNames: Record<string, string> = {
          '/': 'Home',
          '/about': 'About',
          '/projects': 'Projects',
          '/projects/imaginbank-digital-banking': 'Imaginbank',
          '/projects/massimo-dutti-conversion': 'Massimo Dutti',
          '/projects/solotemazos-music-platform': 'SoloTemazos',
          '/projects/banco-sabadell-design-system': 'Banco Sabadell',
          '/projects/iberia-flight-experience': 'Iberia',
          '/projects/movefast-startup-platform': 'MoveFast',
          '/projects/global-helping': 'Global Helping',
        };

        // Route → technical path mapping for Code Mode
        const projectShortNames: Record<string, string> = {
          'imaginbank-digital-banking': 'imaginbank',
          'massimo-dutti-conversion': 'massimo-dutti',
          'solotemazos-music-platform': 'solotemazos',
          'banco-sabadell-design-system': 'banco-sabadell',
          'iberia-flight-experience': 'iberia',
          'movefast-startup-platform': 'movefast',
          'global-helping': 'global-helping',
        };

        function getCodeModeTitle(): string {
          const path = window.location.pathname.replace(/\/$/, '') || '/';
          if (path === '/') return 'root@ramonriera:~/portfolio';
          if (path === '/about') return 'root@ramonriera:~/about.md';
          if (path.startsWith('/projects/')) {
            const slug = path.split('/projects/')[1];
            const shortName = projectShortNames[slug] || slug;
            return `root@ramonriera:~/projects/${shortName}`;
          }
          if (path === '/projects') return 'root@ramonriera:~/projects';
          return `root@ramonriera:~${path}`;
        }

        // Normal Mode title: [Page Name] ⚡ Ramon Riera
        function getNormalTitle(): string {
          const path = window.location.pathname.replace(/\/$/, '') || '/';
          const name = routeNames[path];
          if (name) return `${name} ⚡ Ramon Riera`;
          // Fallback: extract project title from slug
          if (path.startsWith('/projects/')) {
            const slug = path.split('/projects/')[1] || '';
            const pretty = slug.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
            return `${pretty} ⚡ Ramon Riera`;
          }
          return 'Ramon Riera';
        }

        function syncTitle() {
          const isCode = document.documentElement.classList.contains('code-mode');
          document.title = isCode ? getCodeModeTitle() : getNormalTitle();
        }

        // ═══════════════════════════════════════════════════════
        // 3c. UNIFIED STATE SYNC — Favicon + Title on class change
        // ═══════════════════════════════════════════════════════

        function syncCodeModeTab() {
          syncFavicon();
          syncTitle();
        }

        const codeModeTabObserver = new MutationObserver(() => syncCodeModeTab());
        codeModeTabObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // Initial sync
        syncCodeModeTab();

        // Welcome-back message when tab regains focus
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            console.log('%c[SYSTEM] Welcome back, user. Resuming session...', 'color:#8be9fd;font-weight:bold');
          }
        });

        // ═══════════════════════════════════════════════════════
        // 4. ASCII SIGNATURE — Easter Egg in console
        // ═══════════════════════════════════════════════════════
        function printSignature() {
          const sig = [
            '',
            '  ╔══════════════════════════════════════════════════════╗',
            '  ║                                                      ║',
            '  ║   ██████   █████  ███    ███  ██████  ███    ██      ║',
            '  ║   ██   ██ ██   ██ ████  ████ ██    ██ ████   ██      ║',
            '  ║   ██████  ███████ ██ ████ ██ ██    ██ ██ ██  ██      ║',
            '  ║   ██   ██ ██   ██ ██  ██  ██ ██    ██ ██  ██ ██      ║',
            '  ║   ██   ██ ██   ██ ██      ██  ██████  ██   ████      ║',
            '  ║                                                      ║',
            '  ║   Product Designer & Design Systems Expert           ║',
            '  ║   ramonriera.design                                  ║',
            '  ║                                                      ║',
            '  ╚══════════════════════════════════════════════════════╝',
            '',
          ].join('\n');
          console.log(`%c${sig}`, 'color:#D97757;font-family:monospace;font-size:11px;line-height:1.2');
          console.log(
            '%c[RAMON_RIERA] — Product Designer & Design Systems Expert',
            'color:#D97757;font-weight:bold;font-size:13px;padding:4px 0'
          );
        }

        // ═══════════════════════════════════════════════════════
        // 5. EASTER EGG — System log in DevTools on Code Mode activation
        // ══════════════════════════════════��════════════════════
        let easterEggPrinted = false;

        function printCodeModeEasterEgg() {
          if (easterEggPrinted) return;
          easterEggPrinted = true;

          const accentStyle = 'color:#D97757;font-weight:bold;font-size:12px;padding:2px 0';
          const systemStyle = 'color:#8be9fd;font-weight:bold;font-size:12px;padding:2px 0';
          const userStyle = 'color:#50fa7b;font-weight:bold;font-size:12px;padding:2px 0';

          console.log('%c─────────────────────────────────────────────', accentStyle);
          console.log('%c[SYSTEM] Environment: Production | Mode: Engineering', systemStyle);
          console.log('%c[USER] Welcome, Recruiter. Accessing design system specs...', userStyle);
          console.log('%c─────────────────────────────────────────────', accentStyle);
        }

        // Listen for Code Mode activation via class mutation
        const easterEggObserver = new MutationObserver(() => {
          const isCode = document.documentElement.classList.contains('code-mode');
          if (isCode) {
            printCodeModeEasterEgg();
          } else {
            easterEggPrinted = false;
          }
        });
        easterEggObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // Print immediately if already in Code Mode
        if (document.documentElement.classList.contains('code-mode')) {
          printCodeModeEasterEgg();
        }

        // ── Boot Sequence ──
        window.addEventListener('load', () => {
          printPerformanceDiag();
          initMicroCopy();
          startPeriodicLogs();
          syncFavicon();
          printSignature();
        });

        // Re-sync title & favicon on client-side navigation (Astro page transitions)
        document.addEventListener('astro:page-load', () => {
          syncCodeModeTab();
          initMicroCopy();
        });
      })();
    </script>
  <script>
    import { inject } from '@vercel/analytics';
    import { injectSpeedInsights } from '@vercel/speed-insights';
    inject();
    injectSpeedInsights();
  </script>
  </body>
</html>
